diff --git a/test/git-rewrite-metadata.test.ts b/test/git-rewrite-metadata.test.ts
new file mode 100644
index 0000000..1d9f2da
--- /dev/null
+++ b/test/git-rewrite-metadata.test.ts
@@ -0,0 +1,93 @@
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from 'vitest';
+import { buildSync } from 'esbuild';
+import { createHash } from 'node:crypto';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { closeSync, ftruncateSync, mkdirSync, mkdtempSync, openSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { objectRewriteState } from '../src/git/trusted';
+import { READ_CAP } from '../src/disk';
+import { runEnvelope } from '../src/cli/run';
+import { rootless } from './rootless';
+
+const roots: string[] = [];
+const workerDir = mkdtempSync(join(tmpdir(), 'tw-rewrite-worker-'));
+const worker = join(workerDir, 'worker.mjs');
+beforeAll(() => buildSync({
+  stdin: { contents: `import { objectRewriteState } from './src/git/trusted';\ntry { console.log(objectRewriteState(process.argv[2])); } catch (e) { console.error(String(e)); process.exitCode = 2; }`, resolveDir: resolve('.') },
+  outfile: worker, bundle: true, platform: 'node', format: 'esm', logLevel: 'silent',
+}));
+afterEach(() => { vi.restoreAllMocks(); for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true }); });
+afterAll(() => rmSync(workerDir, { recursive: true, force: true }));
+function fixture() {
+  const cwd = mkdtempSync(join(tmpdir(), 'tw-rewrite-')); roots.push(cwd);
+  const git = (...args: string[]) => execFileSync('git', args, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim();
+  git('init', '-q'); git('config', 'user.name', 'h'); git('config', 'user.email', 'h@x');
+  writeFileSync(join(cwd, 'source.js'), 'module.exports = 1;\n'); git('add', '.'); git('commit', '-qm', 'seed');
+  return { cwd, git };
+}
+function refused(cwd: string) {
+  // The outer process owns the watchdog: a regression cannot hang Vitest itself.
+  const result = spawnSync(process.execPath, [worker, cwd], { encoding: 'utf8', timeout: 4000, killSignal: 'SIGKILL' });
+  expect(result.error, result.stderr).toBeUndefined();
+  expect(result.signal, result.stderr).toBeNull();
+  expect(result.status, result.stderr).toBe(2);
+  expect(result.stdout).toBe('');
+}
+
+describe('bounded Git rewrite metadata (#798)', () => {
+  it('refuses malformed entry-time metadata before any agent starts', () => {
+    const f = fixture(); mkdirSync(join(f.cwd, '.git/info/grafts'));
+    const agentResult = vi.fn(); const errors: string[] = [];
+    vi.spyOn(process.stderr, 'write').mockImplementation(chunk => { errors.push(String(chunk)); return true; });
+    expect(runEnvelope({ cwd: f.cwd, cmd: 'node -e "process.exit(0)"', argv: [process.execPath, '-e', ''], onAgentResult: agentResult })).toBe(2);
+    expect(agentResult).not.toHaveBeenCalled();
+    expect(errors.join('')).toContain('entry-time Git rewrite state');
+  });
+  it.skipIf(!rootless)('reports uninspectable post-agent state as unavailable, never a clean fingerprint', () => {
+    const f = fixture(); const output: string[] = [];
+    vi.spyOn(process.stdout, 'write').mockImplementation(chunk => { output.push(String(chunk)); return true; });
+    vi.spyOn(process.stderr, 'write').mockImplementation(() => true);
+    const result = runEnvelope({ cwd: f.cwd, cmd: 'node -e "process.exit(0)"', argv: [process.execPath, '-e', ''], json: true,
+      onBeforeAdjudication: () => { mkdirSync(join(f.cwd, '.git/info/grafts')); },
+    });
+    expect(result).toBe(2);
+    expect(JSON.parse(output.join('').trim())).toMatchObject({ verdict: 'CANNOT_ADJUDICATE', reason: 'GIT_REWRITE_STATE_UNAVAILABLE', exit_code: 2, complete: false });
+  });
+  it('preserves the established digest for absent metadata and trimmed regular files', () => {
+    const f = fixture();
+    const digest = (grafts: string, shallow: string) => createHash('sha256').update(`replace:\ninfo/grafts:${grafts}\nshallow:${shallow}`).digest('hex');
+    expect(objectRewriteState(f.cwd)).toBe(digest('', ''));
+    const head = f.git('rev-parse', 'HEAD');
+    writeFileSync(join(f.cwd, '.git/info/grafts'), head + '\n');
+    writeFileSync(join(f.cwd, '.git/shallow'), head + '\n');
+    expect(objectRewriteState(f.cwd)).toBe(digest(head, head));
+  });
+  it.each(['info/grafts', 'shallow'])('refuses a directory at %s rather than hashing an unreadable marker', rel => {
+    const f = fixture(); mkdirSync(join(f.cwd, '.git', rel)); refused(f.cwd);
+  });
+  it.each(['info/grafts', 'shallow'])('refuses oversized %s without reading its contents', rel => {
+    const f = fixture(); const fd = openSync(join(f.cwd, '.git', rel), 'w');
+    try { ftruncateSync(fd, READ_CAP + 1); } finally { closeSync(fd); }
+    refused(f.cwd);
+  });
+  it.skipIf(process.platform === 'win32').each(['info/grafts', 'shallow'])('refuses a FIFO at %s without waiting for a writer', rel => {
+    const f = fixture(); execFileSync('mkfifo', [join(f.cwd, '.git', rel)]); refused(f.cwd);
+  });
+  it.skipIf(process.platform === 'win32').each(['regular', 'absent', 'fifo'])('refuses a metadata link to a %s target', kind => {
+    const f = fixture(); const target = join(f.cwd, '.git/target');
+    if (kind === 'regular') writeFileSync(target, '');
+    if (kind === 'fifo') execFileSync('mkfifo', [target]);
+    symlinkSync(target, join(f.cwd, '.git/info/grafts')); refused(f.cwd);
+  });
+  it('tracks the actual common-directory metadata from linked worktrees', () => {
+    const f = fixture(); const worktree = join(f.cwd, 'linked'); f.git('worktree', 'add', '--detach', worktree, 'HEAD');
+    const before = objectRewriteState(worktree);
+    writeFileSync(join(f.cwd, '.git/info/grafts'), f.git('rev-parse', 'HEAD') + '\n');
+    expect(objectRewriteState(worktree)).not.toBe(before);
+    expect(objectRewriteState(worktree)).toBe(objectRewriteState(f.cwd));
+  });
+  it('does not accept a directory outside a repository as an inspectable state', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'tw-not-git-')); roots.push(dir); refused(dir);
+  });
+});
