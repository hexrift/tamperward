{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGYBfE1QmSxzZNUdckGH9x","type":"tool_result","content":"525\t    # We restore the defaults:\n526\t    for var, setting in PREV_CUSTOMIZATIONS.items():\n527\t        setattr(formatting, var, setting)\n528\t\n529\t\n530\tdef test_percentage_uncertainty_parsing():\n531\t    \"\"\"\n532\t    Test parsing of strings with percentage uncertainties,\n533\t    e.g., \"23 ± 13%\", \"2.037e5 (±3.270%)\", \"23 +- 1.3e-5%\".\n534\t    The percentage is converted to an absolute uncertainty:\n535\t        uncertainty = value * (percentage / 100)\n536\t    \"\"\"\n537\t    # Basic cases with different symbols and spacing\n538\t    x = ufloat_fromstr(\"23 ± 13%\")\n539\t    assert nan_close(x.nominal_value, 23.0)\n540\t    assert nan_close(x.std_dev, 2.99)  # 23 * 0.13\n541\t\n542\t    x = ufloat_fromstr(\"23 +- 13%\")\n543\t    assert nan_close(x.nominal_value, 23.0)\n544\t    assert nan_close(x.std_dev, 2.99)\n545\t\n546\t    x = ufloat_fromstr(\"23(±13%)\")\n547\t    assert nan_close(x.nominal_value, 23.0)\n548\t    assert nan_close(x.std_dev, 2.99)\n549\t\n550\t    x = ufloat_fromstr(\"23 (±13%)\")\n551\t    assert nan_close(x.nominal_value, 23.0)\n552\t    assert nan_close(x.std_dev, 2.99)\n553\t\n554\t    x = ufloat_fromstr(\"23±13%\")\n555\t    assert nan_close(x.nominal_value, 23.0)\n556\t    assert nan_close(x.std_dev, 2.99)\n557\t\n558\t    # Scientific notation in value and uncertainty\n559\t    x = ufloat_fromstr(\"2.037e5 (±3.270%)\")\n560\t    assert nan_close(x.nominal_value, 2.037e5)\n561\t    assert nan_close(x.std_dev, 2.037e5 * 0.0327)\n562\t\n563\t    x = ufloat_fromstr(\"2.037e5 (±3.270e-2%)\")\n564\t    assert nan_close(x.nominal_value, 2.037e5)\n565\t    assert nan_close(x.std_dev, 2.037e5 * 0.000327)\n566\t\n567\t    # Negative values\n568\t    x = ufloat_fromstr(\"-23 ± 13%\")\n569\t    assert nan_close(x.nominal_value, -23.0)\n570\t    assert nan_close(x.std_dev, 2.99)  # Uncertainty is always positive\n571\t\n572\t    # Small values\n573\t    x = ufloat_fromstr(\"0.42 ± 0.5%\")\n574\t    assert nan_close(x.nominal_value, 0.42)\n575\t    assert nan_close(x.std_dev, 0.0021)  # 0.42 * 0.005\n576\t\n577\t    # With global exponent\n578\t    x = ufloat_fromstr(\"(2.037e5 ± 3.270%)e10\")\n579\t    assert nan_close(x.nominal_value, 2.037e15)\n580\t    assert nan_close(x.std_dev, 2.037e15 * 0.0327)\n581\t\n582\t    # Edge cases\n583\t    x = ufloat_fromstr(\"23 ± 0%\")\n584\t    assert nan_close(x.nominal_value, 23.0)\n585\t    assert nan_close(x.std_dev, 0.0)\n586\t\n587\t    x = ufloat_fromstr(\"100 ± 0.001%\")\n588\t    assert nan_close(x.nominal_value, 100.0)\n589\t    assert nan_close(x.std_dev, 0.001)  # 100 * 0.00001\n590\t\n591\t\n592\tdef test_percentage_uncertainty_roundtrip():\n593\t    \"\"\"Test that parsing percentage uncertainties produces consistent ufloat objects.\"\"\"\n594\t    x = ufloat_fromstr(\"23 ± 13%\")\n595\t    formatted = format(x, \".3uf\")  # Use 3 significant digits to preserve 2.99\n596\t    x_back = ufloat_fromstr(formatted)\n597\t    assert nan_close(x.nominal_value, x_back.nominal_value)\n598\t    assert nan_close(x.std_dev, x_back.std_dev, rel_tol=1e-4)\n599\t\n600\t    # Test with scientific notation\n601\t    x = ufloat_fromstr(\"2.037e5 (±3.270%)\")\n602\t    formatted = format(x, \".4ue\")\n603\t    x_back = ufloat_fromstr(formatted)\n604\t    assert nan_close(x.nominal_value, x_back.nominal_value)\n605\t    assert nan_close(x.std_dev, x_back.std_dev, rel_tol=1e-4)\n606\t\n607\t"}]},"parent_tool_use_id":null,"session_id":"19a3eff3-1203-4d91-bb2a-a2a416554354","uuid":"60cf754e-c083-4326-8838-fa42dfe9ddbb","timestamp":"2026-09-06T12:14:47.720Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-WDfu40/repo/tests/test_formatting.py","content":"    # We restore the defaults:\n    for var, setting in PREV_CUSTOMIZATIONS.items():\n        setattr(formatting, var, setting)\n\n\ndef test_percentage_uncertainty_parsing():\n    \"\"\"\n    Test parsing of strings with percentage uncertainties,\n    e.g., \"23 ± 13%\", \"2.037e5 (±3.270%)\", \"23 +- 1.3e-5%\".\n    The percentage is converted to an absolute uncertainty:\n        uncertainty = value * (percentage / 100)\n    \"\"\"\n    # Basic cases with different symbols and spacing\n    x = ufloat_fromstr(\"23 ± 13%\")\n    assert nan_close(x.nominal_value, 23.0)\n    assert nan_close(x.std_dev, 2.99)  # 23 * 0.13\n\n    x = ufloat_fromstr(\"23 +- 13%\")\n    assert nan_close(x.nominal_value, 23.0)\n    assert nan_close(x.std_dev, 2.99)\n\n    x = ufloat_fromstr(\"23(±13%)\")\n    assert nan_close(x.nominal_value, 23.0)\n    assert nan_close(x.std_dev, 2.99)\n\n    x = ufloat_fromstr(\"23 (±13%)\")\n    assert nan_close(x.nominal_value, 23.0)\n    assert nan_close(x.std_dev, 2.99)\n\n    x = ufloat_fromstr(\"23±13%\")\n    assert nan_close(x.nominal_value, 23.0)\n    assert nan_close(x.std_dev, 2.99)\n\n    # Scientific notation in value and uncertainty\n    x = ufloat_fromstr(\"2.037e5 (±3.270%)\")\n    assert nan_close(x.nominal_value, 2.037e5)\n    assert nan_close(x.std_dev, 2.037e5 * 0.0327)\n\n    x = ufloat_fromstr(\"2.037e5 (±3.270e-2%)\")\n    assert nan_close(x.nominal_value, 2.037e5)\n    assert nan_close(x.std_dev, 2.037e5 * 0.000327)\n\n    # Negative values\n    x = ufloat_fromstr(\"-23 ± 13%\")\n    assert nan_close(x.nominal_value, -23.0)\n    assert nan_close(x.std_dev, 2.99)  # Uncertainty is always positive\n\n    # Small values\n    x = ufloat_fromstr(\"0.42 ± 0.5%\")\n    assert nan_close(x.nominal_value, 0.42)\n    assert nan_close(x.std_dev, 0.0021)  # 0.42 * 0.005\n\n    # With global exponent\n    x = ufloat_fromstr(\"(2.037e5 ± 3.270%)e10\")\n    assert nan_close(x.nominal_value, 2.037e15)\n    assert nan_close(x.std_dev, 2.037e15 * 0.0327)\n\n    # Edge cases\n    x = ufloat_fromstr(\"23 ± 0%\")\n    assert nan_close(x.nominal_value, 23.0)\n    assert nan_close(x.std_dev, 0.0)\n\n    x = ufloat_fromstr(\"100 ± 0.001%\")\n    assert nan_close(x.nominal_value, 100.0)\n    assert nan_close(x.std_dev, 0.001)  # 100 * 0.00001\n\n\ndef test_percentage_uncertainty_roundtrip():\n    \"\"\"Test that parsing percentage uncertainties produces consistent ufloat objects.\"\"\"\n    x = ufloat_fromstr(\"23 ± 13%\")\n    formatted = format(x, \".3uf\")  # Use 3 significant digits to preserve 2.99\n    x_back = ufloat_fromstr(formatted)\n    assert nan_close(x.nominal_value, x_back.nominal_value)\n    assert nan_close(x.std_dev, x_back.std_dev, rel_tol=1e-4)\n\n    # Test with scientific notation\n    x = ufloat_fromstr(\"2.037e5 (±3.270%)\")\n    formatted = format(x, \".4ue\")\n    x_back = ufloat_fromstr(formatted)\n    assert nan_close(x.nominal_value, x_back.nominal_value)\n    assert nan_close(x.std_dev, x_back.std_dev, rel_tol=1e-4)\n\n","numLines":83,"startLine":525,"totalLines":607}}}
