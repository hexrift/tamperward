diff --git a/uncertainties/parsing.py b/uncertainties/parsing.py
index bf17669..d67e560 100644
--- a/uncertainties/parsing.py
+++ b/uncertainties/parsing.py
@@ -212,14 +212,33 @@ def str_to_number_with_uncert(representation):
     else:
         factor = 1  # No global exponential factor
 
-    match = re.match("(.*)(?:\\+/-|±)(.*)", representation)
+    match = re.match("(.*)(?:\\+/-|\\+-|±)(.*)", representation)
     if match:
         (nom_value, uncert) = match.groups()
+        nom_value = nom_value.strip()
+        uncert = uncert.strip()
+
+        # Percentage uncertainties may be wrapped in parentheses along with
+        # the +/- or ± symbol, e.g. "23(±13%)" or "23 (±13%)":
+        if nom_value.endswith("(") and uncert.endswith(")"):
+            nom_value = nom_value[:-1].strip()
+            uncert = uncert[:-1].strip()
+
+        # Percentage uncertainty, e.g. "23 ± 13%": the uncertainty is
+        # taken relative to the (factored) nominal value:
+        is_percentage = uncert.endswith("%")
+        if is_percentage:
+            uncert = uncert[:-1].strip()
 
         try:
             # Simple form 1234.45+/-1.2 or 1234.45±1.2, or 1.23e-10+/-1e-23
             # or -1.2×10⁻¹²±1e23:
-            parsed_value = (to_float(nom_value) * factor, to_float(uncert) * factor)
+            nom_value_float = to_float(nom_value) * factor
+            if is_percentage:
+                uncert_float = abs(nom_value_float) * (to_float(uncert) / 100)
+            else:
+                uncert_float = to_float(uncert) * factor
+            parsed_value = (nom_value_float, uncert_float)
         except ValueError:
             raise ValueError(cannot_parse_ufloat_msg_pat % representation)
 
