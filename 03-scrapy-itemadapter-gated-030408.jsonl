  return result\n65\t\n66\t\n67\tdef update_prop_from_union(prop: dict[str, Any], prop_type: Any, state: _JsonSchemaState) -> None:\n68\t    prop_types = dedupe_types(get_args(prop_type))\n69\t    simple_types = [v for k, v in SIMPLE_TYPES.items() if k in prop_types]\n70\t    complex_types = sorted([t for t in prop_types if t not in SIMPLE_TYPES])  # type: ignore[type-var]\n71\t    if not complex_types:\n72\t        prop.setdefault(\"type\", simple_types)\n73\t        return\n74\t    new_any_of: list[dict[str, Any]] = []\n75\t    any_of = prop.setdefault(\"anyOf\", new_any_of)\n76\t    if any_of is not new_any_of:\n77\t        return\n78\t    any_of.append({\"type\": simple_types if len(simple_types) > 1 else simple_types[0]})\n79\t    for complex_type in complex_types:\n80\t        complex_prop: dict[str, Any] = {}\n81\t        update_prop_from_type(complex_prop, complex_type, state)\n82\t        any_of.append(complex_prop)\n83\t\n84\t\n85\t@runtime_checkable\n86\tclass ArrayProtocol(Protocol):\n87\t    def __iter__(self) -> Iterator[Any]: ...\n88\t    def __len__(self) -> int: ...\n89\t    def __contains__(self, item: Any) -> bool: ...\n90\t\n91\t\n92\t@runtime_checkable\n93\tclass ObjectProtocol(Protocol):  # noqa: PLW1641\n94\t    def __getitem__(self, key: str) -> Any: ...\n95\t    def __iter__(self) -> Iterator[str]: ...\n96\t    def __len__(self) -> int: ...\n97\t    def __contains__(self, key: str) -> bool: ...\n98\t    def keys(self): ...\n99\t    def items(self): ...\n100\t    def values(self): ...\n101\t    def get(self, key: str, default: Any = ...): ...\n102\t    def __eq__(self, other): ...\n103\t    def __ne__(self, other): ...\n104\t\n105\t\n106\tINVALID_PATTERN_SUBSTRINGS = [\n107\t    \"(?P<\",  # named groups\n108\t    \"(?<=\",  # lookbehind\n109\t    \"(?<!\",  # negative lookbehind\n110\t    \"(?>\",  # atomic group\n111\t    \"\\\\A\",  # start of string\n112\t    \"\\\\Z\",  # end of string\n113\t    \"(?i)\",  # inline flags (case-insensitive, etc.)\n114\t    \"(?m)\",  # multiline\n115\t    \"(?s)\",  # dotall\n116\t    \"(?x)\",  # verbose\n117\t    \"(?#\",  # comments\n118\t]\n119\t\n120\t\n121\tdef is_valid_pattern(pattern: str) -> bool:\n122\t    # https://ecma-international.org/publications-and-standards/standards/ecma-262/\n123\t    #\n124\t    # Note: We allow word boundaries (\\b, \\B) in patterns even thought there is\n125\t    # a difference in behavior: in Python, they work with Unicode; in JSON\n126\t    # Schema, they only work with ASCII.\n127\t    return not any(sub in pattern for sub in INVALID_PATTERN_SUBSTRINGS)\n128\t\n129\t\n130\tdef array_type(type_hint):\n131\t    \"\"\"Given the type hint of a Python type that maps to a JSON Schema array,\n132\t    such as a list, a tuple or a set, return the type of the items in that\n133\t    array.\"\"\"\n134\t    args = get_args(type_hint)\n135\t    if not args:\n136\t        return Any\n137\t    if args[-1] is Ellipsis:\n138\t        args = args[:-1]\n139\t    unique_args = set(args)\n140\t    if len(unique_args) == 1:\n141\t        return next(iter(unique_args))\n142\t    return Union[tuple(unique_args)]\n143\t\n144\t\n145\tdef update_prop_from_pattern(prop: dict[str, Any], pattern: str) -> None:\n146\t    if is_valid_pattern(pattern):\n147\t        prop.setdefault(\"pattern\", pattern)\n148\t\n149\t\n150\ttry:\n151\t    from types import UnionType\n152\texcept ImportError:  # Python < 3.10\n153\t    UNION_TYPES: set[Any] = {Union}\n154\telse:\n155\t    UNION_TYPES = {Union, UnionType}\n156\t\n157\t\n158\tdef update_prop_from_origin(\n159\t    prop: dict[str, Any], origin: Any, prop_type: Any, state: _JsonSchemaState\n160\t) -> None:\n161\t    if isinstance(origin, type):\n162\t        if issubclass(origin, (Sequence, AbstractSet)):\n163\t            prop.setdefault(\"type\", \"array\")\n164\t            if issubclass(origin, AbstractSet):\n165\t                prop.setdefault(\"uniqueItems\", True)\n166\t            had_items = \"items\"