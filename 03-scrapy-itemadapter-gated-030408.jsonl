_prop_from_type(prop, prop_type, state)\n209\t            prop.setdefault(\"enum\", values)\n210\t            return\n211\t        if not issubclass(prop_type, str):\n212\t            if isinstance(prop_type, ObjectProtocol):\n213\t                prop.setdefault(\"type\", \"object\")\n214\t                return\n215\t            if isinstance(prop_type, ArrayProtocol):\n216\t                prop.setdefault(\"type\", \"array\")\n217\t                if issubclass(prop_type, AbstractSet):\n218\t                    prop.setdefault(\"uniqueItems\", True)\n219\t                return\n220\t    json_schema_type = SIMPLE_TYPES.get(prop_type)\n221\t    if json_schema_type is not None:\n222\t        prop.setdefault(\"type\", json_schema_type)\n223\t\n224\t\n225\tdef _setdefault_attribute_types_on_json_schema(\n226\t    schema: dict[str, Any], item_class: type, state: _JsonSchemaState\n227\t) -> None:\n228\t    \"\"\"Inspect the type hints of the class attributes of the item class and,\n229\t    for any matching JSON Schema property that has no type set, set the type\n230\t    based on the type hint.\"\"\"\n231\t    props = schema.get(\"properties\", {})\n232\t    attribute_type_hints = get_type_hints(item_class)\n233\t    for prop_name, prop in props.items():\n234\t        if prop_name not in attribute_type_hints:\n235\t            continue\n236\t        prop_type = attribute_type_hints[prop_name]\n237\t        update_prop_from_type(prop, prop_type, state)\n238\t\n239\t\n240\tdef iter_docstrings(item_class: type, attr_names: AbstractSet[str]) -> Iterator[tuple[str, str]]:\n241\t    try:\n242\t        source = inspect.getsource(item_class)\n243\t    except (OSError, TypeError):\n244\t        return\n245\t    tree = ast.parse(dedent(source))\n246\t    class_node = None\n247\t    for node in tree.body:\n248\t        if isinstance(node, ast.ClassDef) and node.name == item_class.__name__:\n249\t            class_node = node\n250\t            break\n251\t    if class_node is None:  # pragma: no cover\n252\t        # This can be reproduced with the doctests of the README, but the\n253\t        # coverage data does not seem to include those.\n254\t        return\n255\t    assert isinstance(class_node, ast.ClassDef)\n256\t    for child in ast.iter_child_nodes(class_node):\n257\t        if isinstance(child, ast.Assign) and isinstance(child.targets[0], ast.Name):\n258\t            attr_name = child.targets[0].id\n259\t        elif isinstance(child, ast.AnnAssign) and isinstance(child.target, ast.Name):\n260\t            attr_name = child.target.id\n261\t        else:\n262\t            continue\n263\t        if attr_name not in attr_names:\n264\t            continue\n265\t        next_idx = class_node.body.index(child) + 1\n266\t        if next_idx >= len(class_node.body):\n267\t            continue\n268\t        next_node = class_node.body[next_idx]\n269\t        if (\n270\t            isinstance(next_node, ast.Expr)\n271\t            and isinstance(next_node.value, ast.Constant)\n272\t            and isinstance(next_node.value.value, str)\n273\t        ):\n274\t            yield attr_name, next_node.value.value\n275\t\n276\t\n277\tdef get_inherited_attr_docstring(item_class: type, attr_name: str) -> str | None:\n278\t    \"\"\"Recursively search the MRO for a docstring for the given attribute\n279\t    name.\"\"\"\n280\t    for cls in item_class.__mro__:\n281\t        for name, doc in iter_docstrings(cls, {attr_name}):\n282\t            if name == attr_name:\n283\t                return doc\n284\t    return None\n285\t\n286\t\n287\tdef _setdefault_attribute_docstrings_on_json_schema(\n288\t    schema: dict[str, Any], item_class: type\n289\t) -> None:\n290\t    \"\"\"Inspect the docstrings after each class attribute of the item class and\n291\t    its bases and, for any matching JSON Schema property that has no\n292\t    description set, set the description to the contents of the docstring.\"\"\"\n293\t    props = schema.get(\"properties\", {})