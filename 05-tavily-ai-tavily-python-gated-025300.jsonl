n-Id\": session_id} if session_id else {}),\n44\t            **({\"X-Human-Id\": human_id} if human_id else {}),\n45\t            **({\"X-Client-Name\": client_name} if client_name else {}),\n46\t        }\n47\t\n48\t        self._external_client = client is not None\n49\t\n50\t        if client is not None:\n51\t            self._client = client\n52\t            # Only set headers that aren't already configured on the external client\n53\t            for key, value in default_headers.items():\n54\t                if key not in self._client.headers:\n55\t                    self._client.headers[key] = value\n56\t            # Set base_url if the external client doesn't have one\n57\t            if not str(self._client.base_url):\n58\t                self._client.base_url = self._api_base_url\n59\t        else:\n60\t            proxies = proxies or {}\n61\t\n62\t            mapped_proxies = {\n63\t                \"http://\": proxies.get(\"http\", os.getenv(\"TAVILY_HTTP_PROXY\")),\n64\t                \"https://\": proxies.get(\"https\", os.getenv(\"TAVILY_HTTPS_PROXY\")),\n65\t            }\n66\t\n67\t            mapped_proxies = {key: value for key, value in mapped_proxies.items() if value}\n68\t\n69\t            proxy_mounts = (\n70\t                {scheme: httpx.AsyncHTTPTransport(proxy=proxy) for scheme, proxy in mapped_proxies.items()}\n71\t                if mapped_proxies\n72\t                else None\n73\t            )\n74\t\n75\t            self._client = httpx.AsyncClient(\n76\t                headers=default_headers,\n77\t                base_url=self._api_base_url,\n78\t                mounts=proxy_mounts\n79\t            )\n80\t\n81\t    async def close(self):\n82\t        \"\"\"Close the client and release connection pool resources.\"\"\"\n83\t        if not self._external_client:\n84\t            await self._client.aclose()\n85\t\n86\t    async def __aenter__(self):\n87\t        return self\n88\t\n89\t    async def __aexit__(self, exc_type, exc_val, exc_tb):\n90\t        await self.close()\n91\t\n92\t    @staticmethod\n93\t    def _pop_request_headers(kwargs: dict) -> Optional[dict]:\n94\t        \"\"\"Pop session_id, human_id, and client_name from kwargs and return them as headers.\n95\t\n96\t        Returns None when no overrides are provided so callers can omit the headers kwarg.\n97\t        \"\"\"\n98\t        overrides = {}\n99\t        for key, header_name in (\n100\t            (\"session_id\", \"X-Session-Id\"),\n101\t            (\"human_id\", \"X-Human-Id\"),\n102\t            (\"client_name\", \"X-Client-Name\"),\n103\t        ):\n104\t            value = kwargs.pop(key, None)\n105\t            if value is not None:\n106\t                overrides[header_name] = str(value)\n107\t        return overrides or None\n108\t\n109\t    async def _search(\n110\t            self,\n111\t            query: str,\n112\t            search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = None,\n113\t            topic: Literal[\"general\", \"news\", \"finance\"] = None,\n114\t            time_range: Literal[\"day\", \"week\", \"month\", \"year\"] = None,\n115\t            start_date: str = None,\n116\t            end_date: str = None,\n117\t            days: int = None,\n118\t            max_results: int = None,\n119\t            include_domains: Sequence[str] = None,\n120\t            exclude_domains: Sequence[str] = None,\n121\t            include_answer: Union[bool, Literal[\"basic\", \"advanced\"]] = None,\n122\t            include_raw_content: Union[bool, Literal[\"markdown\", \"text\"]] = None,\n123\t            include_images: bool = None,\n124\t            timeout: float = 60,\n125\t            country: str = None,\n126\t            auto_parameters: bool = None,\n127\t            include_favicon: bool = None,\n128\t            include_usage: bool = None,\n129\t            exact_match: bool = None,\n130\t            **kwargs,\n131\t    ) -> dict:\n132\t        \"\"\"\n133\t        Internal search method to send the request to the API.\n134\t        \"\"\"\n135\t        data = {\n136\t            \"query\": query,\n137\t            \"search_depth\": search_depth,\n138\t            \"topic\": topic,\n139\t            \"time_range\": time_range,\n140\t            \"start_date\": start_date,\n141\t            \"end_date\": end_date,\n142\t            \"days\": days,\n143\t            \"include_answer\": include_answer,\n144\t            \"include_raw_content\": include_raw_content,\n145\t            \"max_results\": max_results,\n146\t            \"include_domains\": include_domains,\n147\t            \"exclude_domains\": exclude_domains,\n148\t            \"include_images\": include_images,\n149\t            \"country\": country,\n150\t            \"auto_parameters\": auto_parameters,\n151\t            \"include_favicon\": include_favicon,\n152\t            \"include_usage\": include_usage,\n153\t            \"exact_match\": exact_match,\n154\t        }\n155\t\n156\t        data = {k: v for k, v in data.items() if v is not None}\n157\t\n158\t        override_headers = self._pop_request_headers(kwargs)\n159\t        if kwargs:\n160\t            data.update(kwargs)\n161\t\n162\t        timeout = min(timeout, 120)\n163\t\n164\t        try:\n165\t            response = await self._client.post(\"/search\", content=json.dumps(data), timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n166\t        except httpx.TimeoutException:\n167\t            raise TimeoutError(timeout)\n168\t\n169\t        if response.status_code == 200:\n170\t            return response.json()\n171\t        else:\n172\t            detail = \"\"\n173\t            try:\n174\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n175\t            except Exception:\n176\t                pass\n177\t\n178\t            if response.status_code == 429:\n179\t                raise UsageLimitExceededError(detail)\n180\t            elif response.status_code in [403,432,433]:\n181\t                raise ForbiddenError(detail)\n182\t            elif response.status_code == 401:\n183\t                raise InvalidAPIKeyError(detail)\n184\t            elif response.status_code == 400:\n185\t                raise BadRequestError(detail)\n186\t            else:\n187\t                raise response.raise_for_status()\n188\t\n189\t    async def search(self,\n190\t                     query: str,\n191\t                     search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = None,\n192\t                     topic: Literal[\"general\", \"news\", \"finance\"] = None,\n193\t                     time_range: Literal[\"day\", \"week\", \"month\", \"year\"] = None,\n194\t                     start_date: str = None,\n195\t                     end_date: str = None,\n196\t                     days: int = None,\n197\t                     max_results: int = None,\n198\t                     include_domains: Sequence[str] = None,\n199\t                     exclude_domains: Sequence[str] = None,\n200\t                     include_answer: Union[bool, Literal[\"basic\", \"advanced\"]] = None,\n201\t                     include_raw_content: Union[bool, Literal[\"markdown\", \"text\"]] = None,\n202\t                     include_images: bool = None,\n203\t                     timeout: float = 60,\n204\t                     country: str = None,\n205\t                     auto_parameters: bool = None,\n206\t                     include_favicon: bool = None,\n207\t                     include_usage: bool = None,\n208\t                     exact_match: bool = None,\n209\t                     **kwargs,  # Accept custom arguments\n210\t                     ) -> dict:\n211\t        \"\"\"\n212\t        Combined search method. Set search_depth to either \"basic\", \"advanced\", \"fast\", or \"ultra-fast\".\n213\t        \"\"\"\n214\t        timeout = min(timeout, 120)\n215\t        response_dict = await self._search(query,\n216\t                                           search_depth=search_depth,\n217\t                                           topic=topic,\n218\t                                           time_range=time_range,\n219\t                                           start_date=start_date,\n220\t                                           end_date=end_date,\n221\t                                           days=days,\n222\t                                           max_results=max_results,\n223\t                                           include_domains=include_domains,\n224\t                                           exclude_domains=exclude_domains,\n225\t                                           include_answer=include_answer,\n226\t                                           include_raw_content=include_raw_content,\n227\t                                           include_images=include_images,\n228\t                                           timeout=timeout,\n229\t                                           country=country,\n230\t                                           auto_parameters=auto_parameters,\n231\t                                           include_favicon=include_favicon,\n232\t                                           include_usage=include_usage,\n233\t                                           exact_match=exact_match,\n234\t                                           **kwargs,\n235\t                                           )\n236\t\n237\t        tavily_results = response_dict.get(\"results\", [])\n238\t\n239\t        response_dict[\"results\"] = tavily_results\n240\t\n241\t        return response_dict\n242\t\n243\t    async def _extract(\n244\t            self,\n245\t            urls: Union[List[str], str],\n246\t            include_images: bool = None,\n247\t            extract_depth: Literal[\"basic\", \"advanced\"] = None,\n248\t            format: Literal[\"markdown\", \"text\"] = None,\n249\t            timeout: float = 30,\n250\t            include_favicon: bool = None,\n251\t            include_usage: bool = None,\n252\t            query: str = None,\n253\t            chunks_per_source: int = None,\n254\t            **kwargs\n255\t    ) -> dict:\n256\t        \"\"\"\n257\t        Internal extract method to send the request to the API.\n258\t        include_favicon: If True, include the favicon in the extraction results.\n259\t        \"\"\"\n260\t        data = {\n261\t            \"urls\": urls,\n262\t            \"include_images\": include_images,\n263\t            \"extract_depth\": extract_depth,\n264\t            \"format\": format,\n265\t            \"timeout\": timeout,\n266\t            \"include_favicon\": include_favicon,\n267\t            \"include_usage\": include_usage,\n268\t            \"query\": query,\n269\t            \"chunks_per_source\": chunks_per_source,\n270\t        }\n271\t\n272\t        data = {k: v for k, v in data.items() if v is not None}\n273\t\n274\t        override_headers = self._pop_request_headers(kwargs)\n275\t        if kwargs:\n276\t            data.update(kwargs)\n277\t\n278\t        try:\n279\t            response = await self._client.post(\"/extract\", content=json.dumps(data), timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n280\t        except httpx.TimeoutException:\n281\t            raise TimeoutError(timeout)\n282\t\n283\t        if response.status_code == 200:\n284\t            return response.json()\n285\t        else:\n286\t            detail = \"\"\n287\t            try:\n288\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n289\t            except Exception:\n290\t                pass\n291\t\n292\t\n293\t            if response.status_code == 429:\n294\t                raise UsageLimitExceededError(detail)\n295\t            elif response.status_code in [403,432,433]:\n296\t                raise ForbiddenError(detail)\n297\t            elif response.status_code == 401:\n298\t                raise InvalidAPIKeyError(detail)\n299\t            elif response.status_code == 400:\n300\t                raise BadRequestError(detail)\n301\t            else:\n302\t                raise response.raise_for_status()\n303\t\n304\t    async def extract(self,\n305\t                      urls: Union[List[str], str],  # Accept a list of URLs or a single URL\n306\t                      include_images: bool = None,\n307\t                      extract_depth: Literal[\"basic\", \"advanced\"] = None,\n308\t                      format: Literal[\"markdown\", \"text\"] = None,\n309\t                      timeout: float = 30,\n310\t                      include_favicon: bool = None,\n311\t                      include_usage: bool = None,\n312\t                      query: str = None,\n313\t                      chunks_per_source: int = None,\n314\t                      **kwargs,  # Accept custom arguments\n315\t                      ) -> dict:\n316\t        \"\"\"\n317\t        Combined extract method.\n318\t        include_favicon: If True, include the favicon in the extraction results.\n319\t        \"\"\"\n320\t        response_dict = await self._extract(urls,\n321\t                                            include_images,\n322\t                                            extract_depth,\n323\t                                            format,\n324\t                                            timeout,\n325\t                                            include_favicon=include_favicon,\n326\t                                            include_usage=include_usage,\n327\t                                            query=query,\n328\t                                            chunks_per_source=chunks_per_source,\n329\t                                            **kwargs,\n330\t                                            )\n331\t\n332\t        tavily_results = response_dict.get(\"results\", [])\n333\t        failed_results = response_dict.get(\"failed_results\", [])\n334\t\n335\t        response_dict[\"results\"] = tavily_results\n336\t        response_dict[\"failed_results\"] = failed_results\n337\t\n338\t        return response_dict\n339\t\n340\t    async def _crawl(self,\n341\t               url: str,\n342\t               max_depth: int = None,\n343\t               max_breadth: int = None,\n344\t               limit: int = None,\n345\t               instructions: str = None,\n346\t               select_paths: Sequence[str] = None,\n347\t               select_domains: Sequence[str] = None,\n348\t               exclude_paths: Sequence[str] = None,\n349\t               exclude_domains: Sequence[str] = None,\n350\t               allow_external: bool = None,\n351\t               include_images: bool = None,\n352\t               extract_depth: Literal[\"basic\", \"advanced\"] = None,\n353\t               format: Literal[\"markdown\", \"text\"] = None,\n354\t               timeout: float = 150,\n355\t               include_favicon: bool = None,\n356\t               include_usage: bool = None,\n357\t               chunks_per_source: int = None,\n358\t               **kwargs\n359\t               ) -> dict:\n360\t        \"\"\"\n361\t        Internal crawl method to send the request to the API.\n362\t        \"\"\"\n363\t        data = {\n364\t            \"url\": url,\n365\t            \"max_depth\": max_depth,\n366\t            \"max_breadth\": max_breadth,\n367\t            \"limit\": limit,\n368\t            \"instructions\": instructions,\n369\t            \"select_paths\": select_paths,\n370\t            \"select_domains\": select_domains,\n371\t            \"exclude_paths\": exclude_paths,\n372\t            \"exclude_domains\": exclude_domains,\n373\t            \"allow_external\": allow_external,\n374\t            \"include_images\": include_images,\n375\t            \"extract_depth\": extract_depth,\n376\t            \"format\": format,\n377\t            \"timeout\": timeout,\n378\t            \"include_favicon\": include_favicon,\n379\t            \"include_usage\": include_usage,\n380\t            \"chunks_per_source\": chunks_per_source,\n381\t        }\n382\t\n383\t        override_headers = self._pop_request_headers(kwargs)\n384\t        if kwargs:\n385\t            data.update(kwargs)\n386\t\n387\t        data = {k: v for k, v in data.items() if v is not None}\n388\t\n389\t        try:\n390\t            response = await self._client.post(\"/crawl\", content=json.dumps(data), timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n391\t        except httpx.TimeoutException:\n392\t            raise TimeoutError(timeout)\n393\t\n394\t        if response.status_code == 200:\n395\t            return response.json()\n396\t        else:\n397\t            detail = \"\"\n398\t            try:\n399\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n400\t            except Exception:\n401\t                pass\n402\t\n403\t            if response.status_code == 429:\n404\t                raise UsageLimitExceededError(detail)\n405\t            elif response.status_code in [403,432,433]:\n406\t                raise ForbiddenError(detail)\n407\t            elif response.status_code == 401:\n408\t                raise InvalidAPIKeyError(detail)\n409\t            elif response.status_code == 400:\n410\t                raise BadRequestError(detail)\n411\t            else:\n412\t                raise response.raise_for_status()\n413\t\n414\t    async def crawl(self,\n415\t                    url: str,\n416\t                    max_depth: int = None,\n417\t                    max_breadth: int = None,\n418\t                    limit: int = None,\n419\t                    instructions: str = None,\n420\t                    select_paths: Sequence[str] = None,\n421\t                    select_domains: Sequence[str] = None,\n422\t                    exclude_paths: Sequence[str] = None,\n423\t                    exclude_domains: Sequence[str] = None,\n424\t                    allow_external: bool = None,\n425\t                    extract_depth: Literal[\"basic\", \"advanced\"] = None,\n426\t                    include_images: bool = None,\n427\t                    format: Literal[\"markdown\", \"text\"] = None,\n428\t                    timeout: float = 150,\n429\t                    include_favicon: bool = None,\n430\t                    include_usage: bool = None,\n431\t                    chunks_per_source: int = None,\n432\t                    **kwargs\n433\t                    ) -> dict:\n434\t        \"\"\"\n435\t        Combined crawl method.\n436\t\n437\t        \"\"\"\n438\t        response_dict = await self._crawl(url,\n439\t                                    max_depth=max_depth,\n440\t                                    max_breadth=max_breadth,\n441\t                                    limit=limit,\n442\t                                    instructions=instructions,\n443\t                                    select_paths=select_paths,\n444\t                                    select_domains=select_domains,\n445\t                                    exclude_paths=exclude_paths,\n446\t                                    exclude_domains=exclude_domains,\n447\t                                    allow_external=allow_external,\n448\t                                    extract_depth=extract_depth,\n449\t                                    include_images=include_images,\n450\t                                    format=format,\n451\t                                    timeout=timeout,\n452\t                                    include_favicon=include_favicon,\n453\t                                    include_usage=include_usage,\n454\t                                    chunks_per_source=chunks_per_source,\n455\t                                    **kwargs)\n456\t\n457\t        return response_dict\n458\t\n459\t    async def _map(self,\n460\t               url: str,\n461\t               max_depth: int = None,\n462\t               max_breadth: int = None,\n463\t               limit: int = None,\n464\t               instructions: str = None,\n465\t               select_paths: Sequence[str] = None,\n466\t               select_domains: Sequence[str] = None,\n467\t               exclude_paths: Sequence[str] = None,\n468\t               exclude_domains: Sequence[str] = None,\n469\t               allow_external: bool = None,\n470\t               include_images: bool = None,\n471\t               timeout: float = 150,\n472\t               include_usage: bool = None,\n473\t               **kwargs\n474\t               ) -> dict:\n475\t        \"\"\"\n476\t        Internal map method to send the request to the API.\n477\t        \"\"\"\n478\t        data = {\n479\t            \"url\": url,\n480\t            \"max_depth\": max_depth,\n481\t            \"max_breadth\": max_breadth,\n482\t            \"limit\": limit,\n483\t            \"instructions\": instructions,\n484\t            \"select_paths\": select_paths,\n485\t            \"select_domains\": select_domains,\n486\t            \"exclude_paths\": exclude_paths,\n487\t            \"exclude_domains\": exclude_domains,\n488\t            \"allow_external\": allow_external,\n489\t            \"include_images\": include_images,\n490\t            \"timeout\": timeout,\n491\t            \"include_usage\": include_usage,\n492\t        }\n493\t\n494\t        override_headers = self._pop_request_headers(kwargs)\n495\t        if kwargs:\n496\t            data.update(kwargs)\n497\t\n498\t        data = {k: v for k, v in data.items() if v is not None}\n499\t\n500\t        try:\n501\t            response = await self._client.post(\"/map\", content=json.dumps(data), timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n502\t        except httpx.TimeoutException:\n503\t            raise TimeoutError(timeout)\n504\t\n505\t        if response.status_code == 200:\n506\t            return response.json()\n507\t        else:\n508\t            detail = \"\"\n509\t            try:\n510\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n511\t            except Exception:\n512\t                pass\n513\t\n514\t            if response.status_code == 429:\n515\t                raise UsageLimitExceededError(detail)\n516\t            elif response.status_code in [403,432,433]:\n517\t                raise ForbiddenError(detail)\n518\t            elif response.status_code == 401:\n519\t                raise InvalidAPIKeyError(detail)\n520\t            elif response.status_code == 400:\n521\t                raise BadRequestError(detail)\n522\t            else:\n523\t                raise response.raise_for_status()\n524\t\n525\t    async def map(self,\n526\t                    url: str,\n527\t                    max_depth: int = None,\n528\t                    max_breadth: int = None,\n529\t                    limit: int = None,\n530\t                    instructions: str = None,\n531\t                    select_paths: Sequence[str] = None,\n532\t                    select_domains: Sequence[str] = None,\n533\t                    exclude_paths: Sequence[str] = None,\n534\t                    exclude_domains: Sequence[str] = None,\n535\t                    allow_external: bool = None,\n536\t                    include_images: bool = None,\n537\t                    timeout: float = 150,\n538\t                    include_usage: bool = None,\n539\t                    **kwargs\n540\t                    ) -> dict:\n541\t        \"\"\"\n542\t        Combined map method.\n543\t\n544\t        \"\"\"\n545\t        response_dict = await self._map(url,\n546\t                                    max_depth=max_depth,\n547\t                                    max_breadth=max_breadth,\n548\t                                    limit=limit,\n549\t                                    instructions=instructions,\n550\t                                    select_paths=select_paths,\n551\t                                    select_domains=select_domains,\n552\t                                    exclude_paths=exclude_paths,\n553\t                                    exclude_domains=exclude_domains,\n554\t                                    allow_external=allow_external,\n555\t                                    include_images=include_images,\n556\t                                    timeout=timeout,\n557\t                                    include_usage=include_usage,\n558\t                                    **kwargs)\n559\t\n560\t        return response_dict\n561\t\n562\t    async def get_search_context(self,\n563\t                                 query: str,\n564\t                                 search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = \"basic\",\n565\t                                 topic: Literal[\"general\", \"news\", \"finance\"] = \"general\",\n566\t                                 days: int = 7,\n567\t                                 max_results: int = 5,\n568\t                                 include_domains: Sequence[str] = None,\n569\t                                 exclude_domains: Sequence[str] = None,\n570\t                                 max_tokens: int = 4000,\n571\t                                 timeout: float = 60,\n572\t                                 country: str = None,\n573\t                                 include_favicon: bool = None,\n574\t                                 **kwargs,  # Accept custom arguments\n575\t                                 ) -> str:\n576\t        \"\"\"\n577\t        Get the search context for a query. Useful for getting only related content from retrieved websites\n578\t        without having to deal with context extraction and limitation yourself.\n579\t\n580\t        max_tokens: The maximum number of tokens to return (based on openai token compute). Defaults to 4000.\n581\t\n582\t        Returns a string of JSON containing the search context up to context limit.\n583\t        \"\"\"\n584\t        timeout = min(timeout, 120)\n585\t        response_dict = await self._search(query,\n586\t                                           search_depth=search_depth,\n587\t                                           topic=topic,\n588\t                                           days=days,\n589\t                                           max_results=max_results,\n590\t                                           include_domains=include_domains,\n591\t                                           exclude_domains=exclude_domains,\n592\t                                           include_answer=False,\n593\t                                           include_raw_content=False,\n594\t                                           include_images=False,\n595\t                                           timeout = timeout,\n596\t                                           country=country,\n597\t                                           include_favicon=include_favicon,\n598\t                                           **kwargs,\n599\t                                           )\n600\t        sources = response_dict.get(\"results\", [])\n601\t        context = [{\"url\": source[\"url\"], \"content\": source[\"content\"]} for source in sources]\n602\t        return json.dumps(get_max_items_from_list(context, max_tokens))\n603\t\n604\t    async def qna_search(self,\n605\t                         query: str,\n606\t                         search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = \"advanced\",\n607\t                         topic: Literal[\"general\", \"news\", \"finance\"] = \"general\",\n608\t                         days: int = 7,\n609\t                         max_results: int = 5,\n610\t                         include_domains: Sequence[str] = None,\n611\t                         exclude_domains: Sequence[str] = None,\n612\t                         timeout: float = 60,\n613\t                         country: str = None,\n614\t                         include_favicon: bool = None,\n615\t                         **kwargs,  # Accept custom arguments\n616\t                         ) -> str:\n617\t        \"\"\"\n618\t        Q&A search method. Search depth is advanced by default to get the best answer.\n619\t        \"\"\"\n620\t        timeout = min(timeout, 120)\n621\t        response_dict = await self._search(query,\n622\t                                           search_depth=search_depth,\n623\t                                           topic=topic,\n624\t                                           days=days,\n625\t                                           max_results=max_results,\n626\t                                           include_domains=include_domains,\n627\t                                           exclude_domains=exclude_domains,\n628\t                                           include_raw_content=False,\n629\t                                           include_images=False,\n630\t                                           include_answer=True,\n631\t                                           timeout = timeout,\n632\t                                           country=country,\n633\t                                           include_favicon=include_favicon,\n634\t                                           **kwargs,\n635\t                                           )\n636\t        return response_dict.get(\"answer\", \"\")\n637\t\n638\t    async def get_company_info(self,\n639\t                               query: str,\n640\t                               search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = \"advanced\",\n641\t                               max_results: int = 5,\n642\t                               timeout: float = 60,\n643\t                               country: str = None,\n644\t                               ) -> Sequence[dict]:\n645\t        \"\"\" Company information search method. Search depth is advanced by default to get the best answer. \"\"\"\n646\t        timeout = min(timeout, 120)\n647\t\n648\t        async def _perform_search(topic: str):\n649\t            return await self._search(query,\n650\t                                      search_depth=search_depth,\n651\t                                      topic=topic,\n652\t                                      max_results=max_results,\n653\t                                      include_answer=False,\n654\t                                      timeout = timeout,\n655\t                                      country=country)\n656\t\n657\t        all_results = []\n658\t        for data in await asyncio.gather(*[_perform_search(topic) for topic in self._company_info_tags]):\n659\t            if \"results\" in data:\n660\t                all_results.extend(data[\"results\"])\n661\t\n662\t        # Sort all the results by score in descending order and take the top 'max_results' items\n663\t        sorted_results = sorted(all_results, key=lambda x: x[\"score\"], reverse=True)[:max_results]\n664\t\n665\t        return sorted_results\n666\t\n667\t    def _research(self,\n668\t                  input: str,\n669\t                  model: Literal[\"mini\", \"pro\", \"auto\"] = None,\n670\t                  output_schema: dict = None,\n671\t                  stream: bool = False,\n672\t                  citation_format: Literal[\"numbered\", \"mla\", \"apa\", \"chicago\"] = \"numbered\",\n673\t                  timeout: Optional[float] = None,\n674\t                  **kwargs\n675\t                  ) -> Union[AsyncGenerator[bytes, None], Awaitable[dict]]:\n676\t        \"\"\"\n677\t        Internal research method to send the request to the API.\n678\t        \"\"\"\n679\t        data = {\n680\t            \"input\": input,\n681\t            \"model\": model,\n682\t            \"output_schema\": output_schema,\n683\t            \"stream\": stream,\n684\t            \"citation_format\": citation_format,\n685\t        }\n686\t\n687\t        data = {k: v