key else {}),\n47\t            \"X-Client-Source\": client_source or \"tavily-python\",\n48\t            **({\"X-Project-ID\": tavily_project} if tavily_project else {}),\n49\t            **({\"X-Session-Id\": session_id} if session_id else {}),\n50\t            **({\"X-Human-Id\": human_id} if human_id else {}),\n51\t            **({\"X-Client-Name\": client_name} if client_name else {}),\n52\t        }\n53\t\n54\t        self._external_session = session is not None\n55\t        self.session = session if session is not None else requests.Session()\n56\t        # For external sessions, only set headers that aren't already configured\n57\t        for key, value in self.headers.items():\n58\t            if key not in self.session.headers:\n59\t                self.session.headers[key] = value\n60\t        if self.proxies:\n61\t            for protocol, url in self.proxies.items():\n62\t                if protocol not in self.session.proxies:\n63\t                    self.session.proxies[protocol] = url\n64\t\n65\t    def close(self):\n66\t        \"\"\"Close the session and release resources.\"\"\"\n67\t        if not self._external_session:\n68\t            self.session.close()\n69\t\n70\t    def __enter__(self):\n71\t        return self\n72\t\n73\t    def __exit__(self, exc_type, exc_val, exc_tb):\n74\t        self.close()\n75\t\n76\t    @staticmethod\n77\t    def _pop_request_headers(kwargs: dict) -> Optional[dict]:\n78\t        \"\"\"Pop session_id, human_id, and client_name from kwargs and return them as headers.\n79\t\n80\t        Returns None when no overrides are provided so callers can omit the headers kwarg.\n81\t        \"\"\"\n82\t        overrides = {}\n83\t        for key, header_name in (\n84\t            (\"session_id\", \"X-Session-Id\"),\n85\t            (\"human_id\", \"X-Human-Id\"),\n86\t            (\"client_name\", \"X-Client-Name\"),\n87\t        ):\n88\t            value = kwargs.pop(key, None)\n89\t            if value is not None:\n90\t                overrides[header_name] = str(value)\n91\t        return overrides or None\n92\t\n93\t    def _search(self,\n94\t                query: str,\n95\t                search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = None,\n96\t                topic: Literal[\"general\", \"news\", \"finance\"] = None,\n97\t                time_range: Literal[\"day\", \"week\", \"month\", \"year\"] = None,\n98\t                start_date: str = None,\n99\t                end_date: str = None,\n100\t                days: int = None,\n101\t                max_results: int = None,\n102\t                include_domains: Sequence[str] = None,\n103\t                exclude_domains: Sequence[str] = None,\n104\t                include_answer: Union[bool, Literal[\"basic\", \"advanced\"]] = None,\n105\t                include_raw_content: Union[bool, Literal[\"markdown\", \"text\"]] = None,\n106\t                include_images: bool = None,\n107\t                timeout: float = 60,\n108\t                country: str = None,\n109\t                auto_parameters: bool = None,\n110\t                include_favicon: bool = None,\n111\t                include_usage: bool = None,\n112\t                exact_match: bool = None,\n113\t                **kwargs\n114\t                ) -> dict:\n115\t        \"\"\"\n116\t        Internal search method to send the request to the API.\n117\t        \"\"\"\n118\t\n119\t        data = {\n120\t            \"query\": query,\n121\t            \"search_depth\": search_depth,\n122\t            \"topic\": topic,\n123\t            \"time_range\": time_range,\n124\t            \"start_date\": start_date,\n125\t            \"end_date\": end_date,\n126\t            \"days\": days,\n127\t            \"include_answer\": include_answer,\n128\t            \"include_raw_content\": include_raw_content,\n129\t            \"max_results\": max_results,\n130\t            \"include_domains\": include_domains,\n131\t            \"exclude_domains\": exclude_domains,\n132\t            \"include_images\": include_images,\n133\t            \"country\": country,\n134\t            \"auto_parameters\": auto_parameters,\n135\t            \"include_favicon\": include_favicon,\n136\t            \"include_usage\": include_usage,\n137\t            \"exact_match\": exact_match,\n138\t        }\n139\t\n140\t        data = {k: v for k, v in data.items() if v is not None}\n141\t\n142\t        override_headers = self._pop_request_headers(kwargs)\n143\t        if kwargs:\n144\t            data.update(kwargs)\n145\t\n146\t        timeout = min(timeout, 120)\n147\t        url = self.base_url + \"/search\"\n148\t        payload = json.dumps(data)\n149\t\n150\t        try:\n151\t            response = self.session.post(url, data=payload, timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n152\t        except requests.exceptions.Timeout:\n153\t            raise TimeoutError(timeout)\n154\t\n155\t        if response.status_code == 200:\n156\t            return response.json()\n157\t        else:\n158\t            detail = \"\"\n159\t            try:\n160\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n161\t            except Exception:\n162\t                pass\n163\t\n164\t            if response.status_code == 429:\n165\t                raise UsageLimitExceededError(detail)\n166\t            elif response.status_code in [403, 432, 433]:\n167\t                raise ForbiddenError(detail)\n168\t            elif response.status_code == 401:\n169\t                raise InvalidAPIKeyError(detail)\n170\t            elif response.status_code == 400:\n171\t                raise BadRequestError(detail)\n172\t            else:\n173\t                raise response.raise_for_status()\n174\t\n175\t\n176\t    def search(self,\n177\t               query: str,\n178\t               search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = None,\n179\t               topic: Literal[\"general\", \"news\", \"finance\" ] = None,\n180\t               time_range: Literal[\"day\", \"week\", \"month\", \"year\"] = None,\n181\t               start_date: str = None,\n182\t               end_date: str = None,\n183\t               days: int = None,\n184\t               max_results: int = None,\n185\t               include_domains: Sequence[str] = None,\n186\t               exclude_domains: Sequence[str] = None,\n187\t               include_answer: Union[bool, Literal[\"basic\", \"advanced\"]] = None,\n188\t               include_raw_content: Union[bool, Literal[\"markdown\", \"text\"]] = None,\n189\t               include_images: bool = None,\n190\t               timeout: float = 60,\n191\t               country: str = None,\n192\t               auto_parameters: bool = None,\n193\t               include_favicon: bool = None,\n194\t               include_usage: bool = None,\n195\t               exact_match: bool = None,\n196\t               **kwargs,  # Accept custom arguments\n197\t               ) -> dict:\n198\t        \"\"\"\n199\t        Combined search method.\n200\t        \"\"\"\n201\t\n202\t        response_dict = self._search(query,\n203\t                                     search_depth=search_depth,\n204\t                                     topic=topic,\n205\t                                     time_range=time_range,\n206\t                                     start_date=start_date,\n207\t                                     end_date=end_date,\n208\t                                     days=days,\n209\t                                     max_results=max_results,\n210\t                                     include_domains=include_domains,\n211\t                                     exclude_domains=exclude_domains,\n212\t                                     include_answer=include_answer,\n213\t                                     include_raw_content=include_raw_content,\n214\t                                     include_images=include_images,\n215\t                                     timeout=timeout,\n216\t                                     country=country,\n217\t                                     auto_parameters=auto_parameters,\n218\t                                     include_favicon=include_favicon,\n219\t                                     include_usage=include_usage,\n220\t                                     exact_match=exact_match,\n221\t                                     **kwargs)\n222\t        response_dict.setdefault(\"results\", [])\n223\t        return response_dict\n224\t\n225\t    def _extract(self,\n226\t                 urls: Union[List[str], str],\n227\t                 include_images: bool = None,\n228\t                 extract_depth: Literal[\"basic\", \"advanced\"] = None,\n229\t                 format: Literal[\"markdown\", \"text\"] = None,\n230\t                 timeout: float = 30,\n231\t                 include_favicon: bool = None,\n232\t                 include_usage: bool = None,\n233\t                 query: str = None,\n234\t                 chunks_per_source: int = None,\n235\t                 **kwargs\n236\t                 ) -> dict:\n237\t        \"\"\"\n238\t        Internal extract method to send the request to the API. \n239\t        \"\"\"\n240\t        data = {\n241\t            \"urls\": urls,\n242\t            \"include_images\": include_images,\n243\t            \"extract_depth\": extract_depth,\n244\t            \"format\": format,\n245\t            \"timeout\": timeout,\n246\t            \"include_favicon\": include_favicon,\n247\t            \"include_usage\": include_usage,\n248\t            \"query\": query,\n249\t            \"chunks_per_source\": chunks_per_source,\n250\t        }\n251\t\n252\t        data = {k: v for k, v in data.items() if v is not None}\n253\t\n254\t        override_headers = self._pop_request_headers(kwargs)\n255\t        if kwargs:\n256\t            data.update(kwargs)\n257\t\n258\t        try:\n259\t            response = self.session.post(self.base_url + \"/extract\", data=json.dumps(data), timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n260\t        except requests.exceptions.Timeout:\n261\t            raise TimeoutError(timeout)\n262\t\n263\t        if response.status_code == 200:\n264\t            return response.json()\n265\t        else:\n266\t            detail = \"\"\n267\t            try:\n268\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n269\t            except Exception:\n270\t                pass\n271\t\n272\t            if response.status_code == 429:\n273\t                raise UsageLimitExceededError(detail)\n274\t            elif response.status_code in [403, 432, 433]:\n275\t                raise ForbiddenError(detail)\n276\t            elif response.status_code == 401:\n277\t                raise InvalidAPIKeyError(detail)\n278\t            elif response.status_code == 400:\n279\t                raise BadRequestError(detail)\n280\t            else:\n281\t                raise response.raise_for_status()\n282\t\n283\t    def extract(self,\n284\t                urls: Union[List[str], str],  # Accept a list of URLs or a single URL\n285\t                include_images: bool = None,\n286\t                extract_depth: Literal[\"basic\", \"advanced\"] = None,\n287\t                format: Literal[\"markdown\", \"text\"] = None,\n288\t                timeout: float = 30,\n289\t                include_favicon: bool = None,\n290\t                include_usage: bool = None,\n291\t                query: str = None,\n292\t                chunks_per_source: int = None,\n293\t                **kwargs,  # Accept custom arguments\n294\t                ) -> dict:\n295\t        \"\"\"\n296\t        Combined extract method.\n297\t        \"\"\"\n298\t        response_dict = self._extract(urls,\n299\t                                      include_images,\n300\t                                      extract_depth,\n301\t                                      format,\n302\t                                      timeout,\n303\t                                      include_favicon=include_favicon,\n304\t                                      include_usage=include_usage,\n305\t                                      query=query,\n306\t                                      chunks_per_source=chunks_per_source,\n307\t                                      **kwargs)\n308\t        response_dict.setdefault(\"results\", [])\n309\t        response_dict.setdefault(\"failed_results\", [])\n310\t        return response_dict\n311\t\n312\t    def _crawl(self,\n313\t            url: str,\n314\t            max_depth: int = None,\n315\t            max_breadth: int = None,\n316\t            limit: int = None,\n317\t            instructions: str = None,\n318\t            select_paths: Sequence[str] = None,\n319\t            select_domains: Sequence[str] = None,\n320\t            exclude_paths: Sequence[str] = None,\n321\t            exclude_domains: Sequence[str] = None,\n322\t            allow_external: bool = None,\n323\t            include_images: bool = None,\n324\t            extract_depth: Literal[\"basic\", \"advanced\"] = None,\n325\t            format: Literal[\"markdown\", \"text\"] = None,\n326\t            timeout: float = 150,\n327\t            include_favicon: bool = None,\n328\t            include_usage: bool = None,\n329\t            chunks_per_source: int = None,\n330\t            **kwargs\n331\t            ) -> dict:\n332\t        \"\"\"\n333\t        Internal crawl method to send the request to the API.\n334\t        include_favicon: If True, include the favicon in the crawl results.\n335\t        \"\"\"\n336\t        data = {\n337\t            \"url\": url,\n338\t            \"max_depth\": max_depth,\n339\t            \"max_breadth\": max_breadth,\n340\t            \"limit\": limit,\n341\t            \"instructions\": instructions,\n342\t            \"select_paths\": select_paths,\n343\t            \"select_domains\": select_domains,\n344\t            \"exclude_paths\": exclude_paths,\n345\t            \"exclude_domains\": exclude_domains,\n346\t            \"allow_external\": allow_external,\n347\t            \"include_images\": include_images,\n348\t            \"extract_depth\": extract_depth,\n349\t            \"format\": format,\n350\t            \"timeout\": timeout,\n351\t            \"include_favicon\": include_favicon,\n352\t            \"include_usage\": include_usage,\n353\t            \"chunks_per_source\": chunks_per_source,\n354\t        }\n355\t\n356\t        override_headers = self._pop_request_headers(kwargs)\n357\t        if kwargs:\n358\t            data.update(kwargs)\n359\t\n360\t        data = {k: v for k, v in data.items() if v is not None}\n361\t\n362\t        try:\n363\t            response = self.session.post(self.base_url + \"/crawl\", data=json.dumps(data), timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n364\t        except requests.exceptions.Timeout:\n365\t            raise TimeoutError(timeout)\n366\t\n367\t        if response.status_code == 200:\n368\t            return response.json()\n369\t        else:\n370\t            detail = \"\"\n371\t            try:\n372\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n373\t            except Exception:\n374\t                pass\n375\t\n376\t            if response.status_code == 429:\n377\t                raise UsageLimitExceededError(detail)\n378\t            elif response.status_code in [403, 432, 433]:\n379\t                raise ForbiddenError(detail)\n380\t            elif response.status_code == 401:\n381\t                raise InvalidAPIKeyError(detail)\n382\t            elif response.status_code == 400:\n383\t                raise BadRequestError(detail)\n384\t            else:\n385\t                raise response.raise_for_status()\n386\t\n387\t    def crawl(self,\n388\t              url: str,\n389\t              max_depth: int = None,\n390\t              max_breadth: int = None,\n391\t              limit: int = None,\n392\t              instructions: str = None,\n393\t              select_paths: Sequence[str] = None,\n394\t              select_domains: Sequence[str] = None,\n395\t              exclude_paths: Sequence[str] = None,\n396\t              exclude_domains: Sequence[str] = None,\n397\t              allow_external: bool = None,\n398\t              include_images: bool = None,\n399\t              extract_depth: Literal[\"basic\", \"advanced\"] = None,\n400\t              format: Literal[\"markdown\", \"text\"] = None,\n401\t              timeout: float = 150,\n402\t              include_favicon: bool = None,\n403\t              include_usage: bool = None,\n404\t              chunks_per_source: int = None,\n405\t              **kwargs\n406\t              ) -> dict:\n407\t        \"\"\"\n408\t        Combined crawl method.\n409\t        include_favicon: If True, include the favicon in the crawl results.\n410\t        \"\"\"\n411\t        return self._crawl(url,\n412\t                           max_depth=max_depth,\n413\t                           max_breadth=max_breadth,\n414\t                           limit=limit,\n415\t                           instructions=instructions,\n416\t                           select_paths=select_paths,\n417\t                           select_domains=select_domains,\n418\t                           exclude_paths=exclude_paths,\n419\t                           exclude_domains=exclude_domains,\n420\t                           allow_external=allow_external,\n421\t                           include_images=include_images,\n422\t                           extract_depth=extract_depth,\n423\t                           format=format,\n424\t                           timeout=timeout,\n425\t                           include_favicon=include_favicon,\n426\t                           include_usage=include_usage,\n427\t                           chunks_per_source=chunks_per_source,\n428\t                           **kwargs)\n429\t    \n430\t    def _map(self,\n431\t            url: str,\n432\t            max_depth: int = None,\n433\t            max_breadth: int = None,\n434\t            limit: int = None,\n435\t            instructions: str = None,\n436\t            select_paths: Sequence[str] = None,\n437\t            select_domains: Sequence[str] = None,\n438\t            exclude_paths: Sequence[str] = None,\n439\t            exclude_domains: Sequence[str] = None,\n440\t            allow_external: bool = None,\n441\t            include_images: bool = None,\n442\t            timeout: float = 150,\n443\t            include_usage: bool = None,\n444\t            **kwargs\n445\t            ) -> dict:\n446\t        \"\"\"\n447\t        Internal map method to send the request to the API.\n448\t        \"\"\"\n449\t        data = {\n450\t            \"url\": url,\n451\t            \"max_depth\": max_depth,\n452\t            \"max_breadth\": max_breadth,\n453\t            \"limit\": limit,\n454\t            \"instructions\": instructions,\n455\t            \"select_paths\": select_paths,\n456\t            \"select_domains\": select_domains,\n457\t            \"exclude_paths\": exclude_paths,\n458\t            \"exclude_domains\": exclude_domains,\n459\t            \"allow_external\": allow_external,\n460\t            \"include_images\": include_images,\n461\t            \"timeout\": timeout,\n462\t            \"include_usage\": include_usage,\n463\t        }\n464\t\n465\t        override_headers = self._pop_request_headers(kwargs)\n466\t        if kwargs:\n467\t            data.update(kwargs)\n468\t\n469\t        data = {k: v for k, v in data.items() if v is not None}\n470\t\n471\t        try:\n472\t            response = self.session.post(self.base_url + \"/map\", data=json.dumps(data), timeout=timeout, **({\"headers\": override_headers} if override_headers else {}))\n473\t        except requests.exceptions.Timeout:\n474\t            raise TimeoutError(timeout)\n475\t\n476\t        if response.status_code == 200:\n477\t            return response.json()\n478\t        else:\n479\t            detail = \"\"\n480\t            try:\n481\t                detail = response.json().get(\"detail\", {}).get(\"error\", None)\n482\t            except Exception:\n483\t                pass\n484\t\n485\t            if response.status_code == 429:\n486\t                raise UsageLimitExceededError(detail)\n487\t            elif response.status_code in [403, 432, 433]:\n488\t                raise ForbiddenError(detail)\n489\t            elif response.status_code == 401:\n490\t                raise InvalidAPIKeyError(detail)\n491\t            elif response.status_code == 400:\n492\t                raise BadRequestError(detail)\n493\t            else:\n494\t                raise response.raise_for_status()\n495\t\n496\t    def map(self,\n497\t              url: str,\n498\t              max_depth: int = None,\n499\t              max_breadth: int = None,\n500\t              limit: int = None,\n501\t              instructions: str = None,\n502\t              select_paths: Sequence[str] = None,\n503\t              select_domains: Sequence[str] = None,\n504\t              exclude_paths: Sequence[str] = None,\n505\t              exclude_domains: Sequence[str] = None,\n506\t              allow_external: bool = None,\n507\t              include_images: bool = None,\n508\t              timeout: float = 150,\n509\t              include_usage: bool = None,\n510\t              **kwargs\n511\t              ) -> dict:\n512\t        \"\"\"\n513\t        Combined map method.\n514\t        \n515\t        \"\"\"\n516\t        return self._map(url,\n517\t                         max_depth=max_depth,\n518\t                         max_breadth=max_breadth,\n519\t                         limit=limit,\n520\t                         instructions=instructions,\n521\t                         select_paths=select_paths,\n522\t                         select_domains=select_domains,\n523\t                         exclude_paths=exclude_paths,\n524\t                         exclude_domains=exclude_domains,\n525\t                         allow_external=allow_external,\n526\t                         include_images=include_images,\n527\t                         timeout=timeout,\n528\t                         include_usage=include_usage,\n529\t                         **kwargs)\n530\t\n531\t    def get_search_context(self,\n532\t                           query: str,\n533\t                           search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = \"basic\",\n534\t                           topic: Literal[\"general\", \"news\", \"finance\"] = \"general\",\n535\t                           days: int = 7,\n536\t                           max_results: int = 5,\n537\t                           include_domains: Sequence[str] = None,\n538\t                           exclude_domains: Sequence[str] = None,\n539\t                           max_tokens: int = 4000,\n540\t                           timeout: float = 60,\n541\t                           country: str = None,\n542\t                           include_favicon: bool = None,\n543\t                           **kwargs,  # Accept custom arguments\n544\t                           ) -> str:\n545\t        \"\"\"\n546\t        Get the search context for a query. Useful for getting only related content from retrieved websites\n547\t        without having to deal with context extraction and limitation yourself.\n548\t\n549\t        max_tokens: The maximum number of tokens to return (based on openai token compute). Defaults to 4000.\n550\t\n551\t        Returns a string of JSON containing the search context up to context limit.\n552\t        \"\"\"\n553\t        warnings.warn(\"get_search_context is deprecated and will be removed in future versions.\",\n554\t                      DeprecationWarning, stacklevel=2)\n555\t\n556\t        response_dict = self._search(query,\n557\t                                     search_depth=search_depth,\n558\t                                     topic=topic,\n559\t                                     days=days,\n560\t                                     max_results=max_results,\n561\t                                     include_domains=include_domains,\n562\t                                     exclude_domains=exclude_domains,\n563\t                                     include_answer=False,\n564\t                                     include_raw_content=False,\n565\t                                     include_images=False,\n566\t                                     timeout=timeout,\n567\t                                     country=country,\n568\t                                     include_favicon=include_favicon,\n569\t                                     **kwargs,\n570\t                                     )\n571\t        sources = response_dict.get(\"results\", [])\n572\t        context = [{\"url\": source[\"url\"], \"content\": source[\"content\"]}\n573\t                   for source in sources]\n574\t        return json.dumps(get_max_items_from_list(context, max_tokens))\n575\t\n576\t    def qna_search(self,\n577\t                   query: str,\n578\t                   search_depth: Literal[\"basic\", \"advanced\", \"fast\", \"ultra-fast\"] = \"advanced\",\n579\t                   topic: Literal[\"general\", \"news\", \"finance\"] = \"general\",\n580\t                   days: int = 7,\n581\t                   max_results: int = 5,\n582\t                   include_domains: Sequence[str] = None,\n583\t                   exclude_domains: Sequence[str] = None,\n584\t                   timeout: float = 60,\n585\t                   country: str = None,\n586\t                   include_favicon: bool = None,\n587\t                   **kwargs,  # Accept custom arguments\n588\t                   ) -> str:\n589\t        \"\"\"\n590\t        Q&A search method. Search depth is advanced by default to get the best answer.\n591\t        \"\"\"\n592\t        warnings.warn(\"qna_search is deprecated and will be removed in future versions.\",\n593\t                      DeprecationWarning, stacklevel=2)\n594\t        response_dict = self._search(query,\n595\t                                     search_depth=search_depth,\n596\t                                     topic=topic,\n597\t                                     days=days,\n598\t                                     max_results=max_results,\n599\t                                     include_domains=include_domains,\n600\t                                     exclude_domains=exclude_domains,\n601\t                                     include_raw_content=False,\n602\t                                     include_images=False,\n603\t                                     include_answer=True,\n604\t                                     timeout=timeout,\n605\t                                     country=country,\n606\t                                     include_favicon=include_favicon,\n607\t                                     **kwargs,\n608\t                                     )\n609\t        return response_dict.get(\"answer\", \"\")\n610\t\n611\t    def _research(self,\n612\t                  input: str,\n613\t                  model: Literal[\"mini\", \"pro\", \"auto\"] = None,\n614\t                  output_schema: dict = None,\n615\t                  stream: bool = False,\n616\t                  citation_format: Literal[\"numbered\", \"mla\", \"apa\", \"chicago\"] = \"numbered\",\n617\t                  timeout: Optional[float] = None,\n618\t                  **kwargs\n619\t                  ) -> Union[dict, Generator[bytes, None, None]]:\n620\t        \"\"\"\n621\t        Internal research method to send the request to the API.\n622\t        \"\"\"\n623\t        data = {\n624\t            \"input\": input,\n625\t            \"model\": model