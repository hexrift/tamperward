diff --git a/src/inject/__init__.py b/src/inject/__init__.py
index 88db0d1..7313063 100644
--- a/src/inject/__init__.py
+++ b/src/inject/__init__.py
@@ -318,13 +318,23 @@ class _ConstructorBinding(Generic[T]):
 #        - `attr` implementation is inherited from `property`
 #        - `attr` class member is not annotated
 class _AttributeInjection(property):
-    def __init__(self, cls: Type[T] | Hashable) -> None:
+    def __init__(self, cls: Optional[Type[T] | Hashable] = None) -> None:
         self._cls = cls
         super().__init__(
             fget=lambda _: instance(self._cls),
             doc="Return an attribute injection",
         )
 
+    def __set_name__(self, owner: type, name: str) -> None:
+        if self._cls is None:
+            annotations = getattr(owner, '__annotations__', {})
+            if name not in annotations:
+                raise TypeError(
+                    f"Cannot determine the injected type for attribute '{name}': "
+                    "pass a class to inject.attr() or annotate the attribute"
+                )
+            self._cls = annotations[name]
+
 
 class _ParameterInjection(Generic[T]):
     __slots__ = ('_name', '_cls')
@@ -528,8 +538,14 @@ def attr(cls: Hashable) -> Injectable: ...
 @overload
 def attr(cls: Type[T]) -> T: ...
 
-def attr(cls):
-    """Return an attribute injection (descriptor)."""
+@overload
+def attr() -> Any: ...
+
+def attr(cls=None):
+    """Return an attribute injection (descriptor).
+
+    If `cls` is omitted, the type is inferred from the attribute's annotation.
+    """
     return _AttributeInjection(cls)
 
 
