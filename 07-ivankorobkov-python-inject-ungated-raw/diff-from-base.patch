 @overload
 def attr(cls: Hashable) -> Injectable: ...
 
 @overload
 def attr(cls: Type[T]) -> T: ...
 
-def attr(cls):
-    """Return an attribute injection (descriptor)."""
+def attr(cls=None):
+    """Return an attribute injection (descriptor).
