         )
 
+    def __set_name__(self, owner: type, name: str) -> None:
+        if self._cls is None:
+            annotations = getattr(owner, '__annotations__', {})
+            if name not in annotations:
+                raise TypeError(
+                    f'inject.attr() requires either an explicit type or an annotation on {owner.__name__}.{name}'
+                )
+            self._cls = annotations[name]
+
 
 class _ParameterInjection(Generic[T]):
