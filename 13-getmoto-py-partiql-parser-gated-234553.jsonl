\t        result = []  # type: ignore[unreachable]\n55\t        for row in json_doc:\n56\t            if current_key not in row:\n57\t                result.append(MissingVariable())\n58\t            else:\n59\t                result.append(\n60\t                    find_nested_data_in_object(\n61\t                        json_doc=row[current_key], select_clause=remaining_keys\n62\t                    )\n63\t                )\n64\t        return result\n65\t    elif is_dict(json_doc):\n66\t        if current_key not in json_doc:\n67\t            return MissingVariable()\n68\t        if remaining_keys:\n69\t            return find_nested_data_in_object(\n70\t                json_doc=json_doc[current_key], select_clause=remaining_keys  # type: ignore[index]\n71\t            )\n72\t        return json_doc.get_original(current_key)  # type: ignore[union-attr]\n73\t\n74\t\n75\tdef find_value_in_document(keys: List[str], json_doc: Any) -> Any:\n76\t    if not is_dict(json_doc):\n77\t        return None\n78\t    key_is_array = re.search(r\"(.+)\\[(\\d+)\\]$\", keys[0])\n79\t    if key_is_array:\n80\t        key_name = key_is_array.group(1)\n81\t        array_index = int(key_is_array.group(2))\n82\t        try:\n83\t            requested_list = json_doc.get(key_name, [])\n84\t            assert isinstance(requested_list, list)\n85\t            doc_one_layer_down = requested_list[array_index]\n86\t        except IndexError:\n87\t            # Array exists, but does not have enough values\n88\t            doc_one_layer_down = {}\n89\t        except AssertionError:\n90\t            # Requested key is not an array - fail silently just like AWS does\n91\t            doc_one_layer_down = {}\n92\t        return find_value_in_document(keys[1:], doc_one_layer_down)\n93\t    if len(keys) == 1:\n94\t        return json_doc.get(keys[0])\n95\t    return find_value_in_document(keys[1:], json_doc.get(keys[0], {}))\n96\t\n97\t\n98\tdef find_value_in_dynamodb_document(keys: List[str], json_