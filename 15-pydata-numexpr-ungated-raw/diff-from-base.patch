 _blacklist_re = re.compile(f'{_flow_pat}|{_dunder_pat}|{_attr_pat}')
 
+
+def _resolve_sanitize(sanitize: Optional[bool]) -> bool:
+    """Resolve a `sanitize=None` argument to the secure default: `True`,
+    unless explicitly disabled via `NUMEXPR_SANITIZE=0`. Fails safe.
+    """
+    if sanitize is None:
+        if 'NUMEXPR_SANITIZE' in os.environ:
+            return bool(int(os.environ['NUMEXPR_SANITIZE']))
+        return True
+    return sanitize
+
+
+def _strip_string_literals(s: str) -> str:
+    """Remove the contents of syntactically real string literals from `s`,
+    so the blacklist below only inspects actual code characters.
+
+    A naive regex that strips text between single-quote characters can be
+    fooled by single quotes that live inside separate double-quoted string
+    literals (e.g. `"'" + ().__class__ + "'"` has no real single-quoted
+    string, but a span-matching regex would treat everything between the
+    two apostrophes as one). Using the tokenizer instead means only
+    genuine STRING tokens are removed, regardless of quote style.
+    """
+    try:
+        tokens = tokenize.generate_tokens(io.StringIO(s).readline)
+        return ''.join(tok.string for tok in tokens if tok.type != tokenize.STRING)
+    except (tokenize.TokenError, SyntaxError, IndentationError):
+        # Could not tokenize; fall back to checking the raw text so the
+        # blacklist still gets a chance to reject it (fail safe).
+        return s
+
