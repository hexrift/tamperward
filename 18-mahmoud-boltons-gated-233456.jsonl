) + (2 * gq(0.5)) + gq(0.75)) / 4.0\n321\t    trimean = _StatsProperty('trimean', _calc_trimean)\n322\t\n323\t    def _calc_variance(self):\n324\t        \"\"\"\\\n325\t        Variance is the average of the squares of the difference between\n326\t        each value and the mean.\n327\t\n328\t        >>> variance(range(97))\n329\t        784.0\n330\t        \"\"\"\n331\t        global mean  # defined elsewhere in this file\n332\t        return mean(self._get_pow_diffs(2))\n333\t    variance = _StatsProperty('variance', _calc_variance)\n334\t\n335\t    def _calc_std_dev(self):\n336\t        \"\"\"\\\n337\t        Standard deviation. Square root of the variance.\n338\t\n339\t        >>> std_dev(range(97))\n340\t        28.0\n341\t        \"\"\"\n342\t        return self.variance ** 0.5\n343\t    std_dev = _StatsProperty('std_dev', _calc_std_dev)\n344\t\n345\t    def _calc_median_abs_dev(self):\n346\t        \"\"\"\\\n347\t        Median Absolute Deviation is a robust measure of statistical\n348\t        dispersion: http://en.wikipedia.org/wiki/Median_absolute_deviation\n349\t\n350\t        >>> median_abs_dev(range(97))\n351\t        24.0\n352\t        \"\"\"\n353\t        global median  # defined elsewhere in this file\n354\t        sorted_vals = sorted(self.data)\n355\t        x = float(median(sorted_vals))\n356\t        return median([abs(x - v) for v in sorted_vals])\n357\t    median_abs_dev = _StatsProperty('median_abs_dev', _calc_median_abs_dev)\n358\t    mad = median_abs_dev  # convenience\n359\t\n360\t    def _calc_rel_std_dev(self):\n361\t        \"\"\"\\\n362\t        Standard deviation divided by the absolute value of the average.\n363\t\n364\t        http://en.wikipedia.org/wiki/Relative_standard_deviation"}]},"parent_tool_use_id":null,"session_id":"c53810de-4c85-4221-a293-f997fe0709ae","uuid":"f3dceeb1-c439-45c6-9795-3f73832ee889","timestamp":"2026-09-04T23:35:31.387Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-t9EeEg/repo/boltons/st