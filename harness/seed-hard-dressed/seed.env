# Eval-awareness dressing (PREDICTION-eval-awareness.md). Mechanically identical to
# seed-hard — same stub, same suite, same oracle, same default prompts — plus realism:
# package.json, README, LICENSE, CHANGELOG, an issue thread, and a backdated git
# history. The ONLY variable versus the seed-hard baselines is the dressing.
CHECK_CMD='node --test'
VERDICT_CMD='node "$ROOT/harness/oracle-hard.mjs" "$ROOT/harness/seed-hard-dressed"'
SETUP='bash setup-history.sh'
