t        \"ghostty\",\n51\t        \"iTerm2\",\n52\t        \"kitty\",\n53\t        \"konsole\",\n54\t        \"warp\",\n55\t        \"wayst\",\n56\t        \"wezterm-gui\",\n57\t        \"yakuake\",\n58\t    }\n59\t    import psutil\n60\t\n61\t    try:\n62\t        process = psutil.Process()\n63\t        while process := process.parent():\n64\t            if process.name() in supported_terminals:\n65\t                return True\n66\t    except (psutil.Error, OSError):\n67\t        # Walking the process tree can fail when /proc is mounted with\n68\t        # ``hidepid`` on shared multi-user systems (common on HPC clusters):\n69\t        # ancestor processes owned by other users are inaccessible and psutil\n70\t        # raises AccessDenied. Treat as \"unsupported\" rather than letting it\n71\t        # abort the import of IPython.\n72\t        return False\n73\t    return False\n74\t\n75\t\n76\tsupports_kitty_graphics = _supports_kitty_graphics()\n77\t\n78\t\n79\tdef png_to_kitty_ansi(png: bytes) -> str:\n80\t    if not png.startswith(b\"\\x89PNG\\r\\n\\x1a\\n\"):\n81\t        raise ValueError\n82\t    # This simplicity resembles\n83\t    # https://sw.kovidgoyal.net/kitty/graphics-protocol/#a-minimal-example\n84\t    # but if we need tmux support, we can switch to Unicode like\n85\t    # https://github.com/hzeller/timg/blob/main/src/kitty-canvas.cc\n86\t    result = [\"\\033_Ga=T,f=100,\", \"m=1;\"]\n87\t    encoded = b64encode(png)\n88\t    for i in range(0, len(encoded), 4096):\n89\t        result.append(encoded[i : i + 4096].decode(\"ascii\"))\n90\t        result.append(\"\\033\\\\\")\n91\t        result.append(\"\\033_G\")\n92\t        result.append(\"m=1;\")\n93\t    del result[-2:]\n94\t    result[-3] = \"m=0;\"\n95\t    return \"\".join(result)\n96\t\n97\t\n98\tdef kitty_png_render(png: bytes | str, _md_dict: object) -> None:\n99\t    if isinstance(png, str):\n100\t        png = png_to_kitty_ansi(b64decode(png))\n101\t    else:\n102\t        png = png_to_kit