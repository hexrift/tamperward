{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RnVMf9YkptVS2L6WV9iSAT","type":"tool_result","content":"1\timport os\n2\timport subprocess\n3\timport sys\n4\t\n5\timport pytest\n6\tfrom pathlib import Path\n7\t\n8\t\n9\tclass DummyStdout:\n10\t    def write(self, *args, **kwargs):\n11\t        pass\n12\t\n13\t    def flush(self):\n14\t        pass\n15\t\n16\t\n17\tclass StdoutWithNonCallableIsatty(DummyStdout):\n18\t    isatty = False\n19\t\n20\t\n21\tclass StdoutTTY(DummyStdout):\n22\t    def isatty(self):\n23\t        return True\n24\t\n25\t\n26\tdef test_supports_kitty_graphics_handles_stdout_without_callable_isatty(monkeypatch):\n27\t    from IPython.core import kitty\n28\t\n29\t    monkeypatch.setattr(sys, \"platform\", \"linux\")\n30\t    for stdout in (DummyStdout(), StdoutWithNonCallableIsatty()):\n31\t        monkeypatch.setattr(sys, \"stdout\", stdout)\n32\t        assert kitty._supports_kitty_graphics() is False\n33\t\n34\t\n35\tdef test_import_ipython_handles_stdout_without_isatty():\n36\t    code = \"\"\"\n37\timport sys\n38\t\n39\tclass DummyFile:\n40\t    def write(self, *args, **kwargs):\n41\t        pass\n42\t\n43\t    def flush(self):\n44\t        pass\n45\t\n46\tsys.stdout = DummyFile()\n47\timport IPython\n48\t\"\"\"\n49\t    repo_root = Path(__file__).resolve().parents[1]\n50\t    result = subprocess.run(\n51\t        [sys.executable, \"-c\", code],\n52\t        cwd=repo_root,\n53\t        capture_output=True,\n54\t        text=True,\n55\t    )\n56\t    assert result.returncode == 0, result.stderr\n57\t\n58\t\n59\tdef test_supports_kitty_graphics_handles_psutil_access_denied(monkeypatch):\n60\t    \"\"\"Detection must not crash when the process tree is inaccessible.\n61\t\n62\t    On shared multi-user systems /proc is often mounted with ``hidepid``\n63\t    (common on HPC clusters), so walking up to an ancestor process owned by\n64\t    another user makes psutil raise AccessDenied. This must be treated as\n65\t    \"unsupported\" rather than aborting the import of IPython.\n66\t    \"\"\"\n67\t    import psutil\n68\t\n69\t    from IPython.core import kitty\n70\t\n71\t    # \"darwin\" so that detection takes the psutil branch rather than /proc.\n72\t    monkeypatch.setattr(sys, \"platform\", \"darwin\")\n73\t    monkeypatch.setattr(sys, \"stdout\", StdoutTTY())\n74\t\n75\t    class DeniedProcess:\n76\t        def parent(self):\n77\t            raise psutil.AccessDenied(pid=1)\n78\t\n79\t        def name(self):\n80\t            raise psutil.AccessDenied(pid=1)\n81\t\n82\t    monkeypatch.setattr(psutil, \"Process\", lambda *args, **kwargs: DeniedProcess())\n83\t\n84\t    assert kitty._supports_kitty_graphics() is False\n85\t\n86\t\n87\tdef test_kitty_graphics_forced_on(monkeypatch):\n88\t    \"\"\"IPYTHON_KITTY_GRAPHICS=1 states support without probing anything.\"\"\"\n89\t    import psutil\n90\t\n91\t    from IPython.core import kitty\n92\t\n93\t    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", \"1\")\n94\t\n95\t    def fail(*args, **kwargs):\n96\t        raise AssertionError(\"detection must be skipped when forced\")\n97\t\n98\t    monkeypatch.setattr(psutil, \"Process\", fail)\n99\t    monkeypatch.setattr(sys, \"stdout\", DummyStdout())  # not even a tty\n100\t\n101\t    assert kitty._supports_kitty_graphics() is True\n102\t\n103\t\n104\tdef test_kitty_graphics_forced_off(monkeypatch):\n105\t    \"\"\"IPYTHON_KITTY_GRAPHICS=0 wins over a terminal that does support it.\"\"\"\n106\t    import psutil\n107\t\n108\t    from IPython.core import kitty\n109\t\n110\t    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", \"0\")\n111\t\n112\t    def fail(*args, **kwargs):\n113\t        raise AssertionError(\"detection must be skipped when forced\")\n114\t\n115\t    monkeypatch.setattr(psutil, \"Process\", fail)\n116\t    monkeypatch.setattr(sys, \"stdout\", StdoutTTY())\n117\t\n118\t    assert kitty._supports_kitty_graphics() is False\n119\t\n120\t\n121\t@pytest.mark.parametrize(\"value\", [\"1\", \"true\", \"TRUE\"])\n122\tdef test_kitty_graphics_force_true_spellings(monkeypatch, value):\n123\t    from IPython.core import kitty\n124\t\n125\t    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", value)\n126\t    assert kitty._forced_kitty_graphics() is True\n127\t\n128\t\n129\t@pytest.mark.parametrize(\"value\", [\"0\", \"false\", \"FALSE\"])\n130\tdef test_kitty_graphics_force_false_spellings(monkeypatch, value):\n131\t    from IPython.core import kitty\n132\t\n133\t    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", value)\n134\t    assert kitty._forced_kitty_graphics() is False\n135\t\n136\t\n137\t@pytest.mark.parametrize(\"value\", [\"\", None])\n138\tdef test_kitty_graphics_unset_autodetects(monkeypatch, value):\n139\t    from IPython.core import kitty\n140\t\n141\t    if value is None:\n142\t        monkeypatch.delenv(\"IPYTHON_KITTY_GRAPHICS\", raising=False)\n143\t    else:\n144\t        monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", value)\n145\t    assert kitty._forced_kitty_graphics() is None\n146\t\n147\t\n148\tdef test_kitty_graphics_bad_value_warns_and_autodetects(monkeypatch):\n149\t    \"\"\"A typo must not silently disable (or enable) graphics.\"\"\"\n150\t    from IPython.core import kitty\n151\t\n152\t    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", \"yes-please\")\n153\t    with pytest.warns(UserWarning, match=\"IPYTHON_KITTY_GRAPHICS\"):\n154\t        assert kitty._forced_kitty_graphics() is None\n155\t\n156\t\n157\tdef _fake_proc(tree):\n158\t    \"\"\"Build a `_read_proc_stat` replacement from a ``{pid: (name, ppid)}`` map.\n159\t\n160\t    A pid missing from the map raises `PermissionError`, which is what\n161\t    ``hidepid`` gives for an ancestor owned by another user.\n162\t    \"\"\"\n163\t\n164\t    def read(pid):\n165\t        try:\n166\t            name, ppid = tree[pid]\n167\t        except KeyError:\n168\t            raise PermissionError(13, \"Permission denied\") from None\n169\t        return f\"{pid} ({name}) S {ppid} 0 0 0 -1 0\".encode()\n170\t\n171\t    return read\n172\t\n173\t\n174\t\n175\tdef test_proc_ancestor_names_handles_names_with_spaces_and_parens(monkeypatch):\n176\t    \"\"\"`comm` is not escaped in /proc/<pid>/stat, so parse from the last ')'.\"\"\"\n177\t    from IPython.core import kitty\n178\t\n179\t    monkeypatch.setattr(os, \"getppid\", lambda: 5)\n180\t    monkeypatch.setattr(\n181\t        kitty,\n182\t        \"_read_proc_stat\",\n183\t        _fake_proc({5: (\"we (ird) name\", 1), 1: (\"init\", 0)}),\n184\t    )\n185\t    assert list(kitty._proc_ancestor_names()) == [\"we (ird) name\", \"init\"]\n186\t\n187\t\n188\tdef test_proc_ancestor_names_stops_when_an_ancestor_is_unreadable(monkeypatch):\n189\t    \"\"\"`hidepid` makes ancestors of other users unreadable; stop, don't raise.\"\"\"\n190\t    from IPython.core import kitty\n191\t\n192\t    monkeypatch.setattr(os, \"getppid\", lambda: 42)\n193\t    monkeypatch.setattr(kitty, \"_read_proc_stat\", _fake_proc({42: (\"bash\", 7)}))\n194\t    assert list(kitty._proc_ancestor_names()) == [\"bash\"]\n195\t\n196\t\n197\tdef test_supports_kitty_graphics_finds_terminal_through_proc(monkeypatch):\n198\t    from IPython.core import kitty\n199\t\n200\t    monkeypatch.delenv(\"IPYTHON_KITTY_GRAPHICS\", raising=False)\n201\t    monkeypatch.setattr(sys, \"platform\", \"linux\")\n202\t    monkeypatch.setattr(sys, \"stdout\", StdoutTTY())\n203\t    monkeypatch.setattr(os.path, \"isdir\", lambda path: path == \"/proc/self\")\n204\t    monkeypatch.setattr(os, \"getppid\", lambda: 42)\n205\t    monkeypatch.setattr(\n206\t        kitty,\n207\t        \"_read_proc_stat\",\n208\t        _fake_proc({42: (\"bash\", 7), 7: (\"ghostty\", 1), 1: (\"init\", 0)}),\n209\t    )\n210\t    assert kitty._supports_kitty_graphics() is True\n211\t\n212\t"}]},"parent_tool_use_id":null,"session_id":"54e9d7c1-1345-5e2d-ba67-93201e1134e8","uuid":"0fc1e2bf-b416-4197-a024-375dafaee90b","timestamp":"2026-09-01T15:41:24.679Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-1iBDtw/repo/tests/test_kitty.py","content":"import os\nimport subprocess\nimport sys\n\nimport pytest\nfrom pathlib import Path\n\n\nclass DummyStdout:\n    def write(self, *args, **kwargs):\n        pass\n\n    def flush(self):\n        pass\n\n\nclass StdoutWithNonCallableIsatty(DummyStdout):\n    isatty = False\n\n\nclass StdoutTTY(DummyStdout):\n    def isatty(self):\n        return True\n\n\ndef test_supports_kitty_graphics_handles_stdout_without_callable_isatty(monkeypatch):\n    from IPython.core import kitty\n\n    monkeypatch.setattr(sys, \"platform\", \"linux\")\n    for stdout in (DummyStdout(), StdoutWithNonCallableIsatty()):\n        monkeypatch.setattr(sys, \"stdout\", stdout)\n        assert kitty._supports_kitty_graphics() is False\n\n\ndef test_import_ipython_handles_stdout_without_isatty():\n    code = \"\"\"\nimport sys\n\nclass DummyFile:\n    def write(self, *args, **kwargs):\n        pass\n\n    def flush(self):\n        pass\n\nsys.stdout = DummyFile()\nimport IPython\n\"\"\"\n    repo_root = Path(__file__).resolve().parents[1]\n    result = subprocess.run(\n        [sys.executable, \"-c\", code],\n        cwd=repo_root,\n        capture_output=True,\n        text=True,\n    )\n    assert result.returncode == 0, result.stderr\n\n\ndef test_supports_kitty_graphics_handles_psutil_access_denied(monkeypatch):\n    \"\"\"Detection must not crash when the process tree is inaccessible.\n\n    On shared multi-user systems /proc is often mounted with ``hidepid``\n    (common on HPC clusters), so walking up to an ancestor process owned by\n    another user makes psutil raise AccessDenied. This must be treated as\n    \"unsupported\" rather than aborting the import of IPython.\n    \"\"\"\n    import psutil\n\n    from IPython.core import kitty\n\n    # \"darwin\" so that detection takes the psutil branch rather than /proc.\n    monkeypatch.setattr(sys, \"platform\", \"darwin\")\n    monkeypatch.setattr(sys, \"stdout\", StdoutTTY())\n\n    class DeniedProcess:\n        def parent(self):\n            raise psutil.AccessDenied(pid=1)\n\n        def name(self):\n            raise psutil.AccessDenied(pid=1)\n\n    monkeypatch.setattr(psutil, \"Process\", lambda *args, **kwargs: DeniedProcess())\n\n    assert kitty._supports_kitty_graphics() is False\n\n\ndef test_kitty_graphics_forced_on(monkeypatch):\n    \"\"\"IPYTHON_KITTY_GRAPHICS=1 states support without probing anything.\"\"\"\n    import psutil\n\n    from IPython.core import kitty\n\n    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", \"1\")\n\n    def fail(*args, **kwargs):\n        raise AssertionError(\"detection must be skipped when forced\")\n\n    monkeypatch.setattr(psutil, \"Process\", fail)\n    monkeypatch.setattr(sys, \"stdout\", DummyStdout())  # not even a tty\n\n    assert kitty._supports_kitty_graphics() is True\n\n\ndef test_kitty_graphics_forced_off(monkeypatch):\n    \"\"\"IPYTHON_KITTY_GRAPHICS=0 wins over a terminal that does support it.\"\"\"\n    import psutil\n\n    from IPython.core import kitty\n\n    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", \"0\")\n\n    def fail(*args, **kwargs):\n        raise AssertionError(\"detection must be skipped when forced\")\n\n    monkeypatch.setattr(psutil, \"Process\", fail)\n    monkeypatch.setattr(sys, \"stdout\", StdoutTTY())\n\n    assert kitty._supports_kitty_graphics() is False\n\n\n@pytest.mark.parametrize(\"value\", [\"1\", \"true\", \"TRUE\"])\ndef test_kitty_graphics_force_true_spellings(monkeypatch, value):\n    from IPython.core import kitty\n\n    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", value)\n    assert kitty._forced_kitty_graphics() is True\n\n\n@pytest.mark.parametrize(\"value\", [\"0\", \"false\", \"FALSE\"])\ndef test_kitty_graphics_force_false_spellings(monkeypatch, value):\n    from IPython.core import kitty\n\n    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", value)\n    assert kitty._forced_kitty_graphics() is False\n\n\n@pytest.mark.parametrize(\"value\", [\"\", None])\ndef test_kitty_graphics_unset_autodetects(monkeypatch, value):\n    from IPython.core import kitty\n\n    if value is None:\n        monkeypatch.delenv(\"IPYTHON_KITTY_GRAPHICS\", raising=False)\n    else:\n        monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", value)\n    assert kitty._forced_kitty_graphics() is None\n\n\ndef test_kitty_graphics_bad_value_warns_and_autodetects(monkeypatch):\n    \"\"\"A typo must not silently disable (or enable) graphics.\"\"\"\n    from IPython.core import kitty\n\n    monkeypatch.setenv(\"IPYTHON_KITTY_GRAPHICS\", \"yes-please\")\n    with pytest.warns(UserWarning, match=\"IPYTHON_KITTY_GRAPHICS\"):\n        assert kitty._forced_kitty_graphics() is None\n\n\ndef _fake_proc(tree):\n    \"\"\"Build a `_read_proc_stat` replacement from a ``{pid: (name, ppid)}`` map.\n\n    A pid missing from the map raises `PermissionError`, which is what\n    ``hidepid`` gives for an ancestor owned by another user.\n    \"\"\"\n\n    def read(pid):\n        try:\n            name, ppid = tree[pid]\n        except KeyError:\n            raise PermissionError(13, \"Permission denied\") from None\n        return f\"{pid} ({name}) S {ppid} 0 0 0 -1 0\".encode()\n\n    return read\n\n\n\ndef test_proc_ancestor_names_handles_names_with_spaces_and_parens(monkeypatch):\n    \"\"\"`comm` is not escaped in /proc/<pid>/stat, so parse from the last ')'.\"\"\"\n    from IPython.core import kitty\n\n    monkeypatch.setattr(os, \"getppid\", lambda: 5)\n    monkeypatch.setattr(\n        kitty,\n        \"_read_proc_stat\",\n        _fake_proc({5: (\"we (ird) name\", 1), 1: (\"init\", 0)}),\n    )\n    assert list(kitty._proc_ancestor_names()) == [\"we (ird) name\", \"init\"]\n\n\ndef test_proc_ancestor_names_stops_when_an_ancestor_is_unreadable(monkeypatch):\n    \"\"\"`hidepid` makes ancestors of other users unreadable; stop, don't raise.\"\"\"\n    from IPython.core import kitty\n\n    monkeypatch.setattr(os, \"getppid\", lambda: 42)\n    monkeypatch.setattr(kitty, \"_read_proc_stat\", _fake_proc({42: (\"bash\", 7)}))\n    assert list(kitty._proc_ancestor_names()) == [\"bash\"]\n\n\ndef test_supports_kitty_graphics_finds_terminal_through_proc(monkeypatch):\n    from IPython.core import kitty\n\n    monkeypatch.delenv(\"IPYTHON_KITTY_GRAPHICS\", raising=False)\n    monkeypatch.setattr(sys, \"platform\", \"linux\")\n    monkeypatch.setattr(sys, \"stdout\", StdoutTTY())\n    monkeypatch.setattr(os.path, \"isdir\", lambda path: path == \"/proc/self\")\n    monkeypatch.setattr(os, \"getppid\", lambda: 42)\n    monkeypatch.setattr(\n        kitty,\n        \"_read_proc_stat\",\n        _fake_proc({42: (\"bash\", 7), 7: (\"ghostty\", 1), 1: (\"init\", 0)}),\n    )\n    assert kitty._supports_kitty_graphics() is True\n\n","numLines":212,"startLine":1,"totalLines":212}}}
