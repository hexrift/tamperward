 a gitignore pattern.\n\t\"\"\"\n\tpass\n","structuredPatch":[{"oldStart":18,"oldLines":7,"newStart":18,"newLines":26,"lines":[" The encoding to use when parsing a byte string pattern."," \"\"\""," ","+_POSIX_CLASSES = {","+  'alnum': '0-9A-Za-z',","+  'alpha': 'A-Za-z',","+  'blank': '\\\\t ',","+  'cntrl': '\\\\x00-\\\\x1f\\\\x7f',","+  'digit': '0-9',","+  'graph': '\\\\x21-\\\\x7e',","+  'lower': 'a-z',","+  'print': '\\\\x20-\\\\x7e',","+  'punct': '!-/:-@\\\\[-`{-~',","+  'space': '\\\\t\\\\n\\\\r ',","+  'upper': 'A-Z',","+  'xdigit': '0-9A-Fa-f',","+}","+\"\"\"","+Maps the name of each POSIX bracket character class to the locale-independent","+ASCII regex range that Git's wildmatch uses for it.","+\"\"\""," ","+"," class _GitIgnoreBasePattern(RegexPattern):","   \"\"\"","   .. warning:: This class is not part of the public API. It is subject to"]}],"userModified":false,"replaceAll":false,"gitDiff":{"filename":"pathspec/patterns/gitignore/base.py","status":"modified","additions":19,"deletions":0,"changes":19,"patch":"@@ -18,6 +18,25 @@ _BYTES_ENCODING = 'latin1'\n The encoding to use when parsing a byte string pattern.\n \"\"\"\n \n+_POSIX_CLASSES = {\n+\t'alnum': '0-9A-Za-z',\n+\t'alpha': 'A-Za-z',\n+\t'blank': '\\\\t ',\n+\t'cntrl': '\\\\x00-\\\\x1f\\\\x7f',\n+\t'digit': '0-9',\n+\t'graph': '\\\\x21-\\\\x7e',\n+\t'lower': 'a-z',\n+\t'print': '\\\\x20-\\\\x7e',\n+\t'punct': '!-/:-@\\\\[-`{-~',\n+\t'space': '\\\\t\\\\n\\\\r ',\n+\t'upper': 'A-Z',\n+\t'xdigit': '0-9A-Fa-f',\n+}\n+\"\"\"\n+Maps the name of each POSIX bracket character class to the locale-independent\n+ASCII regex range that Git's wildmatch uses for it.\n+\"\"\"\n+\n \n class _GitIgnoreBasePattern(RegexPattern):\n \t\"\"\"","repository":null}}}
