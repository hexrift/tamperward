n\t\t\t\t# Regular character, escape it for regex.\n\t\t\t\tregex += re.escape(char)\n\n\t\tif escape:\n\t\t\traise ValueError((\n\t\t\t\tf\"Escape character found with no next character to escape: {pattern!r}\"\n\t\t\t))  # ValueError\n\n\t\treturn regex\n\n\nclass GitIgnorePatternError(ValueError):\n\t\"\"\"\n\tThe :class:`GitIgnorePatternError` class indicates an invalid gitignore\n\tpattern.\n\t\"\"\"\n\tpass\n\n\nclass _RangeError(GitIgnorePatternError):\n\t\"\"\"\n\tThe :class:`_RangeError` class indicates an invalid range notation was found\n\tin a gitignore pattern.\n\t\"\"\"\n\tpass\n","structuredPatch":[{"oldStart":148,"oldLines":8,"newStart":148,"newLines":16,"lines":["         if j < end and pattern[j] == ']':","           j += 1"," ","-        # Find closing bracket. Stop once we reach the end or find it.","+        # Find closing bracket. Stop once we reach the end or find it. A","+        # POSIX bracket character class (e.g., \"[:alpha:]\") contains its own","+        # ']' as part of the \":]\" delimiter, so skip over any such class","+        # instead of stopping at its internal closing bracket.","         while j < end and pattern[j] != ']':","+          if pattern[j] == '[' and j + 1 < end and pattern[j + 1] == ':':","+            class_end = pattern.find(':]', j + 2, end)","+            if class_end != -1:","+              j = class_end + 2","+              continue","           j += 1"," ","         if j < end:"]}],"userModified":false,"replaceAll":false,"gitDiff":{"filename":"pathspec/patterns/gitignore/base.py","status":"modified","additions":28,"deletions":1,"changes":29,"patch":"@@ -18,6 +18,25 @@ _BYTES_ENCODING = 'latin1'\n The encoding to use when parsing a byte string pattern.\n \"\"\"\n \n+_POSIX_CLASSES = {\n+\t'alnum': '0-9A-Za-z',\n+\t'alpha': 'A-Za-z',\n+\t'blank': '\\\\t ',\n+\t'cntrl': '\\\\x00-\\\\x1f\\\\x7f',\n+\t'digit': '0-9',\n+\t'graph': '\\\\x21-\\\\x7e',\n+\t'lower': 'a-z',\n+\t'print': '\\\\x20-\\\\x7e',\n+\t'punct': '!