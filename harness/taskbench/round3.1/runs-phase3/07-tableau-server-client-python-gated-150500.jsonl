{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AAyX9JBU9etd5rUwscEUXA","type":"tool_result","content":"1\timport logging\n2\tfrom unittest.mock import *\n3\timport io\n4\t\n5\timport pytest\n6\t\n7\timport tableauserverclient as TSC\n8\t\n9\t\n10\tdef test_invalid_auth_setting():\n11\t    user = TSC.UserItem(\"me\", TSC.UserItem.Roles.Publisher)\n12\t    with pytest.raises(ValueError):\n13\t        user.auth_setting = \"Hello\"\n14\t\n15\t\n16\tdef test_invalid_site_role():\n17\t    user = TSC.UserItem(\"me\", TSC.UserItem.Roles.Publisher)\n18\t    with pytest.raises(ValueError):\n19\t        user.site_role = \"Hello\"\n20\t\n21\t\n22\tlogger = logging.getLogger(\"UserModelTest\")\n23\t\n24\t\n25\trole_inputs = [\n26\t    [\"creator\", \"system\", \"yes\", \"SiteAdministrator\"],\n27\t    [\"None\", \"system\", \"no\", \"SiteAdministrator\"],\n28\t    [\"explorer\", \"SysTEm\", \"no\", \"SiteAdministrator\"],\n29\t    [\"creator\", \"site\", \"yes\", \"SiteAdministratorCreator\"],\n30\t    [\"explorer\", \"site\", \"yes\", \"SiteAdministratorExplorer\"],\n31\t    [\"creator\", \"SITE\", \"no\", \"SiteAdministratorCreator\"],\n32\t    [\"creator\", \"none\", \"yes\", \"Creator\"],\n33\t    [\"explorer\", \"none\", \"yes\", \"ExplorerCanPublish\"],\n34\t    [\"viewer\", \"None\", \"no\", \"Viewer\"],\n35\t    [\"explorer\", \"no\", \"yes\", \"ExplorerCanPublish\"],\n36\t    [\"EXPLORER\", \"noNO\", \"yes\", \"ExplorerCanPublish\"],\n37\t    [\"explorer\", \"no\", \"no\", \"Explorer\"],\n38\t    [\"unlicensed\", \"none\", \"no\", \"Unlicensed\"],\n39\t    [\"Chef\", \"none\", \"yes\", \"Unlicensed\"],\n40\t    [\"yes\", \"yes\", \"yes\", \"Unlicensed\"],\n41\t]\n42\t\n43\tvalid_import_content = [\n44\t    \"username, pword, fname, creator, site, yes, email\",\n45\t    \"username, pword, fname, explorer, none, no, email\",\n46\t    \"\",\n47\t    \"u\",\n48\t    \"p\",\n49\t]\n50\t\n51\tvalid_username_content = [\"jfitzgerald@tableau.com\"]\n52\t\n53\tusernames = [\n54\t    \"valid\",\n55\t    \"valid@email.com\",\n56\t    \"domain/valid\",\n57\t    \"domain/valid@tmail.com\",\n58\t    \"va!@#$%^&*()lid\",\n59\t    \"in@v@lid\",\n60\t    \"in valid\",\n61\t    \"\",\n62\t]\n63\t\n64\t\n65\tdef test_validate_usernames() -> None:\n66\t    TSC.UserItem.validate_username_or_throw(usernames[0])\n67\t    TSC.UserItem.validate_username_or_throw(usernames[1])\n68\t    TSC.UserItem.validate_username_or_throw(usernames[2])\n69\t    TSC.UserItem.validate_username_or_throw(usernames[3])\n70\t    TSC.UserItem.validate_username_or_throw(usernames[4])\n71\t    with pytest.raises(AttributeError):\n72\t        TSC.UserItem.validate_username_or_throw(usernames[5])\n73\t    with pytest.raises(AttributeError):\n74\t        TSC.UserItem.validate_username_or_throw(usernames[6])\n75\t\n76\t\n77\tdef test_evaluate_role() -> None:\n78\t    for line in role_inputs:\n79\t        actual = TSC.UserItem.CSVImport._evaluate_site_role(line[0], line[1], line[2])\n80\t        assert actual == line[3], line + [actual]\n81\t\n82\t\n83\t# _decompose_site_role writes CSV rows that the server (and TSC's own\n84\t# _evaluate_site_role) parse back into a site role. This parametrized test\n85\t# pins the round-trip so a change in either direction can't drift silently.\n86\t# The two documented asymmetries are the ServerAdministrator/SiteAdministrator\n87\t# label pair and the legacy-role fold; both are captured explicitly below.\n88\t\n89\t\n90\tdef test_get_user_detail_empty_line() -> None:\n91\t    test_line = \"\"\n92\t    test_user = TSC.UserItem.CSVImport.create_user_from_line(test_line)\n93\t    assert test_user is None\n94\t\n95\t\n96\tdef test_get_user_detail_standard() -> None:\n97\t    test_line = \"username, pword, fname, license, admin, pub, email\"\n98\t    test_user = TSC.UserItem.CSVImport.create_user_from_line(test_line)\n99\t    assert test_user is not None\n100\t    assert test_user.name == \"username\", test_user.name\n101\t    assert test_user.fullname == \"fname\", test_user.fullname\n102\t    assert test_user.site_role == \"Unlicensed\", test_user.site_role\n103\t    assert test_user.email == \"email\", test_user.email\n104\t\n105\t\n106\tdef test_get_user_details_only_username() -> None:\n107\t    test_line = \"username\"\n108\t    test_user = TSC.UserItem.CSVImport.create_user_from_line(test_line)\n109\t\n110\t\n111\tdef test_populate_user_details_only_some() -> None:\n112\t    values = \"username, , , creator, admin\"\n113\t    user = TSC.UserItem.CSVImport.create_user_from_line(values)\n114\t    assert user is not None\n115\t    assert user.name == \"username\"\n116\t\n117\t\n118\tdef test_validate_user_detail_standard() -> None:\n119\t    test_line = \"username, pword, fname, creator, site, 1, email\"\n120\t    TSC.UserItem.CSVImport._validate_import_line_or_throw(test_line, logger)\n121\t    TSC.UserItem.CSVImport.create_user_from_line(test_line)\n122\t\n123\t\n124\t# for file handling\n125\tdef _mock_file_content(content: list[str]) -> io.TextIOWrapper:\n126\t    # the empty string represents EOF\n127\t    # the tests run through the file twice, first to validate then to fetch\n128\t    mock = MagicMock(io.TextIOWrapper)\n129\t    content.append(\"\")  # EOF\n130\t    mock.readline.side_effect = content\n131\t    mock.name = \"file-mock\"\n132\t    return mock\n133\t\n134\t\n135\tdef test_validate_import_file() -> None:\n136\t    test_data = _mock_file_content(valid_import_content)\n137\t    valid, invalid = TSC.UserItem.CSVImport.validate_file_for_import(test_data, logger)\n138\t    assert valid == 2, f\"Expected two lines to be parsed, got {valid}\"\n139\t    assert invalid == [], f\"Expected no failures, got {invalid}\"\n140\t\n141\t\n142\tdef test_validate_usernames_file() -> None:\n143\t    test_data = _mock_file_content(usernames)\n144\t    valid, invalid = TSC.UserItem.CSVImport.validate_file_for_import(test_data, logger)\n145\t    assert valid == 5, f\"Exactly 5 of the