{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TpJRJnAo9fNeFU3NjTYniv","type":"tool_result","content":"420\t            domain_name,\n421\t            locale,\n422\t            language,\n423\t            idp_configuration_id,\n424\t        )\n425\t\n426\t    class CSVImport:\n427\t        \"\"\"\n428\t        This class includes hardcoded options and logic for the CSV file format defined for user import\n429\t        https://help.tableau.com/current/server/en-us/users_import.htm\n430\t        \"\"\"\n431\t\n432\t        # username, password, display_name, license, admin_level, publishing, email, auth type\n433\t        class ColumnType(IntEnum):\n434\t            USERNAME = 0\n435\t            PASS = 1\n436\t            DISPLAY_NAME = 2\n437\t            LICENSE = 3  # aka site role\n438\t            ADMIN = 4\n439\t            PUBLISHER = 5\n440\t            EMAIL = 6\n441\t            AUTH = 7\n442\t\n443\t        # Total number of columns supported by the import format. Held outside\n444\t        # the ColumnType enum so it can't be mistaken for a real column index.\n445\t        COLUMN_COUNT = 8\n446\t\n447\t        # Lowercase -> canonical form mapping for the AUTH column. Class-level\n448\t        # so the dict isn't rebuilt on every call to create_user_from_line /\n449\t        # _validate_import_line_or_throw. The set of accepted values is derived\n450\t        # from this map (see _valid_attributes[AUTH]) so there's a single\n451\t        # source of truth.\n452\t        _AUTH_CANONICAL: dict[str, str] = {\n453\t            \"saml\": \"SAML\",\n454\t            \"openid\": \"OpenID\",\n455\t            \"serverdefault\": \"ServerDefault\",\n456\t            \"tableauidwithmfa\": \"TableauIDWithMFA\",\n457\t        }\n458\t\n459\t        # Read a csv line and create a user item populated by the given attributes\n460\t        @staticmethod\n461\t        def create_user_from_line(line: str):\n462\t            if line is None or line is False or line == \"\\n\" or line == \"\":\n463\t                return None\n464\t            values: list[str] = list(map(str.strip, line.strip().split(\",\")))\n465\t            if len(values) > UserItem.CSVImport.COLUMN_COUNT:\n466\t                raise ValueError(\"Too many attributes for user import\")\n467\t            username = values[UserItem.CSVImport.ColumnType.USERNAME]\n468\t            user = UserItem(username)\n469\t            if len(values) > 1:\n470\t                while len(values) < UserItem.CSVImport.COLUMN_COUNT:\n471\t                    values.append(\"\")\n472\t                site_role = UserItem.CSVImport._evaluate_site_role(\n473\t                    values[UserItem.CSVImport.ColumnType.LICENSE],\n474\t                    values[UserItem.CSVImport.ColumnType.ADMIN],\n475\t                    values[UserItem.CSVImport.ColumnType.PUBLISHER],\n476\t                )\n477\t                raw_auth = values[UserItem.CSVImport.ColumnType.AUTH]\n478\t                if raw_auth:\n479\t                    auth = UserItem.CSVImport._AUTH_CANONICAL.get(raw_auth.lower())\n480\t                    if auth is None:\n481\t                        raise ValueError(\n482\t                            f\"Unknown auth setting: {raw_auth!r}. \"\n483\t                            f\"Valid values: {sorted(UserItem.CSVImport._AUTH_CANONICAL.values())}\"\n484\t                        )\n485\t                else:\n486\t                    auth = None\n487\t                user._set_values(\n488\t                    None,\n489\t                    username,\n490\t                    site_role,\n491\t                    None,\n492\t                    None,\n493\t                    values[UserItem.CSVImport.ColumnType.DISPLAY_NAME],\n494\t                    values[UserItem.CSVImport.ColumnType.EMAIL],\n495\t                    auth,\n496\t                    None,\n497\t                    None,\n498\t                    None,\n499\t                    None,\n500\t                )\n501\t            return user\n502\t\n503\t        # Read through an entire CSV file meant for user import\n504\t        # Return the number of valid lines and a list of all the invalid lines\n505\t        @staticmethod\n506\t        def validate_file_for_import(csv_file: io.TextIOWrapper, logger) -> tuple[int, list[str]]:\n507\t            num_valid_lines = 0\n508\t            invalid_lines = []\n509\t            csv_file.seek(0)  # set to start of file in case it has been read earlier\n510\t            line: str = csv_file.readline()\n511\t            while line and line != \"\":\n512\t                try:\n513\t                    # do not print passwords\n514\t                    logger.info(f\"Reading user {line[:4]}\")\n515\t                    UserItem.CSVImport._validate_import_line_or_throw(line, logger)\n516\t                    num_valid_lines += 1\n517\t                except Exception as exc:\n518\t                    logger.info(f\"Error parsing {line[:4]}: {exc}\")\n519\t                    invalid_lines.append(line)\n520\t                line = csv_file.readline()\n521\t            return num_valid_lines, invalid_lines\n522\t\n523\t        # Some fields in the import file are restricted to specific values\n524\t        # Iterate through each field and validate the given value against hardcoded constraints\n525\t        @staticmethod\n526\t        def _validate_import_line_or_throw(incoming, logger) -> None:\n527\t            # AUTH column's valid set is derived from _AUTH_CANONICAL so there's\n528\t            # one source of truth for the accepted values.\n529\t            _valid_attributes: list[list[str]] = [\n530\t                [],\n531\t                [],\n532\t                [],\n533\t                [\"creator\", \"explorer\", \"viewer\", \"unlicensed\"],  # license\n534\t                [\"system\", \"site\", \"none\", \"no\"],  # admin\n535\t                [\"yes\", \"true\", \"1\", \"no\", \"false\", \"0\"],  