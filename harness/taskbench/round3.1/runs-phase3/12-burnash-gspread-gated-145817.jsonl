erver error\n            #   - AND we did not reach the max retry limit\n            return (\n                code in self._HTTP_ERROR_CODES\n                or code >= HTTPStatus.INTERNAL_SERVER_ERROR\n            ) and uncapped_wait <= self._MAX_BACKOFF","numLines":20,"startLine":578,"totalLines":646}}}
