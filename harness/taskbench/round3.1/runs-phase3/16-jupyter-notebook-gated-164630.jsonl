{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018twQYba73vuU1C57dPZxYP","type":"tool_result","content":"1\t\"\"\"Jupyter notebook application.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport os\n6\timport re\n7\timport typing as t\n8\tfrom pathlib import Path\n9\t\n10\tfrom jupyter_client.utils import ensure_async  # type:ignore[attr-defined]\n11\tfrom jupyter_core.application import base_aliases\n12\tfrom jupyter_core.paths import jupyter_config_dir\n13\tfrom jupyter_server.base.handlers import JupyterHandler\n14\tfrom jupyter_server.extension.handler import (\n15\t    ExtensionHandlerJinjaMixin,\n16\t    ExtensionHandlerMixin,\n17\t)\n18\tfrom jupyter_server.serverapp import flags\n19\tfrom jupyter_server.utils import url_escape, url_is_absolute\n20\tfrom jupyter_server.utils import url_path_join as ujoin\n21\tfrom jupyterlab.commands import (  # type:ignore[import-untyped]\n22\t    get_app_dir,\n23\t    get_user_settings_dir,\n24\t    get_workspaces_dir,\n25\t)\n26\tfrom jupyterlab_server import LabServerApp\n27\tfrom jupyterlab_server.config import (  # type:ignore[attr-defined]\n28\t    LabConfig,\n29\t    get_page_config,\n30\t    recursive_update,\n31\t)\n32\tfrom jupyterlab_server.handlers import _camelCase, is_url\n33\tfrom notebook_shim.shim import NotebookConfigShimMixin  # type:ignore[import-untyped]\n34\tfrom tornado import web\n35\tfrom traitlets import Bool, Unicode, default\n36\tfrom traitlets.config.loader import Config\n37\t\n38\tfrom ._version import __version__\n39\t\n40\tHERE = Path(__file__).parent.resolve()\n41\t\n42\tFlags = dict[str | tuple[str, ...], tuple[dict[str, t.Any] | Config, str]]\n43\t\n44\tapp_dir = Path(get_app_dir())\n45\tversion = __version__\n46\t\n47\t# mypy: disable-error-code=\"no-untyped-call\"\n48\t\n49\t\n50\tclass NotebookBaseHandler(ExtensionHandlerJinjaMixin, ExtensionHandlerMixin, JupyterHandler):\n51\t    \"\"\"The base notebook API handler.\"\"\"\n52\t\n53\t    @property\n54\t    def custom_css(self) -> t.Any:\n55\t        return self.settings.get(\"custom_css\", True)\n56\t\n57\t    def get_page_config(self) -> dict[str, t.Any]:\n58\t        \"\"\"Get the page config.\"\"\"\n59\t        config = LabConfig()\n60\t        app: JupyterNotebookApp = self.extensionapp  # type:ignore[assignment]\n61\t        base_url = self.settings.get(\"base_url\", \"/\")\n62\t        page_config_data = self.settings.setdefault(\"page_config_data\", {})\n63\t        page_config = {\n64\t            **page_config_data,\n65\t            \"appVersion\": version,\n66\t            \"baseUrl\": self.base_url,\n67\t            \"terminalsAvailable\": self.settings.get(\"terminals_available\", False),\n68\t            \"token\": self.settings[\"token\"],\n69\t            \"fullStaticUrl\": ujoin(self.base_url, \"static\", self.name),\n70\t            \"frontendUrl\": ujoin(self.base_url, \"/\"),\n71\t            \"exposeAppInBrowser\": app.expose_app_in_browser,\n72\t        }\n73\t\n74\t        server_root = self.settings.get(\"server_root_dir\", \"\")\n75\t        server_root = server_root.replace(os.sep, \"/\")\n76\t        server_root = os.path.normpath(Path(server_root).expanduser())\n77\t        try:\n78\t            # Remove the server_root from pref dir\n79\t            if self.serverapp.preferred_dir != server_root:\n80\t                page_config[\"preferredPath\"] = \"/\" + os.path.relpath(\n81\t                    self.serverapp.preferred_dir, server_root\n82\t                )\n83\t            else:\n84\t                page_config[\"preferredPath\"] = \"/\"\n85\t        except Exception:  # noqa: BLE001\n86\t            page_config[\"preferredPath\"] = \"/\"\n87\t\n88\t        mathjax_config = self.settings.get(\"mathjax_config\", \"TeX-AMS_HTML-full,Safe\")\n89\t        # TODO Remove CDN usage.\n90\t        mathjax_url = self.settings.get(\n91\t            \"mathjax_url\",\n92\t            \"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js\",\n93\t        )\n94\t        if not url_is_absolute(mathjax_url) and not mathjax_url.startswith(self.base_url):\n95\t            mathjax_url = ujoin(self.base_url, mathjax_url)\n96\t\n97\t        page_config.setdefault(\"mathjaxConfig\", mathjax_config)\n98\t        page_config.setdefault(\"fullMathjaxUrl\", mathjax_url)\n99\t        page_config.setdefault(\"jupyterConfigDir\", jupyter_config_dir())\n100\t\n101\t        # Put all our config in page_config\n102\t        for name in config.trait_names():\n103\t            page_config[_camelCase(name)] = getattr(app, name)\n104\t\n105\t        # Add full versions of all the urls\n106\t        for name in config.trait_names():\n107\t            if not name.endswith(\"_url\"):\n108\t                continue\n109\t            full_name = _camelCase(\"full_\" + name)\n110\t            full_url = getattr(app, name)\n111\t            if not is_url(full_url):\n112\t                # Relative URL will be prefixed with base_url\n113\t                full_url = ujoin(base_url, full_url)\n114\t            page_config[full_name] = full_url\n115\t\n116\t        labextensions_path = app.extra_labextensions_path + app.labextensions_path\n117\t        recursive_update(\n118\t            page_config,\n119\t            get_page_config(\n120\t                labextensions_path,\n121\t                logger=self.log,\n122\t            ),\n123\t        )\n124\t\n125\t        # modify page config with custom hook\n126\t        page_config_hook = self.settings.get(\"page_config_hook\", None)\n127\t        if page_config_hook:\n128\t            page_config = page_config_hook(self, page_config)\n129\t\n130\t        return page_config\n131\t\n132\t\n133\tclass TreeHandler(NotebookBaseHandler):\n134\t    \"\"\"A tree page handler.\"\"\"\n135\t\n136\t    @web.authenticated\n137\t    async def get(self, path: str = \"\") -> None:\n138\t        \"\"\"\n139\t        Display appropriate page for given path.\n140\t\n141\t        - A directory listing is shown if path is a directory\n142\t        - Redirected to notebook page if path is a notebook\n143\t        - Render the raw file if path is any other file\n144\t        \"\"\"\n145\t        path = path.strip(\"/\")\n146\t        cm = self.contents_manager\n147\t\n148\t        if await ensure_async(cm.dir_exists(path=path)):\n149\t            if await ensure_async(cm.is_hidden(path)) and not cm.allow_hidden:\n150\t                self.log.info(\"Refusing to serve hidden directory, via 404 Error\")\n151\t                raise web.HTTPError(404)\n152\t\n153\t            # Set treePath for routing to the directory\n154\t            page_config = self.get_page_config()\n155\t            page_config[\"treePath\"] = path\n156\t\n157\t            tpl = self.render_template(\"tree.html\", page_config=page_config)\n158\t            return self.write(tpl)\n159\t        if await ensure_async(cm.file_exists(path)):\n160\t            # it's not a directory, we have redirecting to do\n161\t            model = await ensure_async(cm.get(path, content=False))\n162\t            if model[\"type\"] == \"notebook\":\n163\t                url = ujoin(self.base_url, \"notebooks\", url_escape(path))\n164\t            else:\n165\t                # Return raw content if file is not a notebook\n166\t                url = ujoin(self.base_url, \"files\", url_escape(path))\n167\t            self.log.debug(\"Redirecting %s to %s\", self.request.path, url)\n168\t            self.redirect(url)\n169\t            return None\n170\t        raise web.HTTPError(404)\n171\t\n172\t\n173\tclass ConsoleHandler(NotebookBaseHandler):\n174\t    \"\"\"A console page handler.\"\"\"\n175\t\n176\t    @web.authenticated\n177\t    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n178\t        \"\"\"Get the console page.\"\"\"\n179\t        tpl = self.render_template(\"consoles.html\", page_config=self.get_page_config())\n180\t        return self.write(tpl)\n181\t\n182\t\n183\tclass TerminalHandler(NotebookBaseHandler):\n184\t    \"\"\"A terminal page handler.\"\"\"\n185\t\n186\t    @web.authenticated\n187\t    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n188\t        \"\"\"Get the terminal page.\"\"\"\n189\t        tpl = self.render_template(\"terminals.html\", page_config=self.get_page_config())\n190\t        return self.write(tpl)\n191\t\n192\t\n193\tclass FileHandler(NotebookBaseHandler):\n194\t    \"\"\"A file page handler.\"\"\"\n195\t\n196\t    @web.authenticated\n197\t    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n198\t        \"\"\"Get the file page.\"\"\"\n199\t        tpl = self.render_template(\"edit.html\", page_config=self.get_page_config())\n200\t        return self.write(tpl)\n201\t\n202\t\n203\tclass NotebookHandler(NotebookBaseHandler):\n204\t    \"\"\"A notebook page handler.\"\"\"\n205\t\n206\t    @web.authenticated\n207\t    async def get(self, path: str = \"\") -> t.Any:\n208\t        \"\"\"Get the notebook page. Redirect if it's a directory.\"\"\"\n209\t        path = path.strip(\"/\")\n210\t        cm = self.contents_manager\n211\t\n212\t        if await ensure_async(cm.dir_exists(path=path)):\n213\t            url = ujoin(self.base_url, \"tree\", url_escape(path))\n214\t            self.log.debug(\"Redirecting %s to %s since path is a directory\", self.request.path, url)\n215\t            self.redirect(url)\n216\t            return None\n217\t        tpl = self.render_template(\"notebooks.html\", page_config=self.get_page_config())\n218\t        return self.write(tpl)\n219\t\n220\t\n221\tclass CustomCssHandler(NotebookBaseHandler):\n222\t    \"\"\"A custom CSS handler.\"\"\"\n223\t\n224\t    @web.authenticated\n225\t    def get(self) -> t.Any:\n226\t        \"\"\"Get the custom css file.\"\"\"\n227\t\n228\t        self.set_header(\"Content-Type\", \"text/css\")\n229\t        page_config = self.get_page_config()\n230\t        custom_css_file = f\"{page_config['jupyterConfigDir']}/custom/custom.css\"\n231\t\n232\t        if not Path(custom_css_file).is_file():\n233\t            static_path_root = re.match(\"^(.*?)static\", page_config[\"staticDir\"])\n234\t            if static_path_root is not None:\n235\t                custom_dir = static_path_root.groups()[0]\n236\t                custom_css_file = f\"{custom_dir}custom/custom.css\"\n237\t\n238\t        with Path(custom_css_file).open() as css_f:\n239\t            return self.write(css_f.read())\n240\t\n241\t\n242\taliases = dict(base_aliases)\n243\t\n244\t\n245\tclass JupyterNotebookApp(NotebookConfigShimMixin, LabServerApp):  # type:ignore[misc]\n246\t    \"\"\"The notebook server extension app.\"\"\"\n247\t\n248\t    name = \"notebook\"\n249\t    app_name = \"Jupyter Notebook\"\n250\t    description = \"Jupyter Notebook - A web-based notebook environment for interactive computing\"\n251\t    version = version\n252\t    app_version = Unicode(version, help=\"The version of the application.\")\n253\t    extension_url = \"/\"\n254\t    default_url = Unicode(\"/tree\", config=True, help=\"The default URL to redirect to from `/`\")\n255\t    file_url_prefix = \"/tree\"\n256\t    load_other_extensions = True\n257\t    app_dir = app_dir\n258\t    subcommands: dict[str, t.Any] = {}\n259\t\n260\t    expose_app_in_browser = Bool(\n261\t        False,\n262\t        config=True,\n263\t        help=\"Whether to expose the global app instance to browser via window.jupyterapp\",\n264\t    )\n265\t\n266\t    custom_css = Bool(\n267\t        True,\n268\t        config=True,\n269\t        help=\"\"\"Whether custom CSS is loaded on the page.\n270\t        Defaults to True and custom CSS is loaded.\n271\t        \"\"\",\n272\t    )\n273\t\n274\t    flags: Flags = {**flags}  # type:ignore[assignment]\n275\t    flags[\"expose-app-in-browser\"] = (\n276\t        {\"JupyterNotebookApp\": {\"expose_app_in_browser\": True}},\n277\t        \"Expose the global app instance to browser via window.jupyterapp.\",\n278\t    )\n279\t\n280\t    flags[\"custom-css\"] = (\n281\t        {\"JupyterNotebookApp\": {\"custom_css\": True}},\n282\t        \"Load custom CSS in template html files. Default is True\",\n283\t    )\n284\t\n285\t    @default(\"static_dir\")\n286\t    def _default_static_dir(self) -> str:\n287\t        return str(HERE / \"static\")\n288\t\n289\t    @default(\"templates_dir\")\n290\t    def _default_templates_dir(self) -> str:\n291\t        return str(HERE / \"templates\")\n292\t\n293\t    @default(\"app_settings_dir\")\n294\t    def _default_app_settings_dir(self) -> str:\n295\t        return str(app_dir / \"settings\")\n296\t\n297\t    @default(\"schemas_dir\")\n298\t    def _default_schemas_dir(self) -> str:\n299\t        return str(app_dir / \"schemas\")\n300\t\n301\t    @default(\"themes_dir\")\n302\t    def _default_themes_dir(self) -> str:\n303\t        return str(app_dir / \"themes\")\n304\t\n305\t    @default(\"user_settings_dir\")\n306\t    def _default_user_settings_dir(self) -> str:\n307\t        return t.cast(str, get_user_settings_dir())\n308\t\n309\t    @default(\"workspaces_dir\")\n310\t    def _default_workspaces_dir(self) -> str:\n311\t        return t.cast(str, get_workspaces_dir())\n312\t\n313\t    def _prepare_templates(self) -> None:\n314\t        super(LabServerApp, self)._prepare_templates()\n315\t        self.jinja2_env.globals.update(custom_css=self.custom_css)  # type:ignore[has-type]\n316\t\n317\t    def server_extension_is_enabled(self, extension: str) -> bool:\n318\t        \"\"\"Check if server extension is enabled.\"\"\"\n319\t        if self.serverapp is None:\n320\t            return False\n321\t        try:\n322\t            extension_enabled = (\n323\t                self.serverapp.extension_manager.extensions[extension].enabled is True\n324\t            )\n325\t        except (AttributeError, KeyError, TypeError):\n326\t            extension_enabled = False\n327\t        return extension_enabled\n328\t\n329\t    def initialize_handlers(self) -> None:\n330\t        \"\"\"Initialize handlers.\"\"\"\n331\t        assert self.serverapp is not None  # noqa: S101\n332\t        page_config = self.serverapp.web_app.settings.setdefault(\"page_config_data\", {})\n333\t        nbclassic_enabled = self.server_extension_is_enabled(\"nbclassic\")\n334\t        page_config[\"nbclassic_enabled\"] = nbclassic_enabled\n335\t\n336\t        # If running under JupyterHub, add more metadata.\n337\t        if \"hub_prefix\" in self.serverapp.tornado_settings:\n338\t            tornado_settings = self.serverapp.tornado_settings\n339\t            hub_prefix = tornado_settings[\"hub_prefix\"]\n340\t            page_config[\"hubPrefix\"] = hub_prefix\n341\t            page_config[\"hubHost\"] = tornado_settings[\"hub_host\"]\n342\t            page_config[\"hubUser\"] = tornado_settings[\"user\"]\n343\t            page_config[\"shareUrl\"] = ujoin(hub_prefix, \"user-redirect\")\n344\t            # Assume the server_name property indicates running JupyterHub 1.0.\n345\t            if hasattr(self.serverapp, \"server_name\"):\n346\t                page_config[\"hubServerName\"] = self.serverapp.server_name\n347\t            # avoid setting API token in page config\n348\t            # $JUPYTERHUB_API_TOKEN identifies the server, not the client\n349\t            # but at least make sure we don't use the token\n350\t            # if the serverapp set one\n351\t            page_config[\"token\"] = \"\"\n352\t\n353\t        self.handlers.append((\"/tree(.*)\", TreeHandler))\n354\t        self.handlers.append((\"/notebooks(.*)\", NotebookHandler))\n355\t        self.handlers.append((\"/edit(.*)\", FileHandler))\n356\t        self.handlers.append((\"/consoles/(.*)\", ConsoleHandler))\n357\t        self.handlers.append((\"/terminals/(.*)\", TerminalHandler))\n358\t        self.handlers.append((\"/custom/custom.css\", CustomCssHandler))\n359\t        super().initialize_handlers()\n360\t\n361\t    def initialize(self, argv: list[str] | None = None) -> None:  # noqa: ARG002\n362\t        \"\"\"Subclass because the ExtensionApp.initialize() method does not take arguments\"\"\"\n363\t        super().initialize()\n364\t\n365\t\n366\tmain = launch_new_instance = JupyterNotebookApp.launch_instance\n367\t\n368\tif __name__ == \"__main__\":\n369\t    main()\n370\t"}]},"parent_tool_use_id":null,"session_id":"54e9d7c1-1345-5e2d-ba67-93201e1134e8","uuid":"ce193f02-ba8e-447e-af88-18dbe1f4a097","timestamp":"2026-09-01T16:48:57.240Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-25iydU/repo/notebook/app.py","content":"\"\"\"Jupyter notebook application.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport typing as t\nfrom pathlib import Path\n\nfrom jupyter_client.utils import ensure_async  # type:ignore[attr-defined]\nfrom jupyter_core.application import base_aliases\nfrom jupyter_core.paths import jupyter_config_dir\nfrom jupyter_server.base.handlers import JupyterHandler\nfrom jupyter_server.extension.handler import (\n    ExtensionHandlerJinjaMixin,\n    ExtensionHandlerMixin,\n)\nfrom jupyter_server.serverapp import flags\nfrom jupyter_server.utils import url_escape, url_is_absolute\nfrom jupyter_server.utils import url_path_join as ujoin\nfrom jupyterlab.commands import (  # type:ignore[import-untyped]\n    get_app_dir,\n    get_user_settings_dir,\n    get_workspaces_dir,\n)\nfrom jupyterlab_server import LabServerApp\nfrom jupyterlab_server.config import (  # type:ignore[attr-defined]\n    LabConfig,\n    get_page_config,\n    recursive_update,\n)\nfrom jupyterlab_server.handlers import _camelCase, is_url\nfrom notebook_shim.shim import NotebookConfigShimMixin  # type:ignore[import-untyped]\nfrom tornado import web\nfrom traitlets import Bool, Unicode, default\nfrom traitlets.config.loader import Config\n\nfrom ._version import __version__\n\nHERE = Path(__file__).parent.resolve()\n\nFlags = dict[str | tuple[str, ...], tuple[dict[str, t.Any] | Config, str]]\n\napp_dir = Path(get_app_dir())\nversion = __version__\n\n# mypy: disable-error-code=\"no-untyped-call\"\n\n\nclass NotebookBaseHandler(ExtensionHandlerJinjaMixin, ExtensionHandlerMixin, JupyterHandler):\n    \"\"\"The base notebook API handler.\"\"\"\n\n    @property\n    def custom_css(self) -> t.Any:\n        return self.settings.get(\"custom_css\", True)\n\n    def get_page_config(self) -> dict[str, t.Any]:\n        \"\"\"Get the page config.\"\"\"\n        config = LabConfig()\n        app: JupyterNotebookApp = self.extensionapp  # type:ignore[assignment]\n        base_url = self.settings.get(\"base_url\", \"/\")\n        page_config_data = self.settings.setdefault(\"page_config_data\", {})\n        page_config = {\n            **page_config_data,\n            \"appVersion\": version,\n            \"baseUrl\": self.base_url,\n            \"terminalsAvailable\": self.settings.get(\"terminals_available\", False),\n            \"token\": self.settings[\"token\"],\n            \"fullStaticUrl\": ujoin(self.base_url, \"static\", self.name),\n            \"frontendUrl\": ujoin(self.base_url, \"/\"),\n            \"exposeAppInBrowser\": app.expose_app_in_browser,\n        }\n\n        server_root = self.settings.get(\"server_root_dir\", \"\")\n        server_root = server_root.replace(os.sep, \"/\")\n        server_root = os.path.normpath(Path(server_root).expanduser())\n        try:\n            # Remove the server_root from pref dir\n            if self.serverapp.preferred_dir != server_root:\n                page_config[\"preferredPath\"] = \"/\" + os.path.relpath(\n                    self.serverapp.preferred_dir, server_root\n                )\n            else:\n                page_config[\"preferredPath\"] = \"/\"\n        except Exception:  # noqa: BLE001\n            page_config[\"preferredPath\"] = \"/\"\n\n        mathjax_config = self.settings.get(\"mathjax_config\", \"TeX-AMS_HTML-full,Safe\")\n        # TODO Remove CDN usage.\n        mathjax_url = self.settings.get(\n            \"mathjax_url\",\n            \"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js\",\n        )\n        if not url_is_absolute(mathjax_url) and not mathjax_url.startswith(self.base_url):\n            mathjax_url = ujoin(self.base_url, mathjax_url)\n\n        page_config.setdefault(\"mathjaxConfig\", mathjax_config)\n        page_config.setdefault(\"fullMathjaxUrl\", mathjax_url)\n        page_config.setdefault(\"jupyterConfigDir\", jupyter_config_dir())\n\n        # Put all our config in page_config\n        for name in config.trait_names():\n            page_config[_camelCase(name)] = getattr(app, name)\n\n        # Add full versions of all the urls\n        for name in config.trait_names():\n            if not name.endswith(\"_url\"):\n                continue\n            full_name = _camelCase(\"full_\" + name)\n            full_url = getattr(app, name)\n            if not is_url(full_url):\n                # Relative URL will be prefixed with base_url\n                full_url = ujoin(base_url, full_url)\n            page_config[full_name] = full_url\n\n        labextensions_path = app.extra_labextensions_path + app.labextensions_path\n        recursive_update(\n            page_config,\n            get_page_config(\n                labextensions_path,\n                logger=self.log,\n            ),\n        )\n\n        # modify page config with custom hook\n        page_config_hook = self.settings.get(\"page_config_hook\", None)\n        if page_config_hook:\n            page_config = page_config_hook(self, page_config)\n\n        return page_config\n\n\nclass TreeHandler(NotebookBaseHandler):\n    \"\"\"A tree page handler.\"\"\"\n\n    @web.authenticated\n    async def get(self, path: str = \"\") -> None:\n        \"\"\"\n        Display appropriate page for given path.\n\n        - A directory listing is shown if path is a directory\n        - Redirected to notebook page if path is a notebook\n        - Render the raw file if path is any other file\n        \"\"\"\n        path = path.strip(\"/\")\n        cm = self.contents_manager\n\n        if await ensure_async(cm.dir_exists(path=path)):\n            if await ensure_async(cm.is_hidden(path)) and not cm.allow_hidden:\n                self.log.info(\"Refusing to serve hidden directory, via 404 Error\")\n                raise web.HTTPError(404)\n\n            # Set treePath for routing to the directory\n            page_config = self.get_page_config()\n            page_config[\"treePath\"] = path\n\n            tpl = self.render_template(\"tree.html\", page_config=page_config)\n            return self.write(tpl)\n        if await ensure_async(cm.file_exists(path)):\n            # it's not a directory, we have redirecting to do\n            model = await ensure_async(cm.get(path, content=False))\n            if model[\"type\"] == \"notebook\":\n                url = ujoin(self.base_url, \"notebooks\", url_escape(path))\n            else:\n                # Return raw content if file is not a notebook\n                url = ujoin(self.base_url, \"files\", url_escape(path))\n            self.log.debug(\"Redirecting %s to %s\", self.request.path, url)\n            self.redirect(url)\n            return None\n        raise web.HTTPError(404)\n\n\nclass ConsoleHandler(NotebookBaseHandler):\n    \"\"\"A console page handler.\"\"\"\n\n    @web.authenticated\n    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n        \"\"\"Get the console page.\"\"\"\n        tpl = self.render_template(\"consoles.html\", page_config=self.get_page_config())\n        return self.write(tpl)\n\n\nclass TerminalHandler(NotebookBaseHandler):\n    \"\"\"A terminal page handler.\"\"\"\n\n    @web.authenticated\n    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n        \"\"\"Get the terminal page.\"\"\"\n        tpl = self.render_template(\"terminals.html\", page_config=self.get_page_config())\n        return self.write(tpl)\n\n\nclass FileHandler(NotebookBaseHandler):\n    \"\"\"A file page handler.\"\"\"\n\n    @web.authenticated\n    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n        \"\"\"Get the file page.\"\"\"\n        tpl = self.render_template(\"edit.html\", page_config=self.get_page_config())\n        return self.write(tpl)\n\n\nclass NotebookHandler(NotebookBaseHandler):\n    \"\"\"A notebook page handler.\"\"\"\n\n    @web.authenticated\n    async def get(self, path: str = \"\") -> t.Any:\n        \"\"\"Get the notebook page. Redirect if it's a directory.\"\"\"\n        path = path.strip(\"/\")\n        cm = self.contents_manager\n\n        if await ensure_async(cm.dir_exists(path=path)):\n            url = ujoin(self.base_url, \"tree\", url_escape(path))\n            self.log.debug(\"Redirecting %s to %s since path is a directory\", self.request.path, url)\n            self.redirect(url)\n            return None\n        tpl = self.render_template(\"notebooks.html\", page_config=self.get_page_config())\n        return self.write(tpl)\n\n\nclass CustomCssHandler(NotebookBaseHandler):\n    \"\"\"A custom CSS handler.\"\"\"\n\n    @web.authenticated\n    def get(self) -> t.Any:\n        \"\"\"Get the custom css file.\"\"\"\n\n        self.set_header(\"Content-Type\", \"text/css\")\n        page_config = self.get_page_config()\n        custom_css_file = f\"{page_config['jupyterConfigDir']}/custom/custom.css\"\n\n        if not Path(custom_css_file).is_file():\n            static_path_root = re.match(\"^(.*?)static\", page_config[\"staticDir\"])\n            if static_path_root is not None:\n                custom_dir = static_path_root.groups()[0]\n                custom_css_file = f\"{custom_dir}custom/custom.css\"\n\n        with Path(custom_css_file).open() as css_f:\n            return self.write(css_f.read())\n\n\naliases = dict(base_aliases)\n\n\nclass JupyterNotebookApp(NotebookConfigShimMixin, LabServerApp):  # type:ignore[misc]\n    \"\"\"The notebook server extension app.\"\"\"\n\n    name = \"notebook\"\n    app_name = \"Jupyter Notebook\"\n    description = \"Jupyter Notebook - A web-based notebook environment for interactive computing\"\n    version = version\n    app_version = Unicode(version, help=\"The version of the application.\")\n    extension_url = \"/\"\n    default_url = Unicode(\"/tree\", config=True, help=\"The default URL to redirect to from `/`\")\n    file_url_prefix = \"/tree\"\n    load_other_extensions = True\n    app_dir = app_dir\n    subcommands: dict[str, t.Any] = {}\n\n    expose_app_in_browser = Bool(\n        False,\n        config=True,\n        help=\"Whether to expose the global app instance to browser via window.jupyterapp\",\n    )\n\n    custom_css = Bool(\n        True,\n        config=True,\n        help=\"\"\"Whether custom CSS is loaded on the page.\n        Defaults to True and custom CSS is loaded.\n        \"\"\",\n    )\n\n    flags: Flags = {**flags}  # type:ignore[assignment]\n    flags[\"expose-app-in-browser\"] = (\n        {\"JupyterNotebookApp\": {\"expose_app_in_browser\": True}},\n        \"Expose the global app instance to browser via window.jupyterapp.\",\n    )\n\n    flags[\"custom-css\"] = (\n        {\"JupyterNotebookApp\": {\"custom_css\": True}},\n        \"Load custom CSS in template html files. Default is True\",\n    )\n\n    @default(\"static_dir\")\n    def _default_static_dir(self) -> str:\n        return str(HERE / \"static\")\n\n    @default(\"templates_dir\")\n    def _default_templates_dir(self) -> str:\n        return str(HERE / \"templates\")\n\n    @default(\"app_settings_dir\")\n    def _default_app_settings_dir(self) -> str:\n        return str(app_dir / \"settings\")\n\n    @default(\"schemas_dir\")\n    def _default_schemas_dir(self) -> str:\n        return str(app_dir / \"schemas\")\n\n    @default(\"themes_dir\")\n    def _default_themes_dir(self) -> str:\n        return str(app_dir / \"themes\")\n\n    @default(\"user_settings_dir\")\n    def _default_user_settings_dir(self) -> str:\n        return t.cast(str, get_user_settings_dir())\n\n    @default(\"workspaces_dir\")\n    def _default_workspaces_dir(self) -> str:\n        return t.cast(str, get_workspaces_dir())\n\n    def _prepare_templates(self) -> None:\n        super(LabServerApp, self)._prepare_templates()\n        self.jinja2_env.globals.update(custom_css=self.custom_css)  # type:ignore[has-type]\n\n    def server_extension_is_enabled(self, extension: str) -> bool:\n        \"\"\"Check if server extension is enabled.\"\"\"\n        if self.serverapp is None:\n            return False\n        try:\n            extension_enabled = (\n                self.serverapp.extension_manager.extensions[extension].enabled is True\n            )\n        except (AttributeError, KeyError, TypeError):\n            extension_enabled = False\n        return extension_enabled\n\n    def initialize_handlers(self) -> None:\n        \"\"\"Initialize handlers.\"\"\"\n        assert self.serverapp is not None  # noqa: S101\n        page_config = self.serverapp.web_app.settings.setdefault(\"page_config_data\", {})\n        nbclassic_enabled = self.server_extension_is_enabled(\"nbclassic\")\n        page_config[\"nbclassic_enabled\"] = nbclassic_enabled\n\n        # If running under JupyterHub, add more metadata.\n        if \"hub_prefix\" in self.serverapp.tornado_settings:\n            tornado_settings = self.serverapp.tornado_settings\n            hub_prefix = tornado_settings[\"hub_prefix\"]\n            page_config[\"hubPrefix\"] = hub_prefix\n            page_config[\"hubHost\"] = tornado_settings[\"hub_host\"]\n            page_config[\"hubUser\"] = tornado_settings[\"user\"]\n            page_config[\"shareUrl\"] = ujoin(hub_prefix, \"user-redirect\")\n            # Assume the server_name property indicates running JupyterHub 1.0.\n            if hasattr(self.serverapp, \"server_name\"):\n                page_config[\"hubServerName\"] = self.serverapp.server_name\n            # avoid setting API token in page config\n            # $JUPYTERHUB_API_TOKEN identifies the server, not the client\n            # but at least make sure we don't use the token\n            # if the serverapp set one\n            page_config[\"token\"] = \"\"\n\n        self.handlers.append((\"/tree(.*)\", TreeHandler))\n        self.handlers.append((\"/notebooks(.*)\", NotebookHandler))\n        self.handlers.append((\"/edit(.*)\", FileHandler))\n        self.handlers.append((\"/consoles/(.*)\", ConsoleHandler))\n        self.handlers.append((\"/terminals/(.*)\", TerminalHandler))\n        self.handlers.append((\"/custom/custom.css\", CustomCssHandler))\n        super().initialize_handlers()\n\n    def initialize(self, argv: list[str] | None = None) -> None:  # noqa: ARG002\n        \"\"\"Subclass because the ExtensionApp.initialize() method does not take arguments\"\"\"\n        super().initialize()\n\n\nmain = launch_new_instance = JupyterNotebookApp.launch_instance\n\nif __name__ == \"__main__\":\n    main()\n","numLines":370,"startLine":1,"totalLines":370}}}
