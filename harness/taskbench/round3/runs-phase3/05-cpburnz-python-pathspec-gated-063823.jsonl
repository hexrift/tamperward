code or byte string.\")\n67\t\n68\t\t\t# Reference: https://git-scm.com/docs/gitignore#_pattern_format\n69\t\t\tout_string = ''.join((f\"\\\\{x}\" if x in '\\\\[]!*#?' else x) for x in string)\n70\t\n71\t\t\tif return_type is bytes:\n72\t\t\t\tout_bytes = out_string.encode(_BYTES_ENCODING)\n73\t\t\t\treturn out_bytes  # type: ignore[return-value]\n74\t\t\telse:\n75\t\t\t\treturn out_string  # type: ignore[return-value]\n76\t\n77\t\t@staticmethod\n78\t\tdef _translate_segment_glob(\n79\t\t\tpattern: str,\n80\t\t\trange_error: Literal['literal', 'raise'],\n81\t\t) -> str:\n82\t\t\t\"\"\"\n83\t\t\tTranslates the glob pattern to a regular expression. This is used in the\n84\t\t\tconstructor to translate a path segment glob pattern to its corresponding\n85\t\t\tregular expression.\n86\t\n87\t\t\t*pattern* (:class:`str`) is the glob pattern.\n88\t\n89\t\t\t*range_error* (:class:`int`) is how to handle invalid range notation in the\n90\t\t\tpattern:\n91\t\n92\t\t\t-\t:data:`\"literal\"`: Invalid notation will be treated as a literal string.\n93\t\n94\t\t\t-\t:data:`\"raise\"`: Invalid notation will cause a :class:`_RangeError` to be\n95\t\t\t\traised.\n96\t\n97\t\t\tReturns the regular expression (:class:`str`).\n98\t\t\t\"\"\"\n99\t\t\t# NOTE: This is derived from `fnmatch.translate()` and is similar to the\n100\t\t\t# POSIX function `fnmatch()` with the `FNM_PATHNAME` flag set.\n101\t\n102\t\t\tescape = False\n103\t\t\tregex = ''\n104\t\t\ti, end = 0, len(pattern)\n105\t\t\twhile i < end:\n106\t\t\t\t# Get next character.\n107\t\t\t\tchar = pattern[i]\n108\t\t\t\ti += 1\n109\t\n110\t\t\t\tif escape:\n111\t\t\t\t\t# Escape the character.\n112\t\t\t\t\tescape = False\n113\t\t\t\t\tregex += re.escape(char)\n114\t\n115\t\t\t\telif char == '\\\\':\n116\t\t\t\t\t# Escape character, escape next character.\n117\t\t\t\t\tescape = True\n118\t\n119\t\t\t\telif char == '*':\n120\t\t\t\t\t# Multi-character wildcard. Match any string (except slashes), including\n121\t\t\t\t\t# an empty string.\n122\t\t\t\t\tregex += '[^/]*'\n123\t\n124\t\t\t\telif char == '?':\n125\t\t\t\t\t# Single-character wildcard. Match any single character (except a\n126\t\t\t\t\t# slash).\n127\t\t\t\t\tregex += '[^/]'\n128\t\n129\t\t\t\telif char == '[':\n130\t\t\t\t\t# Bracket expression (range notation) wildcard. Except for the beginning\n131\t\t\t\t\t# exclamation mark, the whole bracket expression can be used directly as\n132\t\t\t\t\t# regex, but we have to find where the expression ends.\n133\t\t\t\t\t# - \"[][!]\" matches ']', '[' and '!'.\n134\t\t\t\t\t# - \"[]-]\" matches ']' and '-'.\n135\t\t\t\t\t# - \"[!]a-]\" matches any character except ']', 'a' and '-'.\n136\t\t\t\t\tj = i\n137\t\n138\t\t\t\t\t# Pass bracket expression negation.\n139\t\t\t\t\tif j < end and (pattern[j] == '!' or pattern[j] == '^'):\n140\t\t\t\t\t\tj += 1\n141\t\n142\t\t\t\t\t# Pass first closing bracket if it is at the beginning of the\n143\t\t\t\t\t# expression.\n144\t\t\t\t\tif j < end and pattern[j] == ']':\n145\t\t\t\t\t\tj += 1\n146\t\n147\t\t\t\t\t# Find closing bracket. Stop once we reach the end or find it.\n148\t\t\t\t\twhile j < end and pattern[j] != ']':\n149\t\t\t\t\t\tj += 1\n150\t\n151\t\t\t\t\tif j < end:\n152\t\t\t\t\t\t# Found end of bracket expression. Increment j to be one past the\n153\t\t\t\t\t\t# closing bracket:\n154\t\t\t\t\t\t#\n155\t\t\t\t\t\t#  [...]\n156\t\t\t\t\t\t#   ^   ^\n157\t\t\t\t\t\t#   i   j\n158\t\t\t\t\t\t#\n159\t\t\t\t\t\tj += 1\n160\t\t\t\t\t\texpr = '['\n161\t\n162\t\t\t\t\t\tif pattern[i] == '!':\n163\t\t\t\t\t\t\t# Bracket expression needs to be negated.\n164\t\t\t\t\t\t\texpr += '^'\n165\t\t\t\t\t\t\ti += 1\n166\t\t\t\t\t\telif pattern[i] == '^':\n167\t\t\t\t\t\t\t# POSIX declares that the regex bracket expression negation \"[^...]\"\n168\t\t\t\t\t\t\t# is undefined in a glob pattern. Python's `fnmatch.translate()`\n169\t\t\t\t\t\t\t# escapes the caret ('^') as a literal. Git supports the using a\n170\t\t\t\t\t\t\t# caret for negation. Maintain consistency with Git because that is\n171\t\t\t\t\t\t\t# the expected behavior.\n172\t\t\t\t\t\t\texpr += '^'\n173\t\t\t\t\t\t\ti += 1\n174\t\n175\t\t\t\t\t\t# Build regex bracket expression. Escape slashes so they are treated\n176\t\t\t\t\t\t# as literal slashes by regex as defined by POSIX.\n177\t\t\t\t\t\texpr += pattern[i:j].replace('\\\\', '\\\\\\\\')\n178\t\n179\t\t\t\t\t\tif range_error == 'raise':\n180\t\t\t\t\t\t\ttry:\n181\t\t\t\t\t\t\t\tre.compile(expr)\n182\t\t\t\t\t\t\texcept re.error as e:\n183\t\t\t\t\t\t\t\traise _RangeError((\n184\t\t\t\t\t\t\t\t\tf\"Invalid range notation={pattern[i:j]!r} found in \"\n185\t\t\t\t\t\t\t\t\tf\"pattern={pattern!r}.\"\n186\t\t\t\t\t\t\t\t)) from e\n187\t\n188\t\t\t\t\t\t# Add regex bracket expression to regex result.\n189\t\t\t\t\t\tregex += expr\n190\t\n191\t\t\t\t\t\t# Set i to one past the closing bracket.\n192\t\t\t\t\t\ti = j\n193\t\n194\t\t\t\t\telse:\n195\t\t\t\t\t\t# Failed to find closing bracket.\n196\t\t\t\t\t\tif range_error == 'literal':\n197\t\t\t\t\t\t\t# Treat opening bracket as a bracket literal instead of as an\n198\t\t\t\t\t\t\t# expression.\n199\t\t\t\t\t\t\tregex += '\\\\['\n200\t\t\t\t\t\telif range_error == 'raise':\n201\t\t\t\t\t\t\t# Treat invalid range notation as an error.\n202\t\t\t\t\t\t\traise _RangeError((\n203\t\t\t\t\t\t\t\tf\"Invalid range notation={pattern[i:j]!r} found in pattern=\"\n204\t\t\t\t\t\t\t\tf\"{pattern!r}.\"\n205\t\t\t\t\t\t\t))\n206\t\t\t\t\t\telse:\n207\t\t\t\t\t\t\tassert_unreachable(f\"{range_error=!r} is invalid.\")\n208\t\n209\t\t\t\telse:\n210\t\t\t\t\t# Regular character, escape it for regex.\n211\t\t\t\t\tregex += re.escape(char)\n212\t\n213\t\t\tif escape:\n214\t\t\t\traise ValueError((\n215\t\t\t\t\tf\"Escape character found with no next character to escape: {pattern!r}\"\n216\t\t\t\t))  # ValueError\n217\t\n218\t\t\treturn regex\n219\t\n220\t\n221\tclass GitIgnorePatternError(ValueError):\n222\t\t\"\"\"\n223\t\tThe :class:`GitIgnorePatternError` class indicates