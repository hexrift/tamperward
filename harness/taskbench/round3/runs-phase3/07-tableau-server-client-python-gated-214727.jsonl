              )\n505\t            return user\n506\t\n507\t        # Read through an entire CSV file meant for user import\n508\t        # Return the number of valid lines and a list of all the invalid lines\n509\t        @staticmethod\n510\t        def validate_file_for_import(csv_file: io.TextIOWrapper, logger) -> tuple[int, list[str]]:\n511\t            num_valid_lines = 0\n512\t            invalid_lines = []\n513\t            csv_file.seek(0)  # set to start of file in case it has been read earlier\n514\t            line: str = csv_file.readline()\n515\t            while line and line != \"\":\n516\t                try:\n517\t                    # do not print passwords\n518\t                    logger.info(f\"Reading user {line[:4]}\")\n519\t                    UserItem.CSVImport._validate_import_line_or_throw(line, logger)\n520\t                    num_valid_lines += 1\n521\t                except Exception as exc:\n522\t                    logger.info(f\"Error parsing {line[:4]}: {exc}\")\n523\t                    invalid_lines.append(line)\n524\t                line = csv_file.readline()\n525\t            return num_valid_lines, invalid_lines\n526\t\n527\t        # Some fields in the import file are restricted to specific values\n528\t        # Iterate through each field and validate the given value against hardcoded constraints\n529\t        @staticmethod\n530\t        def _validate_import_line_or_throw(incoming, logger) -> None:\n531\t            # AUTH column's valid set is derived from _AUTH_CANONICAL so there's\n532\t            # one source of truth for the accepted values.\n533\t            _valid_attributes: list[list[str]] = [\n534\t                [],\n535\t                [],\n536\t                [],\n537\t                [\"creator\", \"explorer\", \"viewer\", \"unlicensed\"],  # license\n538\t                [\"system\", \"site\", \"none\", \"no\"],  # admin\n539\t                [\"yes\", \"true\", \"1\", \"no\", \"false\", \"0\"],  # publishe