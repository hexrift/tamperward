{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EXqeMA9RzfhjbixbaNj9Zt","type":"tool_result","content":"1\t\"\"\"AMQP Channels.\"\"\"\n2\t# Copyright (C) 2007-2008 Barry Pederson <bp@barryp.org>\n3\t\n4\timport logging\n5\timport socket\n6\tfrom collections import defaultdict\n7\tfrom queue import Queue\n8\t\n9\tfrom vine import ensure_promise\n10\t\n11\tfrom . import spec\n12\tfrom .abstract_channel import AbstractChannel\n13\tfrom .exceptions import (ChannelError, ConsumerCancelled, MessageNacked,\n14\t                         RecoverableChannelError, RecoverableConnectionError,\n15\t                         error_for_code)\n16\tfrom .protocol import queue_declare_ok_t\n17\t\n18\t__all__ = ('Channel',)\n19\t\n20\tAMQP_LOGGER = logging.getLogger('amqp')\n21\t\n22\tREJECTED_MESSAGE_WITHOUT_CALLBACK = \"\"\"\\\n23\tRejecting message with delivery tag %r for reason of having no callbacks.\n24\tconsumer_tag=%r exchange=%r routing_key=%r.\\\n25\t\"\"\"\n26\t\n27\t\n28\tclass VDeprecationWarning(DeprecationWarning):\n29\t    pass\n30\t\n31\t\n32\tclass Channel(AbstractChannel):\n33\t    \"\"\"AMQP Channel.\n34\t\n35\t    The channel class provides methods for a client to establish a\n36\t    virtual connection - a channel - to a server and for both peers to\n37\t    operate the virtual connection thereafter.\n38\t\n39\t    GRAMMAR::\n40\t\n41\t        channel             = open-channel *use-channel close-channel\n42\t        open-channel        = C:OPEN S:OPEN-OK\n43\t        use-channel         = C:FLOW S:FLOW-OK\n44\t                            / S:FLOW C:FLOW-OK\n45\t                            / functional-class\n46\t        close-channel       = C:CLOSE S:CLOSE-OK\n47\t                            / S:CLOSE C:CLOSE-OK\n48\t\n49\t    Create a channel bound to a connection and using the specified\n50\t    numeric channel_id, and open on the server.\n51\t\n52\t    The 'auto_decode' parameter (defaults to True), indicates\n53\t    whether the l