{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014wD5eKMfQzjGmPwk95Sp2Z","type":"tool_result","content":"1\t\"\"\"\n2\tgspread.exceptions\n3\t~~~~~~~~~~~~~~~~~~\n4\t\n5\tExceptions used in gspread.\n6\t\n7\t\"\"\"\n8\t\n9\tfrom typing import Any, Mapping\n10\t\n11\tfrom requests import Response\n12\t\n13\t\n14\tclass UnSupportedExportFormat(Exception):\n15\t    \"\"\"Raised when export format is not supported.\"\"\"\n16\t\n17\t\n18\tclass GSpreadException(Exception):\n19\t    \"\"\"A base class for gspread's exceptions.\"\"\"\n20\t\n21\t\n22\tclass WorksheetNotFound(GSpreadException):\n23\t    \"\"\"Trying to open non-existent or inaccessible worksheet.\"\"\"\n24\t\n25\t\n26\tclass NoValidUrlKeyFound(GSpreadException):\n27\t    \"\"\"No valid key found in URL.\"\"\"\n28\t\n29\t\n30\tclass IncorrectCellLabel(GSpreadException):\n31\t    \"\"\"The cell label is incorrect.\"\"\"\n32\t\n33\t\n34\tclass InvalidInputValue(GSpreadException):\n35\t    \"\"\"The provided values is incorrect.\"\"\"\n36\t\n37\t\n38\tclass APIError(GSpreadException):\n39\t    \"\"\"Errors coming from the API itself,\n40\t    such as when we attempt to retrieve things that don't exist.\"\"\"\n41\t\n42\t    def __init__(self, response: Response):\n43\t        try:\n44\t            error = response.json()[\"error\"]\n45\t        except Exception as e:\n46\t            # in case we failed to parse the error from the API\n47\t            # build an empty error object to notify the caller\n48\t            # and keep the exception raise flow running\n49\t\n50\t            error = {\n51\t                \"code\": -1,\n52\t                \"message\": response.text,\n53\t                \"status\": \"invalid JSON: '{}'\".format(e),\n54\t            }\n55\t\n56\t        super().__init__(error)\n57\t        self.response: Response = response\n58\t        self.error: Mapping[str, Any] = error\n59\t        self.code: int = self.error[\"code\"]\n60\t\n61\t    def __str__(self) -> str:\n62\t        return \"{}: [{}]: {}\".format(\n63\t            self.__class__.__name__, self.code, self.error[\"message\"]\n64\t        )\n65\t\n66\t    def __repr__(self) -> str:\n67\t        return self.__str__()\n68\t\n69\t    def __reduce__(self) -> tuple:\n70\t        return self.__class__, (self.response,)\n71\t\n72\t\n73\tclass SpreadsheetNotFound(GSpreadException):\n74\t    \"\"\"Trying to open non-existent or inaccessible spreadsheet.\"\"\"\n75\t"}]},"parent_tool_use_id":null,"session_id":"54e9d7c1-1345-5e2d-ba67-93201e1134e8","uuid":"0351b1a2-7147-4e63-bfeb-da9c12a5091c","timestamp":"2026-09-01T06:28:39.062Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-TX6ZNy/repo/gspread/exceptions.py","content":"\"\"\"\ngspread.exceptions\n~~~~~~~~~~~~~~~~~~\n\nExceptions used in gspread.\n\n\"\"\"\n\nfrom typing import Any, Mapping\n\nfrom requests import Response\n\n\nclass UnSupportedExportFormat(Exception):\n    \"\"\"Raised when export format is not supported.\"\"\"\n\n\nclass GSpreadException(Exception):\n    \"\"\"A base class for gspread's exceptions.\"\"\"\n\n\nclass WorksheetNotFound(GSpreadException):\n    \"\"\"Trying to open non-existent or inaccessible worksheet.\"\"\"\n\n\nclass NoValidUrlKeyFound(GSpreadException):\n    \"\"\"No valid key found in URL.\"\"\"\n\n\nclass IncorrectCellLabel(GSpreadException):\n    \"\"\"The cell label is incorrect.\"\"\"\n\n\nclass InvalidInputValue(GSpreadException):\n    \"\"\"The provided values is incorrect.\"\"\"\n\n\nclass APIError(GSpreadException):\n    \"\"\"Errors coming from the API itself,\n    such as when we attempt to retrieve things that don't exist.\"\"\"\n\n    def __init__(self, response: Response):\n        try:\n            error = response.json()[\"error\"]\n        except Exception as e:\n            # in case we failed to parse the error from the API\n            # build an empty error object to notify the caller\n            # and keep the exception raise flow running\n\n            error = {\n                \"code\": -1,\n                \"message\": response.text,\n                \"status\": \"invalid JSON: '{}'\".format(e),\n            }\n\n        super().__init__(error)\n        self.response: Response = response\n        self.error: Mapping[str, Any] = error\n        self.code: int = self.error[\"code\"]\n\n    def __str__(self) -> str:\n        return \"{}: [{}]: {}\".format(\n            self.__class__.__name__, self.code, self.error[\"message\"]\n        )\n\n    def __repr__(self) -> str:\n        return self.__str__()\n\n    def __reduce__(self) -> tuple:\n        return self.__class__, (self.response,)\n\n\nclass SpreadsheetNotFound(GSpreadException):\n    \"\"\"Trying to open non-existent or inaccessible spreadsheet.\"\"\"\n","numLines":75,"startLine":1,"totalLines":75}}}
