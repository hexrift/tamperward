{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PXu21Vk8hFENTSa1ZERLqa","type":"tool_result","content":"1\t\"\"\"\n2\tgspread.http_client\n3\t~~~~~~~~~~~~~~\n4\t\n5\tThis module contains HTTPClient class responsible for communicating with\n6\tGoogle API.\n7\t\n8\t\"\"\"\n9\t\n10\timport time\n11\tfrom http import HTTPStatus\n12\tfrom json import dumps as json_dumps\n13\tfrom typing import (\n14\t    IO,\n15\t    Any,\n16\t    Callable,\n17\t    Dict,\n18\t    List,\n19\t    Mapping,\n20\t    MutableMapping,\n21\t    Optional,\n22\t    Tuple,\n23\t    Type,\n24\t    Union,\n25\t)\n26\t\n27\tfrom google.auth.credentials import Credentials\n28\tfrom google.auth.exceptions import RefreshError\n29\tfrom google.auth.transport.requests import AuthorizedSession\n30\tfrom requests import Response, Session\n31\t\n32\tfrom .exceptions import APIError, UnSupportedExportFormat\n33\tfrom .urls import (\n34\t    DRIVE_FILES_API_V3_URL,\n35\t    DRIVE_FILES_UPLOAD_API_V2_URL,\n36\t    SPREADSHEET_BATCH_UPDATE_URL,\n37\t    SPREADSHEET_SHEETS_COPY_TO_URL,\n38\t    SPREADSHEET_URL,\n39\t    SPREADSHEET_VALUES_APPEND_URL,\n40\t    SPREADSHEET_VALUES_BATCH_CLEAR_URL,\n41\t    SPREADSHEET_VALUES_BATCH_UPDATE_URL,\n42\t    SPREADSHEET_VALUES_BATCH_URL,\n43\t    SPREADSHEET_VALUES_CLEAR_URL,\n44\t    SPREADSHEET_VALUES_URL,\n45\t)\n46\tfrom .utils import ExportFormat, convert_credentials, quote\n47\t\n48\tParamsType = MutableMapping[str, Optional[Union[str, int, bool, float, List[str]]]]\n49\tDefaultSerializerType = Optional[Callable[[Any], Any]]\n50\t\n51\tFileType = Optional[\n52\t    Union[\n53\t        MutableMapping[str, IO[Any]],\n54\t        MutableMapping[str, Tuple[str, IO[Any]]],\n55\t        MutableMapping[str, Tuple[str, IO[Any], str]],\n56\t        MutableMapping[str, Tuple[str, IO[Any], str, MutableMapping[str, str]]],\n57\t    ]\n58\t]\n59\t\n60\t\n61\tclass HTTPClient:\n62\t    \"\"\"An instance of this class communicates with Google API.\n63\t\n64\t    :param Credentials auth: An instance of google.auth.Credentials used to authenticate requests\n65\t        created by either:\n66\t\n67\t        * gspread.auth.oauth()\n68\t        * gspread.auth.oauth_from_dict()\n69\t        * gspread.auth.service_account()\n70\t        * gspread.auth.service_account_from_dict()\n71\t\n72\t    :param Session session: (Optional) An OAuth2 credential object. Credential objects\n73\t        created by `google-auth <https://github.com/googleapis/google-auth-library-python>`_.\n74\t\n75\t        You can pass you own Session object, simply pass ``auth=None`` and ``session=my_custom_session``.\n76\t\n77\t    This class is not intended to be created manually.\n78\t    It will be created by the gspread.Client class.\n79\t    \"\"\"\n80\t\n81\t    def __init__(self, auth: Credentials, session: Optional[Session] = None) -> None:\n82\t        if session is not None:\n83\t            self.session = session\n84\t        else:\n85\t            self.auth: Credentials = convert_credentials(auth)\n86\t            self.session = AuthorizedSession(self.auth)\n87\t\n88\t        self.timeout: Optional[Union[float, Tuple[float, float]]] = None\n89\t\n90\t    def login(self) -> None:\n91\t        from google.auth.transport.requests import Request\n92\t\n93\t        self.auth.refresh(Request(self.session))\n94\t\n95\t        self.session.headers.update({\"Authorization\": \"Bearer %s\" % self.auth.token})\n96\t\n97\t    def set_timeout(self, timeout: Optional[Union[float, Tuple[float, float]]]) -> None:\n98\t        \"\"\"How long to wait for the server to send\n99\t        data before giving up, as a float, or a ``(connect timeout,\n100\t        read timeout)`` tuple.\n101\t\n102\t        Use value ``None`` to restore default timeout\n103\t\n104\t        Value for ``timeout`` is in seconds (s).\n105\t        \"\"\"\n106\t        self.timeout = timeout\n107\t\n108\t    def request(\n109\t        self,\n110\t        method: str,\n111\t        endpoint: str,\n112\t        params: Optional[ParamsType] = None,\n113\t        data: Optional[Union[str, bytes]] = None,\n114\t        json: Optional[Mapping[str, Any]] = None,\n115\t        files: FileType = None,\n116\t        headers: Optional[MutableMapping[str, str]] = None,\n117\t        default_serializer: DefaultSerializerType = None,\n118\t    ) -> Response:\n119\t        if default_serializer is not None and json is not None:\n120\t            data = json_dumps(dict(json), default=default_serializer)\n121\t            json = None\n122\t            headers = {**(headers or {}), \"Content-Type\": \"application/json\"}\n123\t        response = self.session.request(\n124\t            method=method,\n125\t            url=endpoint,\n126\t            json=dict(json) if json else None,\n127\t            params=params,\n128\t            data=data,\n129\t            files=files,\n130\t            headers=headers,\n131\t            timeout=self.timeout,\n132\t        )\n133\t\n134\t        if response.ok:\n135\t            return response\n136\t        else:\n137\t            raise APIError(response)\n138\t\n139\t    def batch_update(self, id: str, body: Optional[Mapping[str, Any]]) -> Any:\n140\t        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>:batchUpdate <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/batchUpdate>`_.\n141\t\n142\t        :param dict body: `Batch Update Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/batchUpdate#request-body>`_.\n143\t        :returns: `Batch Update Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/batchUpdate#response-body>`_.\n144\t        :rtype: dict\n145\t\n146\t        .. versionadded:: 3.0\n147\t        \"\"\"\n148\t        r = self.request(\"post\", SPREADSHEET_BATCH_UPDATE_URL % id, json=body)\n149\t\n150\t        return r.json()\n151\t\n152\t    def values_update(\n153\t        self,\n154\t        id: str,\n155\t        range: str,\n156\t        params: Optional[ParamsType] = None,\n157\t        body: Optional[Mapping[str, Any]] = None,\n158\t        default_serializer: DefaultSerializerType = None,\n159\t    ) -> Any:\n160\t        \"\"\"Lower-level method that directly calls `PUT spreadsheets/<ID>/values/<range> <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update>`_.\n161\t\n162\t        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to update.\n163\t        :param dict params: (optional) `Values Update Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update#query-parameters>`_.\n164\t        :param dict body: (optional) `Values Update Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update#request-body>`_.\n165\t        :returns: `Values Update Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update#response-body>`_.\n166\t        :rtype: dict\n167\t\n168\t        Example::\n169\t\n170\t            sh.values_update(\n171\t                'Sheet1!A2',\n172\t                params={\n173\t                    'valueInputOption': 'USER_ENTERED'\n174\t                },\n175\t                body={\n176\t                    'values': [[1, 2, 3]]\n177\t                }\n178\t            )\n179\t\n180\t        .. versionadded:: 3.0\n181\t        \"\"\"\n182\t        url = SPREADSHEET_VALUES_URL % (id, quote(range))\n183\t        r = self.request(\n184\t            \"put\", url, params=params, json=body, default_serializer=default_serializer\n185\t        )\n186\t        return r.json()\n187\t\n188\t    def values_append(\n189\t        self,\n190\t        id: str,\n191\t        range: str,\n192\t        params: ParamsType,\n193\t        body: Optional[Mapping[str, Any]],\n194\t        default_serializer: DefaultSerializerType = None,\n195\t    ) -> Any:\n196\t        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:append <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append>`_.\n197\t\n198\t        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_\n199\t                          of a range to search for a logical table of data. Values will be appended after the last row of the table.\n200\t        :param dict params: `Values Append Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append#query-parameters>`_.\n201\t        :param dict body: `Values Append Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append#request-body>`_.\n202\t        :returns: `Values Append Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append#response-body>`_.\n203\t        :rtype: dict\n204\t\n205\t        .. versionadded:: 3.0\n206\t        \"\"\"\n207\t        url = SPREADSHEET_VALUES_APPEND_URL % (id, quote(range))\n208\t        r = self.request(\n209\t            \"post\", url, params=params, json=body, default_serializer=default_serializer\n210\t        )\n211\t        return r.json()\n212\t\n213\t    def values_clear(self, id: str, range: str) -> Any:\n214\t        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:clear <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/clear>`_.\n215\t\n216\t        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to clear.\n217\t        :returns: `Values Clear Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/clear#response-body>`_.\n218\t        :rtype: dict\n219\t\n220\t        .. versionadded:: 3.0\n221\t        \"\"\"\n222\t        url = SPREADSHEET_VALUES_CLEAR_URL % (id, quote(range))\n223\t        r = self.request(\"post\", url)\n224\t        return r.json()\n225\t\n226\t    def values_batch_clear(\n227\t        self,\n228\t        id: str,\n229\t        params: Optional[ParamsType] = None,\n230\t        body: Optional[Mapping[str, Any]] = None,\n231\t    ) -> Any:\n232\t        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:batchClear`\n233\t\n234\t        :param dict params: (optional) `Values Batch Clear Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchClear#path-parameters>`_.\n235\t        :param dict body: (optional) `Values Batch Clear request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchClear#request-body>`_.\n236\t        :rtype: dict\n237\t        \"\"\"\n238\t        url = SPREADSHEET_VALUES_BATCH_CLEAR_URL % id\n239\t        r = self.request(\"post\", url, params=params, json=body)\n240\t        return r.json()\n241\t\n242\t    def values_get(\n243\t        self, id: str, range: str, params: Optional[ParamsType] = None\n244\t    ) -> Any:\n245\t        \"\"\"Lower-level method that directly calls `GET spreadsheets/<ID>/values/<range> <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/get>`_.\n246\t\n247\t        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to retrieve.\n248\t        :param dict params: (optional) `Values Get Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/get#query-parameters>`_.\n249\t        :returns: `Values Get Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/get#response-body>`_.\n250\t        :rtype: dict\n251\t\n252\t        .. versionadded:: 3.0\n253\t        \"\"\"\n254\t        url = SPREADSHEET_VALUES_URL % (id, quote(range))\n255\t        r = self.request(\"get\", url, params=params)\n256\t        return r.json()\n257\t\n258\t    def values_batch_get(\n259\t        self, id: str, ranges: List[str], params: Optional[ParamsType] = None\n260\t    ) -> Any:\n261\t        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:batchGet <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchGet>`_.\n262\t\n263\t        :param list ranges: List of ranges in the `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to retrieve.\n264\t        :param dict params: (optional) `Values Batch Get Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchGet#query-parameters>`_.\n265\t        :returns: `Values Batch Get Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchGet#response-body>`_.\n266\t        :rtype: dict\n267\t        \"\"\"\n268\t        if params is None:\n269\t            params = {}\n270\t\n271\t        params[\"ranges\"] = ranges\n272\t\n273\t        url = SPREADSHEET_VALUES_BATCH_URL % id\n274\t        r = self.request(\"get\", url, params=params)\n275\t        return r.json()\n276\t\n277\t    def values_batch_update(\n278\t        self,\n279\t        id: str,\n280\t        body: Optional[Mapping[str, Any]] = None,\n281\t        default_serializer: DefaultSerializerType = None,\n282\t    ) -> Any:\n283\t        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:batchUpdate <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchUpdate>`_.\n284\t\n285\t        :param dict body: (optional) `Values Batch Update Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchUpdate#request-body>`_.\n286\t        :returns: `Values Batch Update Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchUpdate#response-body>`_.\n287\t        :rtype: dict\n288\t        \"\"\"\n289\t        url = SPREADSHEET_VALUES_BATCH_UPDATE_URL % id\n290\t        r = self.request(\"post\", url, json=body, default_serializer=default_serializer)\n291\t        return r.json()\n292\t\n293\t    def spreadsheets_get(self, id: str, params: Optional[ParamsType] = None) -> Any:\n294\t        \"\"\"A method stub that directly calls `spreadsheets.get <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/get>`_.\"\"\"\n295\t        url = SPREADSHEET_URL % id\n296\t        r = self.request(\"get\", url, params=params)\n297\t        return r.json()\n298\t\n299\t    def spreadsheets_sheets_copy_to(\n300\t        self, id: str, sheet_id: int, destination_spreadsheet_id: str\n301\t    ) -> Any:\n302\t        \"\"\"Lower-level method that directly calls `spreadsheets.sheets.copyTo <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.sheets/copyTo>`_.\"\"\"\n303\t        url = SPREADSHEET_SHEETS_COPY_TO_URL % (id, sheet_id)\n304\t\n305\t        body = {\"destinationSpreadsheetId\": destination_spreadsheet_id}\n306\t        r = self.request(\"post\", url, json=body)\n307\t        return r.json()\n308\t\n309\t    def fetch_sheet_metadata(\n310\t        self, id: str, params: Optional[ParamsType] = None\n311\t    ) -> Mapping[str, Any]:\n312\t        \"\"\"Similar to :method spreadsheets_get:`gspread.http_client.spreadsheets_get`,\n313\t        get the spreadsheet from the API but by default **does not get the cells data**.\n314\t        It only retrieves the metadata from the spreadsheet.\n315\t\n316\t        :param str id: the spreadsheet ID key\n317\t        :param dict params: (optional) the HTTP params for the GET request.\n318\t            By default sets the parameter ``includeGridData`` to ``false``.\n319\t        :returns: The raw spreadsheet\n320\t        :rtype: dict\n321\t        \"\"\"\n322\t        if params is None:\n323\t            params = {\"includeGridData\": \"false\"}\n324\t\n325\t        url = SPREADSHEET_URL % id\n326\t\n327\t        r = self.request(\"get\", url, params=params)\n328\t\n329\t        return r.json()\n330\t\n331\t    def get_file_drive_metadata(self, id: str) -> Any:\n332\t        \"\"\"Get the metadata from the Drive API for a specific file\n333\t        This method is mainly here to retrieve the create/update time\n334\t        of a file (these metadata are only accessible from the Drive API).\n335\t        \"\"\"\n336\t\n337\t        url = DRIVE_FILES_API_V3_URL + \"/{}\".format(id)\n338\t\n339\t        params: ParamsType = {\n340\t            \"supportsAllDrives\": True,\n341\t            \"includeItemsFromAllDrives\": True,\n342\t            \"fields\": \"id,name,createdTime,modifiedTime\",\n343\t        }\n344\t\n345\t        res = self.request(\"get\", url, params=params)\n346\t\n347\t        return res.json()\n348\t\n349\t    def export(self, file_id: str, format: str = ExportFormat.PDF) -> bytes:\n350\t        \"\"\"Export the spreadsheet in the given format.\n351\t\n352\t        :param str file_id: The key of the spreadsheet to export\n353\t\n354\t        :param str format: The format of the resulting file.\n355\t            Possible values are:\n356\t\n357\t                * ``ExportFormat.PDF``\n358\t                * ``ExportFormat.EXCEL``\n359\t                * ``ExportFormat.CSV``\n360\t                * ``ExportFormat.OPEN_OFFICE_SHEET``\n361\t                * ``ExportFormat.TSV``\n362\t                * ``ExportFormat.ZIPPED_HTML``\n363\t\n364\t            See `ExportFormat`_ in the Drive API.\n365\t\n366\t        :type format: :class:`~gspread.utils.ExportFormat`\n367\t\n368\t        :returns bytes: The content of the exported file.\n369\t\n370\t        .. _ExportFormat: https://developers.google.com/drive/api/guides/ref-export-formats\n371\t        \"\"\"\n372\t\n373\t        if format not in ExportFormat:\n374\t            raise UnSupportedExportFormat\n375\t\n376\t        url = \"{}/{}/export\".format(DRIVE_FILES_API_V3_URL, file_id)\n377\t\n378\t        params: ParamsType = {\"mimeType\": format}\n379\t\n380\t        r = self.request(\"get\", url, params=params)\n381\t        return r.content\n382\t\n383\t    def insert_permission(\n384\t        self,\n385\t        file_id: str,\n386\t        email_address: Optional[str],\n387\t        perm_type: Optional[str],\n388\t        role: Optional[str],\n389\t        notify: bool = True,\n390\t        email_message: Optional[str] = None,\n391\t        with_link: bool = False,\n392\t    ) -> Response:\n393\t        \"\"\"Creates a new permission for a file.\n394\t\n395\t        :param str file_id: a spreadsheet ID (aka file ID).\n396\t        :param email_address: user or group e-mail address, domain name\n397\t            or None for 'anyone' type.\n398\t        :type email_address: str, None\n399\t        :param str perm_type: (optional) The account type.\n400\t            Allowed values are: ``user``, ``group``, ``domain``, ``anyone``\n401\t        :param str role: (optional) The primary role for this user.\n402\t            Allowed values are: ``owner``, ``writer``, ``reader``\n403\t        :param bool notify: Whether to send an email to the target\n404\t            user/domain. Default ``True``.\n405\t        :param str email_message: (optional) An email message to be sent\n406\t            if ``notify=True``.\n407\t        :param bool with_link: Whether the link is required for this\n408\t            permission to be active. Default ``False``.\n409\t\n410\t        :returns dict: the newly created permission\n411\t\n412\t        Examples::\n413\t\n414\t            # Give write permissions to otto@example.com\n415\t\n416\t            gc.insert_permission(\n417\t                '0BmgG6nO_6dprnRRUWl1UFE',\n418\t                'otto@example.org',\n419\t                perm_type='user',\n420\t                role='writer'\n421\t            )\n422\t\n423\t            # Make the spreadsheet publicly readable\n424\t\n425\t            gc.insert_permission(\n426\t                '0BmgG6nO_6dprnRRUWl1UFE',\n427\t                None,\n428\t                perm_type='anyone',\n429\t                role='reader'\n430\t            )\n431\t\n432\t        \"\"\"\n433\t        url = \"{}/{}/permissions\".format(DRIVE_FILES_API_V3_URL, file_id)\n434\t        payload = {\n435\t            \"type\": perm_type,\n436\t            \"role\": role,\n437\t            \"withLink\": with_link,\n438\t        }\n439\t        params: ParamsType = {\n440\t            \"supportsAllDrives\": \"true\",\n441\t        }\n442\t\n443\t        if perm_type == \"domain\":\n444\t            payload[\"domain\"] = email_address\n445\t        elif perm_type in {\"user\", \"group\"}:\n446\t            payload[\"emailAddress\"] = email_address\n447\t            params[\"sendNotificationEmail\"] = notify\n448\t            params[\"emailMessage\"] = email_message\n449\t        elif perm_type == \"anyone\":\n450\t            pass\n451\t        else:\n452\t            raise ValueError(\"Invalid permission type: {}\".format(perm_type))\n453\t\n454\t        return self.request(\"post\", url, json=payload, params=params)\n455\t\n456\t    def list_permissions(self, file_id: str) -> List[Dict[str, Union[str, bool]]]:\n457\t        \"\"\"Retrieve a list of permissions for a file.\n458\t\n459\t        :param str file_id: a spreadsheet ID (aka file ID).\n460\t        \"\"\"\n461\t        url = \"{}/{}/permissions\".format(DRIVE_FILES_API_V3_URL, file_id)\n462\t\n463\t        params: ParamsType = {\n464\t            \"supportsAllDrives\": True,\n465\t            \"fields\": \"nextPageToken,permissions\",\n466\t        }\n467\t\n468\t        token = \"\"\n469\t\n470\t        permissions = []\n471\t\n472\t        while token is not None:\n473\t            if token:\n474\t                params[\"pageToken\"] = token\n475\t\n476\t            r = self.request(\"get\", url, params=params).json()\n477\t            permissions.extend(r[\"permissions\"])\n478\t\n479\t            token = r.get(\"nextPageToken\", None)\n480\t\n481\t        return permissions\n482\t\n483\t    def remove_permission(self, file_id: str, permission_id: str) -> None:\n484\t        \"\"\"Deletes a permission from a file.\n485\t\n486\t        :param str file_id: a spreadsheet ID (aka file ID.)\n487\t        :param str permission_id: an ID for the permission.\n488\t        \"\"\"\n489\t        url = \"{}/{}/permissions/{}\".format(\n490\t            DRIVE_FILES_API_V3_URL, file_id, permission_id\n491\t        )\n492\t\n493\t        params: ParamsType = {\"supportsAllDrives\": True}\n494\t        self.request(\"delete\", url, params=params)\n495\t\n496\t    def import_csv(self, file_id: str, data: Union[str, bytes]) -> Any:\n497\t        \"\"\"Imports data into the first page of the spreadsheet.\n498\t\n499\t        :param str data: A CSV string of data.\n500\t\n501\t        Example:\n502\t\n503\t        .. code::\n504\t\n505\t            # Read CSV file contents\n506\t            content = open('file_to_import.csv', 'r').read()\n507\t\n508\t            gc.import_csv(spreadsheet.id, content)\n509\t\n510\t        .. note::\n511\t\n512\t           This method removes all other worksheets and then entirely\n513\t           replaces the contents of the first worksheet.\n514\t\n515\t        \"\"\"\n516\t        # Make sure we send utf-8\n517\t        if isinstance(data, str):\n518\t            data = data.encode(\"utf-8\")\n519\t\n520\t        headers = {\"Content-Type\": \"text/csv\"}\n521\t        url = \"{}/{}\".format(DRIVE_FILES_UPLOAD_API_V2_URL, file_id)\n522\t\n523\t        res = self.request(\n524\t            \"put\",\n525\t            url,\n526\t            data=data,\n527\t            params={\n528\t                \"uploadType\": \"media\",\n529\t                \"convert\": True,\n530\t                \"supportsAllDrives\": True,\n531\t            },\n532\t            headers=headers,\n533\t        )\n534\t\n535\t        return res.json()\n536\t\n537\t\n538\tclass BackOffHTTPClient(HTTPClient):\n539\t    \"\"\"BackOffHTTPClient is a http client with exponential\n540\t    backoff retries.\n541\t\n542\t    In case a request fails due to some API rate limits,\n543\t    it will wait for some time, then retry the request.\n544\t\n545\t    This can help by trying the request after some time and\n546\t    prevent the application from failing (by raising an APIError exception).\n547\t\n548\t    .. Warning::\n549\t        This HTTPClient is not production ready yet.\n550\t        Use it at your own risk !\n551\t\n552\t    .. note::\n553\t        To use with the `auth` module, make sure to pass this backoff\n554\t        http client using the ``http_client`` parameter of the\n555\t        method used.\n556\t\n557\t    .. note::\n558\t        Currently known issues are:\n559\t\n560\t        * will retry exponentially even when the error should\n561\t          raise instantly. Due to the Drive API that raises\n562\t          403 (Forbidden) errors for forbidden access and\n563\t          for api rate limit exceeded.\"\"\"\n564\t\n565\t    _HTTP_ERROR_CODES: List[HTTPStatus] = [\n566\t        HTTPStatus.REQUEST_TIMEOUT,  # in case of a timeout\n567\t        HTTPStatus.TOO_MANY_REQUESTS,  # sheet API usage rate limit exceeded\n568\t    ]\n569\t    _NR_BACKOFF: int = 0\n570\t    _MAX_BACKOFF: int = 128  # arbitrary maximum backoff\n571\t\n572\t    def request(self, *args: Any, **kwargs: Any) -> Response:\n573\t        # Check if we should retry the request\n574\t        def _should_retry(\n575\t            code: int,\n576\t            error: Mapping[str, Any],\n577\t            wait: int,\n578\t        ) -> bool:\n579\t            # Drive API return a dict object 'errors', the sheet API does not\n580\t            if \"errors\" in error:\n581\t                # Drive API returns a code 403 when reaching quotas/usage limits\n582\t                if (\n583\t                    code == HTTPStatus.FORBIDDEN\n584\t                    and error[\"errors\"][0][\"domain\"] == \"usageLimits\"\n585\t                ):\n586\t                    return True\n587\t\n588\t            # We retry if:\n589\t            #   - the return code is one of:\n590\t            #     - 429: too many requests\n591\t            #     - 408: request timeout\n592\t            #     - >= 500: some server error\n593\t            #   - AND we did not reach the max retry limit\n594\t            return (\n595\t                code in self._HTTP_ERROR_CODES\n596\t                or code >= HTTPStatus.INTERNAL_SERVER_ERROR\n597\t            ) and wait <= self._MAX_BACKOFF\n598\t\n599\t        try:\n600\t            return super().request(*args, **kwargs)\n601\t        except APIError as err:\n602\t            code = err.code\n603\t            error = err.error\n604\t\n605\t            self._NR_BACKOFF += 1\n606\t            wait = min(2**self._NR_BACKOFF, self._MAX_BACKOFF)\n607\t\n608\t            # check if error should retry\n609\t            if _should_retry(code, error, wait) is True:\n610\t                time.sleep(wait)\n611\t\n612\t                # make the request again\n613\t                response = self.request(*args, **kwargs)\n614\t\n615\t                # reset counters for next time\n616\t                self._NR_BACKOFF = 0\n617\t\n618\t                return response\n619\t\n620\t            # failed too many times, raise APIEerror\n621\t            self._NR_BACKOFF = 0\n622\t            raise err\n623\t        except RefreshError as err:\n624\t            self._NR_BACKOFF += 1\n625\t            wait = min(2**self._NR_BACKOFF, self._MAX_BACKOFF)\n626\t\n627\t            if wait <= self._MAX_BACKOFF:\n628\t                time.sleep(wait)\n629\t\n630\t                # make the request again\n631\t                response = self.request(*args, **kwargs)\n632\t\n633\t                # reset counters for next time\n634\t                self._NR_BACKOFF = 0\n635\t\n636\t                return response\n637\t\n638\t            # failed too many times, raise APIEerror\n639\t            self._NR_BACKOFF = 0\n640\t            raise err\n641\t\n642\t\n643\tHTTPClientType = Type[HTTPClient]\n644\t"}]},"parent_tool_use_id":null,"session_id":"54e9d7c1-1345-5e2d-ba67-93201e1134e8","uuid":"a7810a7d-daa5-4f68-a421-da3b49651119","timestamp":"2026-09-01T06:27:47.041Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-TX6ZNy/repo/gspread/http_client.py","content":"\"\"\"\ngspread.http_client\n~~~~~~~~~~~~~~\n\nThis module contains HTTPClient class responsible for communicating with\nGoogle API.\n\n\"\"\"\n\nimport time\nfrom http import HTTPStatus\nfrom json import dumps as json_dumps\nfrom typing import (\n    IO,\n    Any,\n    Callable,\n    Dict,\n    List,\n    Mapping,\n    MutableMapping,\n    Optional,\n    Tuple,\n    Type,\n    Union,\n)\n\nfrom google.auth.credentials import Credentials\nfrom google.auth.exceptions import RefreshError\nfrom google.auth.transport.requests import AuthorizedSession\nfrom requests import Response, Session\n\nfrom .exceptions import APIError, UnSupportedExportFormat\nfrom .urls import (\n    DRIVE_FILES_API_V3_URL,\n    DRIVE_FILES_UPLOAD_API_V2_URL,\n    SPREADSHEET_BATCH_UPDATE_URL,\n    SPREADSHEET_SHEETS_COPY_TO_URL,\n    SPREADSHEET_URL,\n    SPREADSHEET_VALUES_APPEND_URL,\n    SPREADSHEET_VALUES_BATCH_CLEAR_URL,\n    SPREADSHEET_VALUES_BATCH_UPDATE_URL,\n    SPREADSHEET_VALUES_BATCH_URL,\n    SPREADSHEET_VALUES_CLEAR_URL,\n    SPREADSHEET_VALUES_URL,\n)\nfrom .utils import ExportFormat, convert_credentials, quote\n\nParamsType = MutableMapping[str, Optional[Union[str, int, bool, float, List[str]]]]\nDefaultSerializerType = Optional[Callable[[Any], Any]]\n\nFileType = Optional[\n    Union[\n        MutableMapping[str, IO[Any]],\n        MutableMapping[str, Tuple[str, IO[Any]]],\n        MutableMapping[str, Tuple[str, IO[Any], str]],\n        MutableMapping[str, Tuple[str, IO[Any], str, MutableMapping[str, str]]],\n    ]\n]\n\n\nclass HTTPClient:\n    \"\"\"An instance of this class communicates with Google API.\n\n    :param Credentials auth: An instance of google.auth.Credentials used to authenticate requests\n        created by either:\n\n        * gspread.auth.oauth()\n        * gspread.auth.oauth_from_dict()\n        * gspread.auth.service_account()\n        * gspread.auth.service_account_from_dict()\n\n    :param Session session: (Optional) An OAuth2 credential object. Credential objects\n        created by `google-auth <https://github.com/googleapis/google-auth-library-python>`_.\n\n        You can pass you own Session object, simply pass ``auth=None`` and ``session=my_custom_session``.\n\n    This class is not intended to be created manually.\n    It will be created by the gspread.Client class.\n    \"\"\"\n\n    def __init__(self, auth: Credentials, session: Optional[Session] = None) -> None:\n        if session is not None:\n            self.session = session\n        else:\n            self.auth: Credentials = convert_credentials(auth)\n            self.session = AuthorizedSession(self.auth)\n\n        self.timeout: Optional[Union[float, Tuple[float, float]]] = None\n\n    def login(self) -> None:\n        from google.auth.transport.requests import Request\n\n        self.auth.refresh(Request(self.session))\n\n        self.session.headers.update({\"Authorization\": \"Bearer %s\" % self.auth.token})\n\n    def set_timeout(self, timeout: Optional[Union[float, Tuple[float, float]]]) -> None:\n        \"\"\"How long to wait for the server to send\n        data before giving up, as a float, or a ``(connect timeout,\n        read timeout)`` tuple.\n\n        Use value ``None`` to restore default timeout\n\n        Value for ``timeout`` is in seconds (s).\n        \"\"\"\n        self.timeout = timeout\n\n    def request(\n        self,\n        method: str,\n        endpoint: str,\n        params: Optional[ParamsType] = None,\n        data: Optional[Union[str, bytes]] = None,\n        json: Optional[Mapping[str, Any]] = None,\n        files: FileType = None,\n        headers: Optional[MutableMapping[str, str]] = None,\n        default_serializer: DefaultSerializerType = None,\n    ) -> Response:\n        if default_serializer is not None and json is not None:\n            data = json_dumps(dict(json), default=default_serializer)\n            json = None\n            headers = {**(headers or {}), \"Content-Type\": \"application/json\"}\n        response = self.session.request(\n            method=method,\n            url=endpoint,\n            json=dict(json) if json else None,\n            params=params,\n            data=data,\n            files=files,\n            headers=headers,\n            timeout=self.timeout,\n        )\n\n        if response.ok:\n            return response\n        else:\n            raise APIError(response)\n\n    def batch_update(self, id: str, body: Optional[Mapping[str, Any]]) -> Any:\n        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>:batchUpdate <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/batchUpdate>`_.\n\n        :param dict body: `Batch Update Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/batchUpdate#request-body>`_.\n        :returns: `Batch Update Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/batchUpdate#response-body>`_.\n        :rtype: dict\n\n        .. versionadded:: 3.0\n        \"\"\"\n        r = self.request(\"post\", SPREADSHEET_BATCH_UPDATE_URL % id, json=body)\n\n        return r.json()\n\n    def values_update(\n        self,\n        id: str,\n        range: str,\n        params: Optional[ParamsType] = None,\n        body: Optional[Mapping[str, Any]] = None,\n        default_serializer: DefaultSerializerType = None,\n    ) -> Any:\n        \"\"\"Lower-level method that directly calls `PUT spreadsheets/<ID>/values/<range> <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update>`_.\n\n        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to update.\n        :param dict params: (optional) `Values Update Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update#query-parameters>`_.\n        :param dict body: (optional) `Values Update Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update#request-body>`_.\n        :returns: `Values Update Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/update#response-body>`_.\n        :rtype: dict\n\n        Example::\n\n            sh.values_update(\n                'Sheet1!A2',\n                params={\n                    'valueInputOption': 'USER_ENTERED'\n                },\n                body={\n                    'values': [[1, 2, 3]]\n                }\n            )\n\n        .. versionadded:: 3.0\n        \"\"\"\n        url = SPREADSHEET_VALUES_URL % (id, quote(range))\n        r = self.request(\n            \"put\", url, params=params, json=body, default_serializer=default_serializer\n        )\n        return r.json()\n\n    def values_append(\n        self,\n        id: str,\n        range: str,\n        params: ParamsType,\n        body: Optional[Mapping[str, Any]],\n        default_serializer: DefaultSerializerType = None,\n    ) -> Any:\n        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:append <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append>`_.\n\n        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_\n                          of a range to search for a logical table of data. Values will be appended after the last row of the table.\n        :param dict params: `Values Append Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append#query-parameters>`_.\n        :param dict body: `Values Append Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append#request-body>`_.\n        :returns: `Values Append Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/append#response-body>`_.\n        :rtype: dict\n\n        .. versionadded:: 3.0\n        \"\"\"\n        url = SPREADSHEET_VALUES_APPEND_URL % (id, quote(range))\n        r = self.request(\n            \"post\", url, params=params, json=body, default_serializer=default_serializer\n        )\n        return r.json()\n\n    def values_clear(self, id: str, range: str) -> Any:\n        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:clear <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/clear>`_.\n\n        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to clear.\n        :returns: `Values Clear Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/clear#response-body>`_.\n        :rtype: dict\n\n        .. versionadded:: 3.0\n        \"\"\"\n        url = SPREADSHEET_VALUES_CLEAR_URL % (id, quote(range))\n        r = self.request(\"post\", url)\n        return r.json()\n\n    def values_batch_clear(\n        self,\n        id: str,\n        params: Optional[ParamsType] = None,\n        body: Optional[Mapping[str, Any]] = None,\n    ) -> Any:\n        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:batchClear`\n\n        :param dict params: (optional) `Values Batch Clear Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchClear#path-parameters>`_.\n        :param dict body: (optional) `Values Batch Clear request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchClear#request-body>`_.\n        :rtype: dict\n        \"\"\"\n        url = SPREADSHEET_VALUES_BATCH_CLEAR_URL % id\n        r = self.request(\"post\", url, params=params, json=body)\n        return r.json()\n\n    def values_get(\n        self, id: str, range: str, params: Optional[ParamsType] = None\n    ) -> Any:\n        \"\"\"Lower-level method that directly calls `GET spreadsheets/<ID>/values/<range> <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/get>`_.\n\n        :param str range: The `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to retrieve.\n        :param dict params: (optional) `Values Get Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/get#query-parameters>`_.\n        :returns: `Values Get Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/get#response-body>`_.\n        :rtype: dict\n\n        .. versionadded:: 3.0\n        \"\"\"\n        url = SPREADSHEET_VALUES_URL % (id, quote(range))\n        r = self.request(\"get\", url, params=params)\n        return r.json()\n\n    def values_batch_get(\n        self, id: str, ranges: List[str], params: Optional[ParamsType] = None\n    ) -> Any:\n        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:batchGet <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchGet>`_.\n\n        :param list ranges: List of ranges in the `A1 notation <https://developers.google.com/sheets/api/guides/concepts#a1_notation>`_ of the values to retrieve.\n        :param dict params: (optional) `Values Batch Get Query parameters <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchGet#query-parameters>`_.\n        :returns: `Values Batch Get Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchGet#response-body>`_.\n        :rtype: dict\n        \"\"\"\n        if params is None:\n            params = {}\n\n        params[\"ranges\"] = ranges\n\n        url = SPREADSHEET_VALUES_BATCH_URL % id\n        r = self.request(\"get\", url, params=params)\n        return r.json()\n\n    def values_batch_update(\n        self,\n        id: str,\n        body: Optional[Mapping[str, Any]] = None,\n        default_serializer: DefaultSerializerType = None,\n    ) -> Any:\n        \"\"\"Lower-level method that directly calls `spreadsheets/<ID>/values:batchUpdate <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchUpdate>`_.\n\n        :param dict body: (optional) `Values Batch Update Request body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchUpdate#request-body>`_.\n        :returns: `Values Batch Update Response body <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.values/batchUpdate#response-body>`_.\n        :rtype: dict\n        \"\"\"\n        url = SPREADSHEET_VALUES_BATCH_UPDATE_URL % id\n        r = self.request(\"post\", url, json=body, default_serializer=default_serializer)\n        return r.json()\n\n    def spreadsheets_get(self, id: str, params: Optional[ParamsType] = None) -> Any:\n        \"\"\"A method stub that directly calls `spreadsheets.get <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets/get>`_.\"\"\"\n        url = SPREADSHEET_URL % id\n        r = self.request(\"get\", url, params=params)\n        return r.json()\n\n    def spreadsheets_sheets_copy_to(\n        self, id: str, sheet_id: int, destination_spreadsheet_id: str\n    ) -> Any:\n        \"\"\"Lower-level method that directly calls `spreadsheets.sheets.copyTo <https://developers.google.com/sheets/api/reference/rest/v4/spreadsheets.sheets/copyTo>`_.\"\"\"\n        url = SPREADSHEET_SHEETS_COPY_TO_URL % (id, sheet_id)\n\n        body = {\"destinationSpreadsheetId\": destination_spreadsheet_id}\n        r = self.request(\"post\", url, json=body)\n        return r.json()\n\n    def fetch_sheet_metadata(\n        self, id: str, params: Optional[ParamsType] = None\n    ) -> Mapping[str, Any]:\n        \"\"\"Similar to :method spreadsheets_get:`gspread.http_client.spreadsheets_get`,\n        get the spreadsheet from the API but by default **does not get the cells data**.\n        It only retrieves the metadata from the spreadsheet.\n\n        :param str id: the spreadsheet ID key\n        :param dict params: (optional) the HTTP params for the GET request.\n            By default sets the parameter ``includeGridData`` to ``false``.\n        :returns: The raw spreadsheet\n        :rtype: dict\n        \"\"\"\n        if params is None:\n            params = {\"includeGridData\": \"false\"}\n\n        url = SPREADSHEET_URL % id\n\n        r = self.request(\"get\", url, params=params)\n\n        return r.json()\n\n    def get_file_drive_metadata(self, id: str) -> Any:\n        \"\"\"Get the metadata from the Drive API for a specific file\n        This method is mainly here to retrieve the create/update time\n        of a file (these metadata are only accessible from the Drive API).\n        \"\"\"\n\n        url = DRIVE_FILES_API_V3_URL + \"/{}\".format(id)\n\n        params: ParamsType = {\n            \"supportsAllDrives\": True,\n            \"includeItemsFromAllDrives\": True,\n            \"fields\": \"id,name,createdTime,modifiedTime\",\n        }\n\n        res = self.request(\"get\", url, params=params)\n\n        return res.json()\n\n    def export(self, file_id: str, format: str = ExportFormat.PDF) -> bytes:\n        \"\"\"Export the spreadsheet in the given format.\n\n        :param str file_id: The key of the spreadsheet to export\n\n        :param str format: The format of the resulting file.\n            Possible values are:\n\n                * ``ExportFormat.PDF``\n                * ``ExportFormat.EXCEL``\n                * ``ExportFormat.CSV``\n                * ``ExportFormat.OPEN_OFFICE_SHEET``\n                * ``ExportFormat.TSV``\n                * ``ExportFormat.ZIPPED_HTML``\n\n            See `ExportFormat`_ in the Drive API.\n\n        :type format: :class:`~gspread.utils.ExportFormat`\n\n        :returns bytes: The content of the exported file.\n\n        .. _ExportFormat: https://developers.google.com/drive/api/guides/ref-export-formats\n        \"\"\"\n\n        if format not in ExportFormat:\n            raise UnSupportedExportFormat\n\n        url = \"{}/{}/export\".format(DRIVE_FILES_API_V3_URL, file_id)\n\n        params: ParamsType = {\"mimeType\": format}\n\n        r = self.request(\"get\", url, params=params)\n        return r.content\n\n    def insert_permission(\n        self,\n        file_id: str,\n        email_address: Optional[str],\n        perm_type: Optional[str],\n        role: Optional[str],\n        notify: bool = True,\n        email_message: Optional[str] = None,\n        with_link: bool = False,\n    ) -> Response:\n        \"\"\"Creates a new permission for a file.\n\n        :param str file_id: a spreadsheet ID (aka file ID).\n        :param email_address: user or group e-mail address, domain name\n            or None for 'anyone' type.\n        :type email_address: str, None\n        :param str perm_type: (optional) The account type.\n            Allowed values are: ``user``, ``group``, ``domain``, ``anyone``\n        :param str role: (optional) The primary role for this user.\n            Allowed values are: ``owner``, ``writer``, ``reader``\n        :param bool notify: Whether to send an email to the target\n            user/domain. Default ``True``.\n        :param str email_message: (optional) An email message to be sent\n            if ``notify=True``.\n        :param bool with_link: Whether the link is required for this\n            permission to be active. Default ``False``.\n\n        :returns dict: the newly created permission\n\n        Examples::\n\n            # Give write permissions to otto@example.com\n\n            gc.insert_permission(\n                '0BmgG6nO_6dprnRRUWl1UFE',\n                'otto@example.org',\n                perm_type='user',\n                role='writer'\n            )\n\n            # Make the spreadsheet publicly readable\n\n            gc.insert_permission(\n                '0BmgG6nO_6dprnRRUWl1UFE',\n                None,\n                perm_type='anyone',\n                role='reader'\n            )\n\n        \"\"\"\n        url = \"{}/{}/permissions\".format(DRIVE_FILES_API_V3_URL, file_id)\n        payload = {\n            \"type\": perm_type,\n            \"role\": role,\n            \"withLink\": with_link,\n        }\n        params: ParamsType = {\n            \"supportsAllDrives\": \"true\",\n        }\n\n        if perm_type == \"domain\":\n            payload[\"domain\"] = email_address\n        elif perm_type in {\"user\", \"group\"}:\n            payload[\"emailAddress\"] = email_address\n            params[\"sendNotificationEmail\"] = notify\n            params[\"emailMessage\"] = email_message\n        elif perm_type == \"anyone\":\n            pass\n        else:\n            raise ValueError(\"Invalid permission type: {}\".format(perm_type))\n\n        return self.request(\"post\", url, json=payload, params=params)\n\n    def list_permissions(self, file_id: str) -> List[Dict[str, Union[str, bool]]]:\n        \"\"\"Retrieve a list of permissions for a file.\n\n        :param str file_id: a spreadsheet ID (aka file ID).\n        \"\"\"\n        url = \"{}/{}/permissions\".format(DRIVE_FILES_API_V3_URL, file_id)\n\n        params: ParamsType = {\n            \"supportsAllDrives\": True,\n            \"fields\": \"nextPageToken,permissions\",\n        }\n\n        token = \"\"\n\n        permissions = []\n\n        while token is not None:\n            if token:\n                params[\"pageToken\"] = token\n\n            r = self.request(\"get\", url, params=params).json()\n            permissions.extend(r[\"permissions\"])\n\n            token = r.get(\"nextPageToken\", None)\n\n        return permissions\n\n    def remove_permission(self, file_id: str, permission_id: str) -> None:\n        \"\"\"Deletes a permission from a file.\n\n        :param str file_id: a spreadsheet ID (aka file ID.)\n        :param str permission_id: an ID for the permission.\n        \"\"\"\n        url = \"{}/{}/permissions/{}\".format(\n            DRIVE_FILES_API_V3_URL, file_id, permission_id\n        )\n\n        params: ParamsType = {\"supportsAllDrives\": True}\n        self.request(\"delete\", url, params=params)\n\n    def import_csv(self, file_id: str, data: Union[str, bytes]) -> Any:\n        \"\"\"Imports data into the first page of the spreadsheet.\n\n        :param str data: A CSV string of data.\n\n        Example:\n\n        .. code::\n\n            # Read CSV file contents\n            content = open('file_to_import.csv', 'r').read()\n\n            gc.import_csv(spreadsheet.id, content)\n\n        .. note::\n\n           This method removes all other worksheets and then entirely\n           replaces the contents of the first worksheet.\n\n        \"\"\"\n        # Make sure we send utf-8\n        if isinstance(data, str):\n            data = data.encode(\"utf-8\")\n\n        headers = {\"Content-Type\": \"text/csv\"}\n        url = \"{}/{}\".format(DRIVE_FILES_UPLOAD_API_V2_URL, file_id)\n\n        res = self.request(\n            \"put\",\n            url,\n            data=data,\n            params={\n                \"uploadType\": \"media\",\n                \"convert\": True,\n                \"supportsAllDrives\": True,\n            },\n            headers=headers,\n        )\n\n        return res.json()\n\n\nclass BackOffHTTPClient(HTTPClient):\n    \"\"\"BackOffHTTPClient is a http client with exponential\n    backoff retries.\n\n    In case a request fails due to some API rate limits,\n    it will wait for some time, then retry the request.\n\n    This can help by trying the request after some time and\n    prevent the application from failing (by raising an APIError exception).\n\n    .. Warning::\n        This HTTPClient is not production ready yet.\n        Use it at your own risk !\n\n    .. note::\n        To use with the `auth` module, make sure to pass this backoff\n        http client using the ``http_client`` parameter of the\n        method used.\n\n    .. note::\n        Currently known issues are:\n\n        * will retry exponentially even when the error should\n          raise instantly. Due to the Drive API that raises\n          403 (Forbidden) errors for forbidden access and\n          for api rate limit exceeded.\"\"\"\n\n    _HTTP_ERROR_CODES: List[HTTPStatus] = [\n        HTTPStatus.REQUEST_TIMEOUT,  # in case of a timeout\n        HTTPStatus.TOO_MANY_REQUESTS,  # sheet API usage rate limit exceeded\n    ]\n    _NR_BACKOFF: int = 0\n    _MAX_BACKOFF: int = 128  # arbitrary maximum backoff\n\n    def request(self, *args: Any, **kwargs: Any) -> Response:\n        # Check if we should retry the request\n        def _should_retry(\n            code: int,\n            error: Mapping[str, Any],\n            wait: int,\n        ) -> bool:\n            # Drive API return a dict object 'errors', the sheet API does not\n            if \"errors\" in error:\n                # Drive API returns a code 403 when reaching quotas/usage limits\n                if (\n                    code == HTTPStatus.FORBIDDEN\n                    and error[\"errors\"][0][\"domain\"] == \"usageLimits\"\n                ):\n                    return True\n\n            # We retry if:\n            #   - the return code is one of:\n            #     - 429: too many requests\n            #     - 408: request timeout\n            #     - >= 500: some server error\n            #   - AND we did not reach the max retry limit\n            return (\n                code in self._HTTP_ERROR_CODES\n                or code >= HTTPStatus.INTERNAL_SERVER_ERROR\n            ) and wait <= self._MAX_BACKOFF\n\n        try:\n            return super().request(*args, **kwargs)\n        except APIError as err:\n            code = err.code\n            error = err.error\n\n            self._NR_BACKOFF += 1\n            wait = min(2**self._NR_BACKOFF, self._MAX_BACKOFF)\n\n            # check if error should retry\n            if _should_retry(code, error, wait) is True:\n                time.sleep(wait)\n\n                # make the request again\n                response = self.request(*args, **kwargs)\n\n                # reset counters for next time\n                self._NR_BACKOFF = 0\n\n                return response\n\n            # failed too many times, raise APIEerror\n            self._NR_BACKOFF = 0\n            raise err\n        except RefreshError as err:\n            self._NR_BACKOFF += 1\n            wait = min(2**self._NR_BACKOFF, self._MAX_BACKOFF)\n\n            if wait <= self._MAX_BACKOFF:\n                time.sleep(wait)\n\n                # make the request again\n                response = self.request(*args, **kwargs)\n\n                # reset counters for next time\n                self._NR_BACKOFF = 0\n\n                return response\n\n            # failed too many times, raise APIEerror\n            self._NR_BACKOFF = 0\n            raise err\n\n\nHTTPClientType = Type[HTTPClient]\n","numLines":644,"startLine":1,"totalLines":644}}}
