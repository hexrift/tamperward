\n596\t            \"pretty_name\": \"Linux Mint 17.3 Rosa\",\n597\t            \"version\": \"17.3\",\n598\t            \"pretty_version\": \"17.3 (rosa)\",\n599\t            \"best_version\": \"17.3\",\n600\t            \"codename\": \"rosa\",\n601\t        }\n602\t        self._test_outcome(desired_outcome)\n603\t\n604\t    def test_manjaro1512_lsb_release(self) -> None:\n605\t        self._test_outcome(\n606\t            {\n607\t                \"id\": \"manjarolinux\",\n608\t                \"name\": \"ManjaroLinux\",\n609\t                \"pretty_name\": \"Manjaro Linux\",\n610\t                \"version\": \"15.12\",\n611\t                \"pretty_version\": \"15.12 (Capella)\",\n612\t                \"best_version\": \"15.12\",\n613\t                \"codename\": \"Capella\",\n614\t            }\n615\t        )\n616\t\n617\t    # @pytest.mark.xfail\n618\t    # def test_openelec6_lsb_release(self) -> None:\n619\t    #     # TODO: This should be fixed as part of #109 when dealing\n620\t    #     # with distro inconsistencies\n621\t    #     desired_outcome = {\n622\t    #         'id': 'openelec',\n623\t    #         'name': 'OpenELEC',\n624\t    #         'pretty_name': 'OpenELEC (official) - Version: 6.0.3',\n625\t    #         'version': '6.0.3',\n626\t    #         'pretty_version': '6.0.3',\n627\t    #         'best_version': '6.0.3',\n628\t    #     }\n629\t    #     self._test_outcome(desired_outcome)\n630\t\n631\t    def test_openbsd62_uname(self) -> None:\n632\t        self._test_outcome(\n633\t            {\n634\t                \"id\": \"openbsd\",\n635\t                \"name\": \"OpenBSD\",\n636\t                \"version\": \"6.2\",\n637\t                \"pretty_name\": \"OpenBSD 6.2\",\n638\t                \"pretty_version\": \"6.2\",\n639\t                \"best_version\": \"6.2\","}]},"parent_tool_use_id":null,"session_id":"54e9d7c1-1345-5e2d-ba67-93201e1134e8","uuid":"63e1225d-3f0f-48d1-bd4b-567cd6b12dfc","timestamp":"2026-08-31T22:10:39.4