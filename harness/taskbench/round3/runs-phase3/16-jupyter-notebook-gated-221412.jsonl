{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Gi6SqapEjebMhqJk9DqTQ","type":"tool_result","content":"1\t\"\"\"Jupyter notebook application.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport os\n6\timport re\n7\timport typing as t\n8\tfrom pathlib import Path\n9\t\n10\tfrom jupyter_client.utils import ensure_async  # type:ignore[attr-defined]\n11\tfrom jupyter_core.application import base_aliases\n12\tfrom jupyter_core.paths import jupyter_config_dir\n13\tfrom jupyter_server.base.handlers import JupyterHandler\n14\tfrom jupyter_server.extension.handler import (\n15\t    ExtensionHandlerJinjaMixin,\n16\t    ExtensionHandlerMixin,\n17\t)\n18\tfrom jupyter_server.serverapp import flags\n19\tfrom jupyter_server.utils import url_escape, url_is_absolute\n20\tfrom jupyter_server.utils import url_path_join as ujoin\n21\tfrom jupyterlab.commands import (  # type:ignore[import-untyped]\n22\t    get_app_dir,\n23\t    get_user_settings_dir,\n24\t    get_workspaces_dir,\n25\t)\n26\tfrom jupyterlab_server import LabServerApp\n27\tfrom jupyterlab_server.config import (  # type:ignore[attr-defined]\n28\t    LabConfig,\n29\t    get_page_config,\n30\t    recursive_update,\n31\t)\n32\tfrom jupyterlab_server.handlers import _camelCase, is_url\n33\tfrom notebook_shim.shim import NotebookConfigShimMixin  # type:ignore[import-untyped]\n34\tfrom tornado import web\n35\tfrom traitlets import Bool, Unicode, default\n36\tfrom traitlets.config.loader import Config\n37\t\n38\tfrom ._version import __version__\n39\t\n40\tHERE = Path(__file__).parent.resolve()\n41\t\n42\tFlags = dict[str | tuple[str, ...], tuple[dict[str, t.Any] | Config, str]]\n43\t\n44\tapp_dir = Path(get_app_dir())\n45\tversion = __version__\n46\t\n47\t# mypy: disable-error-code=\"no-untyped-call\"\n48\t\n49\t\n50\tclass NotebookBaseHandler(ExtensionHandlerJinjaMixin, ExtensionHandlerMixin, JupyterHandler):\n51\t    \"\"\"The base notebook API handler.\"\"\"\n52\t\n53\t    @property\n54\t    def custom_css(self) -> t.Any:\n55\t        return self.settings.get(\"custom_css\", True)\n56\t\n57\t    def get_page_config(self) -> dict[str, t.Any]:\n58\t        \"\"\"Get the page config.\"\"\"\n59\t        config = LabConfig()\n60\t        app: JupyterNotebookApp = self.extensionapp  # type:ignore[assignment]\n61\t        base_url = self.settings.get(\"base_url\", \"/\")\n62\t        page_config_data = self.settings.setdefault(\"page_config_data\", {})\n63\t        page_config = {\n64\t            **page_config_data,\n65\t            \"appVersion\": version,\n66\t            \"baseUrl\": self.base_url,\n67\t            \"terminalsAvailable\": self.settings.get(\"terminals_available\", False),\n68\t            \"token\": self.settings[\"token\"],\n69\t            \"fullStaticUrl\": ujoin(self.base_url, \"static\", self.name),\n70\t            \"frontendUrl\": ujoin(self.base_url, \"/\"),\n71\t            \"exposeAppInBrowser\": app.expose_app_in_browser,\n72\t        }\n73\t\n74\t        server_root = self.settings.get(\"server_root_dir\", \"\")\n75\t        server_root = server_root.replace(os.sep, \"/\")\n76\t        server_root = os.path.normpath(Path(server_root).expanduser())\n77\t        try:\n78\t            # Remove the server_root from pref dir\n79\t            if self.serverapp.preferred_dir != server_root:\n80\t                page_config[\"preferredPath\"] = \"/\" + os.path.relpath(\n81\t                    self.serverapp.preferred_dir, server_root\n82\t                )\n83\t            else:\n84\t                page_config[\"preferredPath\"] = \"/\"\n85\t        except Exception:  # noqa: BLE001\n86\t            page_config[\"preferredPath\"] = \"/\"\n87\t\n88\t        mathjax_config = self.settings.get(\"mathjax_config\", \"TeX-AMS_HTML-full,Safe\")\n89\t        # TODO Remove CDN usage.\n90\t        mathjax_url = self.settings.get(\n91\t            \"mathjax_url\",\n92\t            \"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js\",\n93\t        )\n94\t        if not url_is_absolute(mathjax_url) and not mathjax_url.startswith(self.base_url):\n95\t            mathjax_url = ujoin(self.base_url, mathjax_url)\n96\t\n97\t        page_config.setdefault(\"mathjaxConfig\", mathjax_config)\n98\t        page_config.setdefault(\"fullMathjaxUrl\", mathjax_url)\n99\t        page_config.setdefault(\"jupyterConfigDir\", jupyter_config_dir())\n100\t\n101\t        # Put all our config in page_config\n102\t        for name in config.trait_names():\n103\t            page_config[_camelCase(name)] = getattr(app, name)\n104\t\n105\t        # Add full versions of all the urls\n106\t        for name in config.trait_names():\n107\t            if not name.endswith(\"_url\"):\n108\t                continue\n109\t            full_name = _camelCase(\"full_\" + name)\n110\t            full_url = getattr(app, name)\n111\t            if not is_url(full_url):\n112\t                # Relative URL will be prefixed with base_url\n113\t                full_url = ujoin(base_url, full_url)\n114\t            page_config[full_name] = full_url\n115\t\n116\t        labextensions_path = app.extra_labextensions_path + app.labextensions_path\n117\t        recursive_update(\n118\t            page_config,\n119\t            get_page_config(\n120\t                labextensions_path,\n121\t                logger=self.log,\n122\t            ),\n123\t        )\n124\t\n125\t        # modify page config with custom hook\n126\t        page_config_hook = self.settings.get(\"page_config_hook\", None)\n127\t        if page_config_hook:\n128\t            page_config = page_config_hook(self, page_config)\n129\t\n130\t        return page_config\n131\t\n132\t\n133\tclass TreeHandler(NotebookBaseHandler):\n134\t    \"\"\"A tree page handler.\"\"\"\n135\t\n136\t    @web.authenticated\n137\t    async def get(self, path: str = \"\") -> None:\n138\t        \"\"\"\n139\t        Display appropriate page for given path.\n140\t\n141\t        - A directory listing is shown if path is a directory\n142\t        - Redirected to notebook page if path is a notebook\n143\t        - Render the raw file if path is any other file\n144\t        \"\"\"\n145\t        path = path.strip(\"/\")\n146\t        cm = self.contents_manager\n147\t\n148\t        if await ensure_async(cm.dir_exists(path=path)):\n149\t            if await ensure_async(cm.is_hidden(path)) and not cm.allow_hidden:\n150\t                self.log.info(\"Refusing to serve hidden directory, via 404 Error\")\n151\t                raise web.HTTPError(404)\n152\t\n153\t            # Set treePath for routing to the directory\n154\t            page_config = self.get_page_config()\n155\t            page_config[\"treePath\"] = path\n156\t\n157\t            tpl = self.render_template(\"tree.html\", page_config=page_config)\n158\t            return self.write(tpl)\n159\t        if await ensure_async(cm.file_exists(path)):\n160\t            # it's not a directory, we have redirecting to do\n161\t            model = await ensure_async(cm.get(path, content=False))\n162\t            if model[\"type\"] == \"notebook\":\n163\t                url = ujoin(self.base_url, \"notebooks\", url_escape(path))\n164\t            else:\n165\t                # Return raw content if file is not a notebook\n166\t                url = ujoin(self.base_url, \"files\", url_escape(path))\n167\t            self.log.debug(\"Redirecting %s to %s\", self.request.path, url)\n168\t            self.redirect(url)\n169\t            return None\n170\t        raise web.HTTPError(404)\n171\t\n172\t\n173\tclass ConsoleHandler(NotebookBaseHandler):\n174\t    \"\"\"A console page handler.\"\"\"\n175\t\n176\t    @web.authenticated\n177\t    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n178\t        \"\"\"Get the console page.\"\"\"\n179\t        tpl = self.render_template(\"consoles.html\", page_config=self.get_page_config())\n180\t        return self.write(tpl)\n181\t\n182\t\n183\tclass TerminalHandler(NotebookBaseHandler):\n184\t    \"\"\"A terminal page handler.\"\"\"\n185\t\n186\t    @web.authenticated\n187\t    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n188\t        \"\"\"Get the terminal page.\"\"\"\n189\t        tpl = self.render_template(\"terminals.html\", page_config=self.get_page_config())\n190\t        return self.write(tpl)\n191\t\n192\t\n193\tclass FileHandler(NotebookBaseHandler):\n194\t    \"\"\"A file page handler.\"\"\"\n195\t\n196\t    @web.authenticated\n197\t    def get(self, path: str | None = None) -> t.Any:  # noqa: ARG002\n198\t        \"\"\"Get the file page.\"\"\"\n199\t        tpl = self.render_template(\"edit.html\", page_config=self.get_page_config())\n200\t        return self.write(tpl)\n201\t\n202\t\n203\tclass NotebookHandler(NotebookBaseHandler):\n204\t    \"\"\"A notebook page handler.\"\"\"\n205\t\n206\t    @web.authenticated\n207\t    async def get(self, path: str = \"\") -> t.Any:\n208\t        \"\"\"Get the notebook page. Redirect if it's a directory.\"\"\"\n209\t        path = path.strip(\"/\")\n210\t        cm = self.contents_manager\n211\t\n212\t        if await ensure_async(cm.dir_exists(path=path)):\n213\t            url = ujoin(self.base_url, \"tree\", url_escape(path))\n214\t            self.log.debug(\"Redirecting %s to %s since path is a directory\", self.request.path, url)\n215\t            self.redirect(url)\n216\t            return None\n217\t        tpl = self.render_template(\"notebooks.html\", page_config=self.get_page_config())\n218\t        return self.write(tpl)\n219\t\n220\t\n221\tclass CustomCssHandler(NotebookBaseHandler):\n222\t    \"\"\"A custom CSS handler.\"\"\"\n223\t\n224\t    @web.authenticated\n225\t    def get(self) -> t.Any:\n226\t        \"\"\"Get the custom css file.\"\"\"\n227\t\n228\t        self.set_header(\"Content-Type\", \"text/css\")\n229\t        page_config = self.get_page_config()\n230\t        custom_css_file = f\"{page_config['jupyterConfigDir'