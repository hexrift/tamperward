ibuted.default_client()\n        self.files = client.submit(FileActor, actor=True).result()\n\n    def complete(self, commit=True):\n        \"\"\"Finish transaction: commit or discard all deferred files\"\"\"\n        if commit:\n            self.files.commit().result()\n        else:\n            self.files.discard().result()\n        self.fs._intrans = False\n        self.fs = None\n","structuredPatch":[{"oldStart":40,"oldLines":15,"newStart":40,"newLines":30,"lines":[" ","     def complete(self, commit=True):","         \"\"\"Finish transaction: commit or discard all deferred files\"\"\"","-        while self.files:","-            f = self.files.popleft()","-            if commit:","-                f.commit()","-            else:","+        try:","+            while self.files:","+                f = self.files.popleft()","+                if commit:","+                    f.commit()","+                else:","+                    f.discard()","+        except Exception:","+            # If commit fails, discard the failed file and remaining files","+            try:","                 f.discard()","-        self.fs._intrans = False","-        self.fs._transaction = None","-        self.fs = None","+            except Exception:","+                pass","+            while self.files:","+                f = self.files.popleft()","+                try:","+                    f.discard()","+                except Exception:","+                    pass","+            raise","+        finally:","+            self.fs._intrans = False","+            self.fs._transaction = None","+            self.fs = None"," "," "," class FileActor:"]}],"userModified":false,"replaceAll":false,"gitDiff":{"filename":"fsspec/transaction.py","status":"modified","additions":31,"deletions":14,"changes":45,"patch":"@@ -24,12 +24,14 @@ class Transaction:\n \n     def __exit__(self, exc_type, exc_val, exc_tb):\n         \"\"\"End transaction and commit, if exit is not due to exception\"\"\"\