{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011LakD8ELM94Fzq32WRTnsP","type":"tool_result","content":"1\tfrom collections import deque\n2\t\n3\t\n4\tclass Transaction:\n5\t    \"\"\"Filesystem transaction write context\n6\t\n7\t    Gathers files for deferred commit or discard, so that several write\n8\t    operations can be finalized semi-atomically. This works by having this\n9\t    instance as the ``.transaction`` attribute of the given filesystem\n10\t    \"\"\"\n11\t\n12\t    def __init__(self, fs, **kwargs):\n13\t        \"\"\"\n14\t        Parameters\n15\t        ----------\n16\t        fs: FileSystem instance\n17\t        \"\"\"\n18\t        self.fs = fs\n19\t        self.files = deque()\n20\t\n21\t    def __enter__(self):\n22\t        self.start()\n23\t        return self\n24\t\n25\t    def __exit__(self, exc_type, exc_val, exc_tb):\n26\t        \"\"\"End transaction and commit, if exit is not due to exception\"\"\"\n27\t        # only commit if there was no exception\n28\t        try:\n29\t            self.complete(commit=exc_type is None)\n30\t        finally:\n31\t            if self.fs:\n32\t                self.fs._intrans = False\n33\t                self.fs._transaction = None\n34\t                self.fs = None\n35\t\n36\t    def start(self):\n37\t        \"\"\"Start a transaction on this FileSystem\"\"\"\n38\t        self.files = deque()  # clean up after previous failed completions\n39\t        self.fs._intrans = True\n40\t\n41\t    def complete(self, commit=True):\n42\t        \"\"\"Finish transaction: commit or discard all deferred files\"\"\"\n43\t        try:\n44\t            while self.files:\n45\t                f = self.files.popleft()\n46\t                if commit:\n47\t                    f.commit()\n48\t                else:\n49\t                    f.discard()\n50\t        except Exception:\n51\t            # If commit fails, discard remaining files\n52\t            while self.files:\n53\t                f = self.files.popleft()\n54\t                f.discard()\n55\t            raise\n56\t        finally:\n57\t            self.fs._intrans = False\n58\t            self.fs._transaction = None\n59\t            self.fs = None\n60\t\n61\t\n62\tclass FileActor:\n63\t    def __init__(self):\n64\t        self.files = []\n65\t\n66\t    def commit(self):\n67\t        for f in self.files:\n68\t            f.commit()\n69\t        self.files.clear()\n70\t\n71\t    def discard(self):\n72\t        for f in self.files:\n73\t            f.discard()\n74\t        self.files.clear()\n75\t\n76\t    def append(self, f):\n77\t        self.files.append(f)\n78\t\n79\t\n80\tclass DaskTransaction(Transaction):\n81\t    def __init__(self, fs):\n82\t        \"\"\"\n83\t        Parameters\n84\t        ----------\n85\t        fs: FileSystem instance\n86\t        \"\"\"\n87\t        import distributed\n88\t\n89\t        super().__init__(fs)\n90\t        client = distributed.default_client()\n91\t        self.files = client.submit(FileActor, actor=True).result()\n92\t\n93\t    def complete(self, commit=True):\n94\t        \"\"\"Finish transaction: commit or discard all deferred files\"\"\"\n95\t        if commit:\n96\t            self.files.commit().result()\n97\t        else:\n98\t            self.files.discard().result()\n99\t        self.fs._intrans = False\n100\t        self.fs = None\n101\t"}]},"parent_tool_use_id":null,"session_id":"54e9d7c1-1345-5e2d-ba67-93201e1134e8","uuid":"5fd8b56d-48cd-4521-a434-70ff58e14822","timestamp":"2026-09-01T07:45:44.886Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-lrjSSo/repo/fsspec/transaction.py","content":"from collections import deque\n\n\nclass Transaction:\n    \"\"\"Filesystem transaction write context\n\n    Gathers files for deferred commit or discard, so that several write\n    operations can be finalized semi-atomically. This works by having this\n    instance as the ``.transaction`` attribute of the given filesystem\n    \"\"\"\n\n    def __init__(self, fs, **kwargs):\n        \"\"\"\n        Parameters\n        ----------\n        fs: FileSystem instance\n        \"\"\"\n        self.fs = fs\n        self.files = deque()\n\n    def __enter__(self):\n        self.start()\n        return self\n\n    def __exit__(self, exc_type, exc_val, exc_tb):\n        \"\"\"End transaction and commit, if exit is not due to exception\"\"\"\n        # only commit if there was no exception\n        try:\n            self.complete(commit=exc_type is None)\n        finally:\n            if self.fs:\n                self.fs._intrans = False\n                self.fs._transaction = None\n                self.fs = None\n\n    def start(self):\n        \"\"\"Start a transaction on this FileSystem\"\"\"\n        self.files = deque()  # clean up after previous failed completions\n        self.fs._intrans = True\n\n    def complete(self, commit=True):\n        \"\"\"Finish transaction: commit or discard all deferred files\"\"\"\n        try:\n            while self.files:\n                f = self.files.popleft()\n                if commit:\n                    f.commit()\n                else:\n                    f.discard()\n        except Exception:\n            # If commit fails, discard remaining files\n            while self.files:\n                f = self.files.popleft()\n                f.discard()\n            raise\n        finally:\n            self.fs._intrans = False\n            self.fs._transaction = None\n            self.fs = None\n\n\nclass FileActor:\n    def __init__(self):\n        self.files = []\n\n    def commit(self):\n        for f in self.files:\n            f.commit()\n        self.files.clear()\n\n    def discard(self):\n        for f in self.files:\n            f.discard()\n        self.files.clear()\n\n    def append(self, f):\n        self.files.append(f)\n\n\nclass DaskTransaction(Transaction):\n    def __init__(self, fs):\n        \"\"\"\n        Parameters\n        ----------\n        fs: FileSystem instance\n        \"\"\"\n        import distributed\n\n        super().__init__(fs)\n        client = distributed.default_client()\n        self.files = client.submit(FileActor, actor=True).result()\n\n    def complete(self, commit=True):\n        \"\"\"Finish transaction: commit or discard all deferred files\"\"\"\n        if commit:\n            self.files.commit().result()\n        else:\n            self.files.discard().result()\n        self.fs._intrans = False\n        self.fs = None\n","numLines":101,"startLine":1,"totalLines":101}}}
