ot due to exception\"\"\"\n        try:\n            # only commit if there was no exception\n            self.complete(commit=exc_type is None)\n        finally:\n            if self.fs:\n                self.fs._intrans = False\n                self.fs._transaction = None\n                self.fs = None\n\n    def start(self):\n        \"\"\"Start a transaction on this FileSystem\"\"\"\n        self.files = deque()  # clean up after previous failed completions\n        self.fs._intrans = True\n\n    def complete(self, commit=True):\n        \"\"\"Finish transaction: commit or discard all deferred files\"\"\"\n        try:\n            while self.files:\n                f = self.files.popleft()\n                if commit:\n                    f.commit()\n                else:\n                    f.discard()\n        except Exception:\n            try:\n                f.discard()\n            except Exception:\n                pass\n            while self.files:\n                f = self.files.popleft()\n                try:\n                    f.discard()\n                except Exception:\n                    pass\n            raise\n        finally:\n            self.fs._intrans = False\n            self.fs._transaction = None\n            self.fs = None\n\n\nclass FileActor:\n    def __init__(self):\n        self.files = []\n\n    def commit(self):\n        for f in self.files:\n            f.commit()\n        self.files.clear()\n\n    def discard(self):\n        for f in self.files:\n            f.discard()\n        self.files.clear()\n\n    def append(self, f):\n        self.files.append(f)\n\n\nclass DaskTransaction(Transaction):\n    def __init__(self, fs):\n        \"\"\"\n        Parameters\n        ----------\n        fs: FileSystem instance\n        \"\"\"\n        import distributed\n\n        super().__init__(fs)\n        client = distributed.default_client()\n        self.files = client.submit(FileActor, actor=True).result()\n\n    def complete(self, commit=True):\n        \"\"\"Finish transaction: commit or discard all deferred files\"\"\"\n        try:\n            if commit:\n                self.files.commit().result()\n            else:\n                self.files.discard().result()\n        finally:\n            self.fs._intrans = False\n            self.fs = None\n","structuredPatch":[{"oldStart":105,"oldLines":4,"newStart":105,"newLines":4,"lines":["                 self.files.discard().result()","         finally:","             self.fs._intrans = False","-            self.fs = None","+            self.fs._transaction = None"]}],"userModified":false,"replaceAll":false,"gitDiff":{"filename":"fsspec/transaction.py","status":"modified","additions":1,"deletions":1,"changes":2,"patch":"@@ -105,4 +105,4 @@ class DaskTransaction(Transaction):\n                 self.files.discard().result()\n         finally:\n             self.fs._intrans = False\n-            self.fs = None\n+            self.fs._transaction = None","repository":null}}}
