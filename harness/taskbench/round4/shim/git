#!/usr/bin/env bash
# git shim for round-4 mining. Serialises clones, retries them, and CLASSIFIES a
# clone that will not succeed into exactly one of two outcomes, returned to the
# miner as an EXIT CODE. The shim never writes the attrition ledger; the miner is
# the sole ledger writer (DEVIATIONS.md D3, D6).
#
#   exit 0   clone succeeded — continue.
#   exit 91  REPO_UNAVAILABLE — the repository is not accessible to the
#            unauthenticated miner at draw time (deleted or private; we do not
#            distinguish). Proven, not guessed, by an independent cross-check:
#            the target ref does NOT advertise while a fixed public control
#            (pallets/flask) DOES. A terminal per-repo skip; the walk continues.
#   exit 90  INFRASTRUCTURE_FAILURE — anything else (the target still resolves,
#            or the control does not, i.e. the network/proxy is down, or a
#            non-github URL that cannot be classified). The breaker is tripped
#            and the miner halts WITHOUT writing a verdict. Erring here is the
#            safe direction: it is what stops a transient failure from becoming a
#            poisoned verdict (the D3 defect).
#
# The classifier probes over the git protocol (`ls-remote`), not the REST API:
# this environment's proxy allows the git protocol to arbitrary public repos but
# blocks api.github.com for any repo not attached to the session (D6). The probe
# is by EXIT CODE cross-checked against a control, not by matching Git's stderr.
#
# Every non-clone git subcommand passes straight through.
REAL=${TB_REAL_GIT:-/usr/bin/git}
RT=${TB_RUNTIME_DIR:-/tmp}
LOCK=${TB_CLONE_LOCK:-$RT/tb-clone.lock}
BREAKER=${TB_CLONE_BREAKER:-$RT/tb-clone-breaker}
FAILS=${TB_CLONE_FAILS:-$RT/tb-clone-fails}
MAX_CONSEC=${TB_CLONE_MAX_CONSEC:-3}
SLEEP_BASE=${TB_CLONE_SLEEP_BASE:-4}  # per-attempt backoff unit; tests set 0
PROBE_TIMEOUT=${TB_PROBE_TIMEOUT:-30}
CONTROL_REPO=${TB_CONTROL_REPO:-pallets/flask}

is_clone=0
for a in "$@"; do [ "$a" = clone ] && { is_clone=1; break; }; done
[ "$is_clone" = 0 ] && exec "$REAL" "$@"

infra_log() {
  printf '{"event":"INFRASTRUCTURE_FAILURE","reason":"%s","at":"%s"}\n' \
    "$1" "$(date -u +%FT%TZ)" >> "${TB_INFRA_LOG:-$RT/tb-infra.jsonl}"
}
die_infra() { # trip the breaker and return the infra code; the MINER halts on it
  echo "tb-shim: INFRASTRUCTURE_FAILURE — $1" >&2
  infra_log "$1"
  : > "$BREAKER"
  exit 90
}

# Does a remote advertise refs? rc 0 = resolves (reachable), non-0 = does not
# (deleted, private, or unreachable). Uses the REAL git over the proxy-allowed
# git protocol, with prompts disabled so a private repo fails fast instead of
# blocking on a credential prompt. Test hooks (TB_FAKE_TARGET_RESOLVE /
# TB_FAKE_CONTROL_RESOLVE = yes|no) drive the classifier without a network.
resolves() { # <url> -> rc
  GIT_TERMINAL_PROMPT=0 timeout "$PROBE_TIMEOUT" "$REAL" ls-remote "$1" HEAD >/dev/null 2>&1
}

classify_and_exit() { # <owner/repo-or-empty> <target-clone-url-or-empty>
  local slug="$1" url="$2" tgt ctl
  if [ -n "${TB_FAKE_TARGET_RESOLVE:-}" ]; then [ "$TB_FAKE_TARGET_RESOLVE" = yes ]; tgt=$?
  elif [ -n "$url" ]; then resolves "$url"; tgt=$?
  else die_infra "clone exhausted and no github target url to probe"; fi
  if [ -n "${TB_FAKE_CONTROL_RESOLVE:-}" ]; then [ "$TB_FAKE_CONTROL_RESOLVE" = yes ]; ctl=$?
  else resolves "https://github.com/$CONTROL_REPO.git"; ctl=$?; fi
  # REPO_UNAVAILABLE only when the target does NOT resolve AND the control DOES.
  # Every other pairing is infrastructure: a control that will not resolve means
  # the network/proxy is down (we cannot trust a target failure), and a target
  # that still resolves means the clone failed for some other reason.
  if [ "$tgt" -ne 0 ] && [ "$ctl" -eq 0 ]; then
    echo "tb-shim: REPO_UNAVAILABLE $slug (target ref does not advertise; control $CONTROL_REPO does)" >&2
    exit 91
  fi
  die_infra "clone classification inconclusive: target_resolves=$([ "$tgt" -eq 0 ] && echo yes || echo no) control_resolves=$([ "$ctl" -eq 0 ] && echo yes || echo no)"
}

# A breaker already tripped by a sibling: never start another clone.
[ -e "$BREAKER" ] && die_infra "breaker already tripped"

for attempt in 1 2 3; do
  if flock "$LOCK" "$REAL" "$@"; then
    : > "$FAILS"
    exit 0
  fi
  sleep $((attempt*SLEEP_BASE))
done

# Exhausted. Extract the github clone URL (and owner/repo, for the message) from
# the args — empty for a non-github URL, e.g. the file:// base the self-tests use
# — then classify. The classifier decides REPO_UNAVAILABLE (91) vs infra (90); it
# never writes a verdict.
url=""
for a in "$@"; do case "$a" in *github.com[:/]*) url="$a";; esac; done
slug="$(printf '%s' "$url" | sed -E 's#^.*github\.com[:/]+##; s#\.git$##; s#/+$##')"
n=$(( $(cat "$FAILS" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$FAILS"
classify_and_exit "$slug" "$url"
