#!/usr/bin/env bash
# git shim for round-4 mining. Serialises clones, retries them, and CLASSIFIES a
# clone that will not succeed into exactly one of two outcomes, returned to the
# miner as an EXIT CODE. The shim never writes the attrition ledger; the miner is
# the sole ledger writer (DEVIATIONS.md D3, D6).
#
#   exit 0   clone succeeded — continue.
#   exit 91  REPO_UNAVAILABLE — the repository is PERSISTENTLY INACCESSIBLE through
#            the miner's frozen unauthenticated git transport at draw time. This
#            does NOT claim the repo is deleted or private — only that this
#            transport cannot reach it while it demonstrably can reach a control.
#            A terminal per-repo skip; the walk continues.
#   exit 90  INFRASTRUCTURE_FAILURE — everything else. The breaker trips and the
#            miner halts WITHOUT writing a verdict. Erring here is the safe
#            direction: it stops a transient failure from becoming a poisoned
#            verdict (the D3 defect).
#
# REPO_UNAVAILABLE is emitted ONLY when ALL of these hold, in this order:
#   1. the clone has exhausted its three attempts (we are past the retry loop);
#   2. a control probe of a fixed public repo SUCCEEDS (the transport is healthy);
#   3. the target ls-remote fails REPEATEDLY with the auth/unavailable signature
#      (not a timeout, not a different error, not a success);
#   4. a SECOND control probe SUCCEEDS afterwards (the transport was healthy
#      throughout, so the persistent target failure is the target's).
# Any timeout, any different error, any control failure, or any target success is
# INFRASTRUCTURE_FAILURE. The probes use /usr/bin/git DIRECTLY so the availability
# check never recurses through this shim. (D6.)
REAL=${TB_REAL_GIT:-/usr/bin/git}
PROBE_GIT=/usr/bin/git            # availability probe: real git, never the shim
RT=${TB_RUNTIME_DIR:-/tmp}
LOCK=${TB_CLONE_LOCK:-$RT/tb-clone.lock}
BREAKER=${TB_CLONE_BREAKER:-$RT/tb-clone-breaker}
FAILS=${TB_CLONE_FAILS:-$RT/tb-clone-fails}
MAX_CONSEC=${TB_CLONE_MAX_CONSEC:-3}
SLEEP_BASE=${TB_CLONE_SLEEP_BASE:-4}   # per-attempt clone backoff unit; tests set 0
PROBE_TIMEOUT=${TB_PROBE_TIMEOUT:-30}  # per ls-remote probe
PROBE_REPEAT=${TB_PROBE_REPEAT:-3}     # target must fail the signature this many times
PROBE_GAP=${TB_PROBE_GAP:-2}           # seconds between target probes; tests set 0
CONTROL_REPO=${TB_CONTROL_REPO:-pallets/flask}
# The auth/unavailable signature of an unauthenticated ls-remote against a repo
# this transport cannot see (private, deleted, or selectively blocked).
SIG='could not read Username|terminal prompts disabled|Authentication failed|Repository not found|repository .* not found|remote: Not Found'

is_clone=0
for a in "$@"; do [ "$a" = clone ] && { is_clone=1; break; }; done
[ "$is_clone" = 0 ] && exec "$REAL" "$@"

infra_log() {
  printf '{"event":"INFRASTRUCTURE_FAILURE","reason":"%s","at":"%s"}\n' \
    "$1" "$(date -u +%FT%TZ)" >> "${TB_INFRA_LOG:-$RT/tb-infra.jsonl}"
}
die_infra() { # trip the breaker and return the infra code; the MINER halts on it
  echo "tb-shim: INFRASTRUCTURE_FAILURE — $1" >&2
  infra_log "$1"
  : > "$BREAKER"
  exit 90
}

# One control probe. rc 0 = the transport reached the public control. Test hooks
# TB_FAKE_CONTROL1 / TB_FAKE_CONTROL2 supply an rc without a network.
probe_control() { # <1|2> -> rc
  local hook=""
  case "$1" in 1) hook=${TB_FAKE_CONTROL1:-};; 2) hook=${TB_FAKE_CONTROL2:-};; esac
  [ -n "$hook" ] && return "$hook"
  GIT_TERMINAL_PROMPT=0 timeout "$PROBE_TIMEOUT" "$PROBE_GIT" ls-remote "https://github.com/$CONTROL_REPO.git" HEAD >/dev/null 2>&1
}

# One target probe. Echoes exactly one of: unavailable | reachable | timeout |
# othererror. Test hook TB_FAKE_TARGET_KIND is a space-separated list consumed one
# per call (the last entry repeats), so a sequence like "unavailable unavailable
# reachable" scripts a target that recovers on the third probe.
probe_target() { # <url> <probe-index> -> kind
  if [ -n "${TB_FAKE_TARGET_KIND:-}" ]; then
    echo "$TB_FAKE_TARGET_KIND" | awk -v i="${2:-1}" '{ if (i<=NF) print $i; else print $NF }'
    return
  fi
  local out rc
  out=$(GIT_TERMINAL_PROMPT=0 timeout "$PROBE_TIMEOUT" "$PROBE_GIT" ls-remote "$1" HEAD 2>&1); rc=$?
  if [ "$rc" = 0 ]; then echo reachable
  elif [ "$rc" = 124 ]; then echo timeout
  elif printf '%s' "$out" | grep -qE "$SIG"; then echo unavailable
  else echo othererror; fi
}

classify_and_exit() { # <owner/repo-or-empty> <target-clone-url-or-empty>
  local slug="$1" url="$2" i kind
  [ -n "$url" ] || [ -n "${TB_FAKE_TARGET_KIND:-}" ] || die_infra "clone exhausted and no github target url to probe"
  # (2) control must be healthy BEFORE we trust a target failure.
  probe_control 1 || die_infra "control probe #1 failed — transport unhealthy, cannot attribute the clone failure to the target"
  # (3) target must fail the signature repeatedly; a success, timeout, or
  #     different error at any probe is infrastructure, not unavailability.
  for i in $(seq 1 "$PROBE_REPEAT"); do
    kind=$(probe_target "$url" "$i")
    case "$kind" in
      unavailable) ;;
      reachable)   die_infra "target became reachable on probe $i — not persistently unavailable";;
      timeout)     die_infra "target probe $i timed out — infrastructure, not unavailability";;
      *)           die_infra "target probe $i failed with a non-auth error — infrastructure";;
    esac
    [ "$i" -lt "$PROBE_REPEAT" ] && sleep "$PROBE_GAP"
  done
  # (4) control must STILL be healthy after the target checks.
  probe_control 2 || die_infra "control probe #2 failed — transport went unhealthy during the target check"
  echo "tb-shim: REPO_UNAVAILABLE $slug (target persistently unavailable across $PROBE_REPEAT probes, between two healthy controls)" >&2
  exit 91
}

# A breaker already tripped by a sibling: never start another clone.
[ -e "$BREAKER" ] && die_infra "breaker already tripped"

for attempt in 1 2 3; do
  if flock "$LOCK" "$REAL" "$@"; then
    : > "$FAILS"
    exit 0
  fi
  sleep $((attempt*SLEEP_BASE))
done

# (1) Exhausted. Extract the github clone URL (and owner/repo, for the message)
# from the args — empty for a non-github URL, e.g. the file:// base the self-tests
# use — then classify. The classifier decides REPO_UNAVAILABLE (91) vs infra (90);
# it never writes a verdict.
url=""
for a in "$@"; do case "$a" in *github.com[:/]*) url="$a";; esac; done
slug="$(printf '%s' "$url" | sed -E 's#^.*github\.com[:/]+##; s#\.git$##; s#/+$##')"
n=$(( $(cat "$FAILS" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$FAILS"
classify_and_exit "$slug" "$url"
