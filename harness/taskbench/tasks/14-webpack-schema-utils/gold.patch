+/** @typedef {import("ajv").KeywordErrorDefinition} KeywordErrorDefinition */
+/**
+ * @param {Ajv} ajv
+ * @returns {Ajv}
+ */
+declare function addLimitKeyword(ajv: Ajv): Ajv;
