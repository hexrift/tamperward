{
  "name": "tamperward",
  "version": "2.33.0",
  "description": "The deterministic agent-integrity gate. One ruleset, evaluated on the actual diff/commands as a verdict, enforced everywhere a change can be made.",
  "license": "Apache-2.0",
  "author": "hexrift",
  "homepage": "https://github.com/hexrift/tamperward#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexrift/tamperward.git"
  },
  "bugs": {
    "url": "https://github.com/hexrift/tamperward/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "coding-agents",
    "agent-safety",
    "reward-hacking",
    "code-integrity",
    "guardrails",
    "test-integrity",
    "pre-commit",
    "ci",
    "hooks",
    "llm",
    "devsecops"
  ],
  "type": "module",
  "bin": {
    "tamperward": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf-smoke": "vitest run --config vitest.perf-smoke.config.ts --no-file-parallelism",
    "check": "node dist/cli/index.js check",
    "probe:codex-runtime": "node harness/adapters/codex-probe.mjs",
    "probe:copilot-runtime": "node harness/adapters/copilot-probe.mjs",
    "spike:copilot-sdk": "node harness/adapters/copilot-sdk-spike.mjs"
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "typescript": "^5.6.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/picomatch": "^4.0.3",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "semver": "7.8.5",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^5.0.0"
  }
}
