{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hexrift/tamperward/blob/main/schemas/audit-event-v1.schema.json",
  "title": "TamperWard audit finding event v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "recorded_at",
    "event",
    "agent",
    "source",
    "rule",
    "severity",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{20,}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "const": "finding"
    },
    "agent": {
      "const": "claude-code"
    },
    "source": {
      "enum": [
        "pretooluse",
        "stop"
      ]
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "block",
        "warn"
      ]
    },
    "decision": {
      "enum": [
        "deny",
        "warn"
      ]
    },
    "session_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{20}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    }
  },
  "additionalProperties": false
}
