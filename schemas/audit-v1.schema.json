{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hexrift/tamperward/blob/main/schemas/audit-v1.schema.json",
  "title": "TamperWard audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "timestamp",
    "surface",
    "agent",
    "rule",
    "severity",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{32}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "surface": {
      "enum": [
        "pretooluse",
        "stop"
      ]
    },
    "agent": {
      "const": "claude-code"
    },
    "rule": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "severity": {
      "enum": [
        "block",
        "warn"
      ]
    },
    "decision": {
      "enum": [
        "deny",
        "warn"
      ]
    },
    "session": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{24}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {
            "const": "block"
          }
        },
        "required": [
          "severity"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "severity": {
            "const": "warn"
          }
        },
        "required": [
          "severity"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "const": "warn"
          }
        }
      }
    }
  ]
}
