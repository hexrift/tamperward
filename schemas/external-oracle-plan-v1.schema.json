{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hexrift/tamperward/v2.47.0/schemas/external-oracle-plan-v1.schema.json",
  "title": "TamperWard external Node JSON RPC oracle plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "image", "budget_secs", "cases"],
  "properties": {
    "protocol": {"const": "node-json-rpc-v1"},
    "image": {"type": "string", "pattern": "^(?!-)[^\\s@]+@sha256:[a-f0-9]{64}$"},
    "budget_secs": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["module", "export", "args", "expected"],
        "properties": {
          "module": {"type": "string", "maxLength": 240, "pattern": "^[A-Za-z0-9_./-]+\\.cjs$", "not": {"pattern": "(^/|(^|/)\\.\\.?(/|$)|//)"}},
          "export": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$"},
          "args": {"type": "array"}, "expected": {}
        }
      }
    }
  }
}
