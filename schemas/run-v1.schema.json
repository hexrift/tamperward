{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hexrift/tamperward/v2.38.0/schemas/run-v1.schema.json",
  "title": "TamperWard run JSON output v1",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "exit_code",
    "complete",
    "base",
    "agent",
    "verifier_backend",
    "dependency_environment"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verdict": {
      "enum": [
        "VERIFIED",
        "AGENT_TIMEOUT",
        "AGENT_FAILED",
        "ENFORCEMENT_FAILED",
        "CANNOT_ADJUDICATE",
        "OBJECT_REWRITE",
        "HISTORY_REWRITE",
        "DEPENDENCY_DRIFT",
        "NOT_QUIESCENT",
        "TRANSIENT_OBSERVER_BLOCK"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "complete": {
      "type": "boolean",
      "description": "true when both policy checks, verification and the quiescence boundary ran on the tree the agent left; false for early convictions (object/history rewrite, dependency drift before verification) and lifecycle refusals, which carry no `checks.verify`/`observer`."
    },
    "base": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "checks": {
      "$ref": "#/$defs/checks"
    },
    "verifier_backend": {
      "$ref": "#/$defs/backend"
    },
    "dependency_environment": {
      "$ref": "#/$defs/dependency_environment"
    },
    "observer": {
      "$ref": "#/$defs/observer"
    },
    "reason": {
      "enum": [
        "AGENT_LIFECYCLE_NOT_OWNED",
        "VERIFY_CANNOT_VERIFY",
        "CHECK_DIFF_UNJUDGEABLE",
        "CHECK_WORKTREE_UNJUDGEABLE"
      ],
      "description": "Present exactly when verdict is CANNOT_ADJUDICATE: which layer could not judge."
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "head",
          "checks",
          "observer"
        ],
        "properties": {
          "head": {},
          "checks": {
            "allOf": [
              {
                "$ref": "#/$defs/checks"
              },
              {
                "type": "object",
                "required": [
                  "diff",
                  "worktree",
                  "verify"
                ],
                "properties": {
                  "diff": {},
                  "worktree": {},
                  "verify": {}
                }
              }
            ]
          },
          "observer": {}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "verdict": {
            "const": "CANNOT_ADJUDICATE"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {},
          "exit_code": {
            "const": 2
          }
        }
      },
      "else": {
        "not": {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {}
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "verdict": {
            "enum": [
              "VERIFIED",
              "AGENT_FAILED",
              "AGENT_TIMEOUT",
              "ENFORCEMENT_FAILED",
              "NOT_QUIESCENT",
              "TRANSIENT_OBSERVER_BLOCK"
            ]
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "complete": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "verdict"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "head": {},
          "checks": {},
          "observer": {}
        },
        "required": [
          "head",
          "checks",
          "observer"
        ],
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "AGENT_TIMEOUT"
          }
        },
        "required": [
          "verdict"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 124
          },
          "agent": {
            "allOf": [
              {
                "$ref": "#/$defs/agent"
              },
              {
                "properties": {
                  "timed_out": {
                    "const": true
                  }
                },
                "required": [
                  "timed_out"
                ],
                "type": "object"
              }
            ]
          },
          "head": {},
          "checks": {},
          "observer": {}
        },
        "required": [
          "head",
          "checks",
          "observer"
        ],
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "ENFORCEMENT_FAILED",
              "OBJECT_REWRITE",
              "HISTORY_REWRITE",
              "DEPENDENCY_DRIFT",
              "NOT_QUIESCENT",
              "TRANSIENT_OBSERVER_BLOCK"
            ]
          }
        },
        "required": [
          "verdict"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "CANNOT_ADJUDICATE"
          }
        },
        "required": [
          "verdict"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "agent": {
      "type": "object",
      "required": [
        "exit_code",
        "timed_out",
        "lifecycle_owned"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "timed_out": {
          "type": "boolean"
        },
        "lifecycle_owned": {
          "type": "boolean"
        },
        "budget_secs": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "properties": {
        "diff": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "worktree": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "verify": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": true
    },
    "observer": {
      "type": "object",
      "required": [
        "enabled",
        "blocking"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "backend": {
      "type": "object",
      "required": [
        "kind",
        "trust",
        "available"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "container"
          ]
        },
        "trust": {
          "enum": [
            "checkpointed-local",
            "isolated-container"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "engine": {
          "const": "docker"
        },
        "reason": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "required": [
            "memory_bytes",
            "memory_swap_bytes",
            "cpus",
            "pids"
          ],
          "properties": {
            "memory_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "memory_swap_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "cpus": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pids": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "dependency_environment": {
      "type": "object",
      "required": [
        "status",
        "roots"
      ],
      "properties": {
        "status": {
          "enum": [
            "none",
            "attested",
            "unattestable",
            "verifier-owned"
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "path"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "node_modules",
                  "python-venv"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "fingerprint": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "diagnostics": {
          "type": "object",
          "required": [
            "full_snapshots",
            "reused_snapshots",
            "total_ms"
          ],
          "properties": {
            "full_snapshots": {
              "type": "integer",
              "minimum": 0
            },
            "reused_snapshots": {
              "type": "integer",
              "minimum": 0
            },
            "total_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "description": "Emitted by `tamperward run --json` as the single stdout document once the wrapped agent has started; agent stdout is routed to stderr in this mode. Pre-agent failures emit no document (stderr + exit 2). Additive within schema major 1.",
  "examples": [
    {
      "schema_version": 1,
      "verdict": "VERIFIED",
      "exit_code": 0,
      "complete": true,
      "base": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "agent": {
        "exit_code": 0,
        "timed_out": false,
        "lifecycle_owned": true
      },
      "checks": {
        "diff": 0,
        "worktree": 0,
        "verify": 0
      },
      "verifier_backend": {
        "kind": "local",
        "trust": "checkpointed-local",
        "available": true
      },
      "dependency_environment": {
        "status": "none",
        "roots": []
      },
      "observer": {
        "enabled": false,
        "blocking": false
      }
    }
  ]
}
