{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hexrift/tamperward/blob/main/schemas/stats-v1.schema.json",
  "title": "TamperWard audit stats v1",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "since",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "github"
          ]
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "github"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "repo",
              "branch"
            ]
          }
        }
      ]
    },
    "since": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "schema_version",
        "findings",
        "blocked",
        "warnings",
        "sessions_with_findings",
        "first_recorded_at",
        "last_recorded_at",
        "by_rule",
        "by_source"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "sessions_with_findings": {
          "type": "integer",
          "minimum": 0
        },
        "first_recorded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_recorded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "by_rule": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_source": {
          "type": "object",
          "required": [
            "pretooluse",
            "stop"
          ],
          "properties": {
            "pretooluse": {
              "type": "integer",
              "minimum": 0
            },
            "stop": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
