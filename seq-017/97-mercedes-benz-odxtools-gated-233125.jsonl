{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U16g9RitBWMwpWK4LyCZ1J","type":"tool_result","content":"1\t# SPDX-License-Identifier: MIT\n2\t\"\"\"Diagnostics emitted when a reference points to the wrong kind of DOP.\n3\t\n4\tThe ODX standard only allows simple DOPs in a few places, e.g. for the value\n5\tof a PHYS-CONST parameter. When a file violates this, the message needs to\n6\tname the offending element so that it can be found in a large database.\n7\t\"\"\"\n8\timport unittest\n9\t\n10\timport odxtools.exceptions as exceptions\n11\t\n12\tfrom odxtools.exceptions import OdxError\n13\tfrom odxtools.odxlink import (DocType, OdxDocFragment, OdxLinkDatabase, OdxLinkId, OdxLinkRef)\n14\tfrom odxtools.parameters.physicalconstantparameter import PhysicalConstantParameter\n15\tfrom odxtools.parameters.valueparameter import ValueParameter\n16\tfrom odxtools.nameditemlist import NamedItemList\n17\tfrom odxtools.snrefcontext import SnRefContext\n18\tfrom odxtools.structure import Structure\n19\t\n20\tdoc_frags = (OdxDocFragment(\"test\", DocType.CONTAINER),)\n21\t\n22\t\n23\tdef _structure(short_name: str) -> Structure:\n24\t    return Structure(\n25\t        odx_id=OdxLinkId(short_name, doc_frags),\n26\t        short_name=short_name,\n27\t        parameters=NamedItemList(),\n28\t    )\n29\t\n30\t\n31\tclass TestDopTypeDiagnostics(unittest.TestCase):\n32\t\n33\t    def setUp(self) -> None:\n34\t        self.structure = _structure(\"a_structure\")\n35\t        self.odxlinks = OdxLinkDatabase()\n36\t        self.odxlinks.update({self.structure.odx_id: self.structure})\n37\t        self.context = SnRefContext(use_weakrefs=False)\n38\t\n39\t    def test_physical_constant_parameter_names_the_element(self) -> None:\n40\t        param = PhysicalConstantParameter(\n41\t            short_name=\"the_constant\",\n42\t            physical_constant_value_raw=\"1\",\n43\t            dop_ref=OdxLinkRef.from_id(self.structure.odx_id),\n44\t        )\n45\t        param._resolve_odxlinks(self.odxlinks)\n46\t\n47\t        with self.assertRaises(OdxError) as ctx:\n48\t            param._resolve_snrefs(self.context)\n49\t\n50\t        message = str(ctx.exception)\n51\t        self.assertIn(\"the_constant\", message)\n52\t        self.assertIn(\"a_structure\", message)\n53\t        self.assertIn(\"Structure\", message)\n54\t\n55\t    def test_value_parameter_names_the_element(self) -> None:\n56\t        param = ValueParameter(\n57\t            short_name=\"the_value\",\n58\t            physical_default_value_raw=\"1\",\n59\t            dop_ref=OdxLinkRef.from_id(self.structure.odx_id),\n60\t        )\n61\t        param._resolve_odxlinks(self.odxlinks)\n62\t\n63\t        with self.assertRaises(OdxError) as ctx:\n64\t            param._resolve_snrefs(self.context)\n65\t\n66\t        message = str(ctx.exception)\n67\t        self.assertIn(\"the_value\", message)\n68\t        self.assertIn(\"a_structure\", message)\n69\t        self.assertIn(\"Structure\", message)\n70\t\n71\t    def test_unresolved_reference_is_not_reported_as_a_wrong_type(self) -> None:\n72\t        \"\"\"An unresolved DOP must read differently from one of the wrong type.\"\"\"\n73\t        param = PhysicalConstantParameter(\n74\t            short_name=\"the_constant\",\n75\t            physical_constant_value_raw=\"1\",\n76\t            dop_ref=OdxLinkRef(\"does_not_exist\", doc_frags),\n77\t        )\n78\t\n79\t        exceptions.strict_mode = False\n80\t        try:\n81\t            param._resolve_odxlinks(OdxLinkDatabase())\n82\t        finally:\n83\t            exceptions.strict_mode = True\n84\t\n85\t        self.assertIn(\"does_not_exist\", param.dop_info)\n86\t        self.assertIn(\"unresolvable\", param.dop_info)\n87\t\n88\t    def test_description_names_the_reference_as_written(self) -> None:\n89\t        \"\"\"The name in the message is the one the ODX file uses.\"\"\"\n90\t        param = PhysicalConstantParameter(\n91\t            short_name=\"the_constant\",\n92\t            physical_constant_value_raw=\"1\",\n93\t            dop_ref=OdxLinkRef.from_id(self.structure.odx_id),\n94\t        )\n95\t        param._resolve_odxlinks(self.odxlinks)\n96\t\n97\t        self.assertIn(\"a_structure\", param.dop_info)\n98\t        self.assertIn(\"Structure\", param.dop_info)\n99\t\n100\t\n101\tif __name__ == \"__main__\":\n102\t    unittest.main()\n103\t"}]},"parent_tool_use_id":null,"session_id":"e3fbea2d-a7eb-45e2-925a-ff35d3f48e2e","uuid":"5ef29095-07e9-44f7-a6a9-a7b562286c40","timestamp":"2026-09-09T23:31:52.482Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-fBMxSs/repo/tests/test_dop_type_diagnostics.py","content":"# SPDX-License-Identifier: MIT\n\"\"\"Diagnostics emitted when a reference points to the wrong kind of DOP.\n\nThe ODX standard only allows simple DOPs in a few places, e.g. for the value\nof a PHYS-CONST parameter. When a file violates this, the message needs to\nname the offending element so that it can be found in a large database.\n\"\"\"\nimport unittest\n\nimport odxtools.exceptions as exceptions\n\nfrom odxtools.exceptions import OdxError\nfrom odxtools.odxlink import (DocType, OdxDocFragment, OdxLinkDatabase, OdxLinkId, OdxLinkRef)\nfrom odxtools.parameters.physicalconstantparameter import PhysicalConstantParameter\nfrom odxtools.parameters.valueparameter import ValueParameter\nfrom odxtools.nameditemlist import NamedItemList\nfrom odxtools.snrefcontext import SnRefContext\nfrom odxtools.structure import Structure\n\ndoc_frags = (OdxDocFragment(\"test\", DocType.CONTAINER),)\n\n\ndef _structure(short_name: str) -> Structure:\n    return Structure(\n        odx_id=OdxLinkId(short_name, doc_frags),\n        short_name=short_name,\n        parameters=NamedItemList(),\n    )\n\n\nclass TestDopTypeDiagnostics(unittest.TestCase):\n\n    def setUp(self) -> None:\n        self.structure = _structure(\"a_structure\")\n        self.odxlinks = OdxLinkDatabase()\n        self.odxlinks.update({self.structure.odx_id: self.structure})\n        self.context = SnRefContext(use_weakrefs=False)\n\n    def test_physical_constant_parameter_names_the_element(self) -> None:\n        param = PhysicalConstantParameter(\n            short_name=\"the_constant\",\n            physical_constant_value_raw=\"1\",\n            dop_ref=OdxLinkRef.from_id(self.structure.odx_id),\n        )\n        param._resolve_odxlinks(self.odxlinks)\n\n        with self.assertRaises(OdxError) as ctx:\n            param._resolve_snrefs(self.context)\n\n        message = str(ctx.exception)\n        self.assertIn(\"the_constant\", message)\n        self.assertIn(\"a_structure\", message)\n        self.assertIn(\"Structure\", message)\n\n    def test_value_parameter_names_the_element(self) -> None:\n        param = ValueParameter(\n            short_name=\"the_value\",\n            physical_default_value_raw=\"1\",\n            dop_ref=OdxLinkRef.from_id(self.structure.odx_id),\n        )\n        param._resolve_odxlinks(self.odxlinks)\n\n        with self.assertRaises(OdxError) as ctx:\n            param._resolve_snrefs(self.context)\n\n        message = str(ctx.exception)\n        self.assertIn(\"the_value\", message)\n        self.assertIn(\"a_structure\", message)\n        self.assertIn(\"Structure\", message)\n\n    def test_unresolved_reference_is_not_reported_as_a_wrong_type(self) -> None:\n        \"\"\"An unresolved DOP must read differently from one of the wrong type.\"\"\"\n        param = PhysicalConstantParameter(\n            short_name=\"the_constant\",\n            physical_constant_value_raw=\"1\",\n            dop_ref=OdxLinkRef(\"does_not_exist\", doc_frags),\n        )\n\n        exceptions.strict_mode = False\n        try:\n            param._resolve_odxlinks(OdxLinkDatabase())\n        finally:\n            exceptions.strict_mode = True\n\n        self.assertIn(\"does_not_exist\", param.dop_info)\n        self.assertIn(\"unresolvable\", param.dop_info)\n\n    def test_description_names_the_reference_as_written(self) -> None:\n        \"\"\"The name in the message is the one the ODX file uses.\"\"\"\n        param = PhysicalConstantParameter(\n            short_name=\"the_constant\",\n            physical_constant_value_raw=\"1\",\n            dop_ref=OdxLinkRef.from_id(self.structure.odx_id),\n        )\n        param._resolve_odxlinks(self.odxlinks)\n\n        self.assertIn(\"a_structure\", param.dop_info)\n        self.assertIn(\"Structure\", param.dop_info)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":103,"startLine":1,"totalLines":103}}}
