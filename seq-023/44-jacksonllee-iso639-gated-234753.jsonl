{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ed8gPtR8SorKanbY6e1SnF","type":"tool_result","content":"1\t\"\"\"The Language class.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport datetime\n6\tfrom dataclasses import dataclass\n7\t\n8\tfrom typing import NoReturn\n9\t\n10\tfrom ._data import (\n11\t    _PART3_TO_CODES,\n12\t    _PART3_TO_NAME_INDEX,\n13\t    _PART3_TO_MACROLANGUAGES,\n14\t    _PART3_TO_RETIREMENTS,\n15\t    _PART2B_TO_PART3,\n16\t    _PART2T_TO_PART3,\n17\t    _PART1_TO_PART3,\n18\t    _REF_NAME_TO_PART3,\n19\t    _PRINT_NAME_TO_PART3,\n20\t    _INVERTED_NAME_TO_PART3,\n21\t    _CodesColumn,\n22\t    _NameIndexColumn,\n23\t    _RetirementsColumn,\n24\t    _MacrolanguagesColumn,\n25\t    _COLUMN_TYPE,\n26\t)\n27\t\n28\t\n29\t_STRING_CLEANING_FUNCS = [\n30\t    lambda x: x.strip().lower(),\n31\t    lambda x: x.strip().title(),\n32\t]\n33\t\n34\t\n35\tclass LanguageNotFoundError(Exception):\n36\t    pass\n37\t\n38\t\n39\t@dataclass(frozen=True)\n40\tclass Name:\n41\t    \"\"\"Represents an alternative name of a language.\"\"\"\n42\t\n43\t    __slots__ = (\"print\", \"inverted\")\n44\t    print: str\n45\t    inverted: str\n46\t\n47\t\n48\t@dataclass(frozen=True)\n49\tclass Language:\n50\t    \"\"\"Represents a language in the ISO 639-3 charts.\"\"\"\n51\t\n52\t    __slots__ = (\n53\t        # From the \"codes\" table\n54\t        \"part3\",\n55\t        \"part2b\",\n56\t        \"part2t\",\n57\t        \"part1\",\n58\t        \"scope\",\n59\t        \"type\",\n60\t        \"status\",\n61\t        \"name\",\n62\t        \"comment\",\n63\t        # From the \"name_index\" table\n64\t        \"other_names\",\n65\t        # From the \"macrolanguages\" table\n66\t        \"macrolanguage\",\n67\t        # From the \"retirements\" table\n68\t        \"retire_reason\",\n69\t        \"retire_change_to\",\n70\t        \"retire_remedy\",\n71\t        \"retire_date\",\n72\t    )\n73\t\n74\t    # From the \"codes\" table\n75\t    part3: str\n76\t    part2b: str | None\n77\t    part2t: str | None\n78\t    part1: str | None\n79\t    scope: str\n80\t    type: str | None\n81\t    status: str\n82\t    name: str\n83\t    comment: str | None\n84\t\n85\t    # From the \"name_index\" table\n86\t    other_names: list[Name] | None\n87\t\n88\t    # From the \"macrolanguages\" table\n89\t    macrolanguage: str | None\n90\t\n91\t    # From the \"retirements\" table\n92\t    retire_reason: str | None\n93\t    retire_change_to: str | None\n94\t    retire_remedy: str | None\n95\t    retire_date: datetime.date | None\n96\t\n97\t    def __hash__(self) -> int:\n98\t        return hash(self.part3)\n99\t\n100\t    def __eq__(self, other) -> bool:\n101\t        return isinstance(other, Language) and self.part3 == other.part3\n102\t\n103\t    @classmethod\n104\t    def match(cls, user_input: str, /, *, exact: bool = False) -> Language:\n105\t        \"\"\"Return a ``Language`` instance by matching on the user input.\n106\t\n107\t        Parameters\n108\t        ----------\n109\t        user_input : str\n110\t            A language code or name.\n111\t        exact : bool, optional\n112\t            Whether to enforce exact matching against the user input.\n113\t            Defaults to `False`. If `False`, matching is case-insensitive\n114\t            and ignores leading/trailing whitespace.\n115\t\n116\t        Returns\n117\t        -------\n118\t        Language\n119\t\n120\t        Notes\n121\t        -----\n122\t        At a high level, `Language.match` assumes the input is more likely to be\n123\t        a language code rather than a language name.\n124\t        Beyond that, the precise order in matching is as follows:\n125\t\n126\t        * ISO 639-3 codes (among the active codes)\n127\t        * ISO 639-2 (bibliographic) codes\n128\t        * ISO 639-2 (terminological) codes\n129\t        * ISO 639-1 codes\n130\t        * ISO 639-3 codes (among the retired codes)\n131\t        * ISO 639-3 reference