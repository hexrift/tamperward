 generator = client.results(arxiv.Search(query=\"testing\", max_results=55))\n48\t        results = [r for r in generator]\n49\t\n50\t        # NOTE: don't directly assert on call count; allow for retries.\n51\t        unique_urls = set()\n52\t        for parse_call in client._parse_feed.call_args_list:\n53\t            args, _kwargs = parse_call\n54\t            unique_urls.add(args[0])\n55\t\n56\t        self.assertEqual(len(results), 55)\n57\t        self.assertSetEqual(\n58\t            unique_urls,\n59\t            {\n60\t                \"https://export.arxiv.org/api/query?search_query=testing&id_list=&sortBy=relevance&sortOrder=descending&start=0&max_results=10\",\n61\t                \"https://export.arxiv.org/api/query?search_query=testing&id_list=&sortBy=relevance&sortOrder=descending&start=10&max_results=10\",\n62\t                \"https://export.arxiv.org/api/query?search_query=testing&id_list=&sortBy=relevance&sortOrder=descending&start=20&max_results=10\",\n63\t                \"https://export.arxiv.org/api/query?search_query=testing&id_list=&sortBy=relevance&sortOrder=descending&start=30&max_results=10\",\n64\t                \"https://export.arxiv.org/api/query?search_query=testing&id_list=&sortBy=relevance&sortOrder=descending&start=40&max_results=10\",\n65\t                \"https://export.arxiv.org/api/query?search_query=testing&id_list=&sortBy=relevance&sortOrder=descending&start=50&max_results=10\",\n66\t            },\n67\t        )\n68\t\n69\t    def test_offset(self):\n70\t        max_results = 10\n71\t        search = arxiv.Search(query=\"testing\", max_results=max_results)\n72\t        client = arxiv.Client(page_size=10)\n73\t\n74\t        default = list(client.results(search))\n75\t        no_offset = list(client.results(search))\n76\t        self.assertListEqual(default, no_offset)\n77\t\n78\t        offset = max_results // 2\n79\t        half_offset = list(client.results(search, offset=offset))\n80\t        self.assertListEqual(default[