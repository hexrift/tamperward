{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LyLYFJupSPJz7bN3fJxjNA","type":"tool_result","content":"1\t\"\"\"\n2\tFunctions for handling encoding of web pages\n3\t\"\"\"\n4\t\n5\tfrom __future__ import annotations\n6\t\n7\timport codecs\n8\timport encodings\n9\timport re\n10\tfrom re import Match\n11\tfrom typing import TYPE_CHECKING, cast\n12\t\n13\timport w3lib.util\n14\t\n15\tif TYPE_CHECKING:\n16\t    from collections.abc import Callable\n17\t\n18\t    from w3lib._types import AnyUnicodeError\n19\t\n20\t# The value ends at whitespace, \";\", \",\" or the end of the header. Comma is\n21\t# not parameter syntax; stopping the value at \",\" approximates Fetch's\n22\t# \"extract a MIME type\" for comma-joined duplicate headers, keeping the first\n23\t# charset rather than the last valid MIME type's.\n24\t_HEADER_ENCODING_RE = re.compile(\n25\t    r\"(?:^|;)[ \\t]*charset=\"\n26\t    r'(?:\"([\\w-]+)\"|([\\w-]+))'\n27\t    r\"(?![^\\s;,])\",\n28\t    re.IGNORECASE,\n29\t)\n30\t# https://mimesniff.spec.whatwg.org/commit-snapshots/39aa53511b13953d84fef8d4131d6f61d0ccbde6/#parse-a-mime-type\n31\t# Parameters are \";\"-separated name=value pairs whose value is either a token\n32\t# or a quoted-string, and a quoted-string is opaque\n33\t# (https://fetch.spec.whatwg.org/commit-snapshots/586cd2a44c2a865b37c166dc0740f3fb8bb220d6/#collect-an-http-quoted-string),\n34\t# so it has to be consumed as a whole: a \"charset=\" written inside one belongs\n35\t# to that value and is not a parameter of its own.\n36\t_HEADER_PARAMETER_RE = re.compile(\n37\t    r\"(?:^|;)[ \\t]*(?P<name>[^\\s;=]+)=\"\n38\t    r'(?:\"(?P<quoted>[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*)\"(?![^\\s;,])'\n39\t    r\"|(?P<token>[^;,\\s]*))\"\n40\t)\n41\t_ENCODING_LABEL_RE = re.compile(r\"[\\w-]+\")\n42\t\n43\t\n44\tdef _quoted_aware_charset(content_type: str) -> str | None:\n45\t    for match in _HEADER_PARAMETER_RE.finditer(content_type):\n46\t        if match.group(\"name\").lower() != \"charset\":\n47\t            continue\n48\t        label = match.group(\"quoted\")\n49\t        if label is None:\n50\t            label = match.group(\"token\")\n51\t        if _ENCODING_LABEL_RE.fullmatch(label):\n52\t            return resolve_encoding(label)\n53\t    return None\n54\t\n55\t\n56\tdef http_content_type_encoding(content_type: str | None) -> str | None:\n57\t    \"\"\"Extract the encoding in the content-type header\n58\t\n59\t    >>> import w3lib.encoding\n60\t    >>> w3lib.encoding.http_content_type_encoding(\"Content-Type: text/html; charset=ISO-8859-4\")\n61\t    'iso8859-4'\n62\t\n63\t    \"\"\"\n64\t\n65\t    if content_type:\n66\t        match = _HEADER_ENCODING_RE.search(content_type)\n67\t        if match:\n68\t            # A match inside a quoted-string must be preceded by that string's\n69\t            # opening quote, so if no '\"' precedes it the fast answer is\n70\t            # correct; only otherwise walk the parameters.\n71\t            if content_type.find('\"', 0, match.start()) < 0:\n72\t                return resolve_encoding(match.group(1) or match.group(2))\n73\t            return _quoted_aware_charset(content_type)\n74\t\n75\t    return None\n76\t\n77\t\n78\t# Check for a charset in a meta tag or an xml declaration, and stop the search\n79\t# if a body tag is encountered. Any meta tag with a charset counts, however it\n80\t# spells its other attributes, e.g. <meta httpequiv=\"ContentType\"\n81\t# content=\"text/html; charset=gbk\">.\n82\t_BODY_ENCODING_PATTERN = (\n83\t    r\"\"\"<\\s*(?:meta\\s+[^>]*?charset\\s*=\\s*[\"']?\\s*(?P<charset>[\\w-]+)\"\"\"\n84\t    r\"\"\"|\\?xml\\s[^>]+encoding\\s*=\\s*[\"']?\\s*(?P<xmlcharset>[\\w-]+)\"\"\"\n85\t    r\"\"\"|body)\"\"\"\n86\t)\n87\t_BODY_ENCODING_STR_RE = re.compile(_BODY_ENCODING_PATTERN, re.IGNORECASE)\n88\t_BODY_ENCODING_BYTES_RE = re.compile(\n89\t    _BODY_ENCODING_PATTERN.encode(\"ascii\"), re.IGNORECASE\n90\t)\n91\t\n92\t\n93\tdef html_body_declared_encoding(html_body_str: str | bytes) -> str | None:\n94\t    '''Return the encoding specified in meta tags in the html body,\n95\t    or ``None`` if no suitable encoding was found\n96\t\n97\t    >>> import w3lib.encoding\n98\t    >>> w3lib.encoding.html_body_declared_encoding(\n99\t    ... \"\"\"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\"\n100\t    ...      \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n101\t    ... <html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\n102\t    ... <head>\n103\t    ...     <title>Some title</title>\n104\t    ...     <meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\" />\n105\t    ... </head>\n106\t    ... <body>\n107\t    ... ...\n108\t    ... </body>\n109\t    ... </html>\"\"\")\n110\t    'utf-8'\n111\t    >>>\n112\t\n113\t    '''\n114\t\n115\t    # html5 suggests the first 1024 bytes are sufficient, we allow for more\n116\t    chunk = html_body_str[:4096]\n117\t    match: Match[bytes] | Match[str] | None\n118\t    if isinstance(chunk, bytes):\n119\t        match = _BODY_ENCODING_BYTES_RE.search(chunk)\n120\t    else:\n121\t        match = _BODY_ENCODING_STR_RE.search(chunk)\n122\t\n123\t    if match:\n124\t        encoding = match.group(\"charset\") or match.group(\"xmlcharset\")\n125\t        if encoding:\n126\t            return resolve_encoding(w3lib.util.to_unicode(encoding))\n127\t\n128\t    return None\n129\t\n130\t\n131\t# Default encoding translation\n132\t# this maps cannonicalized encodings to target encodings\n133\t# see http://www.whatwg.org/specs/web-apps/current-work/multipage/parsing.html#character-encodings-0\n134\t# in addition, gb18030 supercedes gb2312 & gbk\n135\t# the keys are converted using _c18n_encoding and in sorted order\n136\tDEFAULT_ENCODING_TRANSLATION = {\n137\t    \"ascii\": \"cp1252\",\n138\t    \"big5\": \"big5hkscs\",\n139\t    \"euc_kr\": \"cp949\",\n140\t    \"gb2312\": \"gb18030\","}]},"parent_tool_use_id":null,"session_id":"a3bfacfa-b319-459f-99b4-c7d