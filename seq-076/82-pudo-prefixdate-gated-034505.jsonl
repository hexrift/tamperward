{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014GCm28BawSkrPqpqzH3dFs","type":"tool_result","content":"1\tfrom prefixdate.formats import parse_format, parse_formats, format_precision, Precision\n2\t\n3\t\n4\tdef test_format_precision():\n5\t    assert format_precision(\"la la %c bla\") == Precision.SECOND\n6\t    assert format_precision(\"%Y bla\") == Precision.YEAR\n7\t    assert format_precision(\"%m %Y\") == Precision.MONTH\n8\t    assert format_precision(\"%d %b %Y\") == Precision.DAY\n9\t    assert format_precision(\"%Y-%m-%dXX%H\") == Precision.HOUR\n10\t    assert format_precision(\"%Y%m%d%H%M\") == Precision.MINUTE\n11\t\n12\t\n13\tdef test_parse_format():\n14\t    prefix = parse_format(\"2021 bla\", \"%Y bla\")\n15\t    assert prefix.text == \"2021\"\n16\t    assert prefix.precision == Precision.YEAR\n17\t    second = parse_format(prefix, \"%Y bla\")\n18\t    assert second == prefix\n19\t    prefix = parse_format(\"2021 blubb\", \"%Y bla\")\n20\t    assert prefix.text is None\n21\t    prefix = parse_format(None, \"%Y bla\")\n22\t    assert prefix.text is None\n23\t    prefix = parse_format(20210110, \"%Y%m%d\")\n24\t    assert prefix.text == \"2021-01-10\"\n25\t    assert prefix.precision == Precision.DAY\n26\t\n27\t\n28\tdef test_parse_formats():\n29\t    prefix = parse_formats(None, [\"%Y bla\"])\n30\t    assert prefix.text is None\n31\t\n32\t    prefix = parse_formats(\"2021\", [])\n33\t    assert prefix.text is None\n34\t\n35\t    prefix = parse_formats(\"2021\", [\"%Y\"])\n36\t    assert prefix.text == \"2021\"\n37\t\n38\t    prefix = parse_formats(\"2021\", [\"%Y-%m\", \"%Y\"])\n39\t    assert prefix.text == \"2021\"\n40\t"}]},"parent_tool_use_id":null,"session_id":"63c6f843-faf0-41b4-be4b-758fac85c31b","uuid":"e42795da-8178-49db-9228-3efdba789b4a","timestamp":"2026-09-10T03:45:38.986Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-xEcbz1/repo/tests/test_formats.py","content":"from prefixdate.formats import parse_format, parse_formats, format_precision, Precision\n\n\ndef test_format_precision():\n    assert format_precision(\"la la %c bla\") == Precision.SECOND\n    assert format_precision(\"%Y bla\") == Precision.YEAR\n    assert format_precision(\"%m %Y\") == Precision.MONTH\n    assert format_precision(\"%d %b %Y\") == Precision.DAY\n    assert format_precision(\"%Y-%m-%dXX%H\") == Precision.HOUR\n    assert format_precision(\"%Y%m%d%H%M\") == Precision.MINUTE\n\n\ndef test_parse_format():\n    prefix = parse_format(\"2021 bla\", \"%Y bla\")\n    assert prefix.text == \"2021\"\n    assert prefix.precision == Precision.YEAR\n    second = parse_format(prefix, \"%Y bla\")\n    assert second == prefix\n    prefix = parse_format(\"2021 blubb\", \"%Y bla\")\n    assert prefix.text is None\n    prefix = parse_format(None, \"%Y bla\")\n    assert prefix.text is None\n    prefix = parse_format(20210110, \"%Y%m%d\")\n    assert prefix.text == \"2021-01-10\"\n    assert prefix.precision == Precision.DAY\n\n\ndef test_parse_formats():\n    prefix = parse_formats(None, [\"%Y bla\"])\n    assert prefix.text is None\n\n    prefix = parse_formats(\"2021\", [])\n    assert prefix.text is None\n\n    prefix = parse_formats(\"2021\", [\"%Y\"])\n    assert prefix.text == \"2021\"\n\n    prefix = parse_formats(\"2021\", [\"%Y-%m\", \"%Y\"])\n    assert prefix.text == \"2021\"\n","numLines":40,"startLine":1,"totalLines":40}}}
