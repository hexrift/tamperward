{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H5r6fGPw7deCQUJxf7r6cq","type":"tool_result","content":"1\t\"\"\"\n2\tModule contains internal SQLToken that creates linked list\n3\t\"\"\"\n4\t\n5\tfrom typing import Dict, List, Union\n6\t\n7\timport sqlparse.sql\n8\tfrom sqlparse.tokens import Comment, Name, Number, Punctuation, Wildcard, Keyword\n9\t\n10\tfrom sql_metadata.keywords_lists import (\n11\t    KEYWORDS_BEFORE_COLUMNS,\n12\t    RELEVANT_KEYWORDS,\n13\t    QueryType,\n14\t    TABLE_ADJUSTMENT_KEYWORDS,\n15\t)\n16\t\n17\t\n18\tclass SQLToken:  # pylint: disable=R0902, R0904\n19\t    \"\"\"\n20\t    Class representing single token and connected into linked list\n21\t    \"\"\"\n22\t\n23\t    def __init__(\n24\t        self,\n25\t        tok: sqlparse.sql.Token = None,\n26\t        index: int = -1,\n27\t        subquery_level: int = 0,\n28\t        last_keyword: str = None,\n29\t    ):\n30\t        self.position = index\n31\t        if tok is None:\n32\t            self._set_default_values()\n33\t        else:\n34\t            self.value = tok.value.strip(\"`\").strip('\"')\n35\t            self.is_keyword = tok.is_keyword or (\n36\t                tok.ttype.parent is Name and tok.ttype is not Name\n37\t            )\n38\t            self.is_name = tok.ttype is Name\n39\t            self.is_punctuation = tok.ttype is Punctuation\n40\t            self.is_dot = str(tok) == \".\"\n41\t            self.is_wildcard = tok.ttype is Wildcard\n42\t            self.is_integer = tok.ttype is Number.Integer\n43\t            self.is_float = tok.ttype is Number.Float\n44\t            self.is_comment = tok.ttype is Comment or tok.ttype.parent == Comment\n45\t            self.is_as_keyword = tok.ttype is Keyword and tok.normalized == \"AS\"\n46\t\n47\t            self.is_left_parenthesis = str(tok) == \"(\"\n48\t            self.is_right_parenthesis = str(tok) == \")\"\n49\t            self.last_keyword = last_keyword\n50\t            self.next_token = EmptyToken\n51\t            self.previous_token = EmptyToken\n52\t            self.subquery_level = subquery_level\n53\t        self.token_type = None\n54\t\n55\t        self._set_default_parenthesis_status()\n56\t\n57\t    def _set_default_values(self):\n58\t        self.value = \"\"\n59\t        self.is_keyword = False\n60\t        self.is_name = False\n61\t        self.is_punctuation = False\n62\t        self.is_dot = False\n63\t        self.is_wildcard = False\n64\t        self.is_integer = False\n65\t        self.is_float = False\n66\t        self.is_comment = False\n67\t        self.is_as_keyword = False\n68\t\n69\t        self.is_left_parenthesis = False\n70\t        self.is_right_parenthesis = False\n71\t        self.last_keyword = None\n72\t        self.subquery_level = 0\n73\t        self.next_token = None\n74\t        self.previous_token = None\n75\t\n76\t    def _set_default_parenthesis_status(self):\n77\t        self.is_in_nested_function = False\n78\t        self.parenthesis_level = 0\n79\t        self.is_subquery_start = False\n80\t        self.is_subquery_end = False\n81\t        self.is_with_query_start = False\n82\t        self.is_with_query_end = False\n83\t        self.is_with_columns_start = False\n84\t        self.is_with_columns_end = False\n85\t        self.is_nested_function_start = False\n86\t        self.is_nested_function_end = False\n87\t        self.is_column_definition_start = False\n88\t        self.is_column_definition_end = False\n89\t        self.is_create_table_columns_declaration_start = False\n90\t        self.is_create_table_columns_declaration_end = False\n91\t        self.is_partition_clause_start = False\n92\t        self.is_partition_clause_end = False\n93\t\n94\t    def __str__(self):\n95\t        \"\"\"\n96\t        String representation\n97\t        \"\"\"\n98\t        return self.value.strip('\"')\n99\t\n100\t    def __repr__(self) -> str:  # pragma: no cover\n101\t        \"\"\"\n102\t        Representation - useful for debugging\n103\t        \"\"\"\n104\t        repr_str = [\"=\".join([str(k), str(v)]) for k, v in self.__dict__.items()]\n105\t        return f\"SQLToken({','.join(repr_str)})\"\n106\t\n107\t    @property\n108\t    def normalized(self) -> str:\n109\t        \"\"\"\n110\t        Property returning uppercase value without end lines and spaces\n111\t        \"\"\"\n112\t        return self.value.translate(str.maketrans(\"\", \"\", \" \\n\\t\\r\")).upper()\n113\t\n114\t    @property\n115\t    def stringified_token(self) -> str:\n116\t        \"\"\"\n117\t        Returns string representation with whitespace or not - used to rebuild query\n118\t        from list of tokens\n119\t        \"\"\"\n120\t        if self.previous_token:\n121\t            if (\n122\t                self.normalized in [\")\", \".\", \",\"]\n123\t                or self.previous_token.normalized in [\"(\", \".\"]\n124\t                or (\n125\t                    self.is_left_parenthesis\n126\t                    and self.previous_token.normalized\n127\t                    not in RELEVANT_KEYWORDS.union({\"*\", \",\", \"IN\", \"NOTIN\"})\n128\t                )\n129\t            ):\n130\t                return str(self)\n131\t            return f\" {self}\"\n132\t        return str(self)  # pragma: no cover\n133\t\n134\t    @property\n135\t    def last_keyword_normalized(self) -> str:\n136\t        \"\"\"\n137\t        Property returning uppercase last keyword without end lines and spaces\n138\t        \"\"\"\n139\t        if self.last_keyword:\n140\t            return self.last_keyword.translate(str.maketrans(\"\", \"\", \" \\n\\t\\r\")).upper()\n141\t        return \"\"\n142\t\n143\t    @property\n144\t    def is_in_parenthesis(self) -> bool:\n145\t        \"\"\"\n146\t        Property checks if token is surrounded with brackets ()\n147\t        \"\"\"\n148\t        return self.parenthesis_level > 0\n149\t\n150\t    @property\n151\t    def is_create_table_columns_definition(self) -> bool:\n152\t        \"\"\"\n153\t        Checks if given token is inside columns definition in\n154\t        create table query like: create table name (<columns def>)\n155\t        \"\"\"\n156\t        open_parenthesis = self.find_nearest_token(\n157\t            True, value_attribute=\"is_create_table_columns_declaration_start\"\n158\t        )\n159\t        if open_parenthesis is EmptyToken:\n160\t            return False\n161\t        close_parenthesis = self.find_nearest_token(\n162\t            True,\n163\t            direction=\"right\",\n164\t            value_attribute=\"is_create_table_columns_declaration_end\",\n165\t        )\n166\t        return (\n167\t            open_parenthesis is not EmptyToken and close_parenthesis is not EmptyToken\n168\t        )\n169\t\n170\t    @property\n171\t    def is_keyword_column_name(self) -> bool:\n172\t        \"\"\"\n173\t        Checks if given keyword can be a column name in SELECT query\n174\t        \"\"\"\n175\t        return (\n176\t            self.is_keyword\n177\t            and self.normalized not in RELEVANT_KEYWORDS\n178\t            and self.previous_token.normalized in [\",\", \"SELECT\"]\n179\t            and self.next_token.normalized in [\",\", \"AS\"]\n180\t        )\n181\t\n182\t    @property\n183\t    def is_alias_without_as(self) -> bool:\n184\t        \"\"\"\n185\t        Checks if a given token is an alias without as keyword,\n186\t        like: SELECT col <alias1>, col2 <alias2> from table\n187\t        \"\"\"\n188\t        return (\n189\t            self.next_token.normalized in [\",\", \"FROM\"]\n190\t            and self.previous_token.normalized not in [\"*\", \",\", \".\", \"(\", \"SELECT\"]\n191\t            and not self.previous_token.is_keyword\n192\t            and (\n193\t                self.last_keyword_normalized == \"SELECT\"\n194\t                or self.previous_token.is_column_definition_end\n195\t                or self.previous_token.is_partition_clause_end\n196\t            )\n197\t            and not self.previous_token.is_comment\n198\t        )\n199\t\n200\t    @property\n201\t    def is_alias_definition(self):\n202\t        \"\"\"\n203\t        Returns if current token is a definition of an alias.\n204\t        Note that aliases can also be used in other queries and be a part\n205\t        of other nested columns with aliases.\n206\t\n207\t        Note that this function only check if alias token is a token with\n208\t        alias definition, it's not suitable for determining IF token is an alias\n209\t        as it's more complicated and this method would match\n210\t        also i.e. sub-queries names\n211\t        \"\"\"\n212\t        return (\n213\t            self.is_alias_without_as\n214\t            or self.previous_token.normalized == \"AS\"\n215\t            or self.is_in_with_columns\n216\t        )\n217\t\n218\t    @property\n219\t    def is_alias_of_self(self) -> bool:\n220\t        \"\"\"\n221\t        Checks if a given token is an alias but at the same time\n222\t        is also an alias of self, so not really an alias\n223\t        \"\"\"\n224\t\n225\t        end_of_column = self.find_nearest_token(\n226\t            [\",\", \"FROM\"], value_attribute=\"normalized\", direction=\"right\"\n227\t        )\n228\t        while end_of_column.is_in_nested_function:\n229\t            end_of_column = end_of_column.find_nearest_token(\n230\t                [\",\", \"FROM\"], value_attribute=\"normalized\", direction=\"right\"\n231\t            )\n232\t        return end_of_column.previous_token.normalized == self.normalized\n233\t\n234\t    @property\n235\t    def is_in_with_columns(self) -> bool:\n236\t        \"\"\"\n237\t        Checks if token is inside with colums part of a query\n238\t        \"\"\"\n239\t        return (\n240\t            self.find_nearest_token(\"(\").is_with_columns_start\n241\t            and self.find_nearest_token(\")\", direction=\"right\").is_with_columns_end\n242\t        )\n243\t\n244\t    @property\n245\t    def is_wildcard_not_operator(self):\n246\t        \"\"\"\n247\t        Determines if * encountered in query is a wildcard like select <*> from aa\n248\t        or is that an operator like Select aa <*> bb as cc from dd\n249\t        \"\"\"\n250\t        return self.normalized == \"*\" and (\n251\t            self.previous_token.value in [\",\", \".\", \"SELECT\"]\n252\t            or (self.previous_token.value == \"(\")\n253\t            and self.next_token.value == \")\"\n254\t        )\n255\t\n256\t    @property\n257\t    def is_potential_table_name(self) -> bool:\n258\t        \"\"\"\n259\t        Checks if token is a possible candidate for table name\n260\t        \"\"\"\n261\t        return (\n262\t            (self.is_name or self.is_keyword)\n263\t            and self.last_keyword_normalized in TABLE_ADJUSTMENT_KEYWORDS\n264\t            and self.previous_token.normalized not in [\"AS\", \"WITH\"]\n265\t            and self.normalized\n266\t            not in [\"AS\", \"SELECT\", \"IF\", \"SET\", \"WITH\", \"IFNOTEXISTS\"]\n267\t        )\n268\t\n269\t    @property\n270\t    def is_with_statement_nested_in_subquery(self) -> bool:\n271\t        \"\"\"\n272\t        Checks if token is with statement nested in subquery\n273\t        \"\"\"\n274\t        return (\n275\t            self.normalized == \"WITH\"\n276\t            and self.previous_token.is_left_parenthesis\n277\t            and self.get_nth_previous(2).normalized == \"FROM\"\n278\t        )\n279\t\n280\t    @property\n281\t    def is_alias_of_table_or_alias_of_subquery(self) -> bool:\n282\t        \"\"\"\n283\t        Checks if token is alias of table or alias of subquery\n284\t\n285\t        It's not a list of tables, e.g. SELECT * FROM foo, bar\n286\t        hence, it can be the case of alias without AS, e.g. SELECT * FROM foo bar\n287\t        or an alias of subquery (SELECT * FROM foo) bar\n288\t        \"\"\"\n289\t        is_alias_without_as = (\n290\t            self.previous_token.normalized != self.last_keyword_normalized\n291\t            and not self.previous_token.is_punctuation\n292\t            and not self.previous_token.normalized == \"IFNOTEXISTS\"\n293\t        )\n294\t        return is_alias_without_as or self.previous_token.is_right_parenthesis\n295\t\n296\t    @property\n297\t    def is_a_wildcard_in_select_statement(self) -> bool:\n298\t        \"\"\"\n299\t        Checks if token is a wildcard in select statement\n300\t\n301\t        Handle * wildcard in select part, but ignore count(*)\n302\t        \"\"\"\n303\t        return (\n304\t            self.is_wildcard\n305\t            and self.last_keyword_normalized == \"SELECT\"\n306\t            and not self.previous_token.is_left_parenthesis\n307\t        )\n308\t\n309\t    @property\n310\t    def is_potential_column_name(self) -> bool:\n311\t        \"\"\"\n312\t        Checks if token is a potential column name\n313\t        \"\"\"\n314\t        return (\n315\t            self.last_keyword_normalized in KEYWORDS_BEFORE_COLUMNS\n316\t            and self.previous_token.normalized not in [\"AS\", \")\"]\n317\t            and not self.is_alias_without_as\n318\t        )\n319\t\n320\t    @property\n321\t    def is_conversion_specifier(self) -> bool:\n322\t        \"\"\"\n323\t        Checks if token is a format or data type in cast or convert\n324\t        \"\"\"\n325\t        return (\n326\t            self.previous_token.normalized in [\"AS\", \"USING\"]\n327\t            and self.is_in_nested_function\n328\t        )\n329\t\n330\t    @property\n331\t    def is_column_name_inside_insert_clause(self) -> bool:\n332\t        \"\"\"\n333\t        Checks if token is a column name inside insert clause,\n334\t        e.g. INSERT INTO `foo` (col1, `col2`) VALUES (..)\n335\t        \"\"\"\n336\t        return (\n337\t            self.last_keyword_normalized == \"INTO\"\n338\t            and self.previous_token.is_punctuation\n339\t        )\n340\t\n341\t    @property\n342\t    def is_potential_alias(self) -> bool:\n343\t        \"\"\"\n344\t        Checks if given token can possibly be an alias\n345\t        \"\"\"\n346\t        return self.is_name or (\n347\t            self.is_keyword\n348\t            and self.previous_token.normalized == \"AS\"\n349\t            and self.last_keyword_normalized == \"SELECT\"\n350\t        )\n351\t\n352\t    @property\n353\t    def is_a_valid_alias(self) -> bool:\n354\t        \"\"\"\n355\t        Checks if given token meets the alias criteria\n356\t        \"\"\"\n357\t        return (\n358\t            self.last_keyword_normalized in KEYWORDS_BEFORE_COLUMNS\n359\t            and self.normalized not in [\"DIV\"]\n360\t            and self.is_alias_definition\n361\t            and not self.is_in_nested_function\n362\t            or self.is_in_with_columns\n363\t        )\n364\t\n365\t    @property\n366\t    def next_token_not_comment(self):\n367\t        \"\"\"\n368\t        Property returning next non-comment token\n369\t        \"\"\"\n370\t        if self.next_token and self.next_token.is_comment:\n371\t            return self.next_token.next_token_not_comment\n372\t        return self.next_token\n373\t\n374\t    @property\n375\t    def previous_token_not_comment(self):\n376\t        \"\"\"\n377\t        Property returning previous non-comment token\n378\t        \"\"\"\n379\t        if self.previous_token and self.previous_token.is_comment:\n380\t            return self.previous_token.previous_token_not_comment\n381\t        return self.previous_token\n382\t\n383\t    def is_constraint_definition_inside_create_table_clause(\n384\t        self, query_type: str\n385\t    ) -> bool:\n386\t        \"\"\"\n387\t        Checks if token is constraint definition inside create table clause\n388\t\n389\t        Used to handle CREATE TABLE queries (#35) to skip keyword that are withing\n390\t        parenthesis-wrapped list of column\n391\t        \"\"\"\n392\t        return (\n393\t            query_type == QueryType.CREATE.value\n394\t            and self.is_in_parenthesis\n395\t            and self.is_create_table_columns_definition\n396\t        )\n397\t\n398\t    def is_columns_alias_of_with_query_or_column_in_insert_query(\n399\t        self, with_names: List[str]\n400\t    ) -> bool:\n401\t        \"\"\"\n402\t        Check if token is column alias of with query or column in insert query\n403\t\n404\t        We are in <columns> of INSERT INTO <TABLE> (<columns>),\n405\t        or columns of with statement: with (<columns>) as ...\n406\t        \"\"\"\n407\t        return self.is_in_parenthesis and (\n408\t            self.find_nearest_token(\"(\").previous_token.value in with_names\n409\t            or self.last_keyword_normalized == \"INTO\"\n410\t        )\n411\t\n412\t    def is_sub_query_alias(self, subqueries_names: List[str]) -> bool:\n413\t        \"\"\"\n414\t        Checks for aliases of sub-queries i.e.: SELECT from (...) <alias>\n415\t        \"\"\"\n416\t        return (\n417\t            self.previous_token.is_right_parenthesis and self.value in subqueries_names\n418\t        )\n419\t\n420\t    def is_with_query_name(self, with_names: List[str]) -> bool:\n421\t        \"\"\"\n422\t        checks for names of the with queries <name> as (subquery)\n423\t        \"\"\"\n424\t        return self.next_token.normalized == \"AS\" and self.value in with_names\n425\t\n426\t    def is_sub_query_name_or_with_name_or_function_name(\n427\t        self, sub_queries_names: List[str], with_names: List[str]\n428\t    ) -> bool:\n429\t        \"\"\"\n430\t        Check for non applicable names: with, subquery or custom function\n431\t        \"\"\"\n432\t        return (\n433\t            self.is_sub_query_alias(subqueries_names=sub_queries_names)\n434\t            or self.is_with_query_name(with_names=with_names)\n435\t            or self.next_token.is_left_parenthesis\n436\t        )\n437\t\n438\t    def is_not_an_alias_or_is_self_alias_outside_of_subquery(\n439\t        self, columns_aliases_names: List[str], max_subquery_level: Dict\n440\t    ) -> bool:\n441\t        \"\"\"\n442\t        Checks if token is not alias or alias of self outside of sub query\n443\t        \"\"\"\n444\t        return (\n445\t            self.value not in columns_aliases_names\n446\t            or self.token_is_alias_of_self_not_from_subquery(\n447\t                aliases_levels=max_subquery_level\n448\t            )\n449\t            or self.token_name_is_same_as_alias_not_from_subquery(\n450\t                aliases_levels=max_subquery_level\n451\t            )\n452\t        )\n453\t\n454\t    def is_table_definition_suffix_in_non_select_create_table(\n455\t        self, query_type: str\n456\t    ) -> bool:\n457\t        \"\"\"\n458\t        Checks if we are after create table definition.\n459\t\n460\t        Ignore annotations outside the parenthesis with the list of columns\n461\t        e.g. ) CHARACTER SET utf8;\n462\t        \"\"\"\n463\t        return (\n464\t            query_type == QueryType.CREATE\n465\t            and not self.is_in_parenthesis\n466\t            and self.find_nearest_token(\"SELECT\", value_attribute=\"normalized\")\n467\t            is EmptyToken\n468\t        )\n469\t\n470\t    def is_column_definition_inside_create_table(self, query_type: str) -> bool:\n471\t        \"\"\"\n472\t        Checks for column names in create table\n473\t\n474\t        Previous token is either ( or , -> indicates the column name\n475\t        \"\"\"\n476\t        return (\n477\t            query_type == QueryType.CREATE\n478\t            and self.is_in_parenthesis\n479\t            and self.previous_token.is_punctuation\n480\t            and self.last_keyword_normalized == \"TABLE\"\n481\t        )\n482\t\n483\t    def is_potential_column_alias(\n484\t        self, columns_aliases_names: List[str], column_aliases: Dict\n485\t    ) -> bool:\n486\t        \"\"\"\n487\t        Checks if column can be an alias\n488\t        \"\"\"\n489\t        return (\n490\t            self.value in columns_aliases_names\n491\t            and self.value not in column_aliases\n492\t            and not self.previous_token.is_nested_function_start\n493\t            and self.is_alias_definition\n494\t        )\n495\t\n496\t    def token_is_alias_of_self_not_from_subquery(self, aliases_levels: Dict) -> bool:\n497\t        \"\"\"\n498\t        Checks if token is also an alias, but is an alias of self that is not\n499\t        coming from a subquery, that means it's a valid column\n500\t        \"\"\"\n501\t        return (\n502\t            self.last_keyword_normalized == \"SELECT\"\n503\t            and self.is_alias_of_self\n504\t            and self.subquery_level == aliases_levels[self.value]\n505\t        )\n506\t\n507\t    def token_name_is_same_as_alias_not_from_subquery(\n508\t        self, aliases_levels: Dict\n509\t    ) -> bool:\n510\t        \"\"\"\n511\t        Checks if token is also an alias, but is an alias of self that is not\n512\t        coming from a subquery, that means it's a valid column\n513\t        \"\"\"\n514\t        return (\n515\t            self.last_keyword_normalized == \"SELECT\"\n516\t            and self.next_token.normalized == \"AS\"\n517\t            and self.subquery_level == aliases_levels[self.value]\n518\t        )\n519\t\n520\t    def table_prefixed_column(self, table_aliases: Dict) -> str:\n521\t        \"\"\"\n522\t        Substitutes table alias with actual table name\n523\t        \"\"\"\n524\t        value = self.value\n525\t        if \".\" in value:\n526\t            parts = value.split(\".\")\n527\t            if len(parts) > 4:  # pragma: no cover\n528\t                raise ValueError(f\"Wrong columns name: {value}\")\n529\t            parts[0] = table_aliases.get(parts[0], parts[0])\n530\t            value = \".\".join(parts)\n531\t        return value\n532\t\n533\t    def get_nth_previous(self, level: int) -> \"SQLToken\":\n534\t        \"\"\"\n535\t        Function iterates previous tokens getting nth previous token\n536\t        \"\"\"\n537\t        assert level >= 1\n538\t        if self.previous_token:\n539\t            if level > 1:\n540\t                return self.previous_token.get_nth_previous(level=level - 1)\n541\t            return self.previous_token\n542\t        return EmptyToken  # pragma: no cover\n543\t\n544\t    def find_nearest_token(\n545\t        self,\n546\t        value: Union[Union[str, bool], List[Union[str, bool]]],\n547\t        direction: str = \"left\",\n548\t        value_attribute: str = \"value\",\n549\t    ) -> \"SQLToken\":\n550\t        \"\"\"\n551\t        Returns token with given value to the left or right.\n552\t        If value is not found it returns EmptyToken.\n553\t        \"\"\"\n554\t        if not isinstance(value, list):\n555\t            value = [value]\n556\t        attribute = \"previous_token\" if direction == \"left\" else \"next_token\"\n557\t        token = self\n558\t        while getattr(token, attribute):\n559\t            tok_value = getattr(getattr(token, attribute), value_attribute)\n560\t            if tok_value in value:\n561\t                return getattr(token, attribute)\n562\t            token = getattr(token, attribute)\n563\t        return EmptyToken\n564\t\n565\t\n566\tEmptyToken = SQLToken()\n567\t"}]},"parent_tool_use_id":null,"session_id":"02b80531-911b-41a6-9401-2e2980698647","uuid":"41771d2d-c52d-4af6-9fbd-4481a9e5b0e4","timestamp":"2026-09-10T03:55:16.555Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-9cUDXf/repo/sql_metadata/token.py","content":"\"\"\"\nModule contains internal SQLToken that creates linked list\n\"\"\"\n\nfrom typing import Dict, List, Union\n\nimport sqlparse.sql\nfrom sqlparse.tokens import Comment, Name, Number, Punctuation, Wildcard, Keyword\n\nfrom sql_metadata.keywords_lists import (\n    KEYWORDS_BEFORE_COLUMNS,\n    RELEVANT_KEYWORDS,\n    QueryType,\n    TABLE_ADJUSTMENT_KEYWORDS,\n)\n\n\nclass SQLToken:  # pylint: disable=R0902, R0904\n    \"\"\"\n    Class representing single token and connected into linked list\n    \"\"\"\n\n    def __init__(\n        self,\n        tok: sqlparse.sql.Token = None,\n        index: int = -1,\n        subquery_level: int = 0,\n        last_keyword: str = None,\n    ):\n        self.position = index\n        if tok is None:\n            self._set_default_values()\n        else:\n            self.value = tok.value.strip(\"`\").strip('\"')\n            self.is_keyword = tok.is_keyword or (\n                tok.ttype.parent is Name and tok.ttype is not Name\n            )\n            self.is_name = tok.ttype is Name\n            self.is_punctuation = tok.ttype is Punctuation\n            self.is_dot = str(tok) == \".\"\n            self.is_wildcard = tok.ttype is Wildcard\n            self.is_integer = tok.ttype is Number.Integer\n            self.is_float = tok.ttype is Number.Float\n            self.is_comment = tok.ttype is Comment or tok.ttype.parent == Comment\n            self.is_as_keyword = tok.ttype is Keyword and tok.normalized == \"AS\"\n\n            self.is_left_parenthesis = str(tok) == \"(\"\n            self.is_right_parenthesis = str(tok) == \")\"\n            self.last_keyword = last_keyword\n            self.next_token = EmptyToken\n            self.previous_token = EmptyToken\n            self.subquery_level = subquery_level\n        self.token_type = None\n\n        self._set_default_parenthesis_status()\n\n    def _set_default_values(self):\n        self.value = \"\"\n        self.is_keyword = False\n        self.is_name = False\n        self.is_punctuation = False\n        self.is_dot = False\n        self.is_wildcard = False\n        self.is_integer = False\n        self.is_float = False\n        self.is_comment = False\n        self.is_as_keyword = False\n\n        self.is_left_parenthesis = False\n        self.is_right_parenthesis = False\n        self.last_keyword = None\n        self.subquery_level = 0\n        self.next_token = None\n        self.previous_token = None\n\n    def _set_default_parenthesis_status(self):\n        self.is_in_nested_function = False\n        self.parenthesis_level = 0\n        self.is_subquery_start = False\n        self.is_subquery_end = False\n        self.is_with_query_start = False\n        self.is_with_query_end = False\n        self.is_with_columns_start = False\n        self.is_with_columns_end = False\n        self.is_nested_function_start = False\n        self.is_nested_function_end = False\n        self.is_column_definition_start = False\n        self.is_column_definition_end = False\n        self.is_create_table_columns_declaration_start = False\n        self.is_create_table_columns_declaration_end = False\n        self.is_partition_clause_start = False\n        self.is_partition_clause_end = False\n\n    def __str__(self):\n        \"\"\"\n        String representation\n        \"\"\"\n        return self.value.strip('\"')\n\n    def __repr__(self) -> str:  # pragma: no cover\n        \"\"\"\n        Representation - useful for debugging\n        \"\"\"\n        repr_str = [\"=\".join([str(k), str(v)]) for k, v in self.__dict__.items()]\n        return f\"SQLToken({','.join(repr_str)})\"\n\n    @property\n    def normalized(self) -> str:\n        \"\"\"\n        Property returning uppercase value without end lines and spaces\n        \"\"\"\n        return self.value.translate(str.maketrans(\"\", \"\", \" \\n\\t\\r\")).upper()\n\n    @property\n    def stringified_token(self) -> str:\n        \"\"\"\n        Returns string representation with whitespace or not - used to rebuild query\n        from list of tokens\n        \"\"\"\n        if self.previous_token:\n            if (\n                self.normalized in [\")\", \".\", \",\"]\n                or self.previous_token.normalized in [\"(\", \".\"]\n                or (\n                    self.is_left_parenthesis\n                    and self.previous_token.normalized\n                    not in RELEVANT_KEYWORDS.union({\"*\", \",\", \"IN\", \"NOTIN\"})\n                )\n            ):\n                return str(self)\n            return f\" {self}\"\n        return str(self)  # pragma: no cover\n\n    @property\n    def last_keyword_normalized(self) -> str:\n        \"\"\"\n        Property returning uppercase last keyword without end lines and spaces\n        \"\"\"\n        if self.last_keyword:\n            return self.last_keyword.translate(str.maketrans(\"\", \"\", \" \\n\\t\\r\")).upper()\n        return \"\"\n\n    @property\n    def is_in_parenthesis(self) -> bool:\n        \"\"\"\n        Property checks if token is surrounded with brackets ()\n        \"\"\"\n        return self.parenthesis_level > 0\n\n    @property\n    def is_create_table_columns_definition(self) -> bool:\n        \"\"\"\n        Checks if given token is inside columns definition in\n        create table query like: create table name (<columns def>)\n        \"\"\"\n        open_parenthesis = self.find_nearest_token(\n            True, value_attribute=\"is_create_table_columns_declaration_start\"\n        )\n        if open_parenthesis is EmptyToken:\n            return False\n        close_parenthesis = self.find_nearest_token(\n            True,\n            direction=\"right\",\n            value_attribute=\"is_create_table_columns_declaration_end\",\n        )\n        return (\n            open_parenthesis is not EmptyToken and close_parenthesis is not EmptyToken\n        )\n\n    @property\n    def is_keyword_column_name(self) -> bool:\n        \"\"\"\n        Checks if given keyword can be a column name in SELECT query\n        \"\"\"\n        return (\n            self.is_keyword\n            and self.normalized not in RELEVANT_KEYWORDS\n            and self.previous_token.normalized in [\",\", \"SELECT\"]\n            and self.next_token.normalized in [\",\", \"AS\"]\n        )\n\n    @property\n    def is_alias_without_as(self) -> bool:\n        \"\"\"\n        Checks if a given token is an alias without as keyword,\n        like: SELECT col <alias1>, col2 <alias2> from table\n        \"\"\"\n        return (\n            self.next_token.normalized in [\",\", \"FROM\"]\n            and self.previous_token.normalized not in [\"*\", \",\", \".\", \"(\", \"SELECT\"]\n            and not self.previous_token.is_keyword\n            and (\n                self.last_keyword_normalized == \"SELECT\"\n                or self.previous_token.is_column_definition_end\n                or self.previous_token.is_partition_clause_end\n            )\n            and not self.previous_token.is_comment\n        )\n\n    @property\n    def is_alias_definition(self):\n        \"\"\"\n        Returns if current token is a definition of an alias.\n        Note that aliases can also be used in other queries and be a part\n        of other nested columns with aliases.\n\n        Note that this function only check if alias token is a token with\n        alias definition, it's not suitable for determining IF token is an alias\n        as it's more complicated and this method would match\n        also i.e. sub-queries names\n        \"\"\"\n        return (\n            self.is_alias_without_as\n            or self.previous_token.normalized == \"AS\"\n            or self.is_in_with_columns\n        )\n\n    @property\n    def is_alias_of_self(self) -> bool:\n        \"\"\"\n        Checks if a given token is an alias but at the same time\n        is also an alias of self, so not really an alias\n        \"\"\"\n\n        end_of_column = self.find_nearest_token(\n            [\",\", \"FROM\"], value_attribute=\"normalized\", direction=\"right\"\n        )\n        while end_of_column.is_in_nested_function:\n            end_of_column = end_of_column.find_nearest_token(\n                [\",\", \"FROM\"], value_attribute=\"normalized\", direction=\"right\"\n            )\n        return end_of_column.previous_token.normalized == self.normalized\n\n    @property\n    def is_in_with_columns(self) -> bool:\n        \"\"\"\n        Checks if token is inside with colums part of a query\n        \"\"\"\n        return (\n            self.find_nearest_token(\"(\").is_with_columns_start\n            and self.find_nearest_token(\")\", direction=\"right\").is_with_columns_end\n        )\n\n    @property\n    def is_wildcard_not_operator(self):\n        \"\"\"\n        Determines if * encountered in query is a wildcard like select <*> from aa\n        or is that an operator like Select aa <*> bb as cc from dd\n        \"\"\"\n        return self.normalized == \"*\" and (\n            self.previous_token.value in [\",\", \".\", \"SELECT\"]\n            or (self.previous_token.value == \"(\")\n            and self.next_token.value == \")\"\n        )\n\n    @property\n    def is_potential_table_name(self) -> bool:\n        \"\"\"\n        Checks if token is a possible candidate for table name\n        \"\"\"\n        return (\n            (self.is_name or self.is_keyword)\n            and self.last_keyword_normalized in TABLE_ADJUSTMENT_KEYWORDS\n            and self.previous_token.normalized not in [\"AS\", \"WITH\"]\n            and self.normalized\n            not in [\"AS\", \"SELECT\", \"IF\", \"SET\", \"WITH\", \"IFNOTEXISTS\"]\n        )\n\n    @property\n    def is_with_statement_nested_in_subquery(self) -> bool:\n        \"\"\"\n        Checks if token is with statement nested in subquery\n        \"\"\"\n        return (\n            self.normalized == \"WITH\"\n            and self.previous_token.is_left_parenthesis\n            and self.get_nth_previous(2).normalized == \"FROM\"\n        )\n\n    @property\n    def is_alias_of_table_or_alias_of_subquery(self) -> bool:\n        \"\"\"\n        Checks if token is alias of table or alias of subquery\n\n        It's not a list of tables, e.g. SELECT * FROM foo, bar\n        hence, it can be the case of alias without AS, e.g. SELECT * FROM foo bar\n        or an alias of subquery (SELECT * FROM foo) bar\n        \"\"\"\n        is_alias_without_as = (\n            self.previous_token.normalized != self.last_keyword_normalized\n            and not self.previous_token.is_punctuation\n            and not self.previous_token.normalized == \"IFNOTEXISTS\"\n        )\n        return is_alias_without_as or self.previous_token.is_right_parenthesis\n\n    @property\n    def is_a_wildcard_in_select_statement(self) -> bool:\n        \"\"\"\n        Checks if token is a wildcard in select statement\n\n        Handle * wildcard in select part, but ignore count(*)\n        \"\"\"\n        return (\n            self.is_wildcard\n            and self.last_keyword_normalized == \"SELECT\"\n            and not self.previous_token.is_left_parenthesis\n        )\n\n    @property\n    def is_potential_column_name(self) -> bool:\n        \"\"\"\n        Checks if token is a potential column name\n        \"\"\"\n        return (\n            self.last_keyword_normalized in KEYWORDS_BEFORE_COLUMNS\n            and self.previous_token.normalized not in [\"AS\", \")\"]\n            and not self.is_alias_without_as\n        )\n\n    @property\n    def is_conversion_specifier(self) -> bool:\n        \"\"\"\n        Checks if token is a format or data type in cast or convert\n        \"\"\"\n        return (\n            self.previous_token.normalized in [\"AS\", \"USING\"]\n            and self.is_in_nested_function\n        )\n\n    @property\n    def is_column_name_inside_insert_clause(self) -> bool:\n        \"\"\"\n        Checks if token is a column name inside insert clause,\n        e.g. INSERT INTO `foo` (col1, `col2`) VALUES (..)\n        \"\"\"\n        return (\n            self.last_keyword_normalized == \"INTO\"\n            and self.previous_token.is_punctuation\n        )\n\n    @property\n    def is_potential_alias(self) -> bool:\n        \"\"\"\n        Checks if given token can possibly be an alias\n        \"\"\"\n        return self.is_name or (\n            self.is_keyword\n            and self.previous_token.normalized == \"AS\"\n            and self.last_keyword_normalized == \"SELECT\"\n        )\n\n    @property\n    def is_a_valid_alias(self) -> bool:\n        \"\"\"\n        Checks if given token meets the alias criteria\n        \"\"\"\n        return (\n            self.last_keyword_normalized in KEYWORDS_BEFORE_COLUMNS\n            and self.normalized not in [\"DIV\"]\n            and self.is_alias_definition\n            and not self.is_in_nested_function\n            or self.is_in_with_columns\n        )\n\n    @property\n    def next_token_not_comment(self):\n        \"\"\"\n        Property returning next non-comment token\n        \"\"\"\n        if self.next_token and self.next_token.is_comment:\n            return self.next_token.next_token_not_comment\n        return self.next_token\n\n    @property\n    def previous_token_not_comment(self):\n        \"\"\"\n        Property returning previous non-comment token\n        \"\"\"\n        if self.previous_token and self.previous_token.is_comment:\n            return self.previous_token.previous_token_not_comment\n        return self.previous_token\n\n    def is_constraint_definition_inside_create_table_clause(\n        self, query_type: str\n    ) -> bool:\n        \"\"\"\n        Checks if token is constraint definition inside create table clause\n\n        Used to handle CREATE TABLE queries (#35) to skip keyword that are withing\n        parenthesis-wrapped list of column\n        \"\"\"\n        return (\n            query_type == QueryType.CREATE.value\n            and self.is_in_parenthesis\n            and self.is_create_table_columns_definition\n        )\n\n    def is_columns_alias_of_with_query_or_column_in_insert_query(\n        self, with_names: List[str]\n    ) -> bool:\n        \"\"\"\n        Check if token is column alias of with query or column in insert query\n\n        We are in <columns> of INSE