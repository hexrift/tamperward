{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019XjK7cs6Zt6Tr5odCHGkix","type":"tool_result","content":"1\t\"\"\"\n2\tModule provide lists of sql keywords that should trigger or skip\n3\tchecks for tables an columns\n4\t\"\"\"\n5\t\n6\t# these keywords are followed by columns reference\n7\tfrom enum import Enum\n8\t\n9\tKEYWORDS_BEFORE_COLUMNS = {\n10\t    \"SELECT\",\n11\t    \"WHERE\",\n12\t    \"HAVING\",\n13\t    \"ORDERBY\",\n14\t    \"GROUPBY\",\n15\t    \"ON\",\n16\t    \"SET\",\n17\t    \"USING\",\n18\t}\n19\t\n20\t# normalized list of table preceding keywords\n21\tTABLE_ADJUSTMENT_KEYWORDS = {\n22\t    \"FROM\",\n23\t    \"JOIN\",\n24\t    \"CROSSJOIN\",\n25\t    \"INNERJOIN\",\n26\t    \"FULLJOIN\",\n27\t    \"FULLOUTERJOIN\",\n28\t    \"LEFTJOIN\",\n29\t    \"RIGHTJOIN\",\n30\t    \"LEFTOUTERJOIN\",\n31\t    \"RIGHTOUTERJOIN\",\n32\t    \"NATURALJOIN\",\n33\t    \"INTO\",\n34\t    \"UPDATE\",\n35\t    \"TABLE\",\n36\t    \"IFNOTEXISTS\",\n37\t}\n38\t\n39\t# next statement beginning after with statement\n40\tWITH_ENDING_KEYWORDS = {\"UPDATE\", \"SELECT\", \"DELETE\", \"REPLACE\", \"INSERT\"}\n41\t\n42\t# subquery preceding keywords\n43\tSUBQUERY_PRECEDING_KEYWORDS = {\n44\t    \"FROM\",\n45\t    \"JOIN\",\n46\t    \"CROSSJOIN\",\n47\t    \"INNERJOIN\",\n48\t    \"FULLJOIN\",\n49\t    \"FULLOUTERJOIN\",\n50\t    \"LEFTJOIN\",\n51\t    \"RIGHTJOIN\",\n52\t    \"LEFTOUTERJOIN\",\n53\t    \"RIGHTOUTERJOIN\",\n54\t    \"NATURALJOIN\",\n55\t}\n56\t\n57\t# section of a query in which column can exists\n58\t# based on last normalized keyword\n59\tCOLUMNS_SECTIONS = {\n60\t    \"SELECT\": \"select\",\n61\t    \"WHERE\": \"where\",\n62\t    \"HAVING\": \"having\",\n63\t    \"ORDERBY\": \"order_by\",\n64\t    \"ON\": \"join\",\n65\t    \"USING\": \"join\",\n66\t    \"INTO\": \"insert\",\n67\t    \"SET\": \"update\",\n68\t    \"GROUPBY\": \"group_by\",\n69\t    \"INNERJOIN\": \"inner_join\",\n70\t}\n71\t\n72\t\n73\tclass QueryType(str, Enum):\n74\t    \"\"\"\n75\t    Types of supported queries\n76\t    \"\"\"\n77\t\n78\t    INSERT = \"INSERT\"\n79\t    REPLACE = \"REPLACE\"\n80\t    UPDATE = \"UPDATE\"\n81\t    DELETE = \"DELETE\"\n82\t    SELECT = \"SELECT\"\n83\t    CREATE = \"CREATE TABLE\"\n84\t    ALTER = \"ALTER TABLE\"\n85\t    DROP = \"DROP TABLE\"\n86\t    TRUNCATE = \"TRUNCATE TABLE\"\n87\t\n88\t\n89\tclass TokenType(str, Enum):\n90\t    \"\"\"\n91\t    Types of SQLTokens\n92\t    \"\"\"\n93\t\n94\t    COLUMN = \"COLUMN\"\n95\t    TABLE = \"TABLE\"\n96\t    COLUMN_ALIAS = \"COLUMN_ALIAS\"\n97\t    TABLE_ALIAS = \"TABLE_ALIAS\"\n98\t    WITH_NAME = \"WITH_NAME\"\n99\t    SUB_QUERY_NAME = \"SUB_QUERY_NAME\"\n100\t    PARENTHESIS = \"PARENTHESIS\"\n101\t\n102\t\n103\t# cannot fully replace with enum as with/select has the same key\n104\tSUPPORTED_QUERY_TYPES = {\n105\t    \"INSERT\": QueryType.INSERT,\n106\t    \"REPLACE\": QueryType.REPLACE,\n107\t    \"UPDATE\": QueryType.UPDATE,\n108\t    \"SELECT\": QueryType.SELECT,\n109\t    \"DELETE\": QueryType.DELETE,\n110\t    \"WITH\": QueryType.SELECT,\n111\t    \"CREATETABLE\": QueryType.CREATE,\n112\t    \"CREATETEMPORARY\": QueryType.CREATE,\n113\t    \"ALTERTABLE\": QueryType.ALTER,\n114\t    \"DROPTABLE\": QueryType.DROP,\n115\t    \"CREATEFUNCTION\": QueryType.CREATE,\n116\t    \"TRUNCATETABLE\": QueryType.TRUNCATE,\n117\t}\n118\t\n119\t# all the keywords we care for - rest is ignored in assigning\n120\t# the last keyword\n121\tRELEVANT_KEYWORDS = {\n122\t    *KEYWORDS_BEFORE_COLUMNS,\n123\t    *TABLE_ADJUSTMENT_KEYWORDS,\n124\t    *WITH_ENDING_KEYWORDS,\n125\t    *SUBQUERY_PRECEDING_KEYWORDS,\n126\t    \"LIMIT\",\n127\t    \"OFFSET\",\n128\t    \"RETURNING\",\n129\t    \"VALUES\",\n130\t    \"INDEX\",\n131\t    \"KEY\",\n132\t    \"WITH\",\n133\t    \"WINDOW\",\n134\t}\n135\t"}]},"parent_tool_use_id":null,"session_id":"02b80531-911b-41a6-9401-2e2980698647","uuid":"cd531fe4-5bf7-4f29-bd5d-97baee668d60","timestamp":"2026-09-10T03:55:13.810Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-9cUDXf/repo/sql_metadata/keywords_lists.py","content":"\"\"\"\nModule provide lists of sql keywords that should trigger or skip\nchecks for tables an columns\n\"\"\"\n\n# these keywords are followed by columns reference\nfrom enum import Enum\n\nKEYWORDS_BEFORE_COLUMNS = {\n    \"SELECT\",\n    \"WHERE\",\n    \"HAVING\",\n    \"ORDERBY\",\n    \"GROUPBY\",\n    \"ON\",\n    \"SET\",\n    \"USING\",\n}\n\n# normalized list of table preceding keywords\nTABLE_ADJUSTMENT_KEYWORDS = {\n    \"FROM\",\n    \"JOIN\",\n    \"CROSSJOIN\",\n    \"INNERJOIN\",\n    \"FULLJOIN\",\n    \"FULLOUTERJOIN\",\n    \"LEFTJOIN\",\n    \"RIGHTJOIN\",\n    \"LEFTOUTERJOIN\",\n    \"RIGHTOUTERJOIN\",\n    \"NATURALJOIN\",\n    \"INTO\",\n    \"UPDATE\",\n    \"TABLE\",\n    \"IFNOTEXISTS\",\n}\n\n# next statement beginning after with statement\nWITH_ENDING_KEYWORDS = {\"UPDATE\", \"SELECT\", \"DELETE\", \"REPLACE\", \"INSERT\"}\n\n# subquery preceding keywords\nSUBQUERY_PRECEDING_KEYWORDS = {\n    \"FROM\",\n    \"JOIN\",\n    \"CROSSJOIN\",\n    \"INNERJOIN\",\n    \"FULLJOIN\",\n    \"FULLOUTERJOIN\",\n    \"LEFTJOIN\",\n    \"RIGHTJOIN\",\n    \"LEFTOUTERJOIN\",\n    \"RIGHTOUTERJOIN\",\n    \"NATURALJOIN\",\n}\n\n# section of a query in which column can exists\n# based on last normalized keyword\nCOLUMNS_SECTIONS = {\n    \"SELECT\": \"select\",\n    \"WHERE\": \"where\",\n    \"HAVING\": \"having\",\n    \"ORDERBY\": \"order_by\",\n    \"ON\": \"join\",\n    \"USING\": \"join\",\n    \"INTO\": \"insert\",\n    \"SET\": \"update\",\n    \"GROUPBY\": \"group_by\",\n    \"INNERJOIN\": \"inner_join\",\n}\n\n\nclass QueryType(str, Enum):\n    \"\"\"\n    Types of supported queries\n    \"\"\"\n\n    INSERT = \"INSERT\"\n    REPLACE = \"REPLACE\"\n    UPDATE = \"UPDATE\"\n    DELETE = \"DELETE\"\n    SELECT = \"SELECT\"\n    CREATE = \"CREATE TABLE\"\n    ALTER = \"ALTER TABLE\"\n    DROP = \"DROP TABLE\"\n    TRUNCATE = \"TRUNCATE TABLE\"\n\n\nclass TokenType(str, Enum):\n    \"\"\"\n    Types of SQLTokens\n    \"\"\"\n\n    COLUMN = \"COLUMN\"\n    TABLE = \"TABLE\"\n    COLUMN_ALIAS = \"COLUMN_ALIAS\"\n    TABLE_ALIAS = \"TABLE_ALIAS\"\n    WITH_NAME = \"WITH_NAME\"\n    SUB_QUERY_NAME = \"SUB_QUERY_NAME\"\n    PARENTHESIS = \"PARENTHESIS\"\n\n\n# cannot fully replace with enum as with/select has the same key\nSUPPORTED_QUERY_TYPES = {\n    \"INSERT\": QueryType.INSERT,\n    \"REPLACE\": QueryType.REPLACE,\n    \"UPDATE\": QueryType.UPDATE,\n    \"SELECT\": QueryType.SELECT,\n    \"DELETE\": QueryType.DELETE,\n    \"WITH\": QueryType.SELECT,\n    \"CREATETABLE\": QueryType.CREATE,\n    \"CREATETEMPORARY\": QueryType.CREATE,\n    \"ALTERTABLE\": QueryType.ALTER,\n    \"DROPTABLE\": QueryType.DROP,\n    \"CREATEFUNCTION\": QueryType.CREATE,\n    \"TRUNCATETABLE\": QueryType.TRUNCATE,\n}\n\n# all the keywords we care for - rest is ignored in assigning\n# the last keyword\nRELEVANT_KEYWORDS = {\n    *KEYWORDS_BEFORE_COLUMNS,\n    *TABLE_ADJUSTMENT_KEYWORDS,\n    *WITH_ENDING_KEYWORDS,\n    *SUBQUERY_PRECEDING_KEYWORDS,\n    \"LIMIT\",\n    \"OFFSET\",\n    \"RETURNING\",\n    \"VALUES\",\n    \"INDEX\",\n    \"KEY\",\n    \"WITH\",\n    \"WINDOW\",\n}\n","numLines":135,"startLine":1,"totalLines":135}}}
