{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015aQwLJ6YdcvAxdsKRUHYRE","type":"tool_result","content":"1\timport json\n2\tfrom typing import Dict, Any, TextIO\n3\t\n4\tfrom _pytest.pathlib import Path\n5\t\n6\timport pytest\n7\t\n8\t\n9\tdef pytest_addoption(parser):\n10\t    group = parser.getgroup(\"terminal reporting\", \"report-log plugin options\")\n11\t    group.addoption(\n12\t        \"--report-log\",\n13\t        action=\"store\",\n14\t        metavar=\"path\",\n15\t        default=None,\n16\t        help=\"Path to line-based json objects of test session events.\",\n17\t    )\n18\t    group.addoption(\n19\t        \"--report-log-exclude-logs-on-passed-tests\",\n20\t        action=\"store_true\",\n21\t        default=False,\n22\t        help=\"Don't capture logs for passing tests\",\n23\t    )\n24\t\n25\t\n26\tdef pytest_configure(config):\n27\t    report_log = config.option.report_log\n28\t    if report_log and not hasattr(config, \"workerinput\"):\n29\t        config._report_log_plugin = ReportLogPlugin(config, Path(report_log))\n30\t        config.pluginmanager.register(config._report_log_plugin)\n31\t\n32\t\n33\tdef pytest_unconfigure(config):\n34\t    report_log_plugin = getattr(config, \"_report_log_plugin\", None)\n35\t    if report_log_plugin:\n36\t        report_log_plugin.close()\n37\t        del config._report_log_plugin\n38\t\n39\t\n40\tdef _open_filtered_writer(log_path: Path) -> TextIO:\n41\t    if log_path.suffix == \".gz\":\n42\t        import gzip\n43\t\n44\t        return gzip.open(log_path, \"wt\", encoding=\"UTF-8\")\n45\t    elif log_path.suffix == \".bz2\":\n46\t        import bz2\n47\t\n48\t        return bz2.open(log_path, \"wt\", encoding=\"UTF-8\")\n49\t    elif log_path.suffix == \".xz\":\n50\t        import lzma\n51\t\n52\t        return lzma.open(log_path, \"wt\", encoding=\"UTF-8\")\n53\t    else:\n54\t        # line buffer for text mode to ease tail -f\n55\t        return log_path.open(\"wt\", buffer