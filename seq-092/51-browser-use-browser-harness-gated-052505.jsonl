{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NqXSaTUdu9WTDETu4kerFv","type":"tool_result","content":"1\t\"\"\"browser-harness filesystem layout.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport os\n5\timport sys\n6\tfrom pathlib import Path\n7\t\n8\t\n9\tdef home_dir() -> Path:\n10\t    raw = os.environ.get(\"BH_HOME\") or os.environ.get(\"BROWSER_HARNESS_HOME\")\n11\t    if raw:\n12\t        return Path(raw).expanduser().resolve()\n13\t    base = os.environ.get(\"XDG_CONFIG_HOME\")\n14\t    if base:\n15\t        return (Path(base).expanduser() / \"browser-harness\").resolve()\n16\t    return (Path.home() / \".config\" / \"browser-harness\").resolve()\n17\t\n18\t\n19\tdef ensure_private_dir(path: Path) -> Path:\n20\t    existed = path.exists()\n21\t    path.mkdir(parents=True, exist_ok=True)\n22\t    if not existed and sys.platform != \"win32\":\n23\t        os.chmod(path, 0o700)\n24\t    return path\n25\t\n26\t\n27\tdef config_dir() -> Path:\n28\t    raw = os.environ.get(\"BH_CONFIG_DIR\")\n29\t    return ensure_private_dir(Path(raw).expanduser().resolve() if raw else home_dir())\n30\t\n31\t\n32\tdef inspect_marker() -> Path:\n33\t    \"\"\"Marker recording that the harness opened a chrome://inspect tab\"\"\"\n34\t    return config_dir() / \"inspect-opened\"\n35\t\n36\t\n37\tdef runtime_dir() -> Path:\n38\t    raw = os.environ.get(\"BH_RUNTIME_DIR\")\n39\t    return ensure_private_dir(Path(raw).expanduser().resolve() if raw else home_dir() / \"runtime\")\n40\t\n41\t\n42\tdef tmp_dir() -> Path:\n43\t    raw = os.environ.get(\"BH_TMP_DIR\")\n44\t    return ensure_private_dir(Path(raw).expanduser().resolve() if raw else home_dir() / \"tmp\")\n45\t\n46\t\n47\tdef workspace_dir() -> Path:\n48\t    raw = os.environ.get(\"BH_AGENT_WORKSPACE\")\n49\t    return ensure_private_dir(Path(raw).expanduser().resolve() if raw else home_dir() / \"agent-workspace\")\n50\t"}]},"parent_tool_use_id":null,"session_id":"9ad40c43-ed88-42ec-89b7-bb