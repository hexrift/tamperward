index ad7a7aa..1a4aeb6 100644
--- a/src/browser_harness/helpers.py
+++ b/src/browser_harness/helpers.py
@@ -237,11 +237,50 @@ _KEYS = {  # key → (windowsVirtualKeyCode, code, text)
     "Home": (36, "Home", ""), "End": (35, "End", ""),
     "PageUp": (33, "PageUp", ""), "PageDown": (34, "PageDown", ""),
 }
+_SHIFT_SYMBOLS = {  # char → (code, windowsVirtualKeyCode) when typed with Shift on a US layout
+    "!": ("Digit1", 49), "@": ("Digit2", 50), "#": ("Digit3", 51), "$": ("Digit4", 52),
+    "%": ("Digit5", 53), "^": ("Digit6", 54), "&": ("Digit7", 55), "*": ("Digit8", 56),
+    "(": ("Digit9", 57), ")": ("Digit0", 48), "_": ("Minus", 189), "+": ("Equal", 187),
+    "{": ("BracketLeft", 219), "}": ("BracketRight", 221), "|": ("Backslash", 220),
+    ":": ("Semicolon", 186), "\"": ("Quote", 222), "<": ("Comma", 188), ">": ("Period", 190),
+    "?": ("Slash", 191), "~": ("Backquote", 192),
+}
+_UNSHIFTED_SYMBOLS = {  # char → (code, windowsVirtualKeyCode) on a US layout, no Shift
+    "`": ("Backquote", 192), "-": ("Minus", 189), "=": ("Equal", 187),
+    "[": ("BracketLeft", 219), "]": ("BracketRight", 221), "\\": ("Backslash", 220),
+    ";": ("Semicolon", 186), "'": ("Quote", 222), ",": ("Comma", 188),
+    ".": ("Period", 190), "/": ("Slash", 191),
+}
+
+def _us_layout_key(char):
+    """Map a character to (code, windowsVirtualKeyCode, shift) on a US keyboard
+    layout, or ("", 0, False) if no US key produces it."""
+    if char.isascii() and char.isalpha():
+        return f"Key{char.upper()}", ord(char.upper()), char.isupper()
+    if char.isascii() and char.isdigit():
+        return f"Digit{char}", ord(char), False
+    if char in _SHIFT_SYMBOLS:
+        code, vk = _SHIFT_SYMBOLS[char]
+        return code, vk, True
+    if char in _UNSHIFTED_SYMBOLS:
+        code, vk = _UNSHIFTED_SYMBOLS[char]
+        return code, vk, False
+    return "", 0, False
+
 def press_key(key, modifiers=0):
     """Modifiers bitfield: 1=Alt, 2=Ctrl, 4=Meta(Cmd), 8=Shift.
     Special keys (Enter, Tab, Arrow*, Backspace, etc.) carry their virtual key codes
-    so listeners checking e.keyCode / e.key all fire."""
-    vk, code, text = _KEYS.get(key, (ord(key[0]) if len(key) == 1 else 0, key, key if len(key) == 1 else ""))
+    so listeners checking e.keyCode / e.key all fire. A single character is mapped to
+    its US-keyboard physical key (code + Shift), or code="" if no US key produces it."""
+    if key in _KEYS:
+        vk, code, text = _KEYS[key]
+    elif len(key) == 1:
+        code, vk, shift = _us_layout_key(key)
+        text = key
+        if shift:
+            modifiers |= 8
+    else:
+        vk, code, text = 0, key, ""
     base = {"key": key, "code": code, "modifiers": modifiers, "windowsVirtualKeyCode": vk, "nativeVirtualKeyCode": vk}
     shortcut_modifiers = modifiers & (1 | 2 | 4)  # Alt/Ctrl/Meta turn single keys into shortcuts.
     printable_char = len(key) == 1 and bool(text) and not shortcut_modifiers
