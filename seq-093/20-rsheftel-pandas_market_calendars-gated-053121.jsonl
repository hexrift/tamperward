"]\n\n    @property\n    def name(self):\n        return \"NSE\"\n\n    @property\n    def full_name(self):\n        return \"National Stock Exchange of India\"\n\n    @property\n    def adhoc_holidays(self):\n        return NSEClosedDay\n","structuredPatch":[{"oldStart":435,"oldLines":7,"newStart":435,"newLines":7,"lines":["     early closes or late opens.","     \"\"\""," ","-    aliases = [\"BSE\"]","+    aliases = [\"BSE\", \"XBOM\"]","     regular_market_times = {","         \"market_open\": ((None, time(9, 15)),),","         \"market_close\": ((None, time(15, 30)),),"]}],"userModified":false,"replaceAll":false}}
