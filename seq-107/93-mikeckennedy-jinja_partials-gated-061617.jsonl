{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Ju6HYWH9uQTHhMQgz1ayj","type":"tool_result","content":"1\t\"\"\"\n2\tjinja_partials - Simple reuse of partial HTML page templates in the Jinja template language for Python web frameworks.\n3\t\"\"\"\n4\t\n5\timport asyncio\n6\tfrom concurrent.futures import ThreadPoolExecutor\n7\tfrom contextlib import asynccontextmanager\n8\tfrom functools import partial\n9\tfrom importlib.metadata import PackageNotFoundError, version\n10\tfrom typing import TYPE_CHECKING, Any, AsyncIterator, Callable, Literal, Optional, Union, overload\n11\t\n12\tfrom jinja2 import Environment\n13\tfrom jinja2.ext import Extension\n14\tfrom jinja2.utils import concat\n15\tfrom markupsafe import Markup as Markup\n16\t\n17\ttry:\n18\t    __version__ = version('jinja_partials')\n19\texcept PackageNotFoundError:\n20\t    __version__ = '0.0.0'\n21\t__author__ = 'Michael Kennedy <michael@talkpython.fm>'\n22\t__all__ = [\n23\t    '__version__',\n24\t    'register_extensions',\n25\t    'register_quart_extensions',\n26\t    'register_fastapi_extensions',\n27\t    'register_starlette_extensions',\n28\t    'register_environment',\n29\t    'render_partial',\n30\t    'generate_render_partial',\n31\t    'PartialsException',\n32\t    'PartialsJinjaExtension',\n33\t]\n34\t\n35\t# Thread pool for running async renders from sync context\n36\t_async_render_executor = ThreadPoolExecutor(max_workers=4)\n37\t\n38\ttry:\n39\t    import flask\n40\texcept ImportError:\n41\t    flask = None\n42\t\n43\ttry:\n44\t    import quart\n45\texcept ImportError:\n46\t    quart = None\n47\t\n48\ttry:\n49\t    import fastapi\n50\texcept ImportError:\n51\t    fastapi = None\n52\t\n53\ttry:\n54\t    import starlette\n55\texcept ImportError:\n56\t    starlette = None\n57\t\n58\tif TYPE_CHECKING:\n59\t    if flask:\n60\t        from flask import Flask\n61\t    if quart:\n62\t        from quart import Quart\n63\t    if fastapi:\n64\t        from fastapi import FastAPI\n65\t        from fastapi.templating import Jinja2Templates as FastAPIJinja2Templates\n66\t    if starlette:\n67\t        from starlette.applications import Starlette\n68\t        from starlette.templating import Jinja2Templates\n69\t\n70\t\n71\tclass PartialsException(Exception):\n72\t    \"\"\"Raised when jinja_partials is misconfigured or a required web framework is not installed.\"\"\"\n73\t\n74\t    pass\n75\t\n76\t\n77\tclass PartialsJinjaExtension(Extension):\n78\t    \"\"\"Jinja2 extension that automatically registers render_partial functionality.\n79\t\n80\t    The extension automatically makes render_partial available as a global\n81\t    function in templates. By default, markup is enabled.\n82\t\n83\t    Note:\n84\t        Partials registered this way render directly through the Jinja2\n85\t        environment rather than flask.render_template, so Flask context\n86\t        processors do not apply inside partials. Flask apps that rely on\n87\t        context processors should use register_extensions instead.\n88\t\n89\t    Args:\n90\t        environment: The Jinja2 environment the extension is loaded into.\n91\t            Jinja2 passes this automatically when the class is listed in\n92\t            extensions=[...].\n93\t\n94\t    Example:\n95\t        Enable the extension on a Jinja2 environment:\n96\t\n97\t            from jinja2 import Environment\n98\t            env = Environment(extensions=[\"jinja_partials.PartialsJinjaExtension\"])\n99\t    \"\"\"\n100\t\n101\t    def __init__(self, environment: Environment) -> None:\n102\t        super().__init__(environment)\n103\t        # Use register_environment with markup=True to maintain same behavior\n104\t        register_environment(environment, markup=True)\n105\t\n106\t\n107\t@overload\n108\tdef render_partial(\n109\t    template_name: str,\n110\t    renderer: Optional[Callable[..., Any]] = ...,\n111\t    markup: Literal[True] = ...,\n112\t    **data: Any,\n113\t) -> Markup: ...\n114\t\n115\t\n116\t@overload\n117\tdef render_partial(\n118\t    template_name: str,\n119\t    renderer: Optional[Callable[..., Any]] = ...,\n120\t    *,\n121\t    markup: Literal[False],\n122\t    **data: Any,\n123\t) -> str: ...\n124\t\n125\t\n126\t@overload\n127\tdef render_partial(\n128\t    template_name: str,\n129\t    renderer: Optional[Callable[..., Any]] = ...,\n130\t    markup: bool = ...,\n131\t    **data: Any,\n132\t) -> Union[Markup, str]: ...\n133\t\n134\t\n135\tdef render_partial(\n136\t    template_name: str,\n137\t    renderer: Optional[Callable[..., Any]] = None,\n138\t    markup: bool = True,\n139\t    **data: Any,\n140\t) -> Union[Markup, str]:\n141\t    \"\"\"Render a partial template and return the resulting HTML fragment.\n142\t\n143\t    Args:\n144\t        template_name: Path of the template within the templates folder,\n145\t            e.g. `shared/partials/video_image.html`.\n146\t        renderer: Callable that renders the template with the given keyword\n147\t            arguments. Defaults to flask.render_template when Flask is installed.\n148\t        markup: When True (the default), wrap the result in markupsafe.Markup\n149\t            so it is not re-escaped when inserted into another template.\n150\t        **data: Model data passed to the template as keyword arguments.\n151\t\n152\t    Returns:\n153\t        The rendered fragment as Markup, or str when markup=False.\n154\t\n155\t    Raises:\n156\t        PartialsException: If no renderer is specified and Flask is not installed.\n157\t    \"\"\"\n158\t    if renderer is None:\n159\t        if flask is None:\n160\t            raise PartialsException('No renderer specified')\n161\t        else:\n162\t            renderer = flask.render_template\n163\t\n164\t    if markup:\n165\t        return Markup(renderer(template_name, **data))\n166\t\n167\t    return renderer(template_name, **data)\n168\t\n169\t\n170\t@overload\n171\tdef generate_render_partial(renderer: Callable[..., Any], markup: Literal[True] = ...) -> Callable[..., Markup]: ...\n172\t\n173\t\n174\t@overload\n175\tdef generate_render_partial(renderer: Callable[..., Any], markup: Literal[False]) -> Callable[..., str]: ...\n176\t\n177\t\n178\t@overload\n179\tdef generate_render_partial(renderer: Callable[..., Any], markup: bool) -> Callable[..., Union[Markup, str]]: ...\n180\t\n181\t\n182\tdef generate_render_partial(renderer: Callable[..., Any], markup: bool = True) -> Callable[..., Union[Markup, str]]:\n183\t    \"\"\"Create a render_partial function bound to a specific renderer.\n184\t\n185\t    Args:\n186\t        renderer: Callable that renders a template name plus keyword arguments to a string.\n187\t        markup: When True (the default), results are wrapped in markupsafe.Markup.\n188\t\n189\t    Returns:\n190\t        A callable with the same signature as render_partial that uses the bound renderer.\n191\t    \"\"\"\n192\t    return partial(render_partial, renderer=renderer, markup=markup)\n193\t\n194\t\n195\tdef register_extensions(app: 'Flask') -> None:\n196\t    \"\"\"Register jinja_partials with a Flask application.\n197\t\n198\t    Makes render_partial available as a global function in the app's Jinja\n199\t    templates, rendering with flask.render_template.\n200\t\n201\t    Args:\n202\t        app: The Flask application instance.\n203\t\n204\t    Raises:\n205\t        PartialsException: If Flask is not installed.\n206\t    \"\"\"\n207\t    if flask is None:\n208\t        raise PartialsException('Install Flask to use `register_extensions`')\n209\t\n210\t    app.jinja_env.globals.update(render_partial=generate_render_partial(flask.render_template))\n211\t\n212\t\n213\tdef register_quart_extensions(app: 'Quart', max_workers: int = 4) -> None:\n214\t    \"\"\"Register jinja_partials with a Quart application.\n215\t\n216\t    This creates a dedicated ThreadPoolExecutor for rendering partials in async\n217\t    environments. The executor lifecycle is tied to the Quart app - it will be\n218\t    properly shut down when the app stops.\n219\t\n220\t    Args:\n221\t        app: The Quart application instance.\n222\t        max_workers: Maximum number of worker threads for rendering partials.\n223\t                     Defaults to 4.\n224\t\n225\t    Raises:\n226\t        PartialsException: If Quart is not installed.\n227\t    \"\"\"\n228\t    if quart is None:\n229\t        raise PartialsException('Install Quart to use `register_quart_extensions`')\n230\t\n231\t    # Create a dedicated executor for this app\n232\t    executor = ThreadPoolExecutor(max_workers=max_workers)\n233\t\n234\t    # Store executor on the app for potential access/debugging\n235\t    app.extensions['jinja_partials_executor'] = executor  # type: ignore[index]\n236\t\n237\t    @app.after_serving\n238\t    async def shutdown_executor():\n239\t        executor.shutdown(wait=True)\n240\t\n241\t    def renderer(template_name: str, **data: Any) -> str:\n242\t        env = app.jinja_env\n243\t        template = env.get_template(template_name)\n244\t\n245\t        if env.is_async:\n246\t            # Run async render in the app's dedicated thread pool\n247\t            future = executor.submit(_run_async_render, template, data)\n248\t            return future.result()\n249\t\n250\t        # Sync environment - use direct rendering (unlikely for Quart)\n251\t        ctx = template.new_context(data)\n252\t        try:\n253\t            return concat(template.root_render_func(ctx))\n254\t        except Exception:\n255\t            return env.handle_exception()\n256\t\n257\t    app.jinja_env.globals.update(render_partial=generate_render_partial(renderer, markup=True))\n258\t\n259\t\n260\tdef register_fastapi_extensions(\n261\t    app: 'FastAPI',\n262\t    templates: 'FastAPIJinja2Templates',\n263\t    max_workers: int = 4,\n264\t) -> None:\n265\t    \"\"\"Register jinja_partials with a FastAPI application.\n266\t\n267\t    This creates a dedicated ThreadPoolExecutor for rendering partials in async\n268\t    environments. The executor lifecycle is tied to the FastAPI app via its\n269\t    lifespan - it is shut down when the lifespan exits normally (one\n270\t    startup/shutdown cycle per registration).\n271\t\n272\t    Args:\n273\t        app: The FastAPI application instance.\n274\t        templates: The Jinja2Templates instance used for rendering.\n275\t        max_workers: Maximum number of worker threads for rendering partials.\n276\t                     Defaults to 4.\n277\t\n278\t    Raises:\n279\t        PartialsException: If FastAPI is not installed.\n280\t\n281\t    Example:\n282\t        Register during app setup:\n283\t\n284\t            from fastapi import FastAPI\n285\t            from fastapi.templating import Jinja2Templates\n286\t            import jinja_partials\n287\t\n288\t            app = FastAPI()\n289\t            templates = Jinja2Templates(directory=\"templates\")\n290\t            jinja_partials.register_fastapi_extensions(app, templates)\n291\t    \"\"\"\n292\t    if fastapi is None:\n293\t        raise PartialsException('Install FastAPI to use `register_fastapi_extensions`')\n294\t\n295\t    # Create a dedicated executor for this app\n296\t    executor = ThreadPoolExecutor(max_workers=max_workers)\n297\t\n298\t    # Store executor on app state for potential access/debugging\n299\t    app.state.jinja_partials_executor = executor\n300\t\n301\t    # Wrap existing lifespan if present\n302\t    original_lifespan = app.router.lifespan_context\n303\t\n304\t    @asynccontextmanager\n305\t    async def lifespan_wrapper(app_instance: 'FastAPI') -> AsyncIterator[dict[str, Any]]:\n306\t        # Run original lifespan startup\n307\t        if original_lifespan is not None:\n308\t            async with original_lifespan(app_instance) as state:\n309\t                yield state if state else {}  # type: ignore\n310\t        else:\n311\t            yield {}\n312\t        # Shutdown executor after app stops\n313\t        executor.shutdown(wait=True)