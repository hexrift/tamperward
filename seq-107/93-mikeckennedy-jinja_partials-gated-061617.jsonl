ns['jinja_partials_executor'] = ThreadPoolExecutor(max_workers=max_workers)\n\n    @app.after_serving\n    async def shutdown_executor():\n        executor = extensions['jinja_partials_executor']\n        if executor is not None:\n            executor.shutdown(wait=True)\n        extensions['jinja_partials_executor'] = None\n\n    def renderer(template_name: str, **data: Any) -> str:\n        env = app.jinja_env\n        template = env.get_template(template_name)\n\n        if env.is_async:\n            # Use the active per-cycle executor when serving, otherwise fall\n            # back to the per-registration executor.\n            executor = extensions['jinja_partials_executor'] or fallback_executor\n            future = executor.submit(_run_async_render, template, data)\n            return future.result()"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1620,"cache_read_input_tokens":56736,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1620},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dadf16f-7177-48cb-b4b7-c98ef018bc5c","uuid":"3809025a-204f-4fdc-9e3f-def6ae21f086","timestamp":"2026-09-10T06:18:53.313Z","request_id":"req_011CeuGkgAVP7U6eS6qaAbvC"}
