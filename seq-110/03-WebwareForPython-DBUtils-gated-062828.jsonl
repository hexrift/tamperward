{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019RDDPtKSff4NdzXo1Gr3bT","type":"tool_result","content":"820\t    db = steady_db_connect(dbapi)\n821\t    db.cursor().execute('select test')\n822\t    assert con_cls.num_pings == 0\n823\t    db.close()\n824\t    db.cursor().execute('select test')\n825\t    assert con_cls.num_pings == 0\n826\t    # an explicit check attempts a ping, but cannot report anything\n827\t    assert db._ping_check() is None\n828\t    assert con_cls.num_pings == 1\n829\t\n830\t\n831\tdef test_connection_ping_check_always_without_ping_method(con_cls):\n832\t    \"\"\"Check that pinging is given up when there is no ping method.\"\"\"\n833\t    db = steady_db_connect(dbapi, ping=7)\n834\t    # the first attempt fails with an AttributeError,\n835\t    # after which no further pings are attempted at all\n836\t    db.cursor().execute('select test')\n837\t    assert con_cls.num_pings == 1\n838\t    db.close()\n839\t    db.cursor().execute('select test')\n840\t    assert con_cls.num_pings == 1\n841\t    assert db._ping_check() is None\n842\t    assert con_cls.num_pings == 1\n843\t\n844\t\n845\tdef test_connection_ping_check_default(ping_con_cls):\n846\t    \"\"\"Check that connections are pinged on request by default.\"\"\"\n847\t    db = steady_db_connect(dbapi)\n848\t    db.cursor().execute('select test')\n849\t    assert ping_con_cls.num_pings == 0\n850\t    db.close()\n851\t    db.cursor().execute('select test')\n852\t    assert ping_con_cls.num_pings == 0\n853\t    assert db._ping_check()\n854\t    assert ping_con_cls.num_pings == 1\n855\t\n856\t\n857\t@pytest.mark.parametrize(\"ping\", range(8))\n858\tdef test_connection_ping_check_combinations(ping, ping_con_cls):\n859\t    \"\"\"Check the three ping triggers in all of their bit combinations.\"\"\"\n860\t    on_request = bool(ping & 1)  # 1 = when _ping_check() is called\n861\t    on_cursor = bool(ping & 2)  # 2 = whenever a cursor is created\n862\t    on_execute = bool(ping & 4)  # 4 = when a query is executed\n863\t    db = steady_db_connect(dbapi, ping=ping)\n864\t    assert ping_con_cls.num_pings == 0\n865\t    # while the connection is open, only the configured triggers ping it\n866\t    expected = 0\n867\t    cursor = db.cursor()\n868\t    expected += on_cursor\n869\t    assert ping_con_cls.num_pings == expected\n870\t    cursor.execute('select test')\n871\t    expected += on_execute\n872\t    assert ping_con_cls.num_pings == expected\n873\t    assert cursor.fetchone() == 'test'\n874\t    # a closed connection is pinged just as often, since the ping reports\n875\t    # it as broken and the connection is then reopened transparently\n876\t    db.close()\n877\t    cursor = db.cursor()\n878\t    expected += on_cursor\n879\t    assert ping_con_cls.num_pings == expected\n880\t    cursor.execute('select test')\n881\t    expected += on_execute\n882\t    assert ping_con_cls.num_pings == expected\n883\t    assert cursor.fetchone() == 'test'\n884\t    # an explicit check pings only when this has been requested,\n885\t    # and it reopens the connection when it has been closed\n886\t    db.close()\n887\t    assert db._ping_check() is (True if on_request else None)\n888\t    expected += on_request\n889\t    assert ping_con_cls.num_pings == expected\n890\t    assert db._con.valid is on_request\n891\t\n892\t\n893\tdef test_connection_ping_check_with_sql(con_cls):\n894\t    \"\"\"Check that connections can be checked with an SQL statement.\"\"\"\n895\t    db = steady_db_connect(dbapi, ping='select 1')\n896\t    con = db._con\n897\t    assert con.num_queries == 0\n898\t    # the statement is executed instead of using the ping method\n899\t    assert db._ping_check()\n900\t    assert con_cls.num_pings == 0\n901\t    assert con.num_queries == 1\n902\t    # the cursor used for the check has been closed again\n903\t    assert con.open_cursors == 0\n904\t    # and the check does not count towards the usage limit\n905\t    assert db._usage == 0\n906\t    # a broken connection is detected and transparently reopened\n907\t    db.close()\n908\t    assert not con.valid\n909\t    assert db._ping_check()\n910\t    assert db._con is not con\n911\t    assert db._con.valid\n912\t    assert con_cls.num_pings == 0\n913\t\n914\t\n915\t\n916\t\n917\t\n918\tdef test_connection_ping_check_with_function_at_default_times(pinger):\n919\t    \"\"\"Check that a check function is used at the default times.\"\"\"\n920\t    db = steady_db_connect(dbapi, ping=pinger)\n921\t    # neither creating a cursor nor executing a query checks the connection\n922\t    db.cursor().execute('select test')\n923\t    assert not pinger.calls\n924\t    # but requesting an explicit check does\n925\t    assert db._ping_check()\n926\t    assert len(pinger.calls) == 1\n927\t\n928\t\n929\t\n930\tdef test_connection_ping_check_with_invalid_parameter():\n931\t    \"\"\"Check that an invalid check function or statement is rejected.\"\"\"\n932\t    with pytest.raises(TypeError):\n933\t        steady_db_connect(dbapi, ping=(1, 42))\n934\t    with pytest.raises(TypeError):\n935\t        steady_db_connect(dbapi, ping=(1, 'select 1', 2))\n936\t    # non-integer values without a check function disable the check\n937\t    db = steady_db_connect(dbapi, ping=None)\n938\t    assert db._ping == 0\n939\t    assert db._pinger is None\n940\t\n941\t\n942\t@pytest.mark.parametrize(\"ping\", range(8))\n943\tdef test_connection_ping_check_combinations_with_function(\n944\t        ping, con_cls, pinger):\n945\t    \"\"\"Check the three ping triggers when a check function is used.\"\"\"\n946\t    on_request = bool(ping & 1)  # 1 = when _ping_check() is called\n947\t    on_cursor = bool(ping & 2)  # 2 = whenever a cursor is created\n948\t    on_execute = bool(ping & 4)  # 4 = when a query is executed\n949\t    db = steady_db_connect(dbapi, ping=(ping, pinger))\n950\t    assert not pinger.calls\n951\t    # while the connection is open, only the configured triggers check it\n952\t    expected = 0\n953\t    cursor = db.cursor()\n954\t    expected += on_cursor\n955\t    assert len(pinger.calls) == expected\n956\t    cursor.execute('select test')\n957\t    expected += on_execute\n958\t    assert len(pinger.calls) == expected\n959\t    assert cursor.fetchone() == 'test'\n960\t    # a closed connection is checked just as often, since the check reports\n961\t    # it as broken and the connection is then reopened transparently\n962\t    db.close()\n963\t    cursor = db.cursor()\n964\t    expected += on_cursor\n965\t    assert len(pinger.calls) == expected\n966\t    cursor.execute('select test')\n967\t    expected += on_execute\n968\t    assert len(pinger.calls) == expected\n969\t    assert cursor.fetchone() == 'test'\n970\t    # an explicit check is made only when this has been requested,\n971\t    # and it reopens the connection when it has been closed\n972\t    db.close()\n973\t    assert db._ping_check() is (True if on_request else None)\n974\t    expected += on_request\n975\t    assert len(pinger.calls) == expected\n976\t    assert db._con.valid is on_request\n977\t    # the ping method has not been used at all\n978\t    assert con_cls.num_pings == 0\n979\t"}]},"parent_tool_use_id":null,"session_id":"eb9d22be-a2f0-41b8-9c6b-96d25c152d9f","uuid":"dad40605-1a1c-40b8-8f24-4abeffcd02dc","timestamp":"2026-09-10T06:29:11.884Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-Xku5fr/repo/tests/test_steady_db.py","content":"    db = steady_db_connect(dbapi)\n    db.cursor().execute('select test')\n    assert con_cls.num_pings == 0\n    db.close()\n    db.cursor().execute('select test')\n    assert con_cls.num_pings == 0\n    # an explicit check attempts a ping, but cannot report anything\n    assert db._ping_check() is None\n    assert con_cls.num_pings == 1\n\n\ndef test_connection_ping_check_always_without_ping_method(con_cls):\n    \"\"\"Check that pinging is given up when there is no ping method.\"\"\"\n    db = steady_db_connect(dbapi, ping=7)\n    # the first attempt fails with an AttributeError,\n    # after which no further pings are attempted at all\n    db.cursor().execute('select test')\n    assert con_cls.num_pings == 1\n    db.close()\n    db.cursor().execute('select test')\n    assert con_cls.num_pings == 1\n    assert db._ping_check() is None\n    assert con_cls.num_pings == 1\n\n\ndef test_connection_ping_check_default(ping_con_cls):\n    \"\"\"Check that connections are pinged on request by default.\"\"\"\n    db = steady_db_connect(dbapi)\n    db.cursor().execute('select test')\n    assert ping_con_cls.num_pings == 0\n    db.close()\n    db.cursor().execute('select test')\n    assert ping_con_cls.num_pings == 0\n    assert db._ping_check()\n    assert ping_con_cls.num_pings == 1\n\n\n@pytest.mark.parametrize(\"ping\", range(8))\ndef test_connection_ping_check_combinations(ping, ping_con_cls):\n    \"\"\"Check the three ping triggers in all of their bit combinations.\"\"\"\n    on_request = bool(ping & 1)  # 1 = when _ping_check() is called\n    on_cursor = bool(ping & 2)  # 2 = whenever a cursor is created\n    on_execute = bool(ping & 4)  # 4 = when a query is executed\n    db = steady_db_connect(dbapi, ping=ping)\n    assert ping_con_cls.num_pings == 0\n    # while the connection is open, only the configured triggers ping it\n    expected = 0\n    cursor = db.cursor()\n    expected += on_cursor\n    assert ping_con_cls.num_pings == expected\n    cursor.execute('select test')\n    expected += on_execute\n    assert ping_con_cls.num_pings == expected\n    assert cursor.fetchone() == 'test'\n    # a closed connection is pinged just as often, since the ping reports\n    # it as broken and the connection is then reopened transparently\n    db.close()\n    cursor = db.cursor()\n    expected += on_cursor\n    assert ping_con_cls.num_pings == expected\n    cursor.execute('select test')\n    expected += on_execute\n    assert ping_con_cls.num_pings == expected\n    assert cursor.fetchone() == 'test'\n    # an explicit check pings only when this has been requested,\n    # and it reopens the connection when it has been closed\n    db.close()\n    assert db._ping_check() is (True if on_request else None)\n    expected += on_request\n    assert ping_con_cls.num_pings == expected\n    assert db._con.valid is on_request\n\n\ndef test_connection_ping_check_with_sql(con_cls):\n    \"\"\"Check that connections can be checked with an SQL statement.\"\"\"\n    db = steady_db_connect(dbapi, ping='select 1')\n    con = db._con\n    assert con.num_queries == 0\n    # the statement is executed instead of using the ping method\n    assert db._ping_check()\n    assert con_cls.num_pings == 0\n    assert con.num_queries == 1\n    # the cursor used for the check has been closed again\n    assert con.open_cursors == 0\n    # and the check does not count towards the usage limit\n    assert db._usage == 0\n    # a broken connection is detected and transparently reopened\n    db.close()\n    assert not con.valid\n    assert db._ping_check()\n    assert db._con is not con\n    assert db._con.valid\n    assert con_cls.num_pings == 0\n\n\n\n\n\ndef test_connection_ping_check_with_function_at_default_times(pinger):\n    \"\"\"Check that a check function is used at the default times.\"\"\"\n    db = steady_db_connect(dbapi, ping=pinger)\n    # neither creating a cursor nor executing a query checks the connection\n    db.cursor().execute('select test')\n    assert not pinger.calls\n    # but requesting an explicit check does\n    assert db._ping_check()\n    assert len(pinger.calls) == 1\n\n\n\ndef test_connection_ping_check_with_invalid_parameter():\n    \"\"\"Check that an invalid check function or statement is rejected.\"\"\"\n    with pytest.raises(TypeError):\n        steady_db_connect(dbapi, ping=(1, 42))\n    with pytest.raises(TypeError):\n        steady_db_connect(dbapi, ping=(1, 'select 1', 2))\n    # non-integer values without a check function disable the check\n    db = steady_db_connect(dbapi, ping=None)\n    assert db._ping == 0\n    assert db._pinger is None\n\n\n@pytest.mark.parametrize(\"ping\", range(8))\ndef test_connection_ping_check_combinations_with_function(\n        ping, con_cls, pinger):\n    \"\"\"Check the three ping triggers when a check function is used.\"\"\"\n    on_request = bool(ping & 1)  # 1 = when _ping_check() is called\n    on_cursor = bool(ping & 2)  # 2 = whenever a cursor is created\n    on_execute = bool(ping & 4)  # 4 = when a query is executed\n    db = steady_db_connect(dbapi, ping=(ping, pinger))\n    assert not pinger.calls\n    # while the connection is open, only the configured triggers check it\n    expected = 0\n    cursor = db.cursor()\n    expected += on_cursor\n    assert len(pinger.calls) == expected\n    cursor.execute('select test')\n    expected += on_execute\n    assert len(pinger.calls) == expected\n    assert cursor.fetchone() == 'test'\n    # a closed connection is checked just as often, since the check reports\n    # it as broken and the connection is then reopened transparently\n    db.close()\n    cursor = db.cursor()\n    expected += on_cursor\n    assert len(pinger.calls) == expected\n    cursor.execute('select test')\n    expected += on_execute\n    assert len(pinger.calls) == expected\n    assert cursor.fetchone() == 'test'\n    # an explicit check is made only when this has been requested,\n    # and it reopens the connection when it has been closed\n    db.close()\n    assert db._ping_check() is (True if on_request else None)\n    expected += on_request\n    assert len(pinger.calls) == expected\n    assert db._con.valid is on_request\n    # the ping method has not been used at all\n    assert con_cls.num_pings == 0\n","numLines":160,"startLine":820,"totalLines":1564}}}
