+    if is_dict or isinstance(spec, str):
+        assert len(extra_specs) == 0, f'assert_shape() takes 1 positional argument but {1 + len(extra_specs)} were given'
+
+        def decorator(fn):
+            signature = inspect.signature(fn)
+
+            @wraps(fn)
+            def inner(*args, **kwargs):
+                bound = signature.bind(*args, **kwargs)
