+def index(string: str, substring: str) -> int:
+    """
+    Returns the grapheme-based index of the first occurrence of substring in string.
+
+    Like `contains`, this respects grapheme boundaries, so a match is only reported
+    if the sequence of graphemes in substring aligns with grapheme boundaries in string.
+
+    Returns -1 if the substring is not found.
+
+    >>> grapheme.index("🇪🇸🇪🇪", "🇸🇪")
+    -1
+    """
+    if substring == "":
+        return 0
+
+    if substring not in string:
+        return -1
+
+    substr_graphemes = list(graphemes(substring))
+    str_graphemes = list(graphemes(string))
+    n = len(substr_graphemes)
+
+    for i in range(len(str_graphemes) - n + 1):
+        if str_graphemes[i : i + n] == substr_graphemes:
+            return i
+
+    return -1
+
