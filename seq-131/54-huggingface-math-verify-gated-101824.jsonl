ool = False,\n43\t):\n44\t    \"\"\"Helper function to compare strings using the math extraction metrics\"\"\"\n45\t    # Convert string match_types to ExtractionTarget objects\n46\t    extraction_targets = []\n47\t    for match_type in match_types:\n48\t        if match_type == \"latex\":\n49\t            extraction_targets.append(LatexExtractionConfig(boxed_match_priority=0))\n50\t        elif match_type == \"expr\":\n51\t            extraction_targets.append(ExprExtractionConfig())\n52\t\n53\t    gold_parsed = parse(gold, extraction_targets)\n54\t    pred_parsed = parse(pred, extraction_targets)\n55\t    return verify(gold_parsed, pred_parsed, float_rounding=precision, strict=strict, allow_set_relation_comp=allow_set_relation_comp)\n56\t\n57\t\n58\t@pytest.mark.parametrize(\n59\t    \"gold,pred,expected\",\n60\t    [\n61\t        # Test negative numbers\n62\t        (\"-5\", \"-5\", 1),\n63\t        # Test for thousands separator\n64\t        (\"7425000\", \"7,425,000\", 1),\n65\t        (\"1000\", \"1 000\", 1),\n66\t        (\"1000\", \"1000.0\", 1),\n67\t        # Test thousand separator with floating point number\n68\t        (\"1000.0\", \"1,000.0\", 1),\n69\t        # Test decimal separator as ,\n70\t        (\"1000.99\", \"1000,99\", 1),"}]},"parent_tool_use_id":null,"session_id":"7b295ff2-6a05-4b7a-81b7-773ca81f81d9","uuid":"7abef6b2-832b-4517-91a4-ef482d687c7a","timestamp":"2026-09-10T10:19:01.917Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-zLmXC4/repo/tests/test_all.py","content":"# MIT License\n\n# Copyright (c) 2024 The HuggingFace Team\n\n# Permission is hereby granted, free of charge, to any person obtaining a copy\n# of this software and associated documentation files (the \"Software\"), to deal\n# in the Software without restriction, including without limitation the rights\n# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n# copies of the Software, and to permit persons to whom the Software is\n# furnished to do so, subject to the following conditions:\n\n# The above copyright notice and this permission notice shall be included in all\n# copies or substantial portions of the Software.\n\n# THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n# SOFTWARE.\n\nimport pytest\nimport sympy\nimport math\n\nfrom math_verify import ExprExtractionConfig, LatexExtractionConfig, parse, verify\nfrom math_verify.grader import sympy_expr_eq\n\n\"\"\"\nThis file contains regression tests for testing evaluation of free-flow generation for math or indices.\nMost of the tests have been created based on observations from the model outputs.\n\"\"\"\n\n\ndef compare_strings(\n    gold: str,\n    pred: str,\n    match_types: list[str] = [\"latex\", \"expr\"],\n    precision: int = 6,\n    strict: bool = True,\n    allow_set_relation_comp: bool = False,\n):\n    \"\"\"Helper function to compare strings using the math extraction metrics\"\"\"\n    # Convert string match_types to ExtractionTarget objects\n    extraction_targets = []\n    for match_type in match_types:\n        if match_type == \"latex\":\n            extraction_targets.append(LatexExtractionConfig(boxed_match_priority=0))\n        elif match_type == \"expr\":\n            extraction_targets.append(ExprExtractionConfig())\n\n    gold_parsed = parse(gold, extraction_targets)\n    pred_parsed = parse(pred, extraction_targets)\n    return verify(gold_parsed, pred_parsed, float_rounding=precision, strict=strict, allow_set_relation_comp=allow_set_relation_comp)\n\n\n@pytest.mark.parametrize(\n    \"gold,pred,expected\",\n    [\n        # Test negative numbers\n        (\"-5\", \"-5\", 1),\n        # Test for thousands separator\n        (\"7425000\", \"7,425,000\", 1),\n        (\"1000\", \"1 000\", 1),\n        (\"1000\", \"1000.0\", 1),\n        # Test thousand separator with floating point number\n        (\"1000.0\", \"1,000.0\", 1),\n        # Test decimal separator as ,\n        (\"1000.99\", \"1000,99\", 1),","numLines":70,"startLine":1,"totalLines":928}}}
