+    @staticmethod
+    def _iter_nested_dicts(
+        raw_node: Any, parent_key: str = ""
+    ) -> Iterator[tuple[str, dict]]:
+        """Recursively yield ``(full_key, raw_node)`` for ``raw_node`` and every
+        dict nested inside it, where ``full_key`` is the dotted path to that dict.
+        Returns immediately if ``raw_node`` isn't a dict, e.g. a top-level
+        metadata key such as a dataset's ``filepath``.
+        """
+        if not isinstance(raw_node, dict):
+            return
+        yield parent_key, raw_node
+        for key, value in raw_node.items():
+            full_key = f"{parent_key}.{key}" if parent_key else key
+            yield from OmegaConfigLoader._iter_nested_dicts(value, full_key)
+
+    def _is_real_runtime_params_hit(self, variable: str) -> bool:
+        """Whether ``variable`` (a dotted path) is actually present in
+        ``self.runtime_params``, as opposed to falling back to a resolver default.
+        """
+        node: Any = self.runtime_params
+        for part in variable.split("."):
+            if not isinstance(node, dict) or part not in node:
+                return False
+            node = node[part]
+        return True
+
+    def _check_runtime_params_type_restriction(self, raw_config: dict) -> None:
+        """Raise if any ``type`` key, at any nesting level, is selected via a
+        `runtime_params:` resolver reference that actually resolves against
+        `runtime_params` (as opposed to falling back to a default value)."""
+        for full_key, node in self._iter_nested_dicts(raw_config):
+            type_value = node.get("type")
+            if not isinstance(type_value, str):
+                continue
+            for match in _RUNTIME_PARAMS_REFERENCE.finditer(type_value):
+                variable = match.group(1).strip()
+                if self._is_real_runtime_params_hit(variable):
+                    type_key = f"{full_key}.type" if full_key else "type"
+                    raise InterpolationResolutionError(
+                        f"Using `runtime_params:` to select the value of '{type_key}' "
+                        "is not permitted when restrict_runtime_params_type_selection "
+                        "is set."
+                    )
+
