{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LMZ2Fzzxe9UcTZovToZYEH","type":"tool_result","content":"1430\t    # Always quote the version to avoid issues with floating point,\n1431\t    # e.g if 'ver' is \"0.10\", it gets treated like 0.1 in YAML.\n1432\t\n1433\t    manifest = Manifest.from_data(f'''\\\n1434\t    manifest:\n1435\t      version: \"{ver}\"\n1436\t      projects:\n1437\t      - name: foo\n1438\t        url: https://foo.com\n1439\t    ''')\n1440\t    assert manifest.projects[-1].name == 'foo'\n1441\t\n1442\t\n1443\t@pytest.mark.parametrize('declared', [None, '0.7', '1.0', SCHEMA_VERSION])\n1444\tdef test_resolve_freeze_stamp_current_schema_version(declared):\n1445\t    # `west manifest --resolve` and `--freeze` output is a synthesis\n1446\t    # produced by this west, so it is always stamped with the current\n1447\t    # SCHEMA_VERSION -- regardless of what the source manifest declared\n1448\t    # (or didn't). This avoids under-claiming when imports declare a\n1449\t    # newer version than the top-level manifest.\n1450\t\n1451\t    lines = ['manifest:']\n1452\t    if declared is not None:\n1453\t        lines.append(f'  version: \"{declared}\"')\n1454\t    lines.append('  projects: []')  # empty, so as_frozen_dict() needs no clones\n1455\t    manifest = Manifest.from_data('\\n'.join(lines) + '\\n')\n1456\t\n1457\t    assert manifest.as_dict()['manifest']['version'] == SCHEMA_VERSION\n1458\t    assert manifest.as_frozen_dict()['manifest']['version'] == SCHEMA_VERSION\n1459\t\n1460\t\n1461\tdef test_resolve_stamps_max_when_import_declares_newer():\n1462\t    # A submanifest imported from a lower-versioned top-level manifest\n1463\t    # must not cause the resolved output to under-claim: the stamp is\n1464\t    # SCHEMA_VERSION, which covers any import's (validated) version.\n1465\t\n1466\t    top = '''\\\n1467\t    manifest:\n1468\t      version: \"1.0\"\n1469\t      projects:\n1470\t      - name: upstream\n1471\t        url: https://example.com/upstream\n1472\t        import: west.yml\n1473\t    '''\n1474\t    sub = f'''\\\n1475\t    manifest:\n1476\t      version: \"{SCHEMA_VERSION}\"\n1477\t      projects:\n1478\t      - name: hal\n1479\t        url: https://example.com/hal\n1480\t    '''\n1481\t    importer = make_importer({('upstream', 'west.yml'): sub})\n1482\t    manifest = Manifest.from_data(top, importer=importer, import_flags=FPI)\n1483\t    assert manifest.as_dict()['manifest']['version'] == SCHEMA_VERSION\n1484\t\n1485\t\n1486\tdef test_project_filter_validation(config_tmpdir):\n1487\t    # Make sure we error out in the expected way when invalid\n1488\t    # manifest.project-filter options occur anywhere.\n1489\t\n1490\t    topdir = config_tmpdir / 'test-topdir'\n1491\t    manifest_repo = topdir / 'mp'\n1492\t    config = Configuration(topdir=topdir)\n1493\t    config.set('manifest.path', 'mp')\n1494\t    create_repo(manifest_repo)\n1495\t    with open(manifest_repo / 'west.yml', 'w') as f:\n1496\t        f.write('manifest: {}')\n1497\t\n1498\t    def clean_up_config_files():\n1499\t        for configfile in [ConfigFile.SYSTEM, ConfigFile.GLOBAL, ConfigFile.LOCAL]:"}]},"parent_tool_use_id":null,"session_id":"ac4efc89-c04d-45eb-88fc-27d757428424","uuid":"8bb77699-5043-4753-a852-53a31c277728","timestamp":"2026-09-10T11:28:09.605Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-mt6vxv/repo/tests/test_manifest.py","content":"    # Always quote the version to avoid issues with floating point,\n    # e.g if 'ver' is \"0.10\", it gets treated like 0.1 in YAML.\n\n    manifest = Manifest.from_data(f'''\\\n    manifest:\n      version: \"{ver}\"\n      projects:\n      - name: foo\n        url: https://foo.com\n    ''')\n    assert manifest.projects[-1].name == 'foo'\n\n\n@pytest.mark.parametrize('declared', [None, '0.7', '1.0', SCHEMA_VERSION])\ndef test_resolve_freeze_stamp_current_schema_version(declared):\n    # `west manifest --resolve` and `--freeze` output is a synthesis\n    # produced by this west, so it is always stamped with the current\n    # SCHEMA_VERSION -- regardless of what the source manifest declared\n    # (or didn't). This avoids under-claiming when imports declare a\n    # newer version than the top-level manifest.\n\n    lines = ['manifest:']\n    if declared is not None:\n        lines.append(f'  version: \"{declared}\"')\n    lines.append('  projects: []')  # empty, so as_frozen_dict() needs no clones\n    manifest = Manifest.from_data('\\n'.join(lines) + '\\n')\n\n    assert manifest.as_dict()['manifest']['version'] == SCHEMA_VERSION\n    assert manifest.as_frozen_dict()['manifest']['version'] == SCHEMA_VERSION\n\n\ndef test_resolve_stamps_max_when_import_declares_newer():\n    # A submanifest imported from a lower-versioned top-level manifest\n    # must not cause the resolved output to under-claim: the stamp is\n    # SCHEMA_VERSION, which covers any import's (validated) version.\n\n    top = '''\\\n    manifest:\n      version: \"1.0\"\n      projects:\n      - name: upstream\n        url: https://example.com/upstream\n        import: west.yml\n    '''\n    sub = f'''\\\n    manifest:\n      version: \"{SCHEMA_VERSION}\"\n      projects:\n      - name: hal\n        url: https://example.com/hal\n    '''\n    importer = make_importer({('upstream', 'west.yml'): sub})\n    manifest = Manifest.from_data(top, importer=importer, import_flags=FPI)\n    assert manifest.as_dict()['manifest']['version'] == SCHEMA_VERSION\n\n\ndef test_project_filter_validation(config_tmpdir):\n    # Make sure we error out in the expected way when invalid\n    # manifest.project-filter options occur anywhere.\n\n    topdir = config_tmpdir / 'test-topdir'\n    manifest_repo = topdir / 'mp'\n    config = Configuration(topdir=topdir)\n    config.set('manifest.path', 'mp')\n    create_repo(manifest_repo)\n    with open(manifest_repo / 'west.yml', 'w') as f:\n        f.write('manifest: {}')\n\n    def clean_up_config_files():\n        for configfile in [ConfigFile.SYSTEM, ConfigFile.GLOBAL, ConfigFile.LOCAL]:","numLines":70,"startLine":1430,"totalLines":3668}}}
