         return [seg for seg in segment.segments if not is_negligible(seg)]
 
 
+def list_set_clause_columns(set_clause: BaseSegment) -> list[BaseSegment]:
+    """
+    Extract the [target_column, source_column] pair of column_reference from a
+    set_clause. tsql wraps the assignment RHS in an `expression` segment even when
+    it's a bare column reference (e.g. `SET target.v = src.v`), unlike ansi which
+    keeps it a direct child of set_clause.
+    """
+    columns = list(set_clause.get_children("column_reference"))
+    if len(columns) < 2:
+        if expression := set_clause.get_child("expression"):
+            inner = [seg for seg in expression.segments if not is_negligible(seg)]
+            if len(inner) == 1 and inner[0].type == "column_reference":
+                columns.append(inner[0])
+    return columns
+
+
 def extract_identifier(col_segment: BaseSegment) -> str:
     identifiers = list_child_segments(col_segment)
 
