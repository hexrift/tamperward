+# sqlfluff's config loader unconditionally lists the user's home directory
+# (os.path.expanduser("~")) to look for user-level config. In sandboxed CI
+# environments the configured $HOME may not be readable by the running user,
+# which crashes every test that parses SQL. Point HOME at a readable temp
+# directory in that case so config loading finds nothing and moves on.
+if not os.access(os.path.expanduser("~"), os.R_OK):
+    os.environ["HOME"] = tempfile.mkdtemp()
