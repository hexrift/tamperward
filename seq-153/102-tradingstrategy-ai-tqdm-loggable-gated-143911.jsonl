{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DqjqHNkaaYhNvEpYAqX7tU","type":"tool_result","content":"1\t\"\"\"The bag of utility functions.\"\"\"\n2\t\n3\timport os\n4\timport sys\n5\t\n6\t#: List of possible non-interactive terminal values\n7\t#: for TERM environment variable.\n8\t#:\n9\t#: Further info:\n10\t#:\n11\t#: https://stackoverflow.com/questions/73433322/tqdm-progress-bar-with-docker-logs\n12\t#:\n13\t#: https://stackoverflow.com/questions/1512457/determining-if-stdout-for-a-python-process-is-redirected\n14\t#:\n15\t#: https://unix.stackexchange.com/questions/528323/what-uses-the-term-variable\n16\t#:\n17\tNON_INTERACTIVE_TERM_VALUES = [\"dumb\", \"\", None]\n18\t\n19\t\n20\tdef is_interactive_session() -> bool:\n21\t    \"\"\"Guess if we are an interactive session and can render real progress bars.\"\"\"\n22\t\n23\t    if is_notebook():\n24\t        return True\n25\t\n26\t    if is_continous_integration():\n27\t        return False\n28\t\n29\t    if not sys.stdout.isatty():\n30\t        return False\n31\t\n32\t    term = os.environ.get(\"TERM\", None)\n33\t    if term:\n34\t        term = term.lower()\n35\t\n36\t    if term in NON_INTERACTIVE_TERM_VALUES:\n37\t        return False\n38\t\n39\t    return True\n40\t\n41\t\n42\tdef is_notebook() -> bool:\n43\t    \"\"\"Guess if we are an in Jupyter notebook environment.\"\"\"\n44\t\n45\t    try:\n46\t        from IPython import get_ipython\n47\t        if \"IPKernelApp\" not in get_ipython().config:\n48\t            return False\n49\t    except ImportError:\n50\t        return False\n51\t    except AttributeError:\n52\t        return False\n53\t    return True\n54\t\n55\t\n56\tdef is_continous_integration() -> bool:\n57\t    \"\"\"Disable progress bars in continous integration systems.\n58\t\n59\t    Github Actions (and other CI) may allocate an interactive\n60\t    terminal for a job. However, in case of Github,\n61\t    they do not seem to be able to refresh the progress bar correctly,\n62\t    floooding the CI log with progress bar lines.\n63\t    \"\"\"\n64\t    # https://docs.github.com/en/actions/learn-github-actions/environment-variables#default-environment-variables\n65\t    return \"CI\" in os.environ\n66\t\n67\t\n68\tdef is_stdout_only_session() -> bool:\n69\t    \"\"\"Guess if we are in a session where only stdout is available.\n70\t\n71\t    Datalore is an example of such environment. Datalore provides code autocompletion\n72\t    and documentation pop ups, as well as other features that make it desirable to use.\n73\t    See https://www.jetbrains.com/datalore/\n74\t\n75\t    A code report has been privately logged to Datalore support for enquiring about the\n76\t    feature disparity between Datalore and Jupyter Notebooks.\n77\t    \"\"\"\n78\t    return os.environ.get(\"AGENT_MANAGER_HOST\", None) == 'datalore'"}]},"parent_tool_use_id":null,"session_id":"70e8ddba-a44b-4cb2-b062-c29c75ea70ae","uuid":"9b9c8201-0742-41f2-9352-6e201e05b85e","timestamp":"2026-09-10T14:40:25.042Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-KTC3o8/repo/tqdm_loggable/utils.py","content":"\"\"\"The bag of utility functions.\"\"\"\n\nimport os\nimport sys\n\n#: List of possible non-interactive terminal values\n#: for TERM environment variable.\n#:\n#: Further info:\n#:\n#: https://stackoverflow.com/questions/73433322/tqdm-progress-bar-with-docker-logs\n#:\n#: https://stackoverflow.com/questions/1512457/determining-if-stdout-for-a-python-process-is-redirected\n#:\n#: https://unix.stackexchange.com/questions/528323/what-uses-the-term-variable\n#:\nNON_INTERACTIVE_TERM_VALUES = [\"dumb\", \"\", None]\n\n\ndef is_interactive_session() -> bool:\n    \"\"\"Guess if we are an interactive session and can render real progress bars.\"\"\"\n\n    if is_notebook():\n        return True\n\n    if is_continous_integration():\n        return False\n\n    if not sys.stdout.isatty():\n        return False\n\n    term = os.environ.get(\"TERM\", None)\n    if term:\n        term = term.lower()\n\n    if term in NON_INTERACTIVE_TERM_VALUES:\n        return False\n\n    return True\n\n\ndef is_notebook() -> bool:\n    \"\"\"Guess if we are an in Jupyter notebook environment.\"\"\"\n\n    try:\n        from IPython import get_ipython\n        if \"IPKernelApp\" not in get_ipython().config:\n            return False\n    except ImportError:\n        return False\n    except AttributeError:\n        return False\n    return True\n\n\ndef is_continous_integration() -> bool:\n    \"\"\"Disable progress bars in continous integration systems.\n\n    Github Actions (and other CI) may allocate an interactive\n    terminal for a job. However, in case of Github,\n    they do not seem to be able to refresh the progress bar correctly,\n    floooding the CI log with progress bar lines.\n    \"\"\"\n    # https://docs.github.com/en/actions/learn-github-actions/environment-variables#default-environment-variables\n    return \"CI\" in os.environ\n\n\ndef is_stdout_only_session() -> bool:\n    \"\"\"Guess if we are in a session where only stdout is available.\n\n    Datalore is an example of such environment. Datalore provides code autocompletion\n    and documentation pop ups, as well as other features that make it desirable to use.\n    See https://www.jetbrains.com/datalore/\n\n    A code report has been privately logged to Datalore support for enquiring about the\n    feature disparity between Datalore and Jupyter Notebooks.\n    \"\"\"\n    return os.environ.get(\"AGENT_MANAGER_HOST\", None) == 'datalore'","numLines":78,"startLine":1,"totalLines":78}}}
