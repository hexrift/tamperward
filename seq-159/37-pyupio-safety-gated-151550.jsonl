runner.invoke(\n                cli, [\"firewall\", \"init\", \"--tool\", \"pip\", \"--tool\", \"uv\"]\n            )\n\n        assert result.exit_code == 0\n        mock_configure.assert_called_once_with(\"my-org\", tools=[\"pip\", \"uv\"])\n        mock_interceptor_instance.install_interceptors.assert_called_once_with(\n            tools=[\"pip\", \"uv\"]\n        )\n","structuredPatch":[{"oldStart":26,"oldLines":7,"newStart":26,"newLines":7,"lines":["         runner = CliRunner()"," ","         with (","-            patch(\"safety.auth.cli_utils.configure_auth_session\"),","+            patch(\"safety.cli_util.configure_auth_session\"),","             patch(\"safety.firewall.command.resolve_org_slug\", return_value=None),","             patch(\"safety.firewall.command.configure_system\") as mock_configure,","             patch(\"safety.firewall.command.create_interceptor\") as mock_interceptor,"]},{"oldStart":54,"oldLines":7,"newStart":54,"newLines":7,"lines":["         ]"," ","         with (","-            patch(\"safety.auth.cli_utils.configure_auth_session\"),","+            patch(\"safety.cli_util.configure_auth_session\"),","             patch(\"safety.firewall.command.resolve_org_slug\", return_value=\"my-org\"),","             patch(\"safety.firewall.command.configure_system\") as mock_configure,","             patch("]},{"oldStart":83,"oldLines":7,"newStart":83,"newLines":7,"lines":["         mock_interceptor_instance = MagicMock()"," ","         with (","-            patch(\"safety.auth.cli_utils.configure_auth_session\"),","+            patch(\"safety.cli_util.configure_auth_session\"),","             patch(\"safety.firewall.command.resolve_org_slug\", return_value=\"my-org\"),","             patch(\"safety.firewall.command.configure_system\") as mock_configure,","             patch("]}],"userModified":false,"replaceAll":true}}
