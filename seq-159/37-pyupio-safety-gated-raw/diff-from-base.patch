diff --git a/tests/conftest.py b/tests/conftest.py
index cb46e79..75416bc 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1,3 +1,18 @@
+import os
+import tempfile
+
+# Redirect HOME (and the Windows equivalents) to a throwaway, writable
+# directory before anything below imports `safety`. Several modules
+# (e.g. safety.constants) compute user/config directory paths at import
+# time from the real home directory, which may not be writable (or even
+# readable) in CI/sandboxed environments. Tests must not depend on the
+# ambient environment's home directory.
+_TEST_HOME = tempfile.mkdtemp(prefix="safety-test-home-")
+os.environ["HOME"] = _TEST_HOME
+os.environ["USERPROFILE"] = _TEST_HOME
+os.environ["LOCALAPPDATA"] = _TEST_HOME
+os.environ["APPDATA"] = _TEST_HOME
+
 from importlib.metadata import distributions
 from packaging.requirements import Requirement
 from packaging.utils import canonicalize_name
