       )\n94\t\n95\t    @staticmethod\n96\t    def to_datetime(date: DateArgument):\n97\t        \"\"\"Convert date inputs of various sorts into a datetime object.\"\"\"\n98\t        if isinstance(date, int):\n99\t            date = (date,)\n100\t        if isinstance(date, tuple):\n101\t            date += (1,) * (3 - len(date))\n102\t            return datetime.datetime(*date)  # noqa: DTZ001\n103\t        if isinstance(date, str):\n104\t            # see https://docs.python.org/2/library/datetime.html#strftime-strptime-behavior\n105\t            if len(date) == 8:\n106\t                return datetime.datetime.strptime(date, \"%Y%m%d\")  # noqa: DTZ007\n107\t            return datetime.datetime.strptime(date, \"%Y%m%dT%H%M%SZ\")  # noqa: DTZ007\n108\t        return date\n109\t\n110\t    def all(self) -> Generator[Component]:\n111\t        \"\"\"Generate all Components.\n112\t\n113\t        The Components are sorted from the first to the last Occurrence.\n114\t        Calendars can contain millions of Occurrences. This iterates\n115\t        safely across all of them\n116\t        \"\"\"\n117\t        # MAX and MIN values may change in the future\n118\t        return self.after(DATE_MIN_DT)\n119\t\n120\t    _DELTAS = [\n121\t        datetime.timedelta(days=1),\n122\t        datetime.timedelta(hours=1),\n123\t        datetime.timedelta(minutes=1),\n124\t        datetime.timedelta(seconds=1),\n125\t    ]\n126\t\n127\t    def at(self, date: DateArgument):\n128\t        \"\"\"Return all events within the next 24 hours of starting at the given day.\n129\t\n130\t        - date can be a year like (2019,) or 2099\n131\t        - a month like (2019, 1) for January of 2019\n132\t        - a day like (2019, 1, 1) for the first of January 2019\n133\t        - a day with hours, (2019, 1, 1, 1)\n134\t        - a day with minutes, (2019, 1, 1, 1, 1)\n135\t        - a day with seconds, (2019, 1, 1, 1, 1, 1)\n136\t        \"\"\"\n137\t        if isinstance(date, int):\n138\t            date = (date,)\n139\t        if isinstance(date, str):\n140\t            if len(date) != 8 or not date.isdigit():\n141\t                raise ValueError(f\"Format yyyymmdd expected for {date!r}.\")\n142\t            date = (int(date[:4], 10), int(date[4:6], 10), int(date[6:]))\n143\t        if isinstance(date, datetime.datetime):\n144\t            return self.between(date, date)\n145\t        if isinstance(date, datetime.date):\n146\t            return self.between(date, date + datetime.timedelta(days=1))\n147\t        if len(date) == 1:\n148\t            return self.between((date[0], 1, 1), (date[0] + 1, 1, 1))\n149\t        if len(date) == 2:\n150\t            year, month = date\n151\t            if month == 12:\n152\t                return self.between((year, 12, 1), (year + 1, 1, 1))\n153\t            return self.between((year, month, 1), (year, month + 1, 1))\n154\t        dt = self.to_datetime(date)\n155\t        return self._between(dt, dt + self._DELTAS[len(date) - 3])\n156\t\n157\t    def between(self, start: DateArgument, stop: DateArgument | datetime.timedelta):\n158\t        \"\"\"Return events at a time between start (inclusive) and end (inclusive)\"\"\"\n159\t        start = self.to_datetime(start)\n160\t        stop = (\n161\t            start + stop\n162\t            if isinstance(stop, datetime.timedelta)\n163\t            else self.to_datetime(stop)\n164\t        )\n165\t        return self._between(start, stop)\n166\t\n167\t    def _occurrences_to_components(\n168\t        self, occurrences: list[Occurrence]\n169\t    ) -> list[Component]:\n170\t        \"\"\"Map occurrences to components.\"\"\"\n171\t        return [\n172\t            occurrence.as_component(self.keep_recurrence_attributes)\n173\t            for occurrence in occurrences\n174\t        ]\n175\t\n176\t    def _between(self, start: Time, end: Time) -> list[Component]:\n177\t        \"\"\"Return the occurrences between the start and the end.\"\"\"\n178\t        return self._occurrences_to_components(self._occurrences_between(start, end))\n179\t\n180\t    def _occurrences_between(self, start: Time, end: Time) -> list[Occurrence]:\n181\t        \"\"\"Return the components between the start and the end.\"\"\"\n182\t        occurrences: list[Occurrence] = []\n183\t        for series in self.series:\n184\t            with contextlib.suppress(self._skip_errors):\n185\t                occurrences.extend(series.between(start, end))\n186\t        return occurrences\n187\t\n188\t    def after(self, earliest_end: DateArgument) -> Generator[Component]:\n189\t        \"\"\"Iterate over components happening during or after earliest_end.\"\"\"\n190\t        earliest_end = self.to_datetime(earliest_end)\n191\t        for occurrence in self._after(earliest_end):\n192\t            yield occurrence.as_component(self.keep_recurrence_attributes)\n193\t\n194\t    def _after(self, earliest_end: Time) -> Generator[Occurrence]:\n195\t        \"\"\"Iterate over occurrences happening during or after earliest_end.\"\"\"\n196\t        time_span = datetime.timedelta(days=1)\n197\t        min_time_span = datetime.timedelta(minutes=15)\n198\t        done = False\n199\t        result_ids: set[OccurrenceID] = set()\n200\t\n201\t        while not done:\n202\t            try:\n203\t                next_end = earliest_end + time_span\n204\t            except OverflowError:\n205\t                # We ran to the end\n206\t                next_end = DATE_MAX_DT\n207\t                if compare_greater(earliest_end, next_end):\n208\t                    return  # we might run too far\n209\t                done = True\n210\t            occurrences = self._occurrences_between(earliest_end, next_end)\n211\t            occurrences.sort()\n212\t            for occurrence in occurrences:\n213\t                if occurrence.id not in result_ids:\n214\t                    yield occurrence\n215\t                    result_ids.add(occurrence.id)\n216\t            # prepare next query\n217\t            time_span = max(\n218\t                time_span / 2 if occurrences else time_span * 2,\n219\t                min_time_span,\n220\t            )  # binary search to improve speed\n221\t            earliest_end = next_end\n222\t\n223\t    def count(self) -> int:\n224\t        \"\"\"Return the amount of recurring components in this calendar.\"\"\"\n225\t        i = 0\n226\t        for _ in self.all():\n227\t            i += 1\n228\t        return i\n229\t\n230\t    @property\n231\t    def first(self) -> Component:\n232\t        \"\"\"Return the first recurring component in this calendar.\n233\t\n234\t        If there is no recurring component, an IndexError is raised.\n235\t        \"\"\"\n236\t        for component in self.all():\n237\t            return component\n238\t        raise IndexError(\"No components found.\")\n239\t\n240\t    def paginate(\n241\t        self,\n242\t        page_size: int,\n243\t        earliest_end: Optional[DateArgument] = None,\n244\t        latest_start: Optional[DateArgument] = None,\n245\t        next_page_id: str = \"\",\n246\t    ) -> Pages:\n247\t        \"\"\"Return pages for pagination.\n248\t\n249\t        Args:\n250\t            page_size: the number of components per page\n251\t            earliest_end: the start of the first page\n252\t                All components occur after this date.\n253\t            latest_start: the end of the last page\n254\t                All components occur before this date.\n255\t            next_page_id: The id of the next page.\n256\t        \"\"\"\n257\t        latest_start = None if latest_start is None else self.to_datetime(latest_start)\n258\t        earliest_end = (\n259\t            DATE_MIN_DT if earliest_end is None else self.to_datetime(earliest_end)\n260\t        )\n261\t        if next_page_id:\n262\t            first_occurrence_id = OccurrenceID.from_string(next_page_id)\n263\t            if not compare_greater(earliest_end, first_occurrence_id.start):\n264\t                iterator = self._after(first_occurrence_id.start)\n265\t                lost_occurrences = []  # in case we do not find the event\n266\t                for occurrence in iterator:\n267\t                    lost_occurrences.append(occurrence)\n268\t                    oid = occurrence.id\n269\t                    if oid == first_occurrence_id:\n270\t                        iterator = itertools.chain([occurrence], iterator)\n271\t                        break\n272\t                    if compare_greater(oid.start, first_occurrence_id.start):\n273\t                        iterator = itertools.chain(lost_occurrences, iterator)\n274\t                        break\n275\t            else:\n276\t                iterator = self._after(earliest_end)\n277\t        else:\n278\t            iterator = self._after(earliest_end)\n279\t        return Pages(\n280\t            occurrence_iterator=iterator,\n281\t            size=page_size,\n282\t            stop=latest_start,\n283\t            keep_recurrence_attributes=self.keep_recurrence_attributes,\n284\t        )\n285\t\n286\t\n287\t__all__ = [\"CalendarQuery\", \"T_COMPONENTS\"]\n288\t"}]},"parent_tool_use_id":null,"session_id":"9e95fb17-f91a-4377-b11f-299a8b673b0a","uuid":"320ab05e-fabe-4f54-a323-7781e64ba99f","timestamp":"2026-09-10T16:29:06.380Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-6Xzc4K/repo/recurring_ical_events/query.py","content":"\"\"\"Core functionality: querying the calendar for occurrences.\"\"\"\n\nfrom __future__ import annotations\n\nimport contextlib\nimport datetime\nimport itertools\nimport sys\nfrom typing import TYPE_CHECKING, Generator, Optional, Sequence\n\nimport icalendar\n\nfrom recurring_ical_events.adapters.component import ComponentAdapter\nfrom recurring_ical_events.constants import DATE_MAX_DT, DATE_MIN_DT\nfrom recurring_ical_events.errors import (\n    BadRuleStringFormat,\n    InvalidCalendar,\n    PeriodEndBeforeStart,\n)\nfrom recurring_ical_events.occurrence