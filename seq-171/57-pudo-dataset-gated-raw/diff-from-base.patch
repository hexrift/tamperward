+    def _release_local_connection(self) -> None:
+        """Close and forget the connection owned by the current thread.
+
+        Called once an explicit transaction (``begin()``/``with db:``) has
+        fully unwound, so short-lived threads don't accumulate one open
+        connection each (issue #425). ``executable`` will lazily reconnect
+        if the thread performs further work.
+        """
+        tid = threading.get_ident()
+        with self.lock:
+            conn = self.connections.pop(tid, None)
+        if conn is not None:
+            conn.close()
+
     def __enter__(self) -> "Database":
         """Start a transaction."""
         self.begin()
