+    def _release_connection(self) -> None:
+        """Return the current thread's connection to the pool.
+
+        Called once a thread's outermost transaction has ended, so that
+        connections opened by short-lived worker threads (e.g. via
+        ``with db:``) don't accumulate in ``self.connections`` forever.
+        """
+        with self.lock:
+            conn = self.connections.pop(threading.get_ident(), None)
+        if conn is not None:
+            conn.close()
+
     def __enter__(self) -> "Database":
         """Start a transaction."""
         self.begin()
