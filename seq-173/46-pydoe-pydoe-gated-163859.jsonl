range(k)]","+    words: list[str] = []"," ","-    gen_str = \" \".join(base + generated)","-    return fracfact(gen_str)","+    # A candidate word is safe to add if no subset of at most (res - 2)","+    # already-placed vectors XORs to the candidate's own vector: such a","+    # subset, together with the candidate, would form a defining word of","+    # length < res.","+    max_subset = res - 2"," ","+    def collides(candidate: int) -> bool:","+        for size in range(1, max_subset + 1):","+            if size > len(vectors):","+                break","+            for combo in itertools.combinations(vectors, size):","+                xor_val = 0","+                for v in combo:","+                    xor_val ^= v","+                if xor_val == candidate:","+                    return True","+        return False"," ","+    for order in range(res - 1, k + 1):","+        for combo in itertools.combinations(range(k), order):","+            if len(words) >= needed:","+                break","+            candidate = 0","+            for idx in combo:","+                candidate |= 1 << idx","+            if collides(candidate):","+                continue","+            vectors.append(candidate)","+            words.append(\"\".join(base[i] for i in combo))","+        if len(words) >= needed:","+            break","+","+    if len(words) < needed:","+        return None","+    return words","+","+"," def _get_base_factors_from_table(n: int, res: int) -> int | None:","     \"\"\"","     Lookup k (base factors) from commonly used fractional factorial tables."]}],"userModified":false,"replaceAll":false}}
