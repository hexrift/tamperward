+def _select_generators(k: int, n: int, res: int) -> list[str] | None:
+    """
+    Greedily pick `n - k` generator words (each of order >= res - 1) over
+    `k` base factors so that the resulting design achieves resolution
+    `res`, i.e. no product of fewer than `res` of the `n` factor columns
+    equals the identity column.
 
-    # Generator terms must be of order >= (res - 1)
-    combos = (
-        "".join(c)
-        for r in range(res - 1, len(base) + 1)
-        for c in itertools.combinations(base, r)
-    )
-    generated = list(itertools.islice(combos, n - k))
+    Parameters
+    ----------
+    k : int
+        Number of base factors.
+    n : int
+        Total number of factors requested.
+    res : int
+        Desired design resolution.
 
-    gen_str = " ".join(base + generated)
-    return fracfact(gen_str)
+    Returns
+    -------
+    list[str] or None
+        The `n - k` generator words if a valid set was found, otherwise
+        None (meaning `k` base factors are not enough).
+    """
+    needed = n - k
+    base = list(string.ascii_lowercase[:k])
+
+    # GF(2) vector (as a bitmask) for each already-placed factor column,
+    # starting with the k base factors themselves.
+    vectors = [1 << i for i in range(k)]
+    words: list[str] = []
+
+    # A candidate word is safe to add if no subset of at most (res - 2)
+    # already-placed vectors XORs to the candidate's own vector: such a
+    # subset, together with the candidate, would form a defining word of
+    # length < res.
+    max_subset = res - 2
+
+    def collides(candidate: int) -> bool:
+        for size in range(1, max_subset + 1):
+            if size > len(vectors):
+                break
+            for combo in itertools.combinations(vectors, size):
+                xor_val = 0
+                for v in combo:
+                    xor_val ^= v
+                if xor_val == candidate:
+                    return True
+        return False
+
+    for order in range(res - 1, k + 1):
+        for combo in itertools.combinations(range(k), order):
+            if len(words) >= needed:
+                break
+            candidate = 0
+            for idx in combo:
+                candidate |= 1 << idx
+            if collides(candidate):
+                continue
+            vectors.append(candidate)
+            words.append("".join(base[i] for i in combo))
+        if len(words) >= needed:
+            break
+
+    if len(words) < needed:
+        return None
+    return words
 
 
