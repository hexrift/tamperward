      The owner of the function or method.\n104\t\n105\t                If spying on an unbound method, this **must** be set to the\n106\t                class that owns it.\n107\t\n108\t                If spying on a bound method that identifies as a plain\n109\t                function (which may happen if the method is decorated and\n110\t                dynamically returns a new function on access), this should\n111\t                be the instance of the object you're spying on.\n112\t\n113\t            func_name (str, optional):\n114\t                An explicit name for the function. This will be used instead\n115\t                of the function's specified name, and is usually a sign of a\n116\t                bad decorator.\n117\t\n118\t                Version Added:\n119\t                    7.0\n120\t        \"\"\"\n121\t        # Start off by grabbing the current frame. This will be needed for\n122\t        # some errors.\n123\t        self.init_frame = inspect.currentframe()\n124\t\n125\t        # Check the parameters passed to make sure that invalid data wasn't\n126\t        # provided.\n127\t        if op is not None and call_fake is not None:\n128\t            raise ValueError('op and call_fake cannot both be provided.')\n129\t\n130\t        if hasattr(func, 'spy'):\n131\t            raise ExistingSpyError(func)\n132\t\n133\t        if (not callable(func) or\n134\t            not hasattr(func, FunctionSig.FUNC_NAME_ATTR) or\n135\t            not (hasattr(func, FunctionSig.METHOD_SELF_ATTR) or\n136\t                 hasattr(func, FunctionSig.FUNC_GLOBALS_ATTR))):\n137\t            raise ValueError('%r cannot be spied on. It does not appear to '\n138\t                             'be a valid function or method.'\n139\t                             % func)\n140\t\n141\t        # Construct a signature for the function and begin closely inspecting\n142\t        # the parameters, making sure everything will be compatible so we\n143\t        # don't have un