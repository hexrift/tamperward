diff --git a/kgb/spies.py b/kgb/spies.py
index 06bbc2a..36e8b23 100644
--- a/kgb/spies.py
+++ b/kgb/spies.py
@@ -220,6 +220,15 @@ class FunctionSpy(object):
 
             # Now we can patch the owner to prevent conflicts between spies.
             self._patch_owner()
+        elif (self.owner is not None and
+              inspect.isclass(self.owner) and
+              self.func_name in self.owner.__dict__):
+            # The owner doesn't need patching, but we still need to record
+            # whatever is actually defined on the class (e.g. a classmethod
+            # or staticmethod descriptor) rather than the resolved function,
+            # so that unspy() can restore the original descriptor instead of
+            # replacing it with a plain function/bound method.
+            self._owner_func_attr_value = self.owner.__dict__[self.func_name]
         else:
             self._owner_func_attr_value = self.orig_func
 
