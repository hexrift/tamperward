   def test_postgres_search_path_escapes_every_libpq_separator(self) -> None:\n106-        # `pg_split_opts` terminates an argument on isspace(), not on the space\n107-        # character alone, so every one of these must be escaped or it splits\n108-        # the options string and the rest is read as further arguments.\n109-        for encoded, raw in (\n110-            (\"%20\", \" \"),\n111-            (\"%09\", \"\\t\"),\n112-            (\"%0A\", \"\\n\"),\n113-            (\"%0B\", \"\\v\"),\n114-            (\"%0C\", \"\\f\"),\n115-            (\"%0D\", \"\\r\"),\n116-        ):\n117-            with self.subTest(separator=repr(raw)):\n118-                url = dj_database_url.parse(\n119-                    f\"postgres://u:p@host:5431/db?currentSchema=a{encoded}b\"\n120-                )\n121-                assert url[\"OPTIONS\"][\"options\"] == f\"-c search_path=a\\\\{raw}b\"\n122-\n123:    def test_postgres_search_path_survives_the_libpq_splitter(self) -> None:\n124-        # Round-trip against the rule `pg_split_opts` implements: whatever the\n125-        # schema name contains, the escaped string must come back out as\n126-        # exactly two arguments with the name intact.\n127-        separators = \" \\t\\n\\v\\f\\r\"\n128-\n129-        def split_opts(optstr: str) -> list[str]:\n130-            # Port of `pg_split_opts`: arguments are separated by isspace(),\n131-            # which in the C locale is exactly `separators`, and a backslash\n132-            # escapes the character that follows it.\n133-            argv, index, length = [], 0, len(optstr)\n134-            while index < length:\n135-                while index < length and optstr[index] in separators:\n136-                    index += 1\n137-                if index >= length:\n138-                    break\n139-                current, escaped = [], False\n140-                while index < length:\n141-                    char = optstr[index]\n142-                    if char in separ