andle well enough invalid payloads.\n        if \"index out of bounds\" in str(e):\n            raise ProtocolError(\"Error decoding header block: %s\" % e)\n        raise\n","structuredPatch":[{"oldStart":461,"oldLines":6,"newStart":461,"newLines":13,"lines":["         )","         self.remote_settings = Settings(client=not self.config.client_side)"," ","+        # Keep the HPACK encoder/decoder table size caps in sync with the","+        # HEADER_TABLE_SIZE defaults declared above: the decoder must allow","+        # updates up to what we advertised locally, and the encoder must not","+        # exceed what the remote peer is assumed to allow by default.","+        self.decoder.max_allowed_table_size = self.local_settings.header_table_size","+        self.encoder.header_table_size = self.remote_settings.header_table_size","+","         # The current value of the connection flow control windows on the","         # connection.","         self.outbound_flow_control_window = self.remote_settings.initial_window_size"]}],"userModified":false,"replaceAll":false}}
