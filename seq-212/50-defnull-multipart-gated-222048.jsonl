0\t        \"\"\"Private constructor used by :class:`PushMultipartParser`\"\"\"\n871\t\n872\t        self.size = 0\n873\t        self.complete = False\n874\t\n875\t        self.headerlist = headerlist\n876\t        self.disposition = None\n877\t        self.name = None\n878\t        self.filename = None\n879\t        self.content_type = None\n880\t        self.charset = None\n881\t\n882\t        for name, value in headerlist:\n883\t            if name == \"Content-Disposition\":\n884\t                self.disposition, self.name, self.filename = parse_content_disposition(\n885\t                    value\n886\t                )\n887\t            elif name == \"Content-Type\":\n888\t                self.content_type, args = parse_options_header(value)\n889\t                self.charset = args.get(\"charset\")\n890\t\n891\t    def header(self, name: str, default=None):\n892\t        \"\"\"Return the value of a header if present, or a default value.\"\"\"\n893\t        compare = name.title()\n894\t        for header in self.headerlist:\n895\t            if header[0] == compare:\n896\t                return header[1]\n897\t        if default is KeyError:\n898\t            raise KeyError(name)\n899\t        return default\n900\t\n901\t    def __getitem__(self, name):\n902\t        \"\"\"Return a header value if present, or raise :exc:`KeyError`.\"\"\"\n903\t        return self.header(name, KeyError)\n904\t\n905\t\n906\t##############################################################################\n907\t################################## Multipart #################################\n908\t##############################################################################\n909\t\n910\t\n911\tclass MultipartParser:\n912\t    def __init__(\n913\t        self,\n914\t        stream,\n915\t        boundary,\n916\t        content_length=-1,\n917\t        charset=\"utf8\",\n918\t        strict=False,\n919\t        buffer_size=1024 * 64,\n920\t        header_limit=8,\n921\t        headersi