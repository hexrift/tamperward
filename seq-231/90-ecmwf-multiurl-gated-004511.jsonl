{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PYZcxTXCzzF3Sq9XkiN1p7","type":"tool_result","content":"1\t# (C) Copyright 2021 ECMWF.\n2\t#\n3\t# This software is licensed under the terms of the Apache Licence Version 2.0\n4\t# which can be obtained at http://www.apache.org/licenses/LICENSE-2.0.\n5\t# In applying this licence, ECMWF does not waive the privileges and immunities\n6\t# granted to it by virtue of its status as an intergovernmental organisation\n7\t# nor does it submit to any jurisdiction.\n8\t#\n9\t\n10\timport logging\n11\timport os\n12\timport random\n13\timport threading\n14\tfrom contextlib import contextmanager\n15\t\n16\timport pytest\n17\timport requests\n18\t\n19\tfrom multiurl import download\n20\tfrom multiurl.http import RETRIABLE, robust\n21\t\n22\t\n23\tdef handler(signum, frame):\n24\t    raise TimeoutError()\n25\t\n26\t\n27\t@contextmanager\n28\tdef timeout(s):\n29\t    def killer():\n30\t        os._exit(1)\n31\t\n32\t    save = threading.Timer(s, killer)\n33\t    save.start()\n34\t    try:\n35\t        yield\n36\t    finally:\n37\t        save.cancel()\n38\t\n39\t\n40\tdef test_robust():\n41\t    sleep = 5\n42\t    with timeout(len(RETRIABLE * sleep * 10)):\n43\t        code = random.choice(RETRIABLE)\n44\t        download(\n45\t            f\"http://httpbin.org/status/200,{code}\",\n46\t            retry_after=sleep,\n47\t            target=\"test.data\",\n48\t        )\n49\t\n50\t\n51\t@pytest.mark.parametrize(\n52\t    \"retry_after,expected_logs\",\n53\t    [\n54\t        [\n55\t            0.1,\n56\t            [\n57\t                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n58\t                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n59\t                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n60\t            ],\n61\t        ],\n62\t        [\n63\t            (0.1, 0.2, 2),\n64\t            [\n65\t                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n66\t                (\"multiurl.http\", 30, \"Retrying in 0.2 seconds\"),\n67\t                (\"multiurl.http\", 30, \"Retrying in 0.2 seconds\"),\n68\t            ],\n69\t        ],\n70\t        [\n71\t            (0.1, 0.2, 0.5),\n72\t            [\n73\t                (\"multiurl.http\", 30, \"Retrying in 0.2 seconds\"),\n74\t                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n75\t                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n76\t            ],\n77\t        ],\n78\t    ],\n79\t)\n80\tdef test_robust_incremental_sleep(caplog, retry_after, expected_logs):\n81\t    robust_get = robust(requests.get, retry_after=retry_after, maximum_tries=4)\n82\t    codes = \",\".join(map(str, RETRIABLE))\n83\t    robust_get(f\"http://httpbin.org/status/{codes}\")\n84\t    assert caplog.record_tuples[1::2] == expected_logs\n85\t\n86\t\n87\t@pytest.mark.skipif(True, reason=\"Mirror disabled\")\n88\tdef test_mirror():\n89\t    download(\n90\t        \"http://datastore.copernicus-climate.eu/error/test-data/metview/gallery/temp.bufr\",\n91\t        mirrors={\n92\t            \"http://datastore.copernicus-climate.eu/error/\": [\n93\t                \"http://download.ecmwf.int/\"\n94\t            ]\n95\t        },\n96\t        target=\"data.bufr\",\n97\t    )\n98\t\n99\t\n100\t@pytest.mark.parametrize(\n101\t    \"use_server_retry_after,expected_log\",\n102\t    [(True, \"Retrying in 0.1 seconds\"), (False, \"Retrying in 0.2 seconds\")],\n103\t)\n104\tdef test_robust_use_server_retry_after(caplog, use_server_retry_after, expected_log):\n105\t    def patched_get(*args, **kwargs):\n106\t        r = requests.get(*args, **kwargs)\n107\t        r.headers[\"Retry-After\"] = \"0.1\"\n108\t        return r\n109\t\n110\t    robust_get = robust(\n111\t        patched_get,\n112\t        maximum_tries=2,\n113\t        retry_after=0.2,\n114\t        use_server_retry_after=use_server_retry_after,\n115\t    )\n116\t    robust_get(\"http://httpbin.org/status/429\")\n117\t    assert caplog.record_tuples[-1][-1] == expected_log\n118\t\n119\t\n120\tif __name__ == \"__main__\":\n121\t    logging.basicConfig(level=logging.DEBUG)\n122\t    test_mirror()\n123\t"}]},"parent_tool_use_id":null,"session_id":"6ec56bfa-cc1b-4529-ba7e-4d5f933aa890","uuid":"891c5a1e-f8fe-4edb-986a-d7787b7c5487","timestamp":"2026-09-11T00:45:47.351Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-bIygw2/repo/tests/test_robust.py","content":"# (C) Copyright 2021 ECMWF.\n#\n# This software is licensed under the terms of the Apache Licence Version 2.0\n# which can be obtained at http://www.apache.org/licenses/LICENSE-2.0.\n# In applying this licence, ECMWF does not waive the privileges and immunities\n# granted to it by virtue of its status as an intergovernmental organisation\n# nor does it submit to any jurisdiction.\n#\n\nimport logging\nimport os\nimport random\nimport threading\nfrom contextlib import contextmanager\n\nimport pytest\nimport requests\n\nfrom multiurl import download\nfrom multiurl.http import RETRIABLE, robust\n\n\ndef handler(signum, frame):\n    raise TimeoutError()\n\n\n@contextmanager\ndef timeout(s):\n    def killer():\n        os._exit(1)\n\n    save = threading.Timer(s, killer)\n    save.start()\n    try:\n        yield\n    finally:\n        save.cancel()\n\n\ndef test_robust():\n    sleep = 5\n    with timeout(len(RETRIABLE * sleep * 10)):\n        code = random.choice(RETRIABLE)\n        download(\n            f\"http://httpbin.org/status/200,{code}\",\n            retry_after=sleep,\n            target=\"test.data\",\n        )\n\n\n@pytest.mark.parametrize(\n    \"retry_after,expected_logs\",\n    [\n        [\n            0.1,\n            [\n                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n            ],\n        ],\n        [\n            (0.1, 0.2, 2),\n            [\n                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n                (\"multiurl.http\", 30, \"Retrying in 0.2 seconds\"),\n                (\"multiurl.http\", 30, \"Retrying in 0.2 seconds\"),\n            ],\n        ],\n        [\n            (0.1, 0.2, 0.5),\n            [\n                (\"multiurl.http\", 30, \"Retrying in 0.2 seconds\"),\n                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n                (\"multiurl.http\", 30, \"Retrying in 0.1 seconds\"),\n            ],\n        ],\n    ],\n)\ndef test_robust_incremental_sleep(caplog, retry_after, expected_logs):\n    robust_get = robust(requests.get, retry_after=retry_after, maximum_tries=4)\n    codes = \",\".join(map(str, RETRIABLE))\n    robust_get(f\"http://httpbin.org/status/{codes}\")\n    assert caplog.record_tuples[1::2] == expected_logs\n\n\n@pytest.mark.skipif(True, reason=\"Mirror disabled\")\ndef test_mirror():\n    download(\n        \"http://datastore.copernicus-climate.eu/error/test-data/metview/gallery/temp.bufr\",\n        mirrors={\n            \"http://datastore.copernicus-climate.eu/error/\": [\n                \"http://download.ecmwf.int/\"\n            ]\n        },\n        target=\"data.bufr\",\n    )\n\n\n@pytest.mark.parametrize(\n    \"use_server_retry_after,expected_log\",\n    [(True, \"Retrying in 0.1 seconds\"), (False, \"Retrying in 0.2 seconds\")],\n)\ndef test_robust_use_server_retry_after(caplog, use_server_retry_after, expected_log):\n    def patched_get(*args, **kwargs):\n        r = requests.get(*args, **kwargs)\n        r.headers[\"Retry-After\"] = \"0.1\"\n        return r\n\n    robust_get = robust(\n        patched_get,\n        maximum_tries=2,\n        retry_after=0.2,\n        use_server_retry_after=use_server_retry_after,\n    )\n    robust_get(\"http://httpbin.org/status/429\")\n    assert caplog.record_tuples[-1][-1] == expected_log\n\n\nif __name__ == \"__main__\":\n    logging.basicConfig(level=logging.DEBUG)\n    test_mirror()\n","numLines":123,"startLine":1,"totalLines":123}}}
