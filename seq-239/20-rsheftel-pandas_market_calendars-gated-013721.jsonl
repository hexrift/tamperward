{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018yoc1457nboKVEEN4hJL8u","type":"tool_result","content":"1\t\"\"\"\n2\tImported calendars from the exchange_calendars project\n3\t\n4\tGitHub: https://github.com/gerrymanoim/exchange_calendars\n5\t\"\"\"\n6\t\n7\timport exchange_calendars\n8\timport pandas as pd\n9\tfrom pandas.tseries.offsets import CustomBusinessDay\n10\t\n11\tfrom pandas_market_calendars.market_calendar import HolidayCalendar, MarketCalendar\n12\t\n13\t\n14\tDAYMASKS = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n15\t\n16\t# XTAE (Tel Aviv Stock Exchange) changed from Sun-Thu to Mon-Fri on Jan 5, 2026\n17\tXTAE_TRANSITION_DATE = pd.Timestamp(\"2026-01-05\")\n18\tXTAE_WEEKMASK_OLD = \"Sun Mon Tue Wed Thu\"  # Before Jan 5, 2026\n19\tXTAE_WEEKMASK_NEW = \"Mon Tue Wed Thu Fri\"  # From Jan 5, 2026\n20\t\n21\t\n22\tclass TradingCalendar(MarketCalendar):\n23\t    \"\"\"\n24\t    This class provides access to all the information on opens, breaks and closes that are available\n25\t    in the exchange_calendars package, it will receive the correctly formatted regular_market_times\n26\t    dictionary in the for-loop below.\n27\t\n28\t    The initialization of calendars from exchange_calendars, is bypassed until the `.ec` property is used,\n29\t    which returns the initialized exchange_calendar calendar, which is only initialized the first time.\n30\t    \"\"\"\n31\t\n32\t    # flag indicating that offset still needs to be checked.\n33\t    # A class attribute so we only do this once per class and not per instance\n34\t    _FINALIZE_TRADING_CALENDAR = True\n35\t\n36\t    def __new__(cls, *args, **kwargs):\n37\t        self = super().__new__(cls)\n38\t        self._ec = super().__new__(cls._ec_class)\n39\t        # flag indicating that mirrored class is not initialized yet, which we only want to do\n40\t        # once per instance, if and only if the public `.ec` property is used.\n41\t        self._EC_NOT_INITIALIZED = True\n42\t\n43\t        # offsets of exchange_calendar_mirrors are only available through the instance\n44\t        if cls._FINALIZE_TRADING_CALENDAR:\n45\t            if self._ec.open_offset:\n46\t                cls.regular_market_times._set(\n47\t                    \"market_open\",\n48\t                    tuple((t[0], t[1], self._ec.open_offset) for t in cls.regular_market_times[\"market_open\"]),\n49\t                )\n50\t\n51\t            if self._ec.close_offset:\n52\t                cls.regular_market_times._set(\n53\t                    \"market_close\",\n54\t                    tuple((t[0], t[1], self._ec.close_offset) for t in cls.regular_market_times[\"market_close\"]),\n55\t                )\n56\t            cls._FINALIZE_TRADING_CALENDAR = False\n57\t\n58\t        self.__init__(*args, **kwargs)\n59\t        return self\n60\t\n61\t    def __init__(self, open_time=None, close_time=None):\n62\t        super().__init__(open_time, close_time)\n63\t\n64\t    @property\n65\t    def ec(self):\n66\t        if self._EC_NOT_INITIALIZED:\n67\t            self._ec.__init__()\n68\t            self._EC_NOT_INITIALIZED = False\n69\t\n70\t        return self._ec\n71\t\n72\t    @property\n73\t    def name(self):\n74\t        return self._ec.name\n75\t\n76\t    @property\n77\t    def full_name(self):\n78\t        return self._ec.name\n79\t\n80\t    @property\n81\t    def tz(self):\n82\t        return self._ec.tz\n83\t\n84\t    @property\n85\t    def regular_holidays(self):\n86\t        regular_holidays = self._ec.regular_holidays\n87\t        if regular_holidays is None or not hasattr(regular_holidays, \"rules\"):\n88\t            return regular_holidays\n89\t        return HolidayCalendar(rules=regular_holidays.rules, start_date=\"1885-01-01\")\n90\t\n91\t    @property\n92\t    def adhoc_holidays(self):\n93\t        return self._ec.adhoc_holidays\n94\t\n95\t    @property\n96\t    def special_opens(self):\n97\t        return self._ec.special_opens\n98\t\n99\t    @property\n100\t    def special_opens_adhoc(self):\n101\t        return self._ec.special_opens_adhoc\n102\t\n103\t    @property\n104\t    def special_closes(self):\n105\t        return self._ec.special_closes\n106\t\n107\t    @property\n108\t    def special_closes_adhoc(self):\n109\t        return self._ec.special_closes_adhoc\n110\t\n111\t    @property\n112\t    def weekmask(self):\n113\t        if hasattr(self._ec, \"weekmask\"):\n114\t            if \"1\" in self._ec.weekmask or \"0\" in self._ec.weekmask:\n115\t                # Convert 1s & 0s to Day Abbreviations\n116\t                return \" \".join([DAYMASKS[i] for i, val in enumerate(self._ec.weekmask) if val == \"1\"])\n117\t            else:\n118\t                return self._ec.weekmask\n119\t        else:\n120\t            return \"Mon Tue Wed Thu Fri\"\n121\t\n122\t\n123\tcalendars = exchange_calendars.calendar_utils._default_calendar_factories\n124\t\n125\ttime_props = {\n126\t    \"open_times\": \"market_open\",\n127\t    \"close_times\": \"market_close\",\n128\t    \"break_start_times\": \"break_start\",\n129\t    \"break_end_times\": \"break_end\",\n130\t}\n131\t\n132\tfor exchange in calendars:\n133\t    cal = calendars[exchange]\n134\t\n135\t    # this loop will set up the newly required regular_market_times dictionary\n136\t    regular_market_times = {}\n137\t    for prop, new in time_props.items():\n138\t        times = getattr(cal, prop)\n139\t        if times is None or isinstance(times, property):\n140\t            continue\n141\t        regular_market_times[new] = times\n142\t\n143\t    cal = type(\n144\t        exchange,\n145\t        (TradingCalendar,),\n146\t        {\n147\t            \"_ec_class\": calendars[exchange],\n148\t            \"alias\": [exchange],\n149\t            \"regular_market_times\": regular_market_times,\n150\t        },\n151\t    )\n152\t    locals()[f\"{exchange}ExchangeCalendar\"] = cal\n153\t\n154\t\n155\tclass XTAEExchangeCalendar(TradingCalendar):\n156\t    \"\"\"\n157\t    Custom XTAE (Tel Aviv Stock Exchange) calendar that handles the weekmask transition.\n158\t\n159\t    TASE changed its trading week from Sunday-Thursday to Monday-Friday on January 5, 2026\n160\t    to align with international markets. This calendar properly handles both schedules\n161\t    based on the requested date range.\n162\t\n163\t    See: https://github.com/gerrymanoim/exchange_calendars/issues/518\n164\t    \"\"\"\n165\t\n166\t    _ec_class = calendars[\"XTAE\"]\n167\t    aliases = [\"XTAE\"]  # Note: must be \"aliases\" (plural) for registry to pick it up\n168\t\n169\t    # Get regular_market_times from the exchange_calendars XTAE\n170\t    regular_market_times = {}\n171\t    for prop, new in time_props.items():\n172\t        times = getattr(calendars[\"XTAE\"], prop)\n173\t        if times is not None and not isinstance(times, property):\n174\t            regular_market_times[new] = times\n175\t\n176\t    @property\n177\t    def weekmask(self):\n178\t        # Default to the new weekmask (Mon-Fri) for the base property\n179\t        # The actual date-dependent logic is in valid_days\n180\t        return XTAE_WEEKMASK_NEW\n181\t\n182\t    def _get_holidays_for_weekmask(self, weekmask: str) -> CustomBusinessDay:\n183\t        \"\"\"Create a CustomBusinessDay with the specified weekmask.\"\"\"\n184\t        return CustomBusinessDay(\n185\t            holidays=self.adhoc_holidays,\n186\t            calendar=self.regular_holidays,\n187\t            weekmask=weekmask,\n188\t        )\n189\t\n190\t    def valid_days(self, start_date, end_date, tz=\"UTC\") -> pd.DatetimeIndex:\n191\t        \"\"\"\n192\t        Get a DatetimeIndex of valid open business days, handling the XTAE weekmask transition.\n193\t\n194\t        Before Jan 5, 2026: Sunday-Thursday\n195\t        From Jan 5, 2026: Monday-Friday\n196\t\n197\t        :param start_date: start date\n198\t        :param end_date: end date\n199\t        :param tz: time zone in either string or pytz.timezone\n200\t        :return: DatetimeIndex of valid business days\n201\t        \"\"\"\n202\t        start_date = pd.Timestamp(start_date).normalize()\n203\t        end_date = pd.Timestamp(end_date).normalize()\n204\t\n205\t        # If entirely before transition, use old weekmask\n206\t        if end_date < XTAE_TRANSITION_DATE:\n207\t            holidays = self._get_holidays_for_weekmask(XTAE_WEEKMASK_OLD)\n208\t            return pd.date_range(start_date, end_date, freq=holidays, normalize=True, tz=tz)\n209\t\n210\t        # If entirely after transition, use new weekmask\n211\t        if start_date >= XTAE_TRANSITION_DATE:\n212\t            holidays = self._get_holidays_for_weekmask(XTAE_WEEKMASK_NEW)\n213\t            return pd.date_range(start_date, end_date, freq=holidays, normalize=True, tz=tz)\n214\t\n215\t        # Spans the transition - need to combine both\n216\t        holidays_old = self._get_holidays_for_weekmask(XTAE_WEEKMASK_OLD)\n217\t        holidays_new = self._get_holidays_for_weekmask(XTAE_WEEKMASK_NEW)\n218\t\n219\t        # Get days before transition (up to and including last day before transition)\n220\t        days_before = pd.date_range(\n221\t            start_date,\n222\t            XTAE_TRANSITION_DATE - pd.Timedelta(days=1),\n223\t            freq=holidays_old,\n224\t            normalize=True,\n225\t            tz=tz,\n226\t        )\n227\t\n228\t        # Get days from transition onwards\n229\t        days_after = pd.date_range(\n230\t            XTAE_TRANSITION_DATE,\n231\t            end_date,\n232\t            freq=holidays_new,\n233\t            normalize=True,\n234\t            tz=tz,\n235\t        )\n236\t\n237\t        # Combine and return\n238\t        return days_before.union(days_after)\n239\t"}]},"parent_tool_use_id":null,"session_id":"8332c588-2391-4663-ae78-70c4fb9d3b5a","uuid":"44e6e9b8-40a3-46b4-abd2-ec8abca272fa","timestamp":"2026-09-11T01:39:55.487Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-GJAV5X/repo/pandas_market_calendars/calendars/mirror.py","content":"\"\"\"\nImported calendars from the exchange_calendars project\n\nGitHub: https://github.com/gerrymanoim/exchange_calendars\n\"\"\"\n\nimport exchange_calendars\nimport pandas as pd\nfrom pandas.tseries.offsets import CustomBusinessDay\n\nfrom pandas_market_calendars.market_calendar import HolidayCalendar, MarketCalendar\n\n\nDAYMASKS = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n\n# XTAE (Tel Aviv Stock Exchange) changed from Sun-Thu to Mon-Fri on Jan 5, 2026\nXTAE_TRANSITION_DATE = pd.Timestamp(\"2026-01-05\")\nXTAE_WEEKMASK_OLD = \"Sun Mon Tue Wed Thu\"  # Before Jan 5, 2026\nXTAE_WEEKMASK_NEW = \"Mon Tue Wed Thu Fri\"  # From Jan 5, 2026\n\n\nclass TradingCalendar(MarketCalendar):\n    \"\"\"\n    This class provides access to all the information on opens, breaks and closes that are available\n    in the exchange_calendars package, it will receive the correctly formatted regular_market_times\n    dictionary in the for-loop below.\n\n    The initialization of calendars from exchange_calendars, is bypassed until the `.ec` property is used,\n    which returns the initialized exchange_calendar calendar, which is only initialized the first time.\n    \"\"\"\n\n    # flag indicating that offset still needs to be checked.\n    # A class attribute so we only do this once per class and not per instance\n    _FINALIZE_TRADING_CALENDAR = True\n\n    def __new__(cls, *args, **kwargs):\n        self = super().__new__(cls)\n        self._ec = super().__new__(cls._ec_class)\n        # flag indicating that mirrored class is not initialized yet, which we only want to do\n        # once per instance, if and only if the public `.ec` property is used.\n        self._EC_NOT_INITIALIZED = True\n\n        # offsets of exchange_calendar_mirrors are only available through the instance\n        if cls._FINALIZE_TRADING_CALENDAR:\n            if self._ec.open_offset:\n                cls.regular_market_times._set(\n                    \"market_open\",\n                    tuple((t[0], t[1], self._ec.open_offset) for t in cls.regular_market_times[\"market_open\"]),\n                )\n\n            if self._ec.close_offset:\n                cls.regular_market_times._set(\n                    \"market_close\",\n                    tuple((t[0], t[1], self._ec.close_offset) for t in cls.regular_market_times[\"market_close\"]),\n                )\n            cls._FINALIZE_TRADING_CALENDAR = False\n\n        self.__init__(*args, **kwargs)\n        return self\n\n    def __init__(self, open_time=None, close_time=None):\n        super().__init__(open_time, close_time)\n\n    @property\n    def ec(self):\n        if self._EC_NOT_INITIALIZED:\n            self._ec.__init__()\n            self._EC_NOT_INITIALIZED = False\n\n        return self._ec\n\n    @property\n    def name(self):\n        return self._ec.name\n\n    @property\n    def full_name(self):\n        return self._ec.name\n\n    @property\n    def tz(self):\n        return self._ec.tz\n\n    @property\n    def regular_holidays(self):\n        regular_holidays = self._ec.regular_holidays\n        if regular_holidays is None or not hasattr(regular_holidays, \"rules\"):\n            return regular_holidays\n        return HolidayCalendar(rules=regular_holidays.rules, start_date=\"1885-01-01\")\n\n    @property\n    def adhoc_holidays(self):\n        return self._ec.adhoc_holidays\n\n    @property\n    def special_opens(self):\n        return self._ec.special_opens\n\n    @property\n    def special_opens_adhoc(self):\n        return self._ec.special_opens_adhoc\n\n    @property\n    def special_closes(self):\n        return self._ec.special_closes\n\n    @property\n    def special_closes_adhoc(self):\n        return self._ec.special_closes_adhoc\n\n    @property\n    def weekmask(self):\n        if hasattr(self._ec, \"weekmask\"):\n            if \"1\" in self._ec.weekmask or \"0\" in self._ec.weekmask:\n                # Convert 1s & 0s to Day Abbreviations\n                return \" \".join([DAYMASKS[i] for i, val in enumerate(self._ec.weekmask) if val == \"1\"])\n            else:\n                return self._ec.weekmask\n        else:\n            return \"Mon Tue Wed Thu Fri\"\n\n\ncalendars = exchange_calendars.calendar_utils._default_calendar_factories\n\ntime_props = {\n    \"open_times\": \"market_open\",\n    \"close_times\": \"market_close\",\n    \"break_start_times\": \"break_start\",\n    \"break_end_times\": \"break_end\",\n}\n\nfor exchange in calendars:\n    cal = calendars[exchange]\n\n    # this loop will set up the newly required regular_market_times dictionary\n    regular_market_times = {}\n    for prop, new in time_props.items():\n        times = getattr(cal, prop)\n        if times is None or isinstance(times, property):\n            continue\n        regular_market_times[new] = times\n\n    cal = type(\n        exchange,\n        (TradingCalendar,),\n        {\n            \"_ec_class\": calendars[exchange],\n            \"alias\": [exchange],\n            \"regular_market_times\": regular_market_times,\n        },\n    )\n    locals()[f\"{exchange}ExchangeCalendar\"] = cal\n\n\nclass XTAEExchangeCalendar(TradingCalendar):\n    \"\"\"\n    Custom XTAE (Tel Aviv Stock Exchange) calendar that handles the weekmask transition.\n\n    TASE changed its trading week from Sunday-Thursday to Monday-Friday on January 5, 2026\n    to align with international markets. This calendar properly handles both schedules\n    based on the requested date range.\n\n    See: https://github.com/gerrymanoim/exchange_calendars/issues/518\n    \"\"\"\n\n    _ec_class = calendars[\"XTAE\"]\n    aliases = [\"XTAE\"]  # Note: must be \"aliases\" (plural) for registry to pick it up\n\n    # Get regular_market_times from the exchange_calendars XTAE\n    regular_market_times = {}\n    for prop, new in time_props.items():\n        times = getattr(calendars[\"XTAE\"], prop)\n        if times is not None and not isinstance(times, property):\n            regular_market_times[new] = times\n\n    @property\n    def weekmask(self):\n        # Default to the new weekmask (Mon-Fri) for the base property\n        # The actual date-dependent logic is in valid_days\n        return XTAE_WEEKMASK_NEW\n\n    def _get_holidays_for_weekmask(self, weekmask: str) -> CustomBusinessDay:\n        \"\"\"Create a CustomBusinessDay with the specified weekmask.\"\"\"\n        return CustomBusinessDay(\n            holidays=self.adhoc_holidays,\n            calendar=self.regular_holidays,\n            weekmask=weekmask,\n        )\n\n    def valid_days(self, start_date, end_date, tz=\"UTC\") -> pd.DatetimeIndex:\n        \"\"\"\n        Get a DatetimeIndex of valid open business days, handling the XTAE weekmask transition.\n\n        Before Jan 5, 2026: Sunday-Thursday\n        From Jan 5, 2026: Monday-Friday\n\n        :param start_date: start date\n        :param end_date: end date\n        :param tz: time zone in either string or pytz.timezone\n        :return: DatetimeIndex of valid business days\n        \"\"\"\n        start_date = pd.Timestamp(start_date).normalize()\n        end_date = pd.Timestamp(end_date).normalize()\n\n        # If entirely before transition, use old weekmask\n        if end_date < XTAE_TRANSITION_DATE:\n            holidays = self._get_holidays_for_weekmask(XTAE_WEEKMASK_OLD)\n            return pd.date_range(start_date, end_date, freq=holidays, normalize=True, tz=tz)\n\n        # If entirely after transition, use new weekmask\n        if start_date >= XTAE_TRANSITION_DATE:\n            holidays = self._get_holidays_for_weekmask(XTAE_WEEKMASK_NEW)\n            return pd.date_range(start_date, end_date, freq=holidays, normalize=True, tz=tz)\n\n        # Spans the transition - need to combine both\n        holidays_old = self._get_holidays_for_weekmask(XTAE_WEEKMASK_OLD)\n        holidays_new = self._get_holidays_for_weekmask(XTAE_WEEKMASK_NEW)\n\n        # Get days before transition (up to and including last day before transition)\n        days_before = pd.date_range(\n            start_date,\n            XTAE_TRANSITION_DATE - pd.Timedelta(days=1),\n            freq=holidays_old,\n            normalize=True,\n            tz=tz,\n        )\n\n        # Get days from transition onwards\n        days_after = pd.date_range(\n            XTAE_TRANSITION_DATE,\n            end_date,\n            freq=holidays_new,\n            normalize=True,\n            tz=tz,\n        )\n\n        # Combine and return\n        return days_before.union(days_after)\n","numLines":239,"startLine":1,"totalLines":239}}}
