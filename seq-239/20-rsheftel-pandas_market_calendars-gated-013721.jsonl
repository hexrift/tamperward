ay = Holiday(\n    \"Early Close Before New Year's Day (Saturday)\",\n    month=12,\n    day=31,\n    days_of_week=(FRIDAY,),\n)\n\n#########################################################################\n# Martin Luther King Jr.\n#    Starting 1998\n##########################################################################\nUSMartinLutherKingJrFrom2022 = Holiday(\n    \"Dr. Martin Luther King Jr. Day\",\n    month=1,\n    day=1,\n    start_date=Timestamp(\"2022-01-01\"),\n    days_of_week=(\n        MONDAY,\n        TUESDAY,\n        WEDNESDAY,\n        THURSDAY,\n        FRIDAY,\n    ),\n    offset=DateOffset(weekday=MO(3)),\n)\n\nUSMartinLutherKingJrPre2022 = Holiday(\n    \"Dr. Martin Luther King Jr. Day\",\n    month=1,\n    day=1,\n    start_date=Timestamp(\"1998-01-01\"),\n    end_date=Timestamp(\"2021-12-31\"),\n    offset=DateOffset(weekday=MO(3)),\n)\n\n#########################################################################\n# US Presidents Day Feb\n##########################################################################\nUSPresidentsDayFrom2022 = Holiday(\n    \"Presidents Day\",\n    start_date=Timestamp(\"2022-01-01\"),\n    month=2,\n    day=1,\n    offset=DateOffset(weekday=MO(3)),\n)\n\nUSPresidentsDayPre2022 = Holiday(\n    \"Presidents Day\",\n    end_date=Timestamp(\"2021-12-31\"),\n    month=2,\n    day=1,\n    offset=DateOffset(weekday=MO(3)),\n)\n\n############################################################\n# Good Friday\n############################################################\nGoodFriday = Holiday(\n    \"Good Friday 1908+\",\n    start_date=Timestamp(\"1908-01-01\"),\n    month=1,\n    day=1,\n    offset=[Easter(), Day(-2)],\n)\n\n##################################################\n# US Memorial Day (Decoration Day) May 30\n##################################################\nUSMemorialDayFrom2022 = Holiday(\n    \"Memorial Day\",\n    month=5,\n    day=25,\n    start_date=Timestamp(\"2022-01-01\"),\n    offset=DateOffset(weekday=