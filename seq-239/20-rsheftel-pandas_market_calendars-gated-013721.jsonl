Timestamp(\"2026-03-26\", tz=\"UTC\"),  # Thu, Shri Ram Navami\n    Timestamp(\"2026-03-31\", tz=\"UTC\"),  # Tue, Shri Mahavir Jayanti\n    Timestamp(\"2026-04-03\", tz=\"UTC\"),  # Fri, Good Friday\n    Timestamp(\"2026-04-14\", tz=\"UTC\"),  # Tue, Dr. Baba Saheb Ambedkar Jayanti\n    Timestamp(\"2026-05-01\", tz=\"UTC\"),  # Fri, Maharashtra Day\n    Timestamp(\"2026-05-28\", tz=\"UTC\"),  # Thu, Bakri Id\n    Timestamp(\"2026-06-26\", tz=\"UTC\"),  # Fri, Muharram\n    Timestamp(\"2026-09-14\", tz=\"UTC\"),  # Mon, Ganesh Chaturthi\n    Timestamp(\"2026-10-02\", tz=\"UTC\"),  # Fri, Mahatma Gandhi Jayanti\n    Timestamp(\"2026-10-20\", tz=\"UTC\"),  # Tue, Dussehra\n    Timestamp(\"2026-11-10\", tz=\"UTC\"),  # Tue, Diwali-Balipratipada\n    Timestamp(\"2026-11-24\", tz=\"UTC\"),  # Tue, Prakash Gurpurb Sri Guru Nanak Dev\n    Timestamp(\"2026-12-25\", tz=\"UTC\"),  # Fri, Christmas\n]\n\nNSEClosedDay = BSEClosedDay.copy()\n\n\nclass BSEExchangeCalendar(MarketCalendar):\n    \"\"\"\n    Exchange calendar for the Bombay Stock Exchange (BSE).\n    Open Time: 9:15 AM, Asia/Calcutta\n    Close Time: 3:30 PM, Asia/Calcutta\n\n    Due to the complexity around the BSE holidays, we are hardcoding a list\n    of holidays back to 1997, and forward through 2026.  There are no known\n    early closes or late opens.\n    \"\"\"\n\n    aliases = [\"BSE\"]\n    regular_market_times = {\n        \"market_open\": ((None, time(9, 15)),),\n        \"market_close\": ((None, time(15, 30)),),\n    }\n\n    @property\n    def name(self):\n        return \"BSE\"\n\n    @property\n    def full_name(self):\n        return \"Bombay Stock Exchange\"\n\n    @property\n    def tz(self):\n        return ZoneInfo(\"Asia/Calcutta\")\n\n    @property\n    def adhoc_holidays(self):\n        return BSEClosedDay\n\n\nclass NSEExchangeCalendar(BSEExchangeCalendar):\n    \"\"\"\n    Exchange calendar for the National Stock Exchange of India (NSE, XNSE).\n    \"\"\"\n\n    aliases = [\"NSE\", \"XNSE\"]\n\n    @property\n    def name(self):\n        return \"NSE\"\n\n    @property\n    def full_name(self):\n        return \"National Stock Exchange of India\"\n\n    @property\n    def adhoc_holidays(self):\n        return NSEClosedDay\n","structuredPatch":[{"oldStart":435,"oldLines":7,"newStart":435,"newLines":7,"lines":["     early closes or late opens.","     \"\"\""," ","-    aliases = [\"BSE\"]","+    aliases = [\"BSE\", \"XBOM\"]","     regular_market_times = {","         \"market_open\": ((None, time(9, 15)),),","         \"market_close\": ((None, time(15, 30)),),"]}],"userModified":false,"replaceAll":false}}
