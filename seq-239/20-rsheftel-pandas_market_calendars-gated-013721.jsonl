{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K6PczU617Bnj69TS3mnySQ","type":"tool_result","content":"424\tNSEClosedDay = BSEClosedDay.copy()\n425\t\n426\t\n427\tclass BSEExchangeCalendar(MarketCalendar):\n428\t    \"\"\"\n429\t    Exchange calendar for the Bombay Stock Exchange (BSE).\n430\t    Open Time: 9:15 AM, Asia/Calcutta\n431\t    Close Time: 3:30 PM, Asia/Calcutta\n432\t\n433\t    Due to the complexity around the BSE holidays, we are hardcoding a list\n434\t    of holidays back to 1997, and forward through 2026.  There are no known\n435\t    early closes or late opens.\n436\t    \"\"\"\n437\t\n438\t    aliases = [\"BSE\"]\n439\t    regular_market_times = {\n440\t        \"market_open\": ((None, time(9, 15)),),\n441\t        \"market_close\": ((None, time(15, 30)),),\n442\t    }\n443\t\n444\t    @property\n445\t    def name(self):\n446\t        return \"BSE\"\n447\t\n448\t    @property\n449\t    def full_name(self):\n450\t        return \"Bombay Stock Exchange\"\n451\t\n452\t    @property\n453\t    def tz(self):\n454\t        return ZoneInfo(\"Asia/Calcutta\")\n455\t\n456\t    @property\n457\t    def adhoc_holidays(self):\n458\t        return BSEClosedDay\n459\t\n460\t\n461\tclass NSEExchangeCalendar(BSEExchangeCalendar):\n462\t    \"\"\"\n463\t    Exchange calendar for the National Stock Exchange of India (NSE, XNSE).\n464\t    \"\"\"\n465\t\n466\t    aliases = [\"NSE\", \"XNSE\"]\n467\t\n468\t    @property\n469\t    def name(self):\n470\t        return \"NSE\"\n471\t\n472\t    @property\n473\t    def full_name(self):"}]},"parent_tool_use_id":null,"session_id":"8332c588-2391-4663-ae78-70c4fb9d3b5a","uuid":"30675f26-36c4-4e93-b25a-2f0113c8e064","timestamp":"2026-09-11T01:39:33.292Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tb3-run-GJAV5X/repo/pandas_market_calendars/calendars/bse.py","content":"NSEClosedDay = BSEClosedDay.copy()\n\n\nclass BSEExchangeCalendar(MarketCalendar):\n    \"\"\"\n    Exchange calendar for the Bombay Stock Exchange (BSE).\n    Open Time: 9:15 AM, Asia/Calcutta\n    Close Time: 3:30 PM, Asia/Calcutta\n\n    Due to the complexity around the BSE holidays, we are hardcoding a list\n    of holidays back to 1997, and forward through 2026.  There are no known\n    early closes or late opens.\n    \"\"\"\n\n    aliases = [\"BSE\"]\n    regular_market_times = {\n        \"market_open\": ((None, time(9, 15)),),\n        \"market_close\": ((None, time(15, 30)),),\n    }\n\n    @property\n    def name(self):\n        return \"BSE\"\n\n    @property\n    def full_name(self):\n        return \"Bombay Stock Exchange\"\n\n    @property\n    def tz(self):\n        return ZoneInfo(\"Asia/Calcutta\")\n\n    @property\n    def adhoc_holidays(self):\n        return BSEClosedDay\n\n\nclass NSEExchangeCalendar(BSEExchangeCalendar):\n    \"\"\"\n    Exchange calendar for the National Stock Exchange of India (NSE, XNSE).\n    \"\"\"\n\n    aliases = [\"NSE\", \"XNSE\"]\n\n    @property\n    def name(self):\n        return \"NSE\"\n\n    @property\n    def full_name(self):","numLines":50,"startLine":424,"totalLines":479}}}
