Thanksgiving = Holiday(\n    \"Friday after Thanksgiving\",\n    month=11,\n    day=1,\n    offset=[DateOffset(weekday=TH(4)), Day(1)],\n)\n\nUSThanksgivingFridayFrom2021 = Holiday(\n    \"Thanksgiving Friday\",\n    month=11,\n    day=1,\n    offset=[DateOffset(weekday=TH(4)), Day(1)],\n    start_date=Timestamp(\"2021-01-01\"),\n)\n\nUSThanksgivingFridayPre2021 = Holiday(\n    \"Thanksgiving Friday\",\n    month=11,\n    day=1,\n    offset=[DateOffset(weekday=TH(4)), Day(1)],\n    end_date=Timestamp(\"2020-12-31\"),\n)\n\n################################\n# Christmas Dec 25\n################################\nChristmasCME = Holiday(\n    \"Christmas\",\n    month=12,\n    day=25,\n    start_date=Timestamp(\"1999-01-01\"),\n    observance=nearest_workday,\n)\n","structuredPatch":[{"oldStart":38,"oldLines":6,"newStart":38,"newLines":7,"lines":["     \"Early Close Before New Year's Day (Saturday)\",","     month=12,","     day=31,","+    end_date=Timestamp(\"2011-12-31\"),","     days_of_week=(FRIDAY,),"," )"," "]}],"userModified":false,"replaceAll":false}}
